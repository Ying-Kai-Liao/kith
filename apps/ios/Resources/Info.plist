<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>KithEnvironment</key><string>$(KITH_ENV)</string>
    <key>KithAppGroup</key><string>$(KITH_APP_GROUP)</string>
    <key>KithURLScheme</key><string>$(KITH_URL_SCHEME)</string>
    <key>KithAPNSEnvironment</key><string>$(KITH_APNS_ENVIRONMENT)</string>
    <key>KithPushRelayHost</key><string>$(KITH_PUSH_RELAY_HOST)</string>
	<key>KithKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(KITH_KEYCHAIN_GROUP)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(KITH_URL_SCHEME)</string>
				<string>$(KITH_LEGACY_URL_SCHEME)</string>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Palette.background, so the splash bot appears on the same canvas. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
