{
  "name": "kith-desktop",
  "productName": "Kith",
  "version": "0.1.3",
  "description": "Kith for macOS, Linux and Windows: your coding agents as teammates.",
  "author": {
    "name": "Ying-Kai Liao"
  },
  "homepage": "https://github.com/Ying-Kai-Liao/kith",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/dev.mjs",
    "build": "electron-vite build",
    "build:demo": "vite build --config vite.demo.config.ts && mv ../../web/public/demo/desktop/index.html ../../web/public/demo/desktop.html",
    "build:web": "vite build --config vite.web.config.ts",
    "tokens": "vite --config vite.tokens.config.ts",
    "components": "vite --config vite.tokens.config.ts --open /components.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-transform-types src/shared/*.test.ts src/shared/relay-core/*.test.ts src/renderer/web/*.test.ts src/renderer/lib/*.test.ts src/renderer/store/*.test.ts src/renderer/client/*.test.ts src/renderer/components/kith/*.test.ts src/renderer/views/thread/*.test.ts src/renderer/views/call/*.test.ts",
    "test:browser": "node tools/browser-vectors.mjs",
    "test:web": "node tools/web-e2e.mjs && node tools/web-confirm.mjs",
    "e2e:relay": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/relay-e2e.ts",
    "e2e:relay:host": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/relay-e2e-host.ts",
    "icons": "swift tools/export-symbols.swift",
    "dist:mac": "node tools/account-config.mjs && node tools/native-host.mjs && node tools/native-screen.mjs && node tools/native-speech.mjs && electron-vite build && electron-builder --mac",
    "dist:linux": "node tools/account-config.mjs && electron-vite build && electron-builder --linux",
    "dist:win": "node tools/account-config.mjs && node tools/native-host.mjs && electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@clerk/clerk-js": "6.40.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide": "^1.52.0",
    "playwright-core": "1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "electron-updater": "^6.8.9"
  }
}
