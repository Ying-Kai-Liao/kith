// Assets-only Worker for the member web client (design 2026-10-25-web-client §4.3): no script, no bindings, no routes.
// Deployed only from CI (.github/workflows/web-deploy.yml); never `wrangler login` on a Mac.
{
  "name": "kith-web-dev",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-web",
    // `/` and `/join` (and the OAuth return) all get index.html.
    "not_found_handling": "single-page-application"
  }
}
