# Cloudflare Workers assets headers. Copied into dist-web/ by check.sh (the build empties that folder).
# connect-src is the dev cloud and the Clerk dev instance's Frontend API only; script-src stays 'self'.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src https://kith-cloud-dev.lykevin890919.workers.dev wss://kith-cloud-dev.lykevin890919.workers.dev https://adjusted-starfish-4735.clerk.accounts.dev; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
