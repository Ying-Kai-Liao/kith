#!/bin/bash
# flow reviewer full check for Ying-Kai-Liao/kith. The reviewer merges a batch of PRs locally; this pushes that batch to
# flow/batch-<sha8> and opens the batch PR main requires. The PR's own `ci` run is the heavy run (ci.yml turns the heavy
# tier on for a flow/batch- head ref), so one run checks the batch. No local builds.
# On success the batch PR stays open and green: merge it with `gh pr merge <n> --merge --delete-branch`.
set -uo pipefail
repo=Ying-Kai-Liao/kith
sha=$(git rev-parse HEAD)
branch="flow/batch-${sha:0:8}"
ok=0

cleanup() { [ "$ok" = 1 ] || git push -q origin --delete "$branch" >/dev/null 2>&1 || true; }
trap cleanup EXIT

git push -q -f origin "HEAD:refs/heads/$branch" || { echo "push of $branch failed"; exit 1; }

pr=$(gh pr list --repo "$repo" --head "$branch" --state open --json number -q '.[0].number')
if [ -z "$pr" ]; then
  url=$(gh pr create --repo "$repo" --base main --head "$branch" --title "flow batch ${sha:0:8}" \
        --body "Batch checked by the flow reviewer (this PR's own ci run is the heavy tier: flow/batch- head ref).") \
    || { echo "could not open the batch PR for $branch"; exit 1; }
  pr=${url##*/}
fi
echo "batch PR: https://github.com/$repo/pull/$pr"

# Wait for the PR's `ci` on this sha. Right after the push `gh pr checks` reports nothing, and it may still show the
# cancelled run of an older sha, so only read the check once the PR's head is this sha.
st=""
for _ in $(seq 1 240); do
  head=$(gh pr view "$pr" --repo "$repo" --json headRefOid -q .headRefOid 2>/dev/null)
  if [ "$head" = "$sha" ]; then
    st=$(gh pr checks "$pr" --repo "$repo" --required --json name,state -q '.[] | select(.name=="ci") | .state' 2>/dev/null)
    case "$st" in
      SUCCESS) break ;;
      FAILURE|CANCELLED|ERROR|TIMED_OUT)
        echo "batch PR #$pr: ci $st"
        gh pr checks "$pr" --repo "$repo" | grep -i fail
        exit 1 ;;
    esac
  fi
  sleep 60
done
[ "$st" = SUCCESS ] || { echo "batch PR #$pr: ci not finished after 4 hours"; exit 1; }
ok=1
echo "batch PR #$pr is green at ${sha:0:8}: merge it with gh pr merge $pr --repo $repo --merge --delete-branch, then reviewer done"
