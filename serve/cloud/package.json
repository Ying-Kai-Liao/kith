{
  "name": "kith-cloud",
  "version": "0.1.0",
  "description": "Kith cloud: accounts, computers and the end-to-end encrypted relay (Cloudflare Worker + Durable Object)",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "deploy:dev": "wrangler deploy --env kith-dev",
    "build:web": "cd ../../apps/desktop && KITH_WEB_BASE=/join/ KITH_WEB_OUT_DIR=../../serve/cloud/site/join KITH_WEB_CLOUD_URL=https://api.kithbot.app KITH_WEB_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsua2l0aGJvdC5hcHAk npm run build:web",
    "deploy:main": "npm run build:web && wrangler deploy --env kith",
    "typecheck": "tsc && tsc -p test/e2e",
    "test": "vitest run",
    "e2e": "node --experimental-strip-types --no-warnings test/e2e/relay.e2e.ts",
    "e2e:account": "node --experimental-strip-types --no-warnings test/e2e/account.e2e.ts",
    "e2e:invite": "node --experimental-strip-types --no-warnings test/e2e/invite.e2e.ts",
    "e2e:bot": "node --experimental-strip-types --no-warnings test/e2e/bot.e2e.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "svix": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.140.0",
    "vitest": "~4.1.11",
    "@cloudflare/vitest-pool-workers": "^0.22.0"
  }
}
