.DS_Store
__pycache__/
.orca/
# Your agents live in this folder too, their own repo: never part of hq itself.
# Careful: `git clean -x` here would delete them; push them (hq-state commit) before cleaning.
/agents/
# Older layouts kept state/ and .store/ here; still ignored so a private state folder can never be committed.
/state/
.store/

# apps/ and serve/ (from kith-app's root .gitignore)
xcuserdata/
DerivedData/
/build/
apps/desktop/build/
.build/
.swiftpm/
Package.resolved
# Xcode Cloud resolves packages only from the checked-in pins
!apps/Kith.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.p8
.dev.vars
.wrangler/

# Local PostHog project key for app builds (see apps/README.md)
apps/shared/Config/Secrets.plist
.hypothesis/
.target-*/
