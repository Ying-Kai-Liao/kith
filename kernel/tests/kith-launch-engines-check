#!/usr/bin/env bash
# kith-launch-engines-check — `kith <agent> --launch-json` for every engine (docs/plans/one-bot-model.md A2b-2): claude and
# codex print what they always printed (golden: kernel/tests/fixtures/launch-claude.json, launch-codex.json; UPDATE_GOLDEN=1
# rewrites them, only from a base whose output is the intended one), another ACP engine (a fake `gemini`) prints the engine
# and acp keys the host starts it with, and a run for anyone but the owner is refused unless the engine can hold the
# guest rules. Throwaway HOME / KITH_HOME; fake engines only.
#
#   kernel/tests/kith-launch-engines-check     a few seconds; prints each check, exits 1 when one fails
#   KITH_DIFFTEST_BIN=/path/to/kith            also the cases that need the Rust program (kith kernel engines)
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
FIX=$KERNEL/tests/fixtures
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-launch-engines-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_MODEL KITH_EFFORT KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME KITH_VIA HQ_VIA
mkdir -p "$HOME/.claude" "$HOME/.codex" "$KITH_HOME/state" "$T/bin"
export KITH_STATE=$KITH_HOME/state
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
for h in codex gemini; do printf '#!/bin/sh\necho "%s $*"\n' "$h" > "$T/bin/$h"; chmod +x "$T/bin/$h"; done
# Claude Code 2.1.257+ is what a guest run needs; the fake says so.
printf '#!/bin/sh\n[ "$1" = --version ] && { echo "2.1.300 (Claude Code)"; exit 0; }\necho claude "$@"\n' > "$T/bin/claude"
chmod +x "$T/bin/claude"
touch "$HOME/.claude/.fake-login" "$HOME/.codex/.fake-login"
export PATH=$T/bin:$PATH
mkdir -p "$T/home"

KITH=$KERNEL/bin/kith
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
agent() { # name harness-or-empty
  local a=$KITH_HOME/agents/$1/role
  mkdir -p "$a"
  { printf -- '---\nname: %s\ndescription: test agent\n' "$1"; [ -n "$2" ] && printf 'harness: %s\n' "$2"; printf -- '---\nYou are %s.\n' "$1"; } > "$a/agent.md"
  git -C "$a" init -q && git -C "$a" commit -qm init --allow-empty
}
# The launch object with the throwaway roots made stable.
launch() { (cd "$T/home" && "$KITH" "$@" --launch-json 2>"$T/err") | sed -e "s#$T#<T>#g" -e "s#$KERNEL#<K>#g" -E -e 's/@[0-9a-f]{10}/@<h>/g' -e 's/"[0-9a-f]{10}"/"<h>"/g' -e 's/[0-9a-f]{32}/<id>/g' -e 's/date=\\"[0-9-]+\\"/date=\\"<d>\\"/g'; }
AUTH=$KERNEL/bin/kith-auth
agent cl ""; agent cx codex; agent gm gemini; agent ag agy; agent nope nosuchengine

for pair in "cl claude" "cx codex"; do
  set -- $pair
  out=$(launch "$1" | python3 -c 'import json,sys; d=json.load(sys.stdin); d["agent_version"]="<v>"; print(json.dumps(d, indent=1, sort_keys=True))')
  if [ -n "${UPDATE_GOLDEN:-}" ]; then printf '%s\n' "$out" > "$FIX/launch-$2.json"; fi
  check "$2 launch-json is the golden one" "[ \"\$out\" = \"\$(cat '$FIX/launch-$2.json')\" ]"
done

BIN=${KITH_DIFFTEST_BIN:-${KITH_BIN:-}}
[ -n "$BIN" ] && export KITH_BIN=$BIN   # the kernel finds its Rust program here (kith_paths.py --bin)
if [ -n "$BIN" ] && "$BIN" kernel engines --json >/dev/null 2>&1; then
  g=$(launch gm | sed "s#<T>#$T#g")
  py() { printf '%s' "$g" | python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"; }
  check "gemini: engine id" "[ \"\$(py 'd[\"engine\"]')\" = gemini ]"
  check "gemini: acp command is the engine's own ACP mode" "[ \"\$(py 'd[\"acp\"][\"command\"]+\" \"+\" \".join(d[\"acp\"][\"args\"])')\" = '$T/bin/gemini --acp' ]"
  check "gemini: role prompt delivery is data" "[ \"\$(py 'd[\"role_prompt\"]')\" = none ]"
  check "gemini: the role prompt is carried" "[ \"\$(py '\"You are gm\" in d[\"system_prompt\"]')\" = True ]"
  check "gemini: harness stays the agent's word" "[ \"\$(py 'd[\"harness\"]')\" = gemini ]"
  check "agy (alias) resolves to its engine" "launch ag | grep -q '\"engine\": \"antigravity\"'"
  check "claude launch lists no engine key" "! launch cl | grep -q '\"engine\"'"
else
  echo "skip the gemini launch checks (no Rust kith program; KITH_DIFFTEST_BIN names one)"
  (cd "$T/home" && KITH_CORE=python "$KITH" gm --launch-json >/dev/null 2>"$T/err"); rc=$?
  check "no Rust program: gemini keeps today's error" "[ $rc = 1 ] && grep -q 'covers claude and codex only' '$T/err'"
fi
(cd "$T/home" && "$KITH" nope --launch-json >/dev/null 2>"$T/err"); rc=$?
check "an unknown engine is an error, never a silent wrong launch" "[ $rc != 0 ]"

"$AUTH" person sam name=Sam >/dev/null 2>&1
for a in cl cx gm; do "$AUTH" member $a sam mode=default >/dev/null 2>&1; done
# Guests: an engine without the hooks is refused with 3 (4 with a backup chain).
(cd "$T/home" && KITH_PERSON=sam "$KITH" gm --launch-json >/dev/null 2>"$T/err"); rc=$?
check "guest run on gemini is refused, exit 3" "[ $rc = 3 ] && grep -q 'anyone but the owner' '$T/err'"
(cd "$T/home" && KITH_PERSON=sam "$KITH" cx --launch-json >/dev/null 2>"$T/err"); rc=$?
check "guest run on codex is refused, exit 3" "[ $rc = 3 ] && grep -q 'anyone but the owner' '$T/err'"
(cd "$T/home" && KITH_PERSON=sam "$KITH" cl --launch-json >/dev/null 2>"$T/err"); rc=$?
check "guest run on claude still starts" "[ $rc = 0 ]"

[ $fails = 0 ] && echo "all launch-engines checks passed" || { echo "$fails check(s) failed"; exit 1; }
