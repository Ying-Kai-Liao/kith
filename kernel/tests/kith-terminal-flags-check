#!/usr/bin/env bash
# kith-terminal-flags-check — which runs get Claude Code whole and which go lean: the owner at their own terminal keeps
# slash commands (/plugin, /mcp, their skills), their plugins and their own MCP servers; the owner's other runs (one-shots,
# helpers, asks, the host's launch-json) load skills lazily (no --disable-slash-commands) but keep --strict-mcp-config and
# the lean plugin list; anyone else's runs keep both flags. Also the permission-mode cap for agents that read other
# people's text (capabilities.yaml reads_others).
#
#   kernel/tests/kith-terminal-flags-check     a few seconds; exits 1 when a check fails
#
# claude is a stub that prints its argv; a terminal run is driven in a pty. Throwaway HOME, KITH_HOME and KITH_STATE.
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-terminal-flags-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/kith" KITH_STATE=$T/state KITH_AUTH=$T/auth.json
unset KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE KITH_RESUME CLAUDE_CONFIG_DIR HQ_HOME HQ_STATE \
  KITH_SERVE_HOME KITH_RUN_TOKEN KITH_RUN_SOCKET KITH_ASK_TOKEN KITH_ASK_SOCKET KITH_VIA KITH_TERMINAL_SESSION
mkdir -p "$HOME" "$KITH_HOME/agents/echo/role" "$KITH_HOME/agents/open/role" "$KITH_STATE/projects" "$KITH_STATE/logs" "$T/bin" "$T/work"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$KITH_HOME/agents/echo/role/agent.md"
printf -- '---\nname: open\ndescription: test agent\n---\nYou are open.\n' > "$KITH_HOME/agents/open/role/agent.md"
printf 'global_skills: true\n' > "$KITH_HOME/agents/open/role/capabilities.yaml"
cat > "$T/bin/claude" <<'STUB'
#!/usr/bin/env bash
[[ $1 == --version ]] && { echo "2.1.309 (Claude Code)"; exit 0; }
[[ $1 == plugin ]] && { echo '[{"id":"mine@elsewhere"}]'; exit 0; }
printf 'ARG=%s\n' "$@" > "$STUB_OUT"
while [[ $# -gt 0 ]]; do [[ $1 == --settings ]] && cp "$2" "$STUB_SETTINGS" 2>/dev/null; shift; done
STUB
chmod +x "$T/bin/claude"
# A guest run refuses to start without a kith program that answers `memory hook`; a stub stands in for the host build.
printf '#!/bin/sh\n[ "$1 $2 $3" = "memory hook --help" ] && echo "usage: kith memory hook <phase>"\nexit 0\n' > "$T/bin/kith-stub"
chmod +x "$T/bin/kith-stub"
export KITH_BIN=$T/bin/kith-stub PATH=$T/bin:$PATH STUB_OUT=$T/stub.out STUB_SETTINGS=$T/stub.settings

KITH=$KERNEL/bin/kith
fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
has() { [[ $2 == *"$3"* ]] && ok "$1" || bad "$1" "'$3' not in: ${2: -400}"; }
hasnt() { [[ $2 != *"$3"* ]] && ok "$1" || bad "$1" "'$3' is in the argv"; }

args() { sed -n 's/^ARG=//p' "$STUB_OUT"; }
# A command with a pty on both ends, as at a terminal; prints what it wrote. (pty.spawn in the system python 3.9 can hang
# on macOS after the child has exited, so this reads the pty itself.)
cat > "$T/inpty.py" <<'PY'
import os, pty, sys
pid, fd = pty.fork()
if pid == 0:
    os.execvp(sys.argv[1], sys.argv[1:])
out = b''
while True:
    try:
        data = os.read(fd, 65536)
    except OSError:
        break
    if not data:
        break
    out += data
os.write(1, out)
sys.exit(os.waitpid(pid, 0)[1] >> 8)
PY
# The environment and the arguments to bin/kith follow.
tty_run() {
  rm -f "$STUB_OUT"
  (cd "$T/work" && python3 "$T/inpty.py" env "$@") >"$T/out" 2>&1 < /dev/null
}
# Neither flag: the run is Claude Code whole.
whole() { local a; a=$(args); has "$1: claude ran" "$a" "--append-system-prompt"; hasnt "$1: no --disable-slash-commands" "$a" "--disable-slash-commands"
  hasnt "$1: no --strict-mcp-config" "$a" "--strict-mcp-config"; has "$1: the agent's --mcp-config still passed" "$a" "--mcp-config"; }
# Both flags: the run is lean.
lean() { local a; a=$(args); has "$1: claude ran" "$a" "--append-system-prompt"; has "$1: --disable-slash-commands" "$a" "--disable-slash-commands"
  has "$1: --strict-mcp-config" "$a" "--strict-mcp-config"; }
# The owner's run between agents: skills load lazily (no --disable-slash-commands), MCP stays strict.
lazy() { local a; a=$(args); has "$1: claude ran" "$a" "--append-system-prompt"; hasnt "$1: no --disable-slash-commands" "$a" "--disable-slash-commands"
  has "$1: --strict-mcp-config" "$a" "--strict-mcp-config"; }
setting() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(eval(sys.argv[2]))' "$STUB_SETTINGS" "$1"; }

tty_run "$KITH" echo
whole "owner at a terminal (kith echo)"

tty_run "$KITH" echo "do it"
lazy "owner, a task given, even with a tty (one-shot)"

rm -f "$STUB_OUT"; (cd "$T/work" && "$KITH" echo "do it") >/dev/null 2>&1
lazy "owner, no tty (kith ask / schedule shape)"

tty_run KITH_VIA=ask "$KITH" echo
lazy "KITH_VIA=ask"

tty_run KITH_VIA=schedule "$KITH" echo
lazy "KITH_VIA=schedule"

tty_run KITH_AGENT=parent "$KITH" echo
lazy "started by another run (helper)"

"$KERNEL/bin/kith-auth" person guest name=Guest >/dev/null 2>&1
"$KERNEL/bin/kith-auth" member echo guest mode=default >/dev/null 2>&1
tty_run KITH_PERSON=guest "$KITH" echo
lean "a guest at a terminal"

tty_run "$KITH" open
whole "global_skills: true agent at a terminal"

# A role may keep skills off for its owner runs (global_skills: false); a guest still needs global_skills: true to get them.
mkdir -p "$KITH_HOME/agents/bare/role"
printf -- '---\nname: bare\ndescription: test agent\n---\nYou are bare.\n' > "$KITH_HOME/agents/bare/role/agent.md"
printf 'global_skills: false\n' > "$KITH_HOME/agents/bare/role/capabilities.yaml"
rm -f "$STUB_OUT"; (cd "$T/work" && "$KITH" bare "do it") >/dev/null 2>&1
lean "global_skills: false agent, owner one-shot"
tty_run "$KITH" bare
whole "global_skills: false agent at the owner terminal (the terminal keeps its slash commands)"
rm -f "$STUB_OUT"; (cd "$T/work" && KITH_ROOM_MEMBERS=guest "$KITH" echo "do it") >/dev/null 2>&1
lean "owner run in a room shared with other people"

# Plugins: the owner terminal leaves the owner's installed plugins alone; every other run turns them off.
tty_run "$KITH" echo
[[ $(setting '"mine@elsewhere" in d.get("enabledPlugins", {})') == False ]] && ok "terminal: installed plugin not filtered" || bad "terminal: installed plugin not filtered" "$(cat "$STUB_SETTINGS")"
rm -f "$STUB_OUT"; (cd "$T/work" && "$KITH" echo "do it") >/dev/null 2>&1
[[ $(setting 'd["enabledPlugins"].get("mine@elsewhere")') == False ]] && ok "owner one-shot: installed plugin off" || bad "owner one-shot: installed plugin off" "$(cat "$STUB_SETTINGS")"

# Permission mode: a reader agent's owner run is held to auto whoever asked for bypass; reads_others: false lifts it.
mkdir -p "$KITH_HOME/agents/reader/role" "$KITH_HOME/agents/mine/role"
printf -- '---\nname: reader\ndescription: test agent\n---\nYou read.\n' > "$KITH_HOME/agents/reader/role/agent.md"
printf -- '---\nname: mine\ndescription: test agent\n---\nYou work on my files.\n' > "$KITH_HOME/agents/mine/role/agent.md"
printf 'reads_others: false\n' > "$KITH_HOME/agents/mine/role/capabilities.yaml"
printf '{"permissions": {"defaultMode": "bypassPermissions", "allow": ["Artifact", "ArtifactComments", "ArtifactData"]}}\n' > "$KITH_HOME/agents/reader/role/settings.json"
mode() { rm -f "$STUB_OUT"; (cd "$T/work" && "$@") >/dev/null 2>&1; args | grep -x -e 'bypassPermissions' -e 'auto' -e 'acceptEdits' | tr '\n' ' '; }
[[ $(mode "$KITH" reader --bypass "do it") == "auto " ]] && ok "reader: --bypass held to auto" || bad "reader: --bypass held to auto" "$(mode "$KITH" reader --bypass "do it")"
[[ $(mode env KITH_PERMISSION_MODE=bypassPermissions "$KITH" reader "do it") == "auto " ]] && ok "reader: KITH_PERMISSION_MODE bypass held to auto" || bad "reader: KITH_PERMISSION_MODE bypass held to auto"
"$KITH" reader set permission bypassPermissions >/dev/null 2>&1
[[ $(mode "$KITH" reader "do it") == "auto " ]] && ok "reader: this Mac's bypass setting held to auto" || bad "reader: this Mac's bypass setting held to auto"
"$KITH" reader set permission '' >/dev/null 2>&1
[[ $(setting 'd["permissions"]["defaultMode"]') == auto ]] && ok "reader: role defaultMode bypass held to auto" || bad "reader: role defaultMode bypass held to auto" "$(cat "$STUB_SETTINGS")"
[[ $(setting '"Artifact" in d["permissions"]["allow"] and "ArtifactData" in d["permissions"]["allow"]') == True ]] && ok "reader: Artifact allow rules kept (architect publish)" || bad "reader: Artifact allow rules kept"
[[ $(mode "$KITH" reader --permission-mode acceptEdits "do it") == "acceptEdits " ]] && ok "reader: other modes untouched" || bad "reader: other modes untouched"
[[ $(mode "$KITH" mine --bypass "do it") == "bypassPermissions " ]] && ok "reads_others: false agent keeps bypass" || bad "reads_others: false agent keeps bypass"

# The host's launch: the JSON says to disable slash commands, and its argv keeps --strict-mcp-config.
j=$(cd "$T/work" && "$KITH" echo --launch-json 2>/dev/null)
has "launch-json (owner): lazy skills" "$j" '"disable_slash_commands": false'
has "launch-json: argv has --strict-mcp-config" "$j" '"--strict-mcp-config"'
j=$(cd "$T/work" && python3 "$T/inpty.py" "$KITH" echo --launch-json 2>/dev/null < /dev/null | tr -d '\r')
has "launch-json with a tty (owner): lazy skills" "$j" '"disable_slash_commands": false'
has "launch-json with a tty: argv has --strict-mcp-config" "$j" '"--strict-mcp-config"'

[[ $fail == 0 ]] && echo "all checks passed" || echo "some checks FAILED"
exit $fail
