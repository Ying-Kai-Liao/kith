#!/usr/bin/env bash
# kith-sched-turn-check: `kith kernel launch AGENT --exec --turn N --claim C` (sched-turn, retire-python P2-4 S1), the core's turn
# of a cron job run by the launch itself instead of `kith-sched run-turn`. The turn's JSON is on stdin.
#   - the program lists the capability token `sched-turn`
#   - the refusals that come before the claim: no prompt / no job (exit 2), the job's person is not the turn's (exit 3); the
#     claim is never asked for, no engine starts, the log the host opened is untouched, and the outbox made for the run is removed
#   - core down at the attach: exit 5, no engine, log untouched, outbox removed
#   - a host-claimed run through plain --exec (KITH_TURN_CLAIM, another engine) no longer exits 10 before asking: it asks the core,
#     and with none answering it starts nothing (exit 10, as Claude's own claim step refuses)
# The attach that wins (the run's env, argv and log against `kith-sched run-turn`) needs a host-made claim in a running core, which
# no script here can make: the Rust tests of core/kernel (launch/sched_turn.rs, threads/writer_turn_tests.rs) cover it.
#
#   KITH_BIN=path/to/kith kernel/tests/kith-sched-turn-check
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
KB=${KITH_BIN:-${KITH_DIFFTEST_BIN:-}}
[[ -n $KB && -x $KB ]] || { echo "skip: needs KITH_BIN (a built kith)"; exit 0; }
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-sched-turn-check.XXXXXX"); T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/state CLAUDE_CONFIG_DIR=$T/claude KITH_CORE=rust
export KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=1
unset KITH_PROJECT KITH_PERSON HQ_PERSON KITH_AGENT KITH_PERMISSION_MODE HQ_HOME HQ_STATE KITH_VIA KITH_RESUME KITH_CLAUDE_ARGS KITH_TURN_CLAIM
MACHINE=$("$KB" kernel paths --json --kernel "$KERNEL" | python3 -c 'import json, sys; print(json.load(sys.stdin)["KITH_MACHINE"])')
mkdir -p "$HOME" "$KITH_STATE" "$MACHINE" "$T/serve" "$T/bin" "$KITH_HOME/agents/house/role"
printf -- '---\nname: house\ndescription: test agent\n---\nbody\n' > "$KITH_HOME/agents/house/role/agent.md"
printf '#!/bin/sh\n[ "$1" = plugin ] && { echo "[]"; exit 0; }\necho ran > "$STUB_OUT"\n' > "$T/bin/claude"
printf '#!/bin/sh\necho ran > "$STUB_OUT"\n' > "$T/bin/codex"
chmod +x "$T/bin/claude" "$T/bin/codex"
export PATH=$T/bin:$PATH STUB_OUT=$T/stub.out
fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
is() { [[ $2 == "$3" ]] && ok "$1" || bad "$1" "got '$2', wanted '$3'"; }

"$KB" kernel version | grep -q '"sched-turn"' && ok "the program lists sched-turn" || bad "no sched-turn token" "$("$KB" kernel version)"

LOG=$T/job.log
OUTBOX=$MACHINE/outbox/sched-house-a-1
fresh() { rm -f "$STUB_OUT"; mkdir -p "$OUTBOX"; echo '{}' > "$OUTBOX.json"; printf 'the winner wrote this\n' > "$LOG"; }
turn() { # $1 = the spec
  printf '%s' "$1" | "$KB" kernel launch house --exec --kernel "$KERNEL" --turn 7 --claim 9 >> "$LOG" 2> "$T/err"; rc=$?
}
untouched() { # $1 = label
  [[ ! -e $STUB_OUT ]] && ok "$1: no engine started" || bad "$1: engine started"
  [[ "$(cat "$LOG")" == "the winner wrote this" ]] && ok "$1: the log is untouched" || bad "$1: log changed" "$(cat "$LOG")"
  [[ ! -e $OUTBOX && ! -e $OUTBOX.json ]] && ok "$1: the outbox is removed" || bad "$1: outbox left behind"
}
origin="{\"KITH_RUN_OUTBOX\": \"$OUTBOX\"}"

fresh; turn "{\"prompt\": \"\", \"job\": {\"id\": \"a\", \"cron\": \"0 8 * * *\"}, \"origin\": $origin}"
is "no prompt exits 2" "$rc" 2; untouched "no prompt"
fresh; turn "{\"prompt\": \"do a\", \"origin\": $origin}"
is "no job exits 2" "$rc" 2; untouched "no job"
fresh; turn "{\"prompt\": \"do a\", \"settings\": null, \"person\": \"sam\", \"job\": {\"id\": \"a\", \"cron\": \"c\"}, \"origin\": $origin}"
is "person mismatch exits 3" "$rc" 3; untouched "person mismatch"
grep -q "sam" "$T/err" && ok "person mismatch: says whose" || bad "person mismatch: no reason" "$(cat "$T/err")"
fresh; turn "{\"prompt\": \"do a\", \"settings\": {\"person\": \"sam\"}, \"person\": null, \"job\": {\"id\": \"a\", \"cron\": \"c\"}, \"origin\": $origin}"
is "settings person that is not the turn's exits 3" "$rc" 3; untouched "settings person"

# No core answers: the claim cannot be attached.
fresh; turn "{\"prompt\": \"do a\", \"settings\": null, \"person\": null, \"job\": {\"id\": \"a\", \"cron\": \"c\"}, \"origin\": $origin}"
is "core down at the attach exits 5" "$rc" 5; untouched "core down"

# A plain --exec with a host claim: asks the core instead of refusing up front; none answers, so nothing starts.
rm -f "$STUB_OUT"
KITH_TURN_CLAIM=7 "$KB" kernel launch house --exec --kernel "$KERNEL" -H codex "do it" >"$T/out" 2>"$T/err"; rc=$?
is "a claimed one-shot of another engine, no core: exits 10" "$rc" 10
[[ ! -e $STUB_OUT ]] && ok "it starts no engine" || bad "engine started"
grep -q "refused" "$T/err" && ok "and says the claim was refused" || bad "no reason" "$(cat "$T/err")"
exit "$fail"
