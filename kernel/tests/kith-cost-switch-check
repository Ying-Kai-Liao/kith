#!/usr/bin/env bash
# kith-cost-switch-check — kernel/bin/kith-cost is a forwarding stub (R2 of docs/plans/retire-python.md): every verb (the
# ported ones, tag and record, the text reports, a bare `kith cost`) runs stub -> `kith kernel cost`, KITH_CORE=python changes
# nothing (there is no Python cost to go back to), and `cost` is not a line of core-switched.txt. Which side answered is read
# from a wrapper standing in for kernel/bin/kith-cost in a copy of the kernel folder: it logs its call and runs the real stub.
# Also the stub's two failure rows (no program; an older program without the `cost-ledger` module: `tag` exits 0 silently, every
# other verb says so in one line and exits 3), what the launch does then (the owner still runs and sees the line; a guest is
# refused, not run without the budget check), the launch's budget checks on both paths (the bash script reaches the stub, the
# Rust launch does not call it), and the SessionStart hook form of a terminal launch with and without a program.
# Needs the Rust program: KITH_DIFFTEST_BIN=/path/to/kith (without one the check says so and exits 0).
#
#   KITH_DIFFTEST_BIN=/path/to/kith kernel/tests/kith-cost-switch-check
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
REAL=${KITH_DIFFTEST_BIN:-}
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then echo "skip: no Rust program (KITH_DIFFTEST_BIN)"; exit 0; fi
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-cost-switch-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_AUTH=$T/auth.json TZ=UTC
unset CARGO_TARGET_DIR KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CORE KITH_BIN HQ_HOME KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR KITH_RUN_TOKEN KITH_RUN_SOCKET KITH_HOME KITH_STORE KITH_PERSON_WAS
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
mkdir -p "$HOME" "$T/state" "$T/bin" "$T/work"
export KITH_STATE=$T/state KITH_HOME=$T/kith
A=$KITH_HOME/agents/echo/role
mkdir -p "$A"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$A/agent.md"
git -C "$A" init -q && git -C "$A" commit -qm init --allow-empty
printf '#!/bin/sh\n[ "$1" = --version ] && { echo "2.1.300 (Claude Code)"; exit 0; }\necho claude "$@"\n' > "$T/bin/claude"
chmod +x "$T/bin/claude"
# no kith on PATH: the stub looks there too, and "no program" must mean none
export PATH=$T/bin:/usr/bin:/bin:/usr/sbin:/sbin

# A copy of the kernel folder whose kith-cost logs what it is asked, then runs the original.
cp -R "$KERNEL" "$T/k"
LOG=$T/calls
mv "$T/k/bin/kith-cost" "$T/k/bin/kith-cost.real"
printf '#!/bin/sh\necho "kith-cost $*" >> "%s"\nexec "%s" "$@"\n' "$LOG" "$T/k/bin/kith-cost.real" > "$T/k/bin/kith-cost"
chmod +x "$T/k/bin/kith-cost"
KITH=$T/k/bin/kith
export KITH_BIN=$REAL

fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
calls() { grep -c "^kith-cost $1" "$LOG" 2>/dev/null || true; }
reset() { rm -f "$LOG"; touch "$LOG"; }
AUTH() { python3 "$T/k/bin/kith-auth" "$@"; }
SW=$T/k/lib/core-switched.txt
cp "$SW" "$T/switched.keep"
! grep -q '^cost	' "$SW" || { echo "FAIL core-switched.txt still has a cost line"; exit 1; }

AUTH person kai owner >/dev/null; AUTH person sam >/dev/null; AUTH person eve >/dev/null
AUTH bot bot-s --of sam name=Scout >/dev/null
AUTH member echo sam budget=5 >/dev/null
AUTH member echo eve budget=5 >/dev/null
AUTH member echo bot-s >/dev/null

# The ledger: the owner and sam spent a little this month; eve spent past her budget; bot-s spends from sam.
"$KERNEL/bin/kith-cost" sync >/dev/null 2>&1
M=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from kith_paths import paths; print(paths()["KITH_MACHINE"])' "$KERNEL/lib")
python3 - "$M/cost.db" <<'PY'
import datetime as dt, sqlite3, sys
c = sqlite3.connect(sys.argv[1])
now = dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S')
for i, (person, cost) in enumerate([(None, 1.0), ('sam', 2.0), ('eve', 9.0), ('bot-s', 0.5)]):
    c.execute("insert into runs (session, agent, person) values (?, 'echo', ?)", (f's{i}', person))
    c.execute("insert into req values (?, ?, ?, 'p', 'm', 'main', '1', 0, 0, 0, 0, ?)", (f'r{i}', f's{i}', now, cost))
c.commit()
PY

# 1. Every verb goes stub -> program, and KITH_CORE=python changes nothing: the stub is run both ways, with the same answer.
for line in "spent sam echo" "limit echo --sh" "members echo" "usage --json" "agent echo --json" "bots --json" "sync"; do
  reset; "$KITH" cost $line > "$T/rust.out" 2>/dev/null; rrc=$?
  check "kith cost $line goes through the stub to the program" "[ \"\$(calls '')\" -ge 1 ] && [ $rrc = 0 ]"
  reset; KITH_CORE=python "$KITH" cost $line > "$T/py.out" 2>/dev/null; prc=$?
  check "KITH_CORE=python: kith cost $line is the same call" "[ \"\$(calls '')\" -ge 1 ] && [ $prc = $rrc ]"
  case $line in
    "spent sam echo"|"limit echo --sh"|"members echo") check "same answer either way: kith cost $line" "cmp -s '$T/rust.out' '$T/py.out'" ;;
  esac
done

# 2b. A limit set and spent past (the owner kai spent $1 on echo): the stub's `limit echo --sh` says l_over=1.
"$KITH" echo set limit 0.5 >/dev/null 2>&1; "$KITH" echo set at-limit hold >/dev/null 2>&1
reset; "$KITH" cost limit echo --sh > "$T/rust.out" 2>/dev/null
check "limit set and over: the stub's answer says l_over=1" "[ \"\$(calls '')\" -ge 1 ] && grep -q 'l_over=1' '$T/rust.out'"
"$KITH" echo set limit 0 >/dev/null 2>&1

# 3. tag and record, the text reports and a bare `kith cost` go through the stub too, with and without KITH_CORE=python.
for line in "tag x" "record" "people month" "month" ""; do
  reset; "$KITH" cost $line >/dev/null 2>&1 </dev/null
  check "kith cost ${line:-<bare>} goes through the stub" "[ \"\$(calls '')\" -ge 1 ]"
  reset; KITH_CORE=python "$KITH" cost $line >/dev/null 2>&1 </dev/null
  check "KITH_CORE=python: kith cost ${line:-<bare>} is the same call" "[ \"\$(calls '')\" -ge 1 ]"
done

# 4. No program, or an old one: `tag` exits 0 without a word, every other verb says so in one line and exits 3. The stub finds
# KITH_BIN, the release it sits in, a kith on PATH, the host kith serve installed, a build next to the checkout; this copy has
# none of the last four, so an unusable KITH_BIN is "no program".
mkdir -p "$T/old"
printf '#!/bin/sh\nif [ "$1 $2" = "kernel version" ]; then echo %s; exit 0; fi\necho "old program was run: $*" >> "%s"\nexit 0\n' "'{\"modules\":[\"cost\"]}'" "$T/old/ran" > "$T/old/kith"
chmod +x "$T/old/kith"
for prog in none old; do
  case $prog in none) export KITH_BIN=$T/nonexistent ;; old) export KITH_BIN=$T/old/kith ;; esac
  reset; "$KITH" cost tag x >"$T/o" 2>"$T/e" </dev/null; rc=$?
  check "$prog program: tag exits 0, silent" "[ $rc = 0 ] && [ ! -s '$T/o' ] && [ ! -s '$T/e' ]"
  for line in "spent sam echo" "limit echo --sh" "sync" "usage --json"; do
    "$KITH" cost $line >"$T/o" 2>"$T/e" </dev/null; rc=$?
    check "$prog program: kith cost $line exits 3, one line on stderr, nothing on stdout" "[ $rc = 3 ] && [ \"\$(wc -l < '$T/e' | tr -d ' ')\" = 1 ] && grep -q '^kith-cost: ' '$T/e' && [ ! -s '$T/o' ]"
  done
  check "$prog program: the old program never ran a cost verb" "[ ! -e '$T/old/ran' ]"
  KITH_CORE=python "$KITH" cost spent sam echo >/dev/null 2>"$T/e" </dev/null; rc=$?
  check "$prog program: KITH_CORE=python changes nothing (still exit 3)" "[ $rc = 3 ]"
done
export KITH_BIN=$REAL

# 5. The launch's budget check on both paths: "rust" is `kith echo --launch-json` through the core's launch, "bash" the same
# with the `launch` line gone, so the script's own checks run (and reach kith-cost through the same router).
launch() { # PATH PERSON [ENV=VAL...] → $T/l.rc, $T/l.err
  local path=$1 who=$2; shift 2
  [ "$path" = bash ] && grep -v '^launch	' "$T/switched.keep" > "$SW"
  (cd "$T/work" && env KITH_PERSON=$who "$@" "$KITH" echo --launch-json >"$T/l.out" 2>"$T/l.err"); echo $? > "$T/l.rc"
  cp "$T/switched.keep" "$SW"
}
for path in rust bash; do
  reset; launch $path kai X=1
  check "$path path: the owner runs" "[ \"\$(cat '$T/l.rc')\" = 0 ]"
  # the bash script's budget reads run the stub; the Rust launch reads the ledger in process and never runs it
  check "$path path: the owner's limit is read $([ $path = bash ] && echo 'through the stub' || echo 'in process')" "[ \"\$(calls 'limit')\" $([ $path = bash ] && echo -ge || echo =) $([ $path = bash ] && echo 1 || echo 0) ]"
  reset; launch $path sam X=1
  check "$path path: a member under the budget runs, its spend read $([ $path = bash ] && echo 'through the stub' || echo 'in process')" "[ \"\$(cat '$T/l.rc')\" = 0 ] && [ \"\$(calls 'spent')\" $([ $path = bash ] && echo -ge || echo =) $([ $path = bash ] && echo 1 || echo 0) ]"
  reset; launch $path eve X=1
  check "$path path: a member over the budget is refused" "[ \"\$(cat '$T/l.rc')\" = 3 ] && grep -q 'has used' '$T/l.err'"
  reset; launch $path bot-s X=1
  check "$path path: a bot guest under its owner's budget runs" "[ \"\$(cat '$T/l.rc')\" = 0 ]"
  "$KITH" echo set limit 0.5 >/dev/null 2>&1
  reset; launch $path kai X=1
  "$KITH" echo set limit 0 >/dev/null 2>&1
  check "$path path: the owner over the agent's limit (hold) is held" "[ \"\$(cat '$T/l.rc')\" = 3 ] && grep -q 'held until you raise the limit' '$T/l.err'"
  reset; launch $path eve KITH_CORE=python
  check "$path path, KITH_CORE=python changes nothing: the member over the budget is refused" "[ \"\$(cat '$T/l.rc')\" = 3 ] && grep -q 'has used' '$T/l.err'"
done

# 5a. No program (the stub finds none): the owner still runs on the bash path and sees the stub's line (the agent's at-limit hold
# is skipped there: the limit could not be read; the Rust launch reads it in process and holds), a guest is refused, not run
# without the budget check. An old program without `cost-ledger` is the same.
for prog in none old; do
  case $prog in none) NB=$T/nonexistent ;; old) NB=$T/old/kith ;; esac
  "$KITH" echo set limit 0.5 >/dev/null 2>&1
  reset; launch bash kai X=1 KITH_BIN=$NB
  check "$prog program, bash path: the owner still runs and sees the stub's line" "[ \"\$(cat '$T/l.rc')\" = 0 ] && grep -q '^kith-cost: ' '$T/l.err'"
  "$KITH" echo set limit 0 >/dev/null 2>&1
  reset; launch bash sam X=1 KITH_BIN=$NB
  check "$prog program, bash path: a member is refused with the stub's line, not run unchecked" "[ \"\$(cat '$T/l.rc')\" = 3 ] && grep -q '^kith-cost: ' '$T/l.err' && grep -q 'not running without the budget check' '$T/l.err'"
done

# 5b. A renamed person: zed spent past the budget under the old id, then became zoe. The ledger still says zed, so zoe is
# refused on both paths (KITH_PERSON_WAS carries the old id to the spend).
AUTH person zed >/dev/null; AUTH member echo zed budget=5 >/dev/null
python3 - "$M/cost.db" <<'PY'
import datetime as dt, sqlite3, sys
c = sqlite3.connect(sys.argv[1])
now = dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S')
c.execute("insert into runs (session, agent, person) values ('sz', 'echo', 'zed')")
c.execute("insert into req values ('rz', 'sz', ?, 'p', 'm', 'main', '1', 0, 0, 0, 0, 9.0)", (now,))
c.commit()
PY
AUTH person zed id=zoe >/dev/null
for path in rust bash; do
  reset; launch $path zoe X=1
  check "$path path: a renamed member whose old id spent past the budget is refused" "[ \"\$(cat '$T/l.rc')\" = 3 ] && grep -q 'has used' '$T/l.err'"
done

# 6. A NaN, inf or text budget refuses a guest's run, switched or not (the limit that can't be read is not "no limit").
cp "$T/auth.json" "$T/auth.keep"
for bad in nan inf abc; do
  python3 - "$T/auth.json" "$bad" <<'PY'
import json, sys
a = json.load(open(sys.argv[1]))
a['members']['echo']['sam']['budget'] = sys.argv[2]
json.dump(a, open(sys.argv[1], 'w'))
PY
  for path in rust bash; do
    launch $path sam X=1
    check "$path path: a '$bad' budget refuses the guest" "[ \"\$(cat '$T/l.rc')\" = 3 ]"
  done
done
cp "$T/auth.keep" "$T/auth.json"

# 7. `members` when the budgets can't be read says so (budgetsError) instead of "no budget", on either side.
"$KITH" cost members echo > "$T/m.out" 2>/dev/null
check "members: sam's budget is there and there is no budgetsError" "grep -q '\"sam\": 5' '$T/m.out' && ! grep -q budgetsError '$T/m.out'"
mv "$T/k/bin/kith-auth" "$T/k/bin/kith-auth.real"
printf '#!/bin/sh\nexit 1\n' > "$T/k/bin/kith-auth"; chmod +x "$T/k/bin/kith-auth"
"$KITH" cost members echo > "$T/m2.out" 2>/dev/null
KITH_CORE=python "$KITH" cost members echo > "$T/m3.out" 2>/dev/null
check "members: kith-auth broken gives budgetsError, as the Python does" "grep -q budgetsError '$T/m2.out' && grep -q budgetsError '$T/m3.out'"
mv "$T/k/bin/kith-auth.real" "$T/k/bin/kith-auth"

# 8. The SessionStart hook of a launch without a terminal (a one-shot task: the launch builds the settings and runs claude) is the
# program's form (`<kith> kernel cost --kernel K tag`) when the program found has `cost-ledger`, and the stub's
# (`<kernel>/bin/kith-cost tag`) when none or an old one is found; KITH_CORE=python writes the same form.
mv "$T/bin/claude" "$T/bin/claude.real"
cat > "$T/bin/claude" <<'WRAP'
#!/bin/sh
prev=""; for a in "$@"; do [ "$prev" = --settings ] && cp "$a" "$STUB_SETTINGS"; prev=$a; done
exec "$(dirname "$0")/claude.real" "$@"
WRAP
chmod +x "$T/bin/claude"
export STUB_SETTINGS=$T/settings.json
hook() { # [ENV=VAL...] → the first SessionStart hook command
  rm -f "$STUB_SETTINGS"
  (cd "$T/work" && env "$@" "$KITH" echo "say hi" >"$T/hook.out" 2>&1 </dev/null)
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["hooks"]["SessionStart"][0]["hooks"][0]["command"])' "$STUB_SETTINGS" 2>/dev/null
}
h=$(hook X=1)
check "terminal launch, program with cost-ledger: the hook is the program's form" "case '$h' in *kernel\ cost\ --kernel*\ tag) true ;; *) false ;; esac"
h=$(hook KITH_CORE=python)
check "terminal launch, KITH_CORE=python: the same hook" "case '$h' in *kernel\ cost\ --kernel*\ tag) true ;; *) false ;; esac"
for NB in "$T/nonexistent" "$T/old/kith"; do
  h=$(hook KITH_BIN=$NB)
  check "terminal launch, no usable program ($(basename "$NB")): the hook is the stub" "case '$h' in *'/bin/kith-cost\" tag'|*'/bin/kith-cost tag') true ;; *) false ;; esac"
done

echo
if [ "$fails" = 0 ]; then echo "all checks passed"; else echo "$fails check(s) failed"; exit 1; fi
