#!/usr/bin/env bash
# kith-auth-revoke-check — revoking a person: they reach nothing (the `*` row and helpers included) and their bots go
# dormant; undo gives back every row as it was; `who` (kith serve's channels) says revoked, and held while a
# cloud-linked Mac is out of sync; on a cloud-linked Mac a revoke or undo goes through kith serve and is refused when it
# can't reach it.
# The rules' properties under random sequences: kith-auth-props. Throwaway dirs, never ~/.kith.
#
#   kernel/tests/kith-auth-revoke-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-revoke.XXXXXX"); T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export KITH_AUTH=$T/auth.json HOME=$T/home KITH_HOME=$T/kith KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=1
unset KITH_STATE HQ_STATE KITH_PERSON KITH_AGENT HQ_HOME
mkdir -p "$HOME" "$KITH_SERVE_DIR"
for a in house garden; do
  mkdir -p "$KITH_HOME/agents/$a/role"
  printf -- '---\nname: %s\ndescription: test\n---\nbody\n' "$a" > "$KITH_HOME/agents/$a/role/agent.md"
done
A() { python3 "$KERNEL/bin/kith-auth" "$@"; }
fail=0
check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
J() { python3 -c "import json,sys; d=json.load(open('$KITH_AUTH')); print($1)"; }
W() { A who telegram "$1" | python3 -c "import json,sys; print(json.load(sys.stdin)$2)"; }

A person kai owner >/dev/null
A person sam name=Sam >/dev/null
A member house sam preset=member helpers=garden budget=7 >/dev/null
A member garden '*' >/dev/null
A handle sam telegram 42 >/dev/null
A bot sambot --of sam >/dev/null
A member house sambot >/dev/null
ROWS=$(J "json.dumps([d['members'], d.get('grants', {})], sort_keys=True)")

check "before: sam uses house" "A may sam house"
check "before: sam uses garden through the everyone row" "A may sam garden"
check "before: sam's bot uses house" "A may sambot house"

A person sam --revoke >/dev/null
check "revoked: house is refused" "! A may sam house"
check "revoked: the everyone row is refused" "! A may sam garden"
check "revoked: a helper of house is refused" "! A may sam garden --via house"
check "revoked: their bot is dormant" "! A may sambot house"
check "revoked: may says why" "{ A may sam house || true; } | grep -q 'access was removed'"
check "revoked: resolve is not allowed" "[ \"\$(A resolve house --person sam | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"allowed\"])')\" = False ]"
check "revoked: access lists nothing" "[ -z \"\$(A access sam --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin) or \"\")')\" ]"
check "revoked: rows are kept" "[ \"\$(J \"json.dumps([d['members'], d.get('grants', {})], sort_keys=True)\")\" = '$ROWS' ]"
check "revoked: their handle is kept (the channels tell them)" "[ \"\$(W 42 \"['person']\")\" = sam ]"
check "revoked: who says revoked" "[ \"\$(W 42 \"['revoked']\")\" = True ]"
check "revoked: people --json says revoked, bot too" "[ \"\$(A people --json | python3 -c 'import json,sys; print(sorted(p[\"id\"] for p in json.load(sys.stdin) if p[\"revoked\"]))')\" = \"['sam', 'sambot']\" ]"
check "revoked: people shows it" "A people sam | grep -q 'access removed'"
check "revoked: an invite is refused" "! A invite sam"
check "revoking again is fine" "A person sam --revoke"
check "the owner can not be revoked" "! A person kai --revoke"
check "a bot can not be revoked on its own" "! A person sambot --revoke"
check "someone who is not a person can not be revoked" "! A person ghost --revoke"
check "the owner still uses house" "A may kai house"

A person sam --unrevoke >/dev/null
check "undo: house is back" "A may sam house"
check "undo: the everyone row is back" "A may sam garden"
check "undo: the helper is back" "A may sam garden --via house"
check "undo: the bot is back" "A may sambot house"
check "undo: rows are exactly as before" "[ \"\$(J \"json.dumps([d['members'], d.get('grants', {})], sort_keys=True)\")\" = '$ROWS' ]"
check "undo: no revoked state left" "[ \"\$(J \"'revoked' in d['people']['sam']\")\" = False ]"
check "undo: who says not revoked" "[ \"\$(W 42 \"['revoked']\")\" = False ]"

# a link code made before the revoke binds nothing after it
CODE=$(A invite sam | head -1)
A person sam --revoke >/dev/null
check "a link code made before the revoke is refused" "! A link discord 77 $CODE"
check "and binds nothing" "[ \"\$(J \"'discord' in d['people']['sam'].get('handles', {})\")\" = False ]"
A person sam --unrevoke >/dev/null
check "undo: the link code made before the revoke works again (revoke keeps it)" "A link discord 77 $CODE"
check "and binds them" "[ \"\$(J \"d['people']['sam']['handles']['discord']\")\" = 77 ]"

# a revoke with nothing else running ends what the kernel holds for them (R5): their delegations, the wakes they are owed
# (and their waiters), the runs their writer claims name; the owner's stay
export KITH_STATE=$T/state KITH_WAKE_NO_KICK=1
mkdir -p "$KITH_STATE/live/ask" "$KITH_STATE/live/terminal"
python3 - "$KITH_STATE/live/ask" <<'PY'
import json, sys, time
box = sys.argv[1]
def reg(mid, person, session):
    json.dump({'asked': 'house', 'agent': 'garden', 'person': person, 'via': 'ask', 'reply_to': {'session': session, 'ask': None},
               'chain': mid, 'hop': 0, 'cross_hops': 0, 'crossed': False, 'cost': 0.0, 'cost_base': 0, 'state': 'open',
               'at': time.time()}, open(f'{box}/{mid}.reg', 'w'))
reg('ask-sam', 'sam', 's-sam')
reg('ask-owner', None, 's-owner')
# an answer nobody has read yet in sam's mailbox
open(f'{box}/ask-sam.jsonl', 'w').write(json.dumps({'text': 'done', 'kind': 'answer'}) + '\n')
PY
python3 "$KERNEL/bin/kith-wake" enqueue s-sam --id c1 --agent house --person sam --door host -- hi >/dev/null
python3 "$KERNEL/bin/kith-wake" enqueue s-owner --id c2 --agent house --door host -- hi >/dev/null
sleep 60 & HOLDER=$!; disown $HOLDER
python3 "$KERNEL/bin/kith-sessions" proc $HOLDER sam house
sleep 60 & OWNER_RUN=$!; disown $OWNER_RUN
check "before: sam's claim holder runs" "kill -0 $HOLDER"
A person sam --revoke >/dev/null
R() { python3 -c "import json; print(json.load(open('$KITH_STATE/live/ask/$1.reg'))$2)"; }
W2() { python3 "$KERNEL/bin/kith-wake" status "$1"; }
check "revoke: sam's delegation is settled stopped and ended" "[ \"\$(R ask-sam \"['state']\")\" = stopped ] && [ \"\$(R ask-sam \"['ended_at'] > 0\")\" = True ]"
check "revoke: the owner's delegation is untouched" "[ \"\$(R ask-owner \"['state']\")\" = open ]"
check "revoke: a wake sam is owed is withdrawn" "[ \"\$(W2 c1)\" = withdrawn ]"
check "revoke: the owner's wake stays queued" "[ \"\$(W2 c2)\" = queued ]"
check "revoke: a late answer to sam's delegation is dropped and wakes no one" \
  "[ \"\$(python3 '$KERNEL/bin/kith-ask' --answer ask-sam -- late)\" = stopped ] && [ \"\$(W2 ask:ask-sam/1)\" = unknown ]"
sleep 1
check "revoke: the run sam's claim named is ended" "! kill -0 $HOLDER"
check "revoke: the owner's process is not" "kill -0 $OWNER_RUN"
kill $OWNER_RUN 2>/dev/null
check "revoking again is fine and sweeps nothing more" "A person sam --revoke && [ \"\$(R ask-owner \"['state']\")\" = open ]"
SUM=$(md5 -q "$KITH_AUTH" 2>/dev/null || md5sum "$KITH_AUTH" | cut -d' ' -f1)
check "a revoked person can not be made the owner, and says to unrevoke first" \
  "! A person sam owner && { A person sam owner 2>&1 || true; } | grep -q \"sam's access was removed: kith-auth person sam --unrevoke first\""
check "and auth.json is untouched" "[ \"\$(md5 -q '$KITH_AUTH' 2>/dev/null || md5sum '$KITH_AUTH' | cut -d' ' -f1)\" = \"$SUM\" ]"
check "and the owner is still kai" "[ \"\$(J \"[n for n, p in d['people'].items() if p.get('owner')]\")\" = \"['kai']\" ]"
# a renamed revoked person's old id is no way round it either
A person zoe >/dev/null && A person zoe --revoke >/dev/null && A person zoe id=zoe2 >/dev/null
SUM2=$(md5 -q "$KITH_AUTH" 2>/dev/null || md5sum "$KITH_AUTH" | cut -d' ' -f1)
check "the old id of a revoked person can not be made the owner: it was renamed" \
  "! A person zoe owner && { A person zoe owner 2>&1 || true; } | grep -q 'was renamed to zoe2'"
check "and writes nothing" "[ \"\$(md5 -q '$KITH_AUTH' 2>/dev/null || md5sum '$KITH_AUTH' | cut -d' ' -f1)\" = \"$SUM2\" ]"
A person sam --unrevoke >/dev/null
check "undo: an ended delegation stays ended" "[ \"\$(R ask-sam \"['state']\")\" = stopped ]"
check "undo: access is back" "A may sam house"
unset KITH_STATE KITH_WAKE_NO_KICK

# the channels' hold (R8): a linked Mac serves non-owners only while kith serve's lease on the cloud sync is live
A handle kai telegram 1 >/dev/null
check "never linked: nobody held" "[ \"\$(W 42 \"['held']\")\" = False ]"
now=$(python3 -c 'import time; print(int(time.time() * 1000))')
printf '{"linked": true, "until": %s}\n' "$((now + 60000))" > "$KITH_SERVE_DIR/cloud-sync.json"
check "linked, lease live: not held" "[ \"\$(W 42 \"['held']\")\" = False ]"
printf '{"linked": true, "until": %s}\n' "$((now - 1000))" > "$KITH_SERVE_DIR/cloud-sync.json"
check "linked, lease run out: held" "[ \"\$(W 42 \"['held']\")\" = True ]"
check "linked, lease run out: the owner is never held" "[ \"\$(W 1 \"['held']\")\" = False ]"
check "resolve says held too (the channels' turn start and delivery re-check)" \
  "[ \"\$(A resolve house --person sam | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"held\"])')\" = True ]"
check "resolve: the owner is never held" \
  "[ \"\$(A resolve house --person kai | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"held\"])')\" = False ]"
printf '{"linked": true, "until": 0}\n' > "$KITH_SERVE_DIR/cloud-sync.json"
check "linked, never synced: held" "[ \"\$(W 42 \"['held']\")\" = True ]"

# R9: on a linked Mac the plain verb goes through kith serve; with kith serve unreachable it is refused, nothing written
check "linked, kith serve down: revoke is refused" "! A person sam --revoke"
check "and says why" "{ A person sam --revoke 2>&1 || true; } | grep -q 'Kith cloud'"
check "and writes nothing" "[ \"\$(J \"'revoked' in d['people']['sam']\")\" = False ]"
check "linked: --local (kith serve's writer) writes here" "A person sam --revoke --local && [ \"\$(J \"'revoked' in d['people']['sam']\")\" = True ]"
check "linked, kith serve down: undo is refused" "! A person sam --unrevoke && [ \"\$(J \"'revoked' in d['people']['sam']\")\" = True ]"
check "linked: --local undo" "A person sam --unrevoke --local && A may sam house"

# data from before the refusal: an owner who is also revoked. A kernel copy (no git around it), so the doctor's update
# check has nothing to fetch.
cp -R "$KERNEL" "$KITH_HOME/kernel"
DOC=$KITH_HOME/kernel/bin/kith
D() { "$DOC" doctor "$@" 2>/dev/null; }
D > "$T/clean.txt"
check "doctor: a clean auth.json says nothing about a revoked owner" "! grep -q 'owner and also revoked' '$T/clean.txt'"
# bad.json.src: kai (the owner) revoked, with a bot; me is the real owner's other id (not the owner here).
python3 -c "
import json; p='$KITH_AUTH'; d=json.load(open(p)); d['people']['kai']['revoked']={'at':'2026-01-01T00:00:00Z'}
d['people']['bot-b']={'bot_of':'kai'}; d['people']['me']={}; json.dump(d,open('$T/bad.json.src','w'))"
rm -f "$KITH_SERVE_DIR/cloud-sync.json"   # the linked checks above are over
BAD() { cp "$T/bad.json.src" "$KITH_AUTH"; }
BAD
D > "$T/bad.txt"; D --json > "$T/bad.json"
check "doctor: says what is true: kith-auth lets them in as the owner, chat refuses" "grep -q 'kai is the owner and also revoked (old data): kith-auth still lets them and their bots in as the owner, while chat refuses them' '$T/bad.txt' && ! grep -q 'treats them as revoked' '$T/bad.txt'"
check "doctor: names the bots --rm removes, both --rm steps in order, and --unrevoke" "grep -q 'person kai --rm (removes kai and their bots (bot-b) for good; the id is retired), then kith auth person <you> owner' '$T/bad.txt' && grep -q 'person kai --unrevoke' '$T/bad.txt' && grep -q 'on each Mac where kith doctor shows this' '$T/bad.txt'"
check "doctor --json: the same line, not ok" "python3 -c \"import json; d=json.load(open('$T/bad.json')); assert any(not c['ok'] and 'owner and also revoked' in c['name'] for c in d['checks'])\""
check "owner: revoke is still refused" "! A person kai --revoke"
check "owner: undo is allowed, and the doctor line is gone" "A person kai --unrevoke && ! D | grep -q 'owner and also revoked'"
check "and the owner is still kai, with no revoked flag" "[ \"\$(J \"[n for n, p in d['people'].items() if p.get('owner') and not p.get('revoked')]\")\" = \"['kai']\" ]"
check "undoing an owner who is not revoked changes nothing" "A person kai --unrevoke"
BAD
check "--rm then <you> owner: both run on the bad file" "A person kai --rm && A person me owner"
check "and the doctor line is gone, the bot with it" "! D | grep -q 'owner and also revoked' && [ \"\$(J \"'bot-b' in d['people']\")\" = False ]"
# an owner who is a bot of someone: the same hole, through cut_off's bot_of walk
python3 -c "
import json; d=json.load(open('$T/bad.json.src')); d['people']['kai'].pop('revoked'); d['people']['kai']['bot_of']='me'; json.dump(d,open('$KITH_AUTH','w'))"
D > "$T/bot.txt"
check "doctor: an owner who is a bot of someone is flagged too, and says the split is latent (nobody revoked)" "grep -q \"kai is the owner and also a bot of me (old data; a bot can't be made the owner now): kith-auth lets them in as the owner, and if me is ever revoked, chat would refuse them. Fix: kith auth person kai --rm (removes kai and their bots (bot-b)), then kith auth person <you> owner\" '$T/bot.txt' && ! grep -q 'is retired\\|the id is retired' '$T/bot.txt'"
python3 -c "
import json; d=json.load(open('$KITH_AUTH')); d['people']['me']['revoked']=True; json.dump(d,open('$KITH_AUTH','w'))"
D > "$T/bot2.txt"
check "doctor: when the chain reaches a revoked person, chat refuses them" "grep -q 'kith-auth lets them in as the owner, and chat refuses them' '$T/bot2.txt' && ! grep -q 'is retired' '$T/bot2.txt'"
exit $fail
