#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["discord.py>=2.4,<3", "aiohttp>=3.9"]
# ///
"""kith-bridge-check — the bridge's self-healing, checked without chat platforms or agents: fake Discord and Telegram
connections, a stub `kith` that answers at once, a throwaway HOME (the real ~/.kith is never read or written).

  kernel/tests/kith-bridge-check     about a minute; prints each check, exits 1 when one fails

What it shows:
  1. a normal message on Discord and on Telegram gets one answer, not marked late; the first run reads no history
  2. messages sent to both while the bridge is down get exactly one answer each once it is back, marked late;
     Discord history older than 24 h is skipped; a second restart answers nothing again
  3. a Discord gateway that goes silent, and a Telegram poll that hangs, are replaced by a new connection that works
  4. a bridge whose event loop or thread pool is stuck exits with code 70 (launchd's KeepAlive starts it again);
     a healthy one doesn't
  5. before the owner's Discord account is linked, only the owner of the server KITH_DISCORD_GUILD names stands in
     for kith's owner: not another server's owner, and no one when no server is named
"""
import asyncio
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from types import SimpleNamespace

KERNEL = Path(__file__).resolve().parent.parent
TMP = Path(tempfile.mkdtemp(prefix='kith-bridge-check-'))
(TMP / '.kith').mkdir()
os.environ.update(HOME=str(TMP), KITH_HOME=str(TMP / 'kith'), KITH_BRIDGE_DEBOUNCE='0', KITH_BRIDGE_ROUTER='off',
                  KITH_BRIDGE_DM_DEFAULT='echo')
os.environ.pop('KITH_DISCORD_GUILD', None)
pkg = TMP / 'kith' / 'agents' / 'echo' / 'role'
pkg.mkdir(parents=True)
(pkg / 'agent.md').write_text('---\nname: echo\ndescription: answers at once\n---\n')

TASKS = TMP / 'tasks.jsonl'   # every task the stub kith was given
STUB = TMP / 'kith-stub'
STUB.write_text(f'''#!/usr/bin/env python3
import json, re, sys
open({str(TASKS)!r}, 'a').write(json.dumps(sys.argv[2]) + '\\n')
print(json.dumps({{'result': 'answer: ' + ' '.join(re.findall(r'msg-[\\w-]+', sys.argv[2])), 'session_id': 's1'}}))
''')
STUB.chmod(0o755)

sys.path.insert(0, str(KERNEL / 'lib'))
import discord  # noqa: E402
from kith_bridge import core, discord_chat, telegram_chat  # noqa: E402

core.KITH_BIN = str(STUB)
core.jev_config = lambda: {}
core.Core.who = staticmethod(lambda platform, uid: {'person': 'kai', 'owner': True, 'was': []})
core.Core.resolve = staticmethod(lambda person, agent: {'allowed': True, 'owner': True})
spec = importlib.util.spec_from_loader('kith_bridge_main', importlib.machinery.SourceFileLoader(
    'kith_bridge_main', str(KERNEL / 'bin' / 'kith-bridge')))
bridge = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bridge)


# ---- fake Telegram: the Bot API as the adapter calls it ----

class FakeTelegram:
    def __init__(self):
        self.updates, self.sent, self.next, self.logins, self.hang = [], [], 1, 0, False

    def message(self, token, ago=0):
        self.updates.append({'update_id': self.next, 'message': {
            'message_id': 500 + self.next, 'date': int(time.time() - ago), 'text': token,
            'from': {'id': 42, 'is_bot': False}, 'chat': {'id': 42, 'type': 'private'}}})
        self.next += 1

    def call(self, method, files=None, **p):
        if method == 'getMe':
            self.logins += 1
            return {'result': {'username': 'hqcheck_bot', 'id': 1}}
        if method == 'getUpdates':
            while self.hang:
                time.sleep(0.1)
            self.updates = [u for u in self.updates if u['update_id'] >= int(p.get('offset') or 0)]   # confirmed
            if not self.updates:
                time.sleep(0.2)
            return {'result': list(self.updates)}
        if method == 'sendMessage':
            self.sent.append(p.get('text', ''))
            return {'result': {'message_id': 9000 + len(self.sent)}}
        return {'result': True}


TG = FakeTelegram()
telegram_chat.Telegram.call = lambda self, method, files=None, **p: TG.call(method, files, **p)


# ---- fake Discord: the client, one server with the #echo channel and its history ----

class Channel(discord.TextChannel):
    def __init__(self, cid, name):
        self.id, self.name, self.log = cid, name, []

    async def history(self, after=None, limit=100, oldest_first=True):
        for m in [m for m in self.log if m.id > after.id][:limit]:
            yield m


ECHO = Channel(1001, 'echo')


async def no_threads():
    return []

GUILD = SimpleNamespace(name='check', id=7, owner_id=42, text_channels=[ECHO], active_threads=no_threads)


class FakeClient:
    made = []

    def __init__(self, **kw):
        self.debug_events = kw.get('enable_debug_events')
        self.on, self.closed, self.beating = {}, False, True
        self.user, self.guilds = SimpleNamespace(id=1), [GUILD]
        FakeClient.made.append(self)

    def event(self, f):
        self.on[f.__name__] = f
        return f

    async def start(self, token):
        await self.on['on_ready']()
        while not self.closed:
            if self.beating and 'on_socket_raw_receive' in self.on:   # a heartbeat ack, or any frame
                await self.on['on_socket_raw_receive']({'op': 11})
            await asyncio.sleep(0.2)

    async def close(self):
        self.closed = True

    async def send(self, token):
        """A message in #echo now: in the history, and to the bot if it is connected."""
        m = dmsg(token)
        await self.on['on_message'](m)


discord_chat.discord.Client = FakeClient
DC_POSTS = []
_n = [0]


def dmsg(token, ago=0):
    at = datetime.now(timezone.utc) - timedelta(seconds=ago)
    _n[0] += 1

    async def create_thread(name, auto_archive_duration):
        return SimpleNamespace(id=m.id + 1)

    async def nothing(*a, **k):
        pass
    m = SimpleNamespace(id=discord.utils.time_snowflake(at) + _n[0], content=token, created_at=at, channel=ECHO,
                        author=SimpleNamespace(id=42, bot=False), webhook_id=None, reference=None, attachments=[],
                        create_thread=create_thread, reply=nothing, add_reaction=nothing)
    ECHO.log.append(m)
    ECHO.log.sort(key=lambda x: x.id)
    return m


class CheckDiscord(discord_chat.Discord):
    """The real adapter (start, liveness, catch-up, incoming); only posting is recorded instead of sent."""
    quiet = 2

    async def setup(self):
        pass

    async def post(self, conv, agent, text, ctx=None):
        DC_POSTS.append(text)

    async def reply(self, m, text):
        DC_POSTS.append('kith: ' + text)

    async def status(self, conv, agent, wid):
        return None

    async def typing(self, conv):
        await asyncio.Event().wait()


# ---- the checks ----

results = []


def check(name, ok, detail=''):
    results.append(ok)
    print(f'{"✓" if ok else "✗"} {name}' + (f'  ({detail})' if detail and not ok else ''), flush=True)


def answers(token):
    """How many answers name this message, on either platform."""
    return sum(t.split().count(token) for t in DC_POSTS + TG.sent if 'answer:' in t)


def told_late(token):
    tasks = [json.loads(x) for x in TASKS.read_text().splitlines()] if TASKS.exists() else []
    return any(token in t and 'bridge was away' in t for t in tasks)


async def until(cond, secs=15):
    end = time.time() + secs
    while time.time() < end:
        if cond():
            return True
        await asyncio.sleep(0.1)
    return cond()


async def up():
    """The bridge as kith-bridge runs it: one Core from the state on disk, each connection supervised."""
    c = core.Core()
    dc, tg = CheckDiscord('discord/hq', {'DISCORD_BOT_TOKEN': 'x'}, c), \
        telegram_chat.Telegram('telegram/hq', {'TELEGRAM_BOT_TOKEN': 'x'}, c)
    tasks = [asyncio.create_task(bridge.supervise(dc)), asyncio.create_task(bridge.supervise(tg))]
    clients = len(FakeClient.made)
    await until(lambda: len(FakeClient.made) > clients and FakeClient.made[-1].on)
    await asyncio.sleep(0.5)
    return tasks, dc, tg


async def down(tasks):
    for t in tasks:
        t.cancel()
    await asyncio.gather(*tasks, return_exceptions=True)


async def scenario():
    print(f'(throwaway HOME: {TMP})')
    ECHO.log.clear()
    dmsg('msg-before-first-run', ago=3600)

    # 1. normal messages
    tasks, dc, tg = await up()
    await FakeClient.made[-1].send('msg-dc-live')
    TG.message('msg-tg-live')
    await until(lambda: answers('msg-dc-live') and answers('msg-tg-live'))
    await asyncio.sleep(1)
    check('Discord: a normal message gets one answer', answers('msg-dc-live') == 1, answers('msg-dc-live'))
    check('Telegram: a normal message gets one answer', answers('msg-tg-live') == 1, answers('msg-tg-live'))
    check('normal messages are not marked late', not told_late('msg-dc-live') and not told_late('msg-tg-live'))
    check('the first run answers no old Discord history', answers('msg-before-first-run') == 0)

    # 2. the bridge is down; messages wait; it comes back
    await down(tasks)
    dmsg('msg-dc-down-1', ago=600)
    dmsg('msg-dc-down-2', ago=300)
    dmsg('msg-dc-too-old', ago=25 * 3600)
    TG.message('msg-tg-down-1', ago=600)
    TG.message('msg-tg-down-2', ago=300)
    st = json.loads(core.STATE.read_text())   # the last message the bridge saw is 30 h old: catch-up stops at 24 h
    st['conns']['discord/hq']['last'] = discord.utils.time_snowflake(datetime.now(timezone.utc) - timedelta(hours=30))
    core.STATE.write_text(json.dumps(st))
    tasks, dc, tg = await up()
    down_tokens = ['msg-dc-down-1', 'msg-dc-down-2', 'msg-tg-down-1', 'msg-tg-down-2']
    await until(lambda: all(answers(t) for t in down_tokens))
    await asyncio.sleep(1.5)
    for t in down_tokens:
        check(f'{t}: sent while down, answered once after', answers(t) == 1, answers(t))
        check(f'{t}: the agent is told it is late', told_late(t))
    check('Discord: history older than 24 h is skipped', answers('msg-dc-too-old') == 0)
    check('Discord: messages answered before the restart are not answered again', answers('msg-dc-live') == 1)

    await down(tasks)   # once more, with nothing new
    tasks, dc, tg = await up()
    await asyncio.sleep(2)
    check('a second restart answers nothing twice',
          all(answers(t) == 1 for t in down_tokens + ['msg-dc-live', 'msg-tg-live']))

    # 3. dead connections
    before, dead = len(FakeClient.made), FakeClient.made[-1]
    dead.beating = False   # the gateway stops sending anything; the client doesn't notice
    await until(lambda: len(FakeClient.made) > before and FakeClient.made[-1].on, secs=25)
    check('Discord: a silent gateway is replaced by a new connection',
          len(FakeClient.made) == before + 1 and dead.closed, f'{len(FakeClient.made) - before} new')
    await asyncio.sleep(0.5)
    await FakeClient.made[-1].send('msg-dc-after-reconnect')
    await until(lambda: answers('msg-dc-after-reconnect'))
    await asyncio.sleep(1)
    check('Discord: the new connection answers once', answers('msg-dc-after-reconnect') == 1)

    logins, tg.quiet, TG.hang = TG.logins, 2, True   # a poll that never comes back
    await until(lambda: TG.logins > logins, secs=25)
    TG.hang, tg.quiet = False, telegram_chat.Telegram.quiet
    check('Telegram: a hung poll is replaced by a new connection', TG.logins == logins + 1, TG.logins - logins)
    await asyncio.sleep(0.5)
    TG.message('msg-tg-after-reconnect')
    await until(lambda: answers('msg-tg-after-reconnect'))
    await asyncio.sleep(1)
    check('Telegram: the new connection answers once', answers('msg-tg-after-reconnect') == 1)
    await down(tasks)


async def owner_stands_in(conn, setting):
    """Whether a `conn` adapter, with KITH_DISCORD_GUILD at `setting`, takes the owner of the server it works in
    (#echo's server, owner 42) as kith's owner."""
    if setting is None:
        os.environ.pop('KITH_DISCORD_GUILD', None)
    else:
        os.environ['KITH_DISCORD_GUILD'] = setting
    dc = CheckDiscord(conn, {'DISCORD_BOT_TOKEN': 'x'}, core.Core())
    t = asyncio.create_task(dc.start())
    try:
        await until(lambda: getattr(dc, 'guild', None) is not None)   # set by start's on_ready
        probe = SimpleNamespace(id=1, content='hi', channel=ECHO, author=SimpleNamespace(id=42, bot=False),
                                reference=None, attachments=[], created_at=datetime.now(timezone.utc))
        return (await dc.incoming(probe)).admin
    finally:
        t.cancel()
        await asyncio.gather(t, return_exceptions=True)
        os.environ.pop('KITH_DISCORD_GUILD', None)


async def owners():
    for conn, setting, want, why in [
        ('discord/hq', 'check', True, 'the named server (by name)'),
        ('discord/hq', '7', True, 'the named server (by id)'),
        ('discord/work', 'check', True, 'the named server, on another connection'),
        ('discord/work', 'other', False, 'a server other than the named one'),
        ('discord/hq', None, False, 'no server named'),
    ]:
        got = await owner_stands_in(conn, setting)
        check(f'{conn}, {why}: its owner {"stands" if want else "does not stand"} in for kith\'s owner', got == want,
              got)


def stuck(name, body, want):
    """kith-bridge's real watchdog in a process of its own, with a loop that gets stuck as `body` says."""
    code = (f'import asyncio, importlib.machinery, importlib.util, time\n'
            f'l = importlib.machinery.SourceFileLoader("b", {str(KERNEL / "bin" / "kith-bridge")!r})\n'
            f'b = importlib.util.module_from_spec(importlib.util.spec_from_loader("b", l)); l.exec_module(b)\n'
            f'async def main():\n    beat = b.guard()\n    await asyncio.sleep(1)\n    {body}\n'
            f'asyncio.run(main())\n')
    began = time.time()
    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, timeout=60,
                       env=dict(os.environ, KITH_BRIDGE_STALL='3'))
    said = (r.stdout + r.stderr).strip().splitlines()
    check(f'{name}: exit {r.returncode} after {time.time() - began:.0f}s', r.returncode == want,
          said[-1] if said else '')
    if want == 70:
        check(f'{name}: says why, with a timestamp', any(re.match(r'\d{4}-\d\d-\d\d \d\d:\d\d:\d\d kith-bridge: stuck', s)
                                                        for s in said), said[-1:] or '')


def main():
    asyncio.run(scenario())
    asyncio.run(owners())
    stuck('event loop blocked', 'time.sleep(30)', 70)
    stuck('thread pool full', 'loop = asyncio.get_running_loop()\n'
          '    [loop.run_in_executor(None, time.sleep, 30) for _ in range(64)]\n    await asyncio.sleep(30)', 70)
    stuck('healthy loop', 'await asyncio.sleep(8)', 0)
    print(f'\n{sum(results)}/{len(results)} checks passed')
    sys.exit(0 if all(results) else 1)


if __name__ == '__main__':
    main()
