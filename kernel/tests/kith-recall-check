#!/usr/bin/env bash
# kith-recall-check — note facets, the local FTS5 index and `kith recall`, in a throwaway HOME and KITH_HOME with fixture
# memory (the real ~/.kith is never read or written).
#
#   kernel/tests/kith-recall-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-recall-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/dot KITH_AUTH=$T/dot/auth.json
unset KITH_AGENT KITH_PERSON KITH_ROOM HQ_STATE HQ_HOME KITH_PROJECT
mkdir -p "$HOME" "$KITH_STATE"
R=$KERNEL/bin/kith-recall KA=$KERNEL/bin/kith-auth
# people first: an id with memory already under it is a removed person's, and a new person is refused it
python3 "$KA" person kai owner >/dev/null; python3 "$KA" person sam >/dev/null; python3 "$KA" person eve >/dev/null
M=$KITH_HOME/agents/echo/memory
mkdir -p "$M/shared" "$M/people/sam" "$M/people/eve" "$M/projects/alpha" "$M/sessions" "$KITH_HOME/agents/other/memory" \
  "$KITH_STATE/people" "$KITH_STATE/secrets" "$KITH_HOME/agents/echo/role" "$KITH_HOME/agents/other/role"
for a in echo other; do printf -- '---\nname: %s\ndescription: test agent\n---\nYou test.\n' $a > "$KITH_HOME/agents/$a/role/agent.md"; done
python3 "$KA" member echo sam >/dev/null; python3 "$KA" member echo eve >/dev/null
echo 'owner secret zebra plan' > "$M/MEMORY.md"
echo 'shared craft zebra tip' > "$M/shared/MEMORY.md"
echo 'sam likes zebra tea' > "$M/people/sam/MEMORY.md"
echo 'eve private zebra' > "$M/people/eve/MEMORY.md"
echo 'alpha zebra detail' > "$M/projects/alpha/notes.md"
printf -- '---\naudience: owner\nprojects: [beta]\n---\nnarrowed zebra note\n' > "$M/people/sam/narrow.md"
printf -- '---\naudience: shared\n---\nwiden attempt zebra\n' > "$M/MEMORY2.md"
mkdir -p "$M/rooms/grp1"; echo 'grp1 room zebra' > "$M/rooms/grp1/MEMORY.md"
echo 'session zebra log' > "$M/sessions/s1.md"
echo 'other agent zebra' > "$KITH_HOME/agents/other/memory/MEMORY.md"
echo 'about owner zebra' > "$KITH_STATE/user.md"
echo 'sam profile zebra' > "$KITH_STATE/people/sam.md"
echo 'TOPSECRET zebra' > "$KITH_STATE/secrets/key.md"
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
# audiences "a b" seen by a recall for zebra, as the env given in $1 (a list of VAR=value)
aud() { env "$@" "$R" zebra -n 50 --json | python3 -c 'import json,sys; print(" ".join(sorted(set(h["audience"] for h in json.load(sys.stdin)))))'; }
count() { python3 -c 'import json,sys; print(len(json.load(sys.stdin)))'; }
F() { python3 -c "import sys; sys.path.insert(0,'$KERNEL/lib'); import kith_facets as k; $1"; }

# facets
check "default: MEMORY.md is owner-only" "[ \"\$(F \"print(k.facets_for('MEMORY.md','echo')['audience'])\")\" = owner ]"
check "default: shared/" "[ \"\$(F \"print(k.facets_for('shared/a.md','echo')['audience'])\")\" = shared ]"
check "default: people/<id>/ is the person and the 1:1 room" "[ \"\$(F \"f=k.facets_for('people/sam/a.md','echo'); print(f['audience'],f['room'])\")\" = 'person:sam 1:1:echo:sam' ]"
check "default: projects/<p>/" "[ \"\$(F \"f=k.facets_for('projects/alpha/a.md','echo'); print(f['audience'],f['projects'])\")\" = \"owner ['alpha']\" ]"
check "default: sessions/ is project-detail" "[ \"\$(F \"f=k.facets_for('sessions/s1.md','echo'); print(f['kind'],f['thread'])\")\" = 'project-detail s1' ]"
check "frontmatter overrides projects and room" "[ \"\$(F \"f=k.facets_for('MEMORY.md','echo','---\\nprojects: [a, b]\\nroom: r1\\n---\\nx'); print(f['projects'],f['room'])\")\" = \"['a', 'b'] r1\" ]"
check "frontmatter can narrow the audience" "[ \"\$(F \"print(k.facets_for('people/sam/a.md','echo','---\\naudience: owner\\n---\\nx')['audience'])\")\" = owner ]"
check "frontmatter cannot widen the audience" "[ \"\$(F \"print(k.facets_for('MEMORY.md','echo','---\\naudience: shared\\n---\\nx')['audience'])\")\" = owner ]"
check "junk facets read as owner-only" "[ \"\$(F \"print(k.facets_for('x.md','echo','---\\naudience: person:../x\\n---\\n')['audience'])\")\" = owner ]"

# promotion: a wider audience in the frontmatter counts only with a recorded, approved, not undone change that the
# host signed with its key in <state>/secrets (row 8 is written without the key; row 9 is signed with another key)
python3 - "$KITH_STATE" "$KERNEL/lib" <<'PY'
import os, sqlite3, sys
sys.path.insert(0, sys.argv[2])
import kith_facets as k
key, other = os.urandom(32), os.urandom(32)
with open(os.path.join(sys.argv[1], 'secrets', 'memory-approvals.key'), 'wb') as f:
    f.write(key)
db = sqlite3.connect(os.path.join(sys.argv[1], 'memory.db'))
db.executescript("""
CREATE TABLE memory_dreams (id INTEGER PRIMARY KEY, bot TEXT, at INTEGER, undone INTEGER NOT NULL DEFAULT 0);
CREATE TABLE hq_promotions (id INTEGER PRIMARY KEY, agent TEXT, file TEXT, audience TEXT, status TEXT, dream INTEGER, sig TEXT);
INSERT INTO memory_dreams VALUES (1, 'echo', 0, 0), (2, 'echo', 0, 1);
""")
rows = [(1, 'echo', 'MEMORY.md', 'shared', 'approved', 1), (2, 'echo', 'MEMORY.md', 'shared', 'pending', None),
        (3, 'echo', 'MEMORY.md', 'shared', 'approved', 2), (4, 'other', 'MEMORY.md', 'shared', 'approved', 1),
        (5, 'echo', 'people/sam/n.md', 'room:grp1', 'applied', 1), (6, 'echo', 'sup.md', 'shared', 'approved', 1),
        (7, 'echo', 'sup.md', 'owner', 'applied', 1), (8, 'echo', 'forged.md', 'shared', 'approved', 1),
        (9, 'echo', 'forged2.md', 'shared', 'approved', 1)]
for r in rows:
    sig = None if r[0] == 8 else k.signature(other if r[0] == 9 else key, *r[:4])
    db.execute('INSERT INTO hq_promotions VALUES (?, ?, ?, ?, ?, ?, ?)', r + (sig,))
db.commit()
PY
wide() { F "print(k.facets_for('${3:-MEMORY.md}','echo','---\\naudience: $2\\napproved_change: $1\\n---\\nx')['audience'])"; }
check "an approved change lets the wider audience be read" "[ \"\$(wide 1 shared)\" = shared ]"
check "a made-up change id does not" "[ \"\$(wide 99 shared)\" = owner ]"
check "a pending change does not" "[ \"\$(wide 2 shared)\" = owner ]"
check "an undone change does not" "[ \"\$(wide 3 shared)\" = owner ]"
check "another agent's change does not" "[ \"\$(wide 4 shared)\" = owner ]"
check "a change approved for another audience does not" "[ \"\$(wide 1 room:grp1)\" = owner ]"
check "a change for another note does not" "[ \"\$(wide 1 shared people/sam/other.md)\" = person:sam ]"
check "an approval a newer change superseded does not come back" "[ \"\$(wide 6 shared sup.md)\" = owner ]"
check "an applied narrowing is read" "[ \"\$(wide 5 room:grp1 people/sam/n.md)\" = room:grp1 ]"
check "an approved row the host did not sign does not" "[ \"\$(wide 8 shared forged.md)\" = owner ]"
check "a row signed with another key does not" "[ \"\$(wide 9 shared forged2.md)\" = owner ]"
# the same answer as the host's signature (serve/host/src/hqmem/promote_tests.rs)
check "the signature is the host's" "[ \"\$(F \"print(k.signature(bytes(range(32)), 7, 'echo', 'people/sam/ü.md', 'room:grp1'))\")\" = 8f50a51b1e41ae8cb8f5488e7dff393bba6b281b275075cf6c122932aa9c9c7f ]"
mv "$KITH_STATE/secrets/memory-approvals.key" "$T/key.bak"
check "with no key nothing is granted" "[ \"\$(wide 1 shared)\" = owner ]"
mv "$T/key.bak" "$KITH_STATE/secrets/memory-approvals.key"
check "the hand-edited wider frontmatter is still ignored" "[ \"\$(F \"print(k.facets_for('MEMORY.md','echo','---\\naudience: shared\\n---\\nx')['audience'])\")\" = owner ]"
# the audience order (twin of crates/memory/src/tidy/promote.rs): from to allowed
W() { F "print(k.within('$2', '$1', {'duo': ['owner', 'sam'], 'trio': ['sam', 'eve']}))"; }
for row in "owner owner True" "room:trio owner True" "shared person:sam True" "person:sam owner True" "owner shared False" \
  "owner person:sam False" "person:sam person:eve False" "person:sam shared False" "person:sam room:duo True" \
  "person:sam room:trio False" "room:trio person:sam True" "room:trio room:duo True" "room:duo room:trio False" "person:sam room:nowhere False" \
  "room:nowhere owner True" "room:nowhere room:nowhere True" "room:nowhere person:sam False"; do
  set -- $row
  check "within $1 -> $2 is $3" "[ \"\$(W $1 $2)\" = $3 ]"
done

# index files and modes
"$R" index rebuild >/dev/null
DB=$KITH_STATE/index/memory.db
mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
check "index folder is 0700 and file 0600" "[ \"\$(mode $KITH_STATE/index)\" = 700 ] && [ \"\$(mode $DB)\" = 600 ]"
check "rebuild leaves no .new file" "[ ! -e $DB.new ]"
INO=$(ls -i "$DB" | awk '{print $1}'); "$R" index rebuild >/dev/null
check "rebuild replaces the file in one step (new inode)" "[ \"\$(ls -i $DB | awk '{print \$1}')\" != $INO ]"
check "the secrets folder is never indexed" "! env KITH_AGENT=echo \"$R\" TOPSECRET | grep -q TOPSECRET"

# owner
check "owner sees owner, shared and person rows" "[ \"\$(aud KITH_AGENT=echo)\" = 'owner person:eve person:sam room:grp1 shared' ]"
check "owner: the other agent's notes stay out" "! env KITH_AGENT=echo \"$R\" zebra | grep -q 'agents/other'"
check "owner: user.md is found" "env KITH_AGENT=echo \"$R\" 'about owner' | grep -q 'about owner'"
check "frontmatter 'shared' in an owner file did not widen it" "[ \"\$(env KITH_AGENT=echo \"$R\" widen --json | python3 -c 'import json,sys; print(json.load(sys.stdin)[0][\"audience\"])')\" = owner ]"
check "--project narrows" "[ \"\$(env KITH_AGENT=echo \"$R\" zebra --project alpha --json | count)\" = 1 ]"

# invitee
check "invitee sees shared and own person rows only" "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=sam)\" = 'person:sam shared' ]"
check "invitee gets no owner or other person's text" "! env KITH_AGENT=echo KITH_PERSON=sam \"$R\" zebra | grep -qE 'owner secret|alpha zebra|session zebra|about owner|narrowed|eve private'"
check "invitee: --project / --room of others widen nothing" "[ \"\$(env KITH_AGENT=echo KITH_PERSON=sam \"$R\" zebra --project alpha --json)\" = '[]' ] && [ \"\$(env KITH_AGENT=echo KITH_PERSON=sam \"$R\" zebra --room 1:1:echo:eve --json)\" = '[]' ]"
check "there is no --person flag" "! env KITH_AGENT=echo KITH_PERSON=sam \"$R\" zebra --person kai 2>/dev/null"
check "unknown person gets nothing" "[ \"\$(env KITH_AGENT=echo KITH_PERSON=zed \"$R\" zebra --json)\" = '[]' ]"
check "an agent they are no member of: nothing" "[ \"\$(env KITH_AGENT=other KITH_PERSON=sam \"$R\" zebra --json)\" = '[]' ]"
check "no KITH_AGENT, not the owner: nothing" "[ \"\$(env KITH_PERSON=sam \"$R\" zebra --json)\" = '[]' ]"

# group room: the answer is read by everyone there, so only what all of them may see (members are not resolvable yet)
check "group room: the invitee gets shared only" "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=grp1)\" = shared ]"
check "group room: the owner is cut down too" "[ \"\$(aud KITH_AGENT=echo KITH_ROOM=grp1)\" = shared ]"
check "group room notes are not recalled by room id, for grp1 or grp2, owner or invitee" "! env KITH_AGENT=echo KITH_ROOM=grp1 \"$R\" 'grp1 room' | grep -q 'grp1 room' && ! env KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=grp2 \"$R\" 'grp1 room' | grep -q 'grp1 room' && ! env KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=grp1 \"$R\" 'grp1 room' | grep -q 'grp1 room'"
check "a channel run with no KITH_ROOM recalls shared only" "[ \"\$(aud KITH_AGENT=echo KITH_VIA=telegram)\" = shared ]"
check "1:1 room changes nothing" "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=1:1:echo:sam)\" = 'person:sam shared' ]"
check "no person and no agent is nobody, not the owner" "[ \"\$(env \"$R\" zebra --json)\" = '[]' ]"
check "a blank query is refused" "! env KITH_AGENT=echo \"$R\" '  ' 2>/dev/null"
check "-n without a value prints usage" "! env KITH_AGENT=echo \"$R\" zebra -n 2>/dev/null"
check "launch-json passes KITH_ROOM on" "[ \"\$(KITH_ROOM=grp1 \"$KERNEL/bin/kith\" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"env\"].get(\"KITH_ROOM\"))')\" = grp1 ]"
check "a link out of memory/ is not followed" "ln -s $KITH_STATE/secrets/key.md $M/leak.md && ! env KITH_AGENT=echo \"$R\" TOPSECRET | grep -q TOPSECRET; rm -f $M/leak.md"
check "frontmatter kind is stored" "[ \"\$(sqlite3 $DB \"select note_kind from index_rows where text like 'session zebra%'\" 2>/dev/null)\" = project-detail ] || python3 -c \"import sqlite3,sys; sys.exit(0 if sqlite3.connect('$DB').execute(\\\"select note_kind from index_rows where text like 'session zebra%'\\\").fetchone()[0]=='project-detail' else 1)\""

# bots: fail closed without a parent; shared only, and only for an agent bot_may allows
check "bot guest with no resolvable parent gets nothing" "[ \"\$(env KITH_AGENT=echo KITH_PERSON=bot-ab12 \"$R\" zebra --json)\" = '[]' ]"
BR() { python3 -c 'import sys, json; sys.path.insert(0, sys.argv[1]); import kith_recall as r; print(r.bot_root(json.loads(sys.argv[2]), "bot-a"))' "$KERNEL/lib" "$1"; }
BOT_OK='{"bot-a": {"bot_of": "kai"}, "kai": {}}' BOT_GONE='{"bot-a": {"bot_of": "gone"}}'
check "bot_root follows bot_of to the root" '[ "$(BR "$BOT_OK")" = kai ]'
check "bot_root: a missing parent is None" '[ "$(BR "$BOT_GONE")" = None ]'
BOT_LIST='[{"id":"bot-a","bot_of":"kai"},{"id":"kai","bot_of":""}]'
check "bot_root reads the list kith-auth people --json prints" '[ "$(BR "$BOT_LIST")" = kai ]'
python3 "$KA" bot bot-ab12 --of kai >/dev/null; python3 "$KA" bot bot-cd34 --of kai >/dev/null
python3 "$KA" member echo bot-ab12 >/dev/null
check "bot with a row for the agent: shared only" "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=bot-ab12)\" = shared ]"
check "bot with no row (bot_may false): nothing" "[ \"\$(env KITH_AGENT=echo KITH_PERSON=bot-cd34 \"$R\" zebra --json)\" = '[]' ]"
check "recall room members: a member outside the room cuts the set to shared" "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam,eve)\" = shared ]"

# owner-only groups (the host's KITH_ROOM_OWNER_ONLY) and the room-note ledger
check "owner-only marker: the owner recalls the room's notes, shared and its own, not other people's" \
  "[ \"\$(aud KITH_AGENT=echo KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=1)\" = 'owner room:grp1 shared' ]"
check "owner-only marker without a room, or in a 1:1 room: nothing changes" \
  "[ \"\$(aud KITH_AGENT=echo KITH_ROOM_OWNER_ONLY=1)\" = 'owner person:eve person:sam room:grp1 shared' ] && [ \"\$(aud KITH_AGENT=echo KITH_ROOM=1:1:echo:owner KITH_ROOM_OWNER_ONLY=1)\" = 'owner person:eve person:sam room:grp1 shared' ]"
check "owner-only marker with a channel via stays shared only" "[ \"\$(aud KITH_AGENT=echo KITH_ROOM=grp1 KITH_VIA=telegram KITH_ROOM_OWNER_ONLY=1)\" = shared ]"
check "owner-only marker with a blank room stays shared only" "[ \"\$(aud KITH_AGENT=echo KITH_VIA=group KITH_ROOM_OWNER_ONLY=1)\" = shared ]"
check "spoofing: a person's run that sets the marker is not widened" \
  "[ \"\$(aud KITH_AGENT=echo KITH_PERSON=sam KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=1)\" = shared ]"
check "marker beside a member list is ignored" "[ \"\$(aud KITH_AGENT=echo KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=1 KITH_ROOM_MEMBERS=sam)\" = shared ]"
check "marker with another value is ignored" "[ \"\$(aud KITH_AGENT=echo KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=true)\" = shared ]"
check "an unrecorded room note is recalled in an owner-only group" "env KITH_AGENT=echo KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=1 \"$R\" 'grp1 room' | grep -q 'grp1 room'"
RN() { python3 -c "import sys; sys.path.insert(0,'$KERNEL/lib'); import kith_recall as r; print(r._room_note_ok({'agent':'echo','audiences':['x'],'present':$1}, 'room:grp1', '$M/rooms/grp1/rec.md', {}))"; }
check "room notes by ledger: no record, a person present: hidden; nobody but the owner: shown" "[ \"\$(RN \"['sam']\")\" = False ] && [ \"\$(RN '[]')\" = True ]"
F "k.record_room_write('echo', 'grp1', 'rooms/grp1/rec.md', ['sam', 'eve'], False)"
check "room notes by ledger: everyone present was there: shown; a guest who joined later: hidden" \
  "[ \"\$(RN \"['sam']\")\" = True ] && [ \"\$(RN \"['sam', 'eve']\")\" = True ] && [ \"\$(RN \"['sam', 'ann']\")\" = False ]"
F "k.record_room_write('echo', 'grp1', 'rooms/grp1/rec.md', ['sam'], False)"
check "room notes by ledger: a later write with fewer present narrows it for good" "[ \"\$(RN \"['sam', 'eve']\")\" = False ] && [ \"\$(RN \"['sam']\")\" = True ]"
check "room notes by ledger: a note Tidy moved to another audience is not held to the room's record" \
  "python3 -c \"import sys; sys.path.insert(0,'$KERNEL/lib'); import kith_recall as r; print(r._room_note_ok({'agent':'echo','audiences':['x'],'present':['zed']}, 'shared', '$M/rooms/grp1/rec.md', {}))\" | grep -q True"
check "room notes by ledger: the owner outside a group sees everything" \
  "python3 -c \"import sys; sys.path.insert(0,'$KERNEL/lib'); import kith_recall as r; print(r._room_note_ok({'agent':'echo','audiences':None}, 'room:grp1', '$M/rooms/grp1/zz.md', {}))\" | grep -q True"


# output shape
check "text output frames hits as data" "env KITH_AGENT=echo \"$R\" zebra | grep -q '^<recalled source=\"note\" tier=\"2\" audience=\"'"
check "--json shape" "env KITH_AGENT=echo \"$R\" zebra --json | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if set(d[0])=={\"kind\",\"tier\",\"agent\",\"audience\",\"room\",\"projects\",\"link\",\"snippet\"} else 1)'"
check "results are capped (-n)" "[ \"\$(env KITH_AGENT=echo \"$R\" zebra -n 2 --json | count)\" = 2 ]"

# staleness and corruption
echo 'fresh quokka' >> "$M/MEMORY.md"
check "a changed file is re-indexed on recall" "env KITH_AGENT=echo \"$R\" quokka | grep -q quokka"
rm "$M/MEMORY.md"
check "a deleted file leaves the index" "! env KITH_AGENT=echo \"$R\" quokka | grep -q quokka"
echo garbage > "$DB"
check "a corrupt index is rebuilt" "env KITH_AGENT=echo \"$R\" 'shared craft' | grep -q 'shared craft'"
rm -rf "$KITH_STATE/index"
check "a missing index is built on first recall, private" "env KITH_AGENT=echo \"$R\" 'shared craft' | grep -q 'shared craft' && [ \"\$(mode $KITH_STATE/index)\" = 700 ]"

# the deny rule for every run
"$KERNEL/bin/kith" echo --launch-json >"$T/launch.json" 2>"$T/err"
check "settings deny Read and Edit of the index" "python3 -c 'import json,sys; d=json.load(open(\"$T/launch.json\"))[\"settings\"][\"permissions\"][\"deny\"]; sys.exit(0 if any(r.startswith(\"Read(\") and r.endswith(\"/index/**)\") for r in d) and any(r.startswith(\"Edit(\") and r.endswith(\"/index/**)\") for r in d) else 1)'"
check "settings deny Read and Edit of memory.db (the approval proof)" "python3 -c 'import json,sys; d=json.load(open(\"$T/launch.json\"))[\"settings\"][\"permissions\"][\"deny\"]; sys.exit(0 if any(r.startswith(\"Read(\") and r.endswith(\"/memory.db*)\") for r in d) and any(r.startswith(\"Edit(\") and r.endswith(\"/memory.db*)\") for r in d) else 1)'"

# a guest run asks the host (KITH_RUN_TOKEN + KITH_RUN_SOCKET): the transport never reads the index
cat > "$T/fake-host.py" <<'PY'
import json, os, socket, sys
path, log, mode = sys.argv[1:4]
srv = socket.socket(socket.AF_UNIX); srv.bind(path); srv.listen(4)
open(log + '.ready', 'w').close()
for _ in range(int(sys.argv[4])):
    c, _a = srv.accept()
    data = b''
    while not data.endswith(b'\n'):
        chunk = c.recv(65536)
        if not chunk: break
        data += chunk
    open(log, 'ab').write(data)
    if mode == 'ok':
        c.sendall(json.dumps({'ok': True, 'stdout': 'host says hi\n', 'stderr': '', 'code': 0}).encode() + b'\n')
    elif mode == 'code':
        c.sendall(json.dumps({'ok': True, 'stdout': '', 'stderr': 'usage\n', 'code': 2}).encode() + b'\n')
    else:
        c.sendall(json.dumps({'ok': False, 'error': 'not authorized'}).encode() + b'\n')
    c.close()
PY
rm -rf "$KITH_STATE/index"
fakehost() { # mode count -> starts the fake host, waits until it listens
  rm -f "$T/s.sock" "$T/req.log" "$T/req.log.ready"
  python3 "$T/fake-host.py" "$T/s.sock" "$T/req.log" "$1" "$2" & FH=$!
  for _ in $(seq 50); do [ -e "$T/req.log.ready" ] && break; sleep 0.1; done
}
fakehost ok 1
OUT=$(env KITH_RUN_TOKEN=tok123 KITH_RUN_SOCKET="$T/s.sock" KITH_PERSON=kai KITH_AGENT=echo "$R" zebra --json -n 3); wait $FH
check "run token: the answer is the host's" "[ \"\$OUT\" = 'host says hi' ]"
check "run token: the request carries the token, the method and the arguments, and no identity" "python3 -c 'import json; d=json.loads(open(\"$T/req.log\").read()); import sys; sys.exit(0 if d == {\"token\":\"tok123\",\"method\":\"recall\",\"args\":[\"zebra\",\"--json\",\"-n\",\"3\"]} else 1)'"
check "run token: the index is never opened or built" "[ ! -e $KITH_STATE/index ]"
fakehost code 1
env KITH_RUN_TOKEN=tok123 KITH_RUN_SOCKET="$T/s.sock" "$R" zebra >"$T/o" 2>"$T/e"; RC=$?; wait $FH
check "run token: the host's exit code and stderr are passed on" "[ $RC = 2 ] && grep -q usage $T/e"
fakehost refuse 2
O1=$(env KITH_RUN_TOKEN=bad KITH_RUN_SOCKET="$T/s.sock" "$R" zebra); R1=$?
O2=$(env KITH_RUN_TOKEN=bad KITH_RUN_SOCKET="$T/s.sock" "$R" zebra --json); wait $FH
check "run token: a refusal is an empty answer, not an error" "[ \"\$O1\" = 'nothing recalled' ] && [ \"\$O2\" = '[]' ] && [ $R1 = 0 ]"
O3=$(env KITH_RUN_TOKEN=tok KITH_RUN_SOCKET="$T/gone.sock" "$R" zebra --json 2>"$T/e"); R3=$?
check "run token: no host listening is an empty answer without a traceback" "[ \"\$O3\" = '[]' ] && [ $R3 = 0 ] && ! grep -q Traceback $T/e"
check "run token: the index subcommands are not reachable" "! env KITH_RUN_TOKEN=tok KITH_RUN_SOCKET=\"$T/s.sock\" \"$R\" index rebuild 2>/dev/null && [ ! -e $KITH_STATE/index ]"
check "run token: a token without a socket is the owner path" "env KITH_RUN_TOKEN=tok KITH_AGENT=echo \"$R\" 'shared craft' | grep -q 'shared craft'"

# the other two tools a guest gets through the host: kith-memory search and project-id. With a token they ask the host and
# touch no Kith folder (the folders are pointed at nothing, so reading one would fail or print something else).
MS=$KERNEL/bin/kith-memory PI=$KERNEL/bin/project-id
nodisk() { env KITH_RUN_TOKEN=tok123 KITH_RUN_SOCKET="$T/s.sock" KITH_HOME="$T/none" KITH_STATE="$T/none" KITH_AGENT=echo KITH_PERSON=kai "$@"; }
reqis() { python3 -c "import json,sys; d=json.loads(open('$T/req.log').read()); sys.exit(0 if d == json.loads(sys.argv[1]) else 1)" "$1"; }
fakehost ok 1
OUT=$(nodisk "$MS" search zebra -n 3 --json); wait $FH
check "guest kith-memory: the answer is the host's, from no folder" "[ \"\$OUT\" = 'host says hi' ]"
check "guest kith-memory: the request is the token, memorySearch and the arguments only" "reqis '{\"token\":\"tok123\",\"method\":\"memorySearch\",\"args\":[\"zebra\",\"-n\",\"3\",\"--json\"]}'"
fakehost refuse 1
OUT=$(nodisk "$MS" search zebra --all 2>"$T/e"); RC=$?; wait $FH
check "guest kith-memory: a refusal is a message and a non-zero exit" "[ $RC = 2 ] && [ -z \"\$OUT\" ] && grep -q 'kith-memory:' $T/e && ! grep -q Traceback $T/e"
OUT=$(nodisk env KITH_RUN_SOCKET="$T/gone.sock" "$MS" search zebra 2>"$T/e"); RC=$?
check "guest kith-memory: no host is a clear error, not a traceback" "[ $RC = 1 ] && grep -q 'could not be reached' $T/e && ! grep -q Traceback $T/e"
fakehost ok 1
OUT=$(nodisk "$PI"); wait $FH
check "guest project-id: the answer is the host's, from no folder" "[ \"\$OUT\" = 'host says hi' ]"
check "guest project-id: the request is the token and projectId, no directory" "reqis '{\"token\":\"tok123\",\"method\":\"projectId\",\"args\":[]}'"
fakehost ok 1
nodisk "$PI" --info alpha >/dev/null; wait $FH
check "guest project-id --info is asked of the host as is" "reqis '{\"token\":\"tok123\",\"method\":\"projectId\",\"args\":[\"--info\",\"alpha\"]}'"
check "owner: no token, kith-memory and project-id read the folders as before" "env KITH_AGENT=echo \"$MS\" search 'shared craft' | grep -q 'zebra tip' && env \"$PI\" --list >/dev/null"

# a sandboxed guest without a token cannot read the index (simulated by an unreadable copy): nothing, whoever it claims to be
"$R" index rebuild >/dev/null
mv "$KITH_STATE/index" "$T/index.keep"; cp -R "$T/index.keep" "$KITH_STATE/index"; chmod 000 "$KITH_STATE/index"/* "$KITH_STATE/index"
for who in "KITH_AGENT=echo KITH_PERSON=kai" "KITH_AGENT=echo" "KITH_AGENT=echo KITH_PERSON=sam"; do
  check "unreadable index, as '$who': nothing, quietly" "[ \"\$(env $who \"$R\" zebra --json 2>$T/e)\" = '[]' ] && ! grep -q Traceback $T/e"
done
chmod 700 "$KITH_STATE/index"; chmod 600 "$KITH_STATE/index"/* 2>/dev/null; rm -rf "$KITH_STATE/index"; mv "$T/index.keep" "$KITH_STATE/index"
check "owner path unchanged once the index is readable again" "[ \"\$(aud KITH_AGENT=echo)\" = 'owner person:eve person:sam room:grp1 shared' ]"

# inside a guest's sandbox nobody is the owner, whatever the shell left in the environment. The real sandbox closes the home
# folder (kith-guest-sandbox-check, KITH_REAL_SANDBOX=1); here sandbox-exec closes it alone, so the index stays readable and
# only the identity gates stand between the shell and the owner's rows. macOS only.
check "outside a guest's sandbox: not one" "! python3 \"$KERNEL/lib/kith_paths.py\" --guest-sandbox"
if command -v sandbox-exec >/dev/null && [ "$(uname)" = Darwin ]; then
  KR=$(cd "$KERNEL" && pwd -P)
  RH=$(python3 -c 'import os, pwd; print(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))')
  printf '(version 1)\n(allow default)\n(deny file-read* (subpath "%s"))\n(allow file-read* (subpath "%s") (subpath "%s"))\n' "$RH" "$T" "$KR" > "$T/guest.sb"
  SB() { sandbox-exec -f "$T/guest.sb" "$@"; }
  saud() { SB env "$@" "$KR/bin/kith-recall" zebra -n 50 --json | python3 -c 'import json,sys; print(" ".join(sorted(set(h["audience"] for h in json.load(sys.stdin)))))'; }
  check "sandboxed: kith_paths says so" "SB python3 \"$KR/lib/kith_paths.py\" --guest-sandbox"
  check "sandboxed, KITH_PERSON dropped: recall is nobody's" "[ \"\$(SB env KITH_AGENT=echo \"$KR/bin/kith-recall\" zebra --json)\" = '[]' ]"
  check "sandboxed, KITH_PERSON names the owner: recall is nobody's" "[ \"\$(SB env KITH_AGENT=echo KITH_PERSON=kai \"$KR/bin/kith-recall\" zebra --json)\" = '[]' ]"
  check "sandboxed invitee: their own audience, as before" "[ \"\$(saud KITH_AGENT=echo KITH_PERSON=sam)\" = 'person:sam shared' ]"
  check "sandboxed, KITH_PERSON dropped: summarise is the owner's only" "! SB env KITH_AGENT=echo \"$KR/bin/kith-recall\" summarise --thread x 2>$T/e && grep -q 'only the owner' $T/e"
  check "outside: the owner's kith-memory search finds the owner text" "env KITH_AGENT=echo \"$KR/bin/kith-memory\" search zebra -n 50 | grep -qE 'alpha|eve private'"
  check "sandboxed, KITH_PERSON dropped: kith-memory search finds no owner text" "SB env KITH_AGENT=echo \"$KR/bin/kith-memory\" search zebra -n 50 >$T/o 2>&1; ! grep -qE 'alpha|eve private' $T/o"
  check "sandboxed, KITH_PERSON names the owner: kith-memory search finds no owner text" "SB env KITH_AGENT=echo KITH_PERSON=kai \"$KR/bin/kith-memory\" search zebra -n 50 >$T/o 2>&1; ! grep -qE 'alpha|eve private' $T/o"
  check "sandboxed: kith-auth acts for no one, not the owner" "SB env KITH_AGENT=echo \"$KR/bin/kith-auth\" resolve echo | grep -q '\"owner\": false' && SB env KITH_PERSON=kai \"$KR/bin/kith-auth\" resolve echo | grep -q '\"owner\": false'"
  check "outside: kith-auth still acts for the owner" "\"$KR/bin/kith-auth\" resolve echo | grep -q '\"owner\": true'"
  check "sandboxed, KITH_PERSON dropped: no owner run starts" "! SB \"$KR/bin/kith\" echo --launch-json >/dev/null 2>$T/e && grep -q \"inside a guest's run\" $T/e"
fi

echo
if [ $fails = 0 ]; then echo "all passed"; else echo "$fails failed"; exit 1; fi
