#!/usr/bin/env bash
# kith-auth-secret-check — `kith-auth once` (a one-time secret for one holder: put, copy, take, drop, list, and
# `exec --secret`) and `kith-auth set <profile> --stdin-json` saves a key without it touching an argv, an env, stdout,
# stderr, auth.json or auth.log; its validation refuses with fixed messages and writes nothing; grants add, never replace;
# account-state and keys list names and never values; revoke --profile removes one grant; kith-permit's request_secret.
# The Keychain is a stub (KITH_SECURITY_BIN) that records argv, env and stdin of every call. Throwaway dirs, never ~/.kith,
# never the real Keychain. The secret is a marker built at run time.
#
#   kernel/tests/kith-auth-secret-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-auth-secret.XXXXXX"); T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export KITH_AUTH=$T/auth.json HOME=$T/home KITH_HOME=$T/kith
unset KITH_STATE HQ_STATE KITH_PERSON KITH_AGENT HQ_HOME KITH_AUTH_PROFILE
mkdir -p "$HOME" "$KITH_HOME/agents/house/role" "$T/rec"
printf -- '---\nname: house\ndescription: test\n---\nbody\n' > "$KITH_HOME/agents/house/role/agent.md"
MARK="mk$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
MARK2="mk$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
HEX=$(printf %s "$MARK" | xxd -p | tr -d '\n')

# The stub: -i reads commands on stdin (add-generic-password ... -X hex), find-generic-password prints the stored value.
# Everything it is given goes to rec/: argv and env in calls.log, stdin in stdin.rec. keychain.json is the fake Keychain.
cat > "$T/security" <<'PY'
#!/usr/bin/env python3
import json, os, sys
rec, store = os.environ['STUB_REC'], os.environ['STUB_REC'] + '/keychain.json'
with open(rec + '/calls.log', 'a') as f:
    f.write(json.dumps({'argv': sys.argv, 'env': dict(os.environ)}) + '\n')
db = json.load(open(store)) if os.path.exists(store) else {}
a = sys.argv[1:]
if a[:1] == ['-i']:
    data = sys.stdin.read()
    open(rec + '/stdin.rec', 'a').write(data)
    if os.environ.get('STUB_FAIL'):
        sys.exit(0)   # the real -i exits 0 even when the item was not written
    for line in data.splitlines():
        w = line.split()
        if w[:1] == ['add-generic-password']:
            db[w[w.index('-s') + 1] + '#' + w[w.index('-a') + 1]] = bytes.fromhex(w[w.index('-X') + 1]).decode()
    json.dump(db, open(store, 'w'))
elif a[:1] == ['delete-generic-password']:
    db.pop(a[a.index('-s') + 1] + '#' + a[a.index('-a') + 1], None)
    json.dump(db, open(store, 'w'))
elif a[:1] == ['find-generic-password']:
    k = a[a.index('-s') + 1] + '#' + a[a.index('-a') + 1]
    if k not in db:
        sys.exit(44)
    print(db[k])
else:
    sys.exit(2)
PY
chmod +x "$T/security"
export KITH_SECURITY_BIN=$T/security STUB_REC=$T/rec

A() { python3 "$KERNEL/bin/kith-auth" "$@"; }
SET() { printf '%s' "$1" | A set "${@:2}" >"$T/out" 2>"$T/err"; }   # SET '<json>' <profile> --stdin-json ...
fail=0
check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
J() { python3 -c "import json; d=json.load(open('$KITH_AUTH')); print($1)"; }
nowrite() { [ ! -e "$KITH_AUTH" ] || [ "$(J "d['profiles']")" = "{}" ]; }

# --- the happy path ----------------------------------------------------------------------------------------------------
SET "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/work --stdin-json --grant house
rc=$?
check "set --stdin-json succeeds" "[ $rc = 0 ] && [ -s $T/out ]"
check "stdout is one JSON line with profile, service, vars, granted" \
  "python3 -c \"import json; d=json.load(open('$T/out')); assert d=={'profile':'anthropic/work','service':'anthropic','vars':['ANTHROPIC_API_KEY'],'granted':'house'}, d\""
check "auth.json holds a keychain ref for the var" "[ \"\$(J \"d['profiles']['anthropic/work']['ANTHROPIC_API_KEY']\")\" = 'keychain:kith/anthropic/work#ANTHROPIC_API_KEY' ]"
check "the grant is recorded" "[ \"\$(J \"d['grants']['house']['anthropic']\")\" = 'anthropic/work' ]"
check "the marker reached the stub's stdin (as hex)" "grep -q $HEX $T/rec/stdin.rec"
check "the stub's stored value is the marker (what the Keychain holds)" "grep -q $MARK $T/rec/keychain.json"
check "get reads it back through the same tool" "[ \"\$(KITH_AGENT=house A get anthropic ANTHROPIC_API_KEY)\" = '$MARK' ]"
check "marker absent from every argv and env the stub saw (plain and hex)" "! grep -q -e $MARK -e $HEX $T/rec/calls.log"
check "marker absent from stdout, stderr, auth.json and auth.log" "! grep -r -q -e $MARK -e $HEX $T/out $T/err $KITH_AUTH $T/auth.log"
check "every call went to the stub" "grep -q '\"-i\"' $T/rec/calls.log"

# --- idempotence and grants add ---------------------------------------------------------------------------------------
SET "{\"ANTHROPIC_API_KEY\": \"$MARK2\"}" anthropic/work --stdin-json --grant house
check "the same set twice updates the value" "grep -q $MARK2 $T/rec/keychain.json && ! grep -q $MARK $T/rec/keychain.json"
check "and the grant stays a single plain entry" "[ \"\$(J \"d['grants']['house']['anthropic']\")\" = 'anthropic/work' ]"
SET "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/personal --stdin-json --grant house
check "a second account is added to the grant, not replacing" "[ \"\$(J \"d['grants']['house']['anthropic']\")\" = \"['anthropic/work', 'anthropic/personal']\" ]"
SET "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/personal --stdin-json --grant house
check "granting the same profile again is idempotent" "[ \"\$(J \"len(d['grants']['house']['anthropic'])\")\" = 2 ]"
SET "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/other --stdin-json
check "without --grant nothing is granted for it" "[ \"\$(J \"'anthropic/other' in d['grants']['house']['anthropic']\")\" = False ] && grep -q '\"granted\": null' $T/out"
check "granted still reads the grant list" "[ \"\$(KITH_AGENT=house A granted anthropic | tr '\n' ' ')\" = 'anthropic/work anthropic/personal ' ]"

# --- account-state and keys -------------------------------------------------------------------------------------------
A account-state house anthropic --json > "$T/st"
check "account-state: declared, secrets, granted, nothing missing" \
  "python3 -c \"import json; d=json.load(open('$T/st')); assert d['declared'] and d['secrets']==['ANTHROPIC_API_KEY'] and d['granted']==['anthropic/work','anthropic/personal'] and d['missing']==[], d\""
check "account-state lists the service's profiles with account, owner and granted agents" \
  "python3 -c \"import json; d=json.load(open('$T/st')); p={x['profile']:x for x in d['profiles']}; assert p['anthropic/work']['account']=='work' and p['anthropic/work']['agents']==['house'] and p['anthropic/other']['agents']==[] and 'owner' in p['anthropic/work'], p\""
A account-state house nosuchservice --json > "$T/st2"
check "account-state: an undeclared service is declared=false with nothing granted" \
  "python3 -c \"import json; d=json.load(open('$T/st2')); assert d=={'declared':False,'secrets':[],'granted':[],'missing':[],'profiles':[]}, d\""
A account-state other anthropic --json > "$T/st3"
check "account-state: an agent with no grant is missing everything" \
  "python3 -c \"import json; d=json.load(open('$T/st3')); assert d['granted']==[] and d['missing']==['ANTHROPIC_API_KEY'], d\""
printf '2026-10-25T10:00:00\texec\tanthropic\tanthropic/work\tfor=house\n2026-10-26T09:00:00\tget\tanthropic\tanthropic/work\tfor=house\n' > "$T/auth.log"
A keys --json > "$T/keys"
check "keys: profile, service, account, vars, agents, last_used (latest hand-out)" \
  "python3 -c \"import json; d={k['profile']:k for k in json.load(open('$T/keys'))}; w=d['anthropic/work']; assert w['service']=='anthropic' and w['account']=='work' and w['vars']==['ANTHROPIC_API_KEY'] and w['agents']==['house'] and w['last_used']=='2026-10-26T09:00:00' and d['anthropic/other']['last_used'] is None, d\""
check "keys and account-state never carry a value" "! grep -q -e $MARK -e $MARK2 $T/keys $T/st $T/st2 $T/st3"

# --- revoke --profile -------------------------------------------------------------------------------------------------
A revoke house anthropic --profile anthropic/work >/dev/null
check "revoke --profile removes only that profile (the list falls back to a plain entry)" "[ \"\$(J \"d['grants']['house']['anthropic']\")\" = 'anthropic/personal' ]"
A revoke house anthropic --profile anthropic/personal >/dev/null
check "revoking the last profile removes the grant" "[ \"\$(J \"'anthropic' in d['grants'].get('house', {})\")\" = False ]"
A grant house anthropic anthropic/work >/dev/null
A revoke house anthropic >/dev/null
check "revoke without --profile works as before" "[ \"\$(J \"'anthropic' in d['grants'].get('house', {})\")\" = False ]"

# --- validation: fixed messages, nothing written ----------------------------------------------------------------------
rm -f "$KITH_AUTH" "$T/rec/keychain.json" "$T/rec/stdin.rec" "$T/rec/calls.log"
refuse() {   # name json profile...
  SET "$2" "${@:3}"; local rc=$?
  check "refused: $1" "[ $rc != 0 ] && [ -s $T/err ] && ! grep -q $MARK $T/err $T/out && nowrite && [ ! -e $T/rec/stdin.rec ]"
}
refuse "undeclared VAR" "{\"NOT_DECLARED\": \"$MARK\"}" anthropic/work --stdin-json
check "the refusal does not echo the name it was given" "! grep -q NOT_DECLARED $T/err"
refuse "empty value" '{"ANTHROPIC_API_KEY": ""}' anthropic/work --stdin-json
refuse "oversize value" "{\"ANTHROPIC_API_KEY\": \"$(python3 -c 'print("a"*1600)')\"}" anthropic/work --stdin-json
refuse "NUL in the value" "{\"ANTHROPIC_API_KEY\": \"${MARK}\\u0000x\"}" anthropic/work --stdin-json
refuse "non-string value" '{"ANTHROPIC_API_KEY": 5}' anthropic/work --stdin-json
refuse "not an object" "[\"$MARK\"]" anthropic/work --stdin-json
refuse "not JSON" "$MARK" anthropic/work --stdin-json
refuse "empty object" '{}' anthropic/work --stdin-json
refuse "account with a capital" "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/Work --stdin-json
refuse "account with a slash" "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/a/b --stdin-json
refuse "account too long" "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" "anthropic/$(python3 -c 'print("a"*41)')" --stdin-json
refuse "profile with no account" "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic --stdin-json
refuse "bad grant agent" "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/work --stdin-json --grant 'a b;x'
refuse "a good value beside an undeclared one writes neither" "{\"ANTHROPIC_API_KEY\": \"$MARK\", \"NOPE\": \"x\"}" anthropic/work --stdin-json

# --- a Keychain that does not take the item ---------------------------------------------------------------------------
STUB_FAIL=1 SET "{\"ANTHROPIC_API_KEY\": \"$MARK\"}" anthropic/work --stdin-json --grant house
rc=$?
check "a failed Keychain write exits non-zero, fixed message, auth.json untouched" \
  "[ $rc != 0 ] && grep -q 'Keychain did not take' $T/err && ! grep -q $MARK $T/err $T/out && nowrite"

# --- old auth.json (no owner on profiles, plain string grants) loads ---------------------------------------------------
cat > "$KITH_AUTH" <<JSON
{"profiles": {"anthropic/old": {"ANTHROPIC_API_KEY": "env:SOMETHING"}}, "grants": {"house": {"anthropic": "anthropic/old"}}}
JSON
A account-state house anthropic --json > "$T/st4"
check "old data: account-state reads it" "python3 -c \"import json; d=json.load(open('$T/st4')); assert d['granted']==['anthropic/old'] and d['missing']==[], d\""
A keys --json > "$T/keys2"
check "old data: keys lists it" "python3 -c \"import json; d=json.load(open('$T/keys2')); assert d[0]['profile']=='anthropic/old' and d[0]['vars']==['ANTHROPIC_API_KEY'], d\""

# --- kith-auth once: a secret handed to one holder, taken once ------------------------------------------------------------
rm -f "$KITH_AUTH" "$T/rec/keychain.json" "$T/rec/stdin.rec" "$T/rec/calls.log" "$T/auth.log"
A person kai owner >/dev/null 2>&1
A person sam >/dev/null 2>&1
OID=rs_0123456789abcdef; OID2=rs_fedcba9876543210
MS() { python3 -c "import time; print(int(time.time()*1000) + $1)"; }
PUT() { printf '%s' "$1" | A once put "${@:2}" >"$T/out" 2>"$T/err"; }   # PUT <value> <id> <opts...>
NONE() { [ "$(A once list --json)" = '[]' ]; }
PUT "$MARK" $OID --agent house --expires "$(MS 600000)"
check "once put stores the item and an entry with holder, created and expires" \
  "[ \"\$(J \"sorted(d['once']['$OID'])\")\" = \"['agent', 'created', 'expires']\" ] && [ \"\$(J \"d['once']['$OID']['agent']\")\" = house ] && grep -q $MARK $T/rec/keychain.json && grep -q kith/once/$OID $T/rec/keychain.json"
check "once put prints nothing; the value is in no argv, env, auth.json, auth.log or output" \
  "[ ! -s $T/out ] && [ ! -s $T/err ] && ! grep -q -e $MARK -e $HEX $T/rec/calls.log $KITH_AUTH $T/auth.log"
check "once list names holder and times, never the value" \
  "A once list --json >$T/ol && python3 -c \"import json; d=json.load(open('$T/ol')); assert [r['id'] for r in d]==['$OID'] and d[0]['agent']=='house' and d[0]['created']<=d[0]['expires'], d\" && ! grep -q $MARK $T/ol"
check "exec --secret for another agent is refused, fixed text, the secret stays" \
  "! KITH_AGENT=garden A exec --secret $OID -- sh -c 'echo \$KITH_SECRET' >$T/o 2>$T/e && grep -q 'no such secret' $T/e && ! grep -q $MARK $T/o $T/e && grep -q $MARK $T/rec/keychain.json"
check "once take names a bot: an agent's secret is not a bot's" "! A once take $OID --bot house >$T/o 2>$T/e && ! grep -q $MARK $T/o $T/e"
check "exec --secret under KITH_PERSON (a guest) is refused and leaves the secret" \
  "! KITH_PERSON=sam KITH_AGENT=house A exec --secret $OID -- sh -c 'echo \$KITH_SECRET' >$T/o 2>$T/e && grep -q 'not available' $T/e && ! grep -q $MARK $T/o $T/e && grep -q $MARK $T/rec/keychain.json"
check "once put under KITH_PERSON is refused" "! (printf x | KITH_PERSON=sam A once put $OID2 --agent house --expires $(MS 600000)) 2>/dev/null"
check "exec --secret hands it to the command in KITH_SECRET" \
  "[ \"\$(KITH_AGENT=house A exec --secret $OID -- sh -c 'printf %s \"\$KITH_SECRET\"')\" = '$MARK' ]"
check "it was deleted first: Keychain and entry are empty, a second use is refused" \
  "! grep -q $MARK $T/rec/keychain.json && NONE && ! KITH_AGENT=house A exec --secret $OID -- true 2>/dev/null"
check "the audit line names the id, never the value" "grep -q $OID $T/auth.log && ! grep -q $MARK $T/auth.log"
PUT "$MARK2" $OID --bot bg_one --expires "$(MS 600000)"
check "once take for another bot is refused" "! A once take $OID --bot bg_two >$T/o 2>$T/e && ! grep -q $MARK2 $T/o $T/e && grep -q $MARK2 $T/rec/keychain.json"
check "exec --secret of a bot's secret is refused" "! KITH_AGENT=bg_one A exec --secret $OID -- true 2>/dev/null"
check "once take prints the value and deletes it" "[ \"\$(A once take $OID --bot bg_one)\" = '$MARK2' ] && ! grep -q $MARK2 $T/rec/keychain.json && NONE"
check "a second take is refused" "! A once take $OID --bot bg_one >$T/o 2>$T/e && ! grep -q $MARK2 $T/o $T/e"
PUT "$MARK" $OID --bot bg_one --expires "$(MS 600000)"
python3 - <<'PY'
import json, os
p = os.environ['KITH_AUTH']; a = json.load(open(p))
a['once']['rs_0123456789abcdef']['expires'] = 1   # lapsed
json.dump(a, open(p, 'w'))
PY
check "a lapsed secret is refused, and what is left of it is deleted" "! A once take $OID --bot bg_one >$T/o 2>$T/e && ! grep -q $MARK $T/o $T/e && ! grep -q $MARK $T/rec/keychain.json && NONE"
PUT "$MARK" $OID --bot bg_one --expires "$(MS 600000)"
check "once drop deletes both, and is fine when repeated" "A once drop $OID && A once drop $OID && ! grep -q $MARK $T/rec/keychain.json && NONE"
PUT "$MARK" $OID --agent house --expires "$(MS $((2 * 3600 * 1000)))"
check "once put refuses a time more than an hour ahead" "[ -s $T/err ] && NONE && ! grep -q $MARK $T/rec/keychain.json"
PUT "$MARK" $OID --agent house --expires 5
check "once put refuses a time in the past" "[ -s $T/err ] && NONE && ! grep -q $MARK $T/rec/keychain.json"
PUT "$(python3 -c 'print("a"*1600)')" $OID --agent house --expires "$(MS 600000)"
check "once put refuses an oversize value" "[ -s $T/err ] && NONE"
PUT "" $OID --agent house --expires "$(MS 600000)"
check "once put refuses an empty value" "[ -s $T/err ] && NONE"
check "a bad id, no holder and two holders are refused" \
  "! (printf x | A once put nope --agent house --expires $(MS 600000)) 2>/dev/null && ! (printf x | A once put $OID --expires $(MS 600000)) 2>/dev/null && ! (printf x | A once put $OID --agent house --bot b --expires $(MS 600000)) 2>/dev/null && NONE"
STUB_FAIL=1 PUT "$MARK" $OID --agent house --expires "$(MS 600000)"
check "a Keychain that does not take it: refused, no entry, no value in the output" "[ -s $T/err ] && ! grep -q $MARK $T/err $T/out && NONE"
# once copy: a stored key travels without anyone typing it
printf '%s' "{\"ANTHROPIC_API_KEY\": \"$MARK2\"}" | A set anthropic/work --stdin-json >/dev/null 2>&1
A once copy $OID2 --from anthropic/work --var ANTHROPIC_API_KEY --bot bg_one --expires "$(MS 600000)" >$T/out 2>$T/err
check "once copy sends a stored key, printing nothing" "[ ! -s $T/out ] && [ ! -s $T/err ] && [ \"\$(J \"d['once']['$OID2']['bot']\")\" = bg_one ] && grep -q kith/once/$OID2 $T/rec/keychain.json"
check "the copy arrives by take, and never touches auth.json or auth.log" "[ \"\$(A once take $OID2 --bot bg_one)\" = '$MARK2' ] && ! grep -q $MARK2 $KITH_AUTH $T/auth.log"
A once copy $OID2 --from anthropic/work --var NOT_THERE --bot bg_one --expires "$(MS 600000)" >$T/out 2>$T/err
check "once copy of a key that isn't there is refused" "[ -s $T/err ] && NONE"

# --- kith-permit: request_secret ----------------------------------------------------------------------------------------
cat > "$T/permit_test.py" <<'PY'
import importlib.machinery, importlib.util, json, os, socket, sys, tempfile, threading, time
loader = importlib.machinery.SourceFileLoader('kith_permit', sys.argv[1])
spec = importlib.util.spec_from_loader('kith_permit', loader); kp = importlib.util.module_from_spec(spec); loader.exec_module(kp)
d = tempfile.mkdtemp(dir='/tmp'); sock = os.path.join(d, 's'); seen = []; reply = [b'{"ok":true,"carded":true,"message":"Asked Kai. End your turn."}\n']
def serve():
    srv = socket.socket(socket.AF_UNIX); srv.bind(sock); srv.listen(5)
    while True:
        c, _ = srv.accept(); buf = b''
        while not buf.endswith(b'\n'):
            x = c.recv(4096)
            if not x: break
            buf += x
        seen.append(json.loads(buf)); c.sendall(reply[0]); c.close()
threading.Thread(target=serve, daemon=True).start()
while not os.path.exists(sock): pass
time.sleep(0.3)
bad = 0
def check(n, got, want):
    global bad
    print(('ok   ' if got == want else 'FAIL ') + n + ('' if got == want else ': got %r wanted %r' % (got, want)))
    bad |= got != want
tok = {'KITH_ASK_TOKEN': 't', 'KITH_ASK_SOCKET': sock}
def names(env): return [t['name'] for t in kp.handle({'jsonrpc': '2.0', 'id': 1, 'method': 'tools/list'}, env)['result']['tools']]
check('listed for a run with a token', names(tok), ['approve', 'request_access', 'report_bug', 'request_secret'])
check('guest tokens count too', 'request_secret' in names({'KITH_RUN_TOKEN': 't', 'KITH_RUN_SOCKET': sock}), True)
check('not listed without a token', 'request_secret' in names({}), False)
def call(args, env=tok): return kp.handle({'jsonrpc': '2.0', 'id': 2, 'method': 'tools/call', 'params': {'name': 'request_secret', 'arguments': args}}, env)
r = call({'service': 'github', 'purpose': 'open a PR'})
check('the host message is the tool result', r['result']['content'][0]['text'], 'Asked Kai. End your turn.')
check('sent token, method, service, purpose', seen[-1], {'token': 't', 'method': 'requestSecret', 'service': 'github', 'purpose': 'open a PR'})
n = len(seen)
check('missing purpose is not sent', ('Give the service' in call({'service': 'github'})['result']['content'][0]['text'], len(seen)), (True, n))
reply[0] = b'{"ok":false,"error":"github declares no secret"}\n'
check('a refusal reaches the agent', call({'service': 'x', 'purpose': 'y'})['result']['content'][0]['text'], 'github declares no secret')
check('no token: no channel, nothing sent', ('No approval channel' in call({'service': 'github', 'purpose': 'y'}, {})['result']['content'][0]['text'], len(seen)), (True, n + 1))
sys.exit(bad)
PY
python3 "$T/permit_test.py" "$KERNEL/bin/kith-permit" > "$T/permit.out" 2>&1 || fail=1
cat "$T/permit.out"

exit $fail
