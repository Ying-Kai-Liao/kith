#!/usr/bin/env bash
# kith-pkg-pid-switch-check — the `pkg` and `project-id` switches (kernel/lib/core-switched.txt): the launch's two lookups,
# `kith-pkg resolve AGENT` and `project-id`, are answered by the Rust core when the line is there, by the Python when
# KITH_CORE=python or the line is gone. Which side answered is read from stubs standing in for kernel/bin/kith-pkg and
# kernel/bin/project-id in a copy of the kernel folder: each logs its call and runs the real script. Also: the other
# kith-pkg verbs stay Python, and a guest's project-id (run token + socket) still reaches the Python, never the core.
# Needs the Rust program: KITH_DIFFTEST_BIN=/path/to/kith (without one the check says so and exits 0).
#
#   KITH_DIFFTEST_BIN=/path/to/kith kernel/tests/kith-pkg-pid-switch-check
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
REAL=${KITH_DIFFTEST_BIN:-}
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then echo "skip: no Rust program (KITH_DIFFTEST_BIN)"; exit 0; fi
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-pkg-pid-switch-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_AUTH=$T/auth.json TZ=UTC
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CORE KITH_BIN HQ_HOME KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR KITH_RUN_TOKEN KITH_RUN_SOCKET KITH_HOME KITH_STORE
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
mkdir -p "$HOME" "$T/state" "$T/bin" "$T/work"
export KITH_STATE=$T/state KITH_HOME=$T/kith
A=$KITH_HOME/agents/echo/role
mkdir -p "$A"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$A/agent.md"
git -C "$A" init -q && git -C "$A" commit -qm init --allow-empty
printf '#!/bin/sh\n[ "$1" = --version ] && { echo "2.1.300 (Claude Code)"; exit 0; }\necho claude "$@"\n' > "$T/bin/claude"
chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH

# A copy of the kernel folder whose two Python programs log what they are asked, then run the originals.
cp -R "$KERNEL" "$T/k"
LOG=$T/calls
for prog in kith-pkg project-id; do
  mv "$T/k/bin/$prog" "$T/k/bin/$prog.real"
  printf '#!/bin/sh\necho "%s $*" >> "%s"\nexec "%s" "$@"\n' "$prog" "$LOG" "$T/k/bin/$prog.real" > "$T/k/bin/$prog"
  chmod +x "$T/k/bin/$prog"
done
KITH=$T/k/bin/kith
export KITH_BIN=$REAL

fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
calls() { grep -c "^$1" "$LOG" 2>/dev/null || true; }
reset() { rm -f "$LOG"; touch "$LOG"; }
launch() { (cd "$T/work" && "$KITH" echo --launch-json 2>"$T/err"); }
norm() { sed -e "s#$T#<T>#g" -E -e 's/@[0-9a-f]{10}/@<h>/g' -e 's/"[0-9a-f]{10}"/"<h>"/g' -e 's/[0-9a-f]{32}/<id>/g'; }

# A registered project the work folder belongs to, as the Python wrote it.
mkdir -p "$T/work/proj"
(cd "$T/work/proj" && "$T/k/bin/project-id.real" --register demo . >/dev/null)
rm -f "$LOG"; touch "$LOG"

# 1. Switched: the launch asks neither program.
reset; (cd "$T/work/proj" && "$KITH" echo --launch-json 2>"$T/err") > "$T/rust.out"; echo $? > "$T/rust.rc"
check "switched: launch exits 0" "[ \"\$(cat '$T/rust.rc')\" = 0 ]"
check "switched: kith-pkg resolve is not run" "[ \"\$(calls 'kith-pkg resolve')\" = 0 ]"
check "switched: project-id is not run" "[ \"\$(calls project-id)\" = 0 ]"
check "switched: the project came from the core" "grep -q demo '$T/rust.out'"

# 2. KITH_CORE=python: both programs are asked, and the launch object is the same.
reset; (cd "$T/work/proj" && KITH_CORE=python "$KITH" echo --launch-json 2>"$T/err") > "$T/py.out"
check "KITH_CORE=python: kith-pkg resolve is run" "[ \"\$(calls 'kith-pkg resolve')\" -ge 1 ]"
check "KITH_CORE=python: project-id is run" "[ \"\$(calls project-id)\" -ge 1 ]"
check "same launch object either way" "[ \"\$(norm < '$T/rust.out')\" = \"\$(norm < '$T/py.out')\" ]"

# 3. Rollback per verb: one line gone from the copy, that program is asked again and the other is not.
cp "$T/k/lib/core-switched.txt" "$T/switched.keep"
grep -v '^pkg	' "$T/switched.keep" > "$T/k/lib/core-switched.txt"
reset; (cd "$T/work/proj" && "$KITH" echo --launch-json 2>/dev/null) > /dev/null
check "pkg line removed: kith-pkg resolve is run, project-id is not" "[ \"\$(calls 'kith-pkg resolve')\" -ge 1 ] && [ \"\$(calls project-id)\" = 0 ]"
grep -v '^project-id	' "$T/switched.keep" > "$T/k/lib/core-switched.txt"
reset; (cd "$T/work/proj" && "$KITH" echo --launch-json 2>/dev/null) > /dev/null
check "project-id line removed: project-id is run, kith-pkg resolve is not" "[ \"\$(calls project-id)\" -ge 1 ] && [ \"\$(calls 'kith-pkg resolve')\" = 0 ]"
cp "$T/switched.keep" "$T/k/lib/core-switched.txt"

# 4. The other kith-pkg verbs stay Python.
reset; "$KITH" versions echo > /dev/null 2>&1
check "kith versions still goes to kith-pkg" "[ \"\$(calls 'kith-pkg versions')\" = 1 ]"

# 5. A guest's project-id (run token + socket) reaches the Python, which asks the host over the socket; the core refuses
# that branch with exit 2, so it must not be what answers.
reset
(cd "$T/work/proj" && KITH_RUN_TOKEN=tok KITH_RUN_SOCKET=$T/none.sock "$T/k/bin/project-id" > "$T/g.out" 2> "$T/g.err"); grc=$?
check "guest: the Python program answers" "[ \"\$(calls project-id)\" = 1 ] && ! grep -q 'the core does not take that branch' '$T/g.err'"
check "guest: it went for the host's socket (not the registry)" "[ $grc != 0 ] && ! grep -q demo '$T/g.out'"
(cd "$T/work/proj" && KITH_RUN_TOKEN=tok KITH_RUN_SOCKET=$T/none.sock "$REAL" kernel project-id > /dev/null 2> "$T/g2.err"); grc2=$?
check "guest: the core refuses with exit 2" "[ $grc2 = 2 ]"

# 6. A launch with a guest token in the environment still works (the launch drops it for its own lookups).
reset; (cd "$T/work/proj" && KITH_RUN_TOKEN=tok KITH_RUN_SOCKET=$T/none.sock "$KITH" echo --launch-json 2>/dev/null) > "$T/gl.out"
check "launch under a guest token: project found, core answered" "grep -q demo '$T/gl.out' && [ \"\$(calls project-id)\" = 0 ]"

# 7. No projects.json, and a malformed one: launch carries on without a project / says so, as the Python does.
mv "$T/state/projects.json" "$T/projects.keep"
reset; (cd "$T/work" && "$KITH" echo --launch-json 2>/dev/null) > "$T/np.out"; nrc=$?
reset; (cd "$T/work" && KITH_CORE=python "$KITH" echo --launch-json 2>/dev/null) > "$T/np.py"; nprc=$?
check "no projects.json: same exit and object as the Python" "[ $nrc = $nprc ] && [ \"\$(norm < '$T/np.out')\" = \"\$(norm < '$T/np.py')\" ]"
printf '{not json' > "$T/state/projects.json"
(cd "$T/work" && "$KITH" echo --launch-json >/dev/null 2>&1); mrc=$?
(cd "$T/work" && KITH_CORE=python "$KITH" echo --launch-json >/dev/null 2>&1); mprc=$?
check "malformed projects.json: same exit as the Python" "[ $mrc = $mprc ]"
mv "$T/projects.keep" "$T/state/projects.json"

echo
if [ "$fails" = 0 ]; then echo "all checks passed"; else echo "$fails check(s) failed"; exit 1; fi
