#!/usr/bin/env bash
# kith-harness-check — `kith <agent> set harness H [--model M]` (kith-pkg set-harness) and the launch's model guard:
# changing the harness drops agent.md's model (it names a model of the old harness) unless --model gives one, and a Claude
# model never reaches another harness at launch (codex -m sonnet fails). Throwaway HOME and KITH_HOME, fake claude/codex.
#
#   kernel/tests/kith-harness-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-harness-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_MODEL KITH_EFFORT KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
A=$KITH_HOME/agents/echo/role
mkdir -p "$HOME/.claude" "$HOME/.codex" "$KITH_HOME/state" "$A" "$T/bin"
export KITH_STATE=$KITH_HOME/state
printf -- '---\nname: echo\ndescription: test agent\nmodel: sonnet\neffort: medium\n---\nYou echo.\n' > "$A/agent.md"
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
git -C "$A" init -q && git -C "$A" commit -qm init --allow-empty

for h in claude codex; do printf '#!/bin/sh\necho "%s $*"\n' "$h" > "$T/bin/$h"; chmod +x "$T/bin/$h"; done
touch "$HOME/.claude/.fake-login" "$HOME/.codex/.fake-login"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
fm() { awk 'NR==1{next} /^---$/{exit} {print}' "$A/agent.md" | grep -E '^(harness|model|effort):' | tr '\n' ' '; }
launch() { "$KITH" echo --launch-json 2>"$T/err" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["harness"], d["model"])'; }

check "start: claude, sonnet" "[ \"\$(launch)\" = 'claude sonnet' ]"

"$KITH" echo set harness nope >/dev/null 2>&1; rc=$?
check "unknown harness refused, file unchanged" "[ $rc = 2 ] && [ \"\$(fm)\" = 'model: sonnet effort: medium ' ]"

"$KITH" echo set harness codex >/dev/null 2>&1
check "set harness codex: harness written, Claude model dropped, effort kept" "[ \"\$(fm)\" = 'harness: codex effort: medium ' ]"
check "set harness codex: committed in the agent's repo" "git -C '$A' log -1 --format=%s | grep -q 'echo: run on codex'"
check "codex launch carries no model" "[ \"\$(launch)\" = 'codex None' ]"

"$KITH" echo set harness codex --model gpt-5 >/dev/null 2>&1
check "--model sets one" "[ \"\$(fm)\" = 'harness: codex model: gpt-5 effort: medium ' ] && [ \"\$(launch)\" = 'codex gpt-5' ]"

"$KITH" echo set harness codex >/dev/null 2>&1
check "same harness again keeps its model" "[ \"\$(fm)\" = 'harness: codex model: gpt-5 effort: medium ' ]"

"$KITH" echo set harness claude --model sonnet >/dev/null 2>&1
check "back to claude: no harness line, model sonnet" "[ \"\$(fm)\" = 'model: sonnet effort: medium ' ] && [ \"\$(launch)\" = 'claude sonnet' ]"

# A hand-edited agent.md with a Claude model on codex: the launch drops it and says so.
printf -- '---\nname: echo\ndescription: test agent\nharness: codex\nmodel: sonnet\n---\nYou echo.\n' > "$A/agent.md"
check "guard: a Claude model never reaches codex" "[ \"\$(launch)\" = 'codex None' ] && grep -q 'sonnet is a Claude model' '$T/err'"
OUT=$(KITH_MODEL=opus "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["model"])')
check "guard: -m/KITH_MODEL with a Claude model on codex is dropped too" "[ '$OUT' = None ]"
OUT=$(KITH_MODEL=gpt-5 "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["model"])')
check "guard: a codex model passes" "[ '$OUT' = gpt-5 ]"

[ $fails = 0 ] && echo "all harness checks passed" || { echo "$fails check(s) failed"; exit 1; }
