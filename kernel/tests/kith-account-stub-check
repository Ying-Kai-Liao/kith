#!/usr/bin/env bash
# kith-account-stub-check — bin/kith-account is a stub since R3 (docs/plans/retire-python.md): it hands the line to the kernel's
# own `kith account`, which sends it to the Rust program, and with no program says so in one line and exits 1. A throwaway copy
# of the kernel folder, a fake kith program that logs what it is asked; nothing real is touched.
#
#   kernel/tests/kith-account-stub-check     a second or two; prints each check, exits 1 when one fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-account-stub-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith
unset KITH_STATE HQ_STATE KITH_MACHINE HQ_MACHINE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CORE KITH_BIN CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
mkdir -p "$HOME" "$KITH_HOME/state" "$T/bin"
export KITH_STATE=$KITH_HOME/state

K=$T/kernel
cp -R "$KERNEL" "$K"
LOG=$T/calls.log
# A kith program that lists the account module and answers the hook probe; every other line is logged.
printf '#!/bin/sh\ncase "$1 $2" in "kernel version") echo %s ;; "memory hook") echo phase ;; *) echo "$*" >> "%s" ;; esac\n' \
  "'{\"abi\":1,\"modules\":[\"account\",\"account-state\"]}'" "$LOG" > "$T/bin/kith-fake"
chmod +x "$T/bin/kith-fake"
ln -s "$K/bin/kith-account" "$T/bin/linked-account"

fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; sed 's/^/     | /' "$T/err" 2>/dev/null | tail -5; fails=$((fails + 1)); fi; }
# No program anywhere: KITH_BIN names nothing, no kith on PATH, no build in the checkout.
none() { CARGO_TARGET_DIR=$T/no-build PATH=$T/bin:/usr/bin:/bin KITH_BIN=$T/none "$@"; }

: > "$LOG"
KITH_BIN=$T/bin/kith-fake "$K/bin/kith-account" pin echo claude:work --only > "$T/out" 2> "$T/err"; rc=$?
check "the stub reaches the program with the same words" "[ $rc = 0 ] && [ \"\$(cat '$LOG')\" = 'kernel account --kernel $K pin echo claude:work --only' ]"

: > "$LOG"
KITH_BIN=$T/bin/kith-fake "$T/bin/linked-account" list --json > "$T/out" 2> "$T/err"; rc=$?
check "through a symlink, a state verb goes to account-state" "[ $rc = 0 ] && [ \"\$(cat '$LOG')\" = 'kernel account-state --kernel $K list --json' ]"

: > "$LOG"
KITH_BIN=$T/bin/kith-fake "$K/bin/kith-account" > "$T/out" 2> "$T/err"
check "no words: the help is asked for" "[ \"\$(cat '$LOG')\" = 'kernel account --kernel $K --help' ]"

none "$K/bin/kith-account" list > "$T/out" 2> "$T/err"; rc=$?
check "no program: one line, exit 1, nothing on stdout" "[ $rc = 1 ] && [ ! -s '$T/out' ] && [ \"\$(wc -l < '$T/err' | tr -d ' ')\" = 1 ] && grep -q 'needs the kith program' '$T/err'"

KITH_CORE=python none "$K/bin/kith-account" add claude work > "$T/out" 2> "$T/err"; rc=$?
check "KITH_CORE=python with no program: the line says it reaches no Python" "[ $rc = 1 ] && grep -q 'KITH_CORE=python reaches no Python body' '$T/err'"

echo
if [ "$fails" = 0 ]; then echo "all checks passed"; else echo "$fails failed"; exit 1; fi
