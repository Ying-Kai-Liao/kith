#!/usr/bin/env bash
# kith-lifecycle-check — F12, the rest of the session lifecycle (designs/2026-10-24-lifecycle.md): a human session sleeps only
# through the `kith-sessions run` wrapper (S2, S7), intent comes before any signal and a taker clears it (S6, rules 8, 14), the
# 54-minute decision for a session no process runs (rule 5) with Kith's /compact re-checked under the writer claim (rules 11,
# 12; S1, S3), rule T (S4), and a guest's waiter staying refused (rule 10).
#
#   kernel/tests/kith-lifecycle-check     under a minute; prints each check, exits 1 when one fails
#
# claude is a stub (KITH_CLAUDE) that writes a compaction into the fake transcript the way Claude does. Nothing touches
# the real ~/.kith or ~/.claude.
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-lifecycle-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'kill $(jobs -p) 2>/dev/null; rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/state KITH_LOGS=$T/logs CLAUDE_CONFIG_DIR=$T/claude KITH_WAKE_NO_KICK=1
unset KITH_PERSON KITH_AGENT KITH_ROOM KITH_RESUME KITH_VIA CLAUDE_CODE_SESSION_ID HQ_HOME HQ_STATE KITH_CACHE_LIFE KITH_SLEEP_MINUTES
mkdir -p "$HOME" "$KITH_STATE/live/terminal" "$CLAUDE_CONFIG_DIR/projects/p" "$CLAUDE_CONFIG_DIR/sessions" "$T/work"
SK=$KERNEL/bin/kith-sessions
LC=$KERNEL/bin/kith-lifecycle
W=$KERNEL/bin/kith-wake
REG=$KITH_STATE/live/terminal
TR=$CLAUDE_CONFIG_DIR/projects/p
fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
is() { [[ $2 == "$3" ]] && ok "$1" || bad "$1" "got '$2', wanted '$3'"; }

# The fixtures: a transcript whose last turn was AGE minutes ago, its registry entry, and the stub claude.
cat > "$T/fx.py" <<'PY'
import datetime as dt, json, sys
sid, age, tokens, tail, kind = sys.argv[1], float(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5]
claude, tr, reg, cwd = sys.argv[6:10]
t = dt.datetime.now(dt.timezone.utc) - dt.timedelta(minutes=age)
iso = lambda d: d.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'
lines = [{'type': 'user', 'timestamp': iso(t - dt.timedelta(seconds=5)), 'message': {'content': 'do the thing'}},
         {'type': 'assistant', 'timestamp': iso(t), 'message': {'content': [{'type': 'text', 'text': tail}],
          'usage': {'input_tokens': 10, 'cache_read_input_tokens': tokens, 'cache_creation_input_tokens': 5}}}]
open(f'{tr}/{sid}.jsonl', 'w').write(''.join(json.dumps(x) + '\n' for x in lines))
json.dump({'v': 1, 'sessionId': sid, 'agent': 'designer', 'cwd': cwd, 'transcriptPath': f'{tr}/{sid}.jsonl', 'pid': None,
           'startedAt': '2026-10-31T00:00:00Z', 'kind': kind}, open(f'{reg}/{sid}.json', 'w'))
PY
fx() { python3 "$T/fx.py" "$1" "$2" "$3" "$4" "${5:-terminal}" "$CLAUDE_CONFIG_DIR" "$TR" "$REG" "$T/work"; }
cat > "$T/claude-stub" <<'STUB'
#!/bin/sh
# stub: claude -p --resume SID /compact. Records the args and whether the claim was held, then writes a compaction.
sid=$3
printf '%s\n' "$*" >> "$KITH_STATE/stub-calls"
[ -f "$KITH_STATE/live/terminal/$sid.claim" ] && echo held >> "$KITH_STATE/stub-claims"
[ "${STUB_MODE:-ok}" = fail ] && exit 1
python3 - "$sid" <<'PY'
import datetime as dt, json, os, sys
now = dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.000Z')
f = os.environ['CLAUDE_CONFIG_DIR'] + '/projects/p/' + sys.argv[1] + '.jsonl'
open(f, 'a').write(''.join(json.dumps(x) + '\n' for x in [
    {'type': 'system', 'subtype': 'compact_boundary', 'timestamp': now},
    {'type': 'user', 'isCompactSummary': True, 'timestamp': now, 'message': {'content': 'This session is being continued...'}},
    {'type': 'user', 'timestamp': now, 'message': {'content': '<local-command-caveat>Caveat: the messages below were generated by the user...</local-command-caveat>'}},
    {'type': 'user', 'timestamp': now, 'message': {'content': '<command-name>/compact</command-name>'}},
    {'type': 'user', 'timestamp': now, 'message': {'content': '<local-command-stdout>Compacted (ctrl+o to see full summary)</local-command-stdout>'}}]))
PY
STUB
chmod +x "$T/claude-stub"
export KITH_CLAUDE=$T/claude-stub
calls() { [[ -f $KITH_STATE/stub-calls ]] && wc -l < "$KITH_STATE/stub-calls" | tr -d ' ' || echo 0; }
dec() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["decision"], "compacted" if d.get("compacted") else "", "ended" if d.get("ended") else "")' "$KITH_STATE/sessions/decisions/$1.json" 2>/dev/null | xargs; }
intent() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["why"])' "$KITH_STATE/sessions/intent/$1.json" 2>/dev/null; }
py() { python3 -c "import sys; sys.path.insert(0, '$KERNEL/lib'); import kith_lifecycle as lc; $1"; }

# --- the decision (rule 5), structural signals only ------------------------------------------------------------------------
Q='shall I go on with plan B?'
fx d-big-q 55 150000 "$Q"
is "big, and the last turn asked: compact" "$(py "print(lc.decide('$TR/d-big-q.jsonl','terminal',False))")" compact
fx d-big-nq 55 150000 "done."
is "big with no sign of return: stay asleep" "$(py "print(lc.decide('$TR/d-big-nq.jsonl','terminal',False))")" sleep
is "big, a waiter open: compact" "$(py "print(lc.decide('$TR/d-big-nq.jsonl','terminal',True))")" compact
is "big, thread pinned: compact" "$(py "print(lc.decide('$TR/d-big-nq.jsonl','terminal',False,{'pinned':True}))")" compact
fx d-small 55 20000 "$Q"
is "under the floor: stay asleep" "$(py "print(lc.decide('$TR/d-small.jsonl','terminal',False))")" sleep
fx d-early 40 150000 "$Q"
is "before 0.9 of the lifetime: no decision" "$(py "print(lc.decide('$TR/d-early.jsonl','terminal',False))")" None
fx d-task 55 150000 "result: 42"
is "a Kith task that returned, no question: end" "$(py "print(lc.decide('$TR/d-task.jsonl','ask',False))")" end
is "a task with a waiter still open does not end" "$(py "print(lc.decide('$TR/d-task.jsonl','ask',True))")" compact
is "a closed thread: end" "$(py "print(lc.decide('$TR/d-big-q.jsonl','terminal',False,{'closed':True}))")" end
is "a 5-minute cache has no timer" "$(KITH_CACHE_LIFE=300 py "print(lc.decide('$TR/d-big-q.jsonl','terminal',False))")" None
is "...but decides when the session goes to sleep" "$(KITH_CACHE_LIFE=300 py "print(lc.decide('$TR/d-early.jsonl','terminal',False,at=lc.last_turn_at('$TR/d-early.jsonl')+300))")" compact

# --- the idle clock: a compaction's own write is not a turn (rule 4) -----------------------------------------------------------
fx c-clock 55 150000 "$Q"
before=$(py "print(lc.last_turn_at('$TR/c-clock.jsonl'))")
"$T/claude-stub" -p --resume c-clock /compact
rm -f "$KITH_STATE/stub-calls" "$KITH_STATE/stub-claims"
is "the idle clock ignores the compaction's summary and boundary" "$(py "print(lc.last_turn_at('$TR/c-clock.jsonl'))")" "$before"
is "...and sees that it was compacted" "$(py "print(lc.compacted_since('$TR/c-clock.jsonl', $before))")" True

# --- the sweep: compact under the claim, once -------------------------------------------------------------------------------
fx s-compact 55 150000 "$Q"
out=$(python3 "$LC" sweep --session s-compact)
is "sweep compacts a big session that asked a question" "$out" "s-compact compact compacted"
is "...with claude -p --resume SID /compact" "$(grep s-compact "$KITH_STATE/stub-calls")" "-p --resume s-compact /compact"
is "...while the writer claim was held" "$(cat "$KITH_STATE/stub-claims")" held
is "...and gave the claim back" "$([[ -e $REG/s-compact.claim ]] && echo held || echo free)" free
is "the decision records it" "$(dec s-compact)" "compact compacted"
n=$(calls)
python3 "$LC" sweep --session s-compact >/dev/null
is "a second sweep in the same idle period does not compact again" "$(( $(calls) - n ))" 0

fx s-asleep 55 150000 "done."
is "no sign of return: decided to stay asleep, not compacted" "$(python3 "$LC" sweep --session s-asleep)" "s-asleep sleep asleep"
fx s-early 30 150000 "$Q"
is "before 54 minutes: nothing" "$(python3 "$LC" sweep --session s-early)" ""

# a writer holds it (a terminal that is open): not touched, its claim not taken
fx s-held 55 150000 "$Q"
sleep 60 &
holder=$!
python3 - "$REG/s-held.claim" "$holder" <<'PY'
import json, os, subprocess, sys
start = ' '.join(subprocess.run(['ps', '-o', 'lstart=', '-p', sys.argv[2]], capture_output=True, text=True, env={**os.environ, 'LC_ALL': 'C'}).stdout.split())
json.dump({'pid': int(sys.argv[2]), 'procStart': start, 'kind': 'terminal'}, open(sys.argv[1], 'w'))
PY
n=$(calls)
is "a live writer: the sweep leaves the session to it (one compactor)" "$(python3 "$LC" sweep --session s-held)" ""
is "...and no claude was started" "$(calls)" "$n"
is "...and the sweep signalled nobody" "$(kill -0 $holder 2>/dev/null && echo alive)" alive
kill $holder 2>/dev/null
wait $holder 2>/dev/null

# re-checks under the claim (rules 11, 12): called past the decision, with the world changed
cat > "$T/recheck.py" <<'PY'
import importlib.machinery, importlib.util, json, sys, os
sys.path.insert(0, sys.argv[1] + '/lib')
import kith_lifecycle as lc
loader = importlib.machinery.SourceFileLoader('kl', sys.argv[1] + '/bin/kith-lifecycle')
spec = importlib.util.spec_from_loader('kl', loader); kl = importlib.util.module_from_spec(spec); loader.exec_module(kl)
ks = kl.sessions_mod()
sid, what = sys.argv[2], sys.argv[3]
e = next(x for x in kl.entries(ks) if x['sessionId'] == sid)
since = lc.last_turn_at(e['transcriptPath'])
lc.write_decision(sid, {'decision': 'compact', 'at': 0, 'idleSince': since, 'compacted': False})
if what == 'resumed':
    lc.clear_decision(sid)                       # a resume cleared the decision between the decision and the claim
elif what == 'newturn':
    open(e['transcriptPath'], 'a').write(json.dumps({'type': 'user', 'timestamp': '2099-01-01T00:00:00.000Z', 'message': {'content': 'back'}}) + '\n')
elif what == 'self':                             # Claude compacted it itself since
    open(e['transcriptPath'], 'a').write(json.dumps({'type': 'system', 'subtype': 'compact_boundary', 'timestamp': '2099-01-01T00:00:00.000Z'}) + '\n')
print(kl.compact(ks, e, since, None))
PY
for what in resumed newturn self; do
  fx r-$what 55 150000 "$Q"
  n=$(calls)
  got=$(python3 "$T/recheck.py" "$KERNEL" r-$what $what)
  is "under the claim: after $what, it exits without compacting" "$got/$(( $(calls) - n ))" "skipped/0"
done
fx r-small 55 20000 "$Q"
n=$(calls)
is "under the claim: under the floor, no compaction" "$(python3 "$T/recheck.py" "$KERNEL" r-small none)/$(( $(calls) - n ))" "skipped/0"
fx r-ok 55 150000 "$Q"
n=$(calls)
is "control: nothing changed, it compacts" "$(python3 "$T/recheck.py" "$KERNEL" r-ok none)/$(( $(calls) - n ))" "compacted/1"
fx r-fail 55 150000 "$Q"
got=$(STUB_MODE=fail python3 "$LC" sweep --session r-fail)
is "a failed /compact is reported, not recorded as done" "$got/$(dec r-fail)" "r-fail compact failed: exit 1/compact"


# a failed /compact is tried once per idle period (a retry every tick would be a bill every minute)
n=$(calls)
python3 "$LC" sweep --session r-fail >/dev/null
is "a failed compaction is not retried in the same idle period" "$(( $(calls) - n ))" 0
fx r-gone 55 150000 "$Q"
python3 - "$REG/r-gone.json" <<'PY'
import json, sys
e = json.load(open(sys.argv[1])); e['cwd'] = '/nonexistent/folder'; json.dump(e, open(sys.argv[1], 'w'))
PY
n=$(calls)
is "a session whose folder is gone is not compacted (resume would run in the wrong project)" "$(python3 "$LC" sweep --session r-gone)/$(( $(calls) - n ))" "r-gone compact failed: the session's folder is gone/0"
fx r-nobin 55 150000 "$Q"
is "claude missing: reported for that session, the sweep goes on" "$(KITH_CLAUDE=/nonexistent/claude python3 "$LC" sweep --session r-nobin | cut -c1-30)" "r-nobin compact failed: [Errno"


# a session the host keeps a conversation for is the host's to compact (one compactor per session)
mkdir -p "$T/serve"
echo tok > "$T/serve/token"
HOSTPID=
cat > "$T/host.py" <<'PY'
import http.server, json, sys
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        self.rfile.read(int(self.headers.get('Content-Length', 0)))
        body = json.dumps({'botId': 'b', 'sessionId': 'h-owned', 'agent': 'designer'}).encode()
        self.send_response(200); self.send_header('Content-Length', str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, *a): pass
s = http.server.HTTPServer(('127.0.0.1', 0), H)
print(s.server_address[1], flush=True)
s.serve_forever()
PY
python3 "$T/host.py" > "$T/host.port" &
HOSTPID=$!
for _ in $(seq 50); do [[ -s $T/host.port ]] && break; sleep 0.1; done
fx h-owned 55 150000 "$Q"
n=$(calls)
is "a session the host has a conversation for is left to the host's compactor" "$(KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=$(cat "$T/host.port") python3 "$LC" sweep --session h-owned)/$(( $(calls) - n ))" "/0"

# end: only under the claim, and a resume clears it
fx e-task 55 150000 "result: 42" ask
is "a returned task with no question is ended under the claim" "$(python3 "$LC" sweep --session e-task)" "e-task end ended"
is "...the decision says ended" "$(dec e-task)" "end ended"
python3 "$SK" claim e-task $$ >/dev/null 2>&1
rm -f "$REG/e-task.claim" "$REG/e-task.claim.lock"
is "any resume (taking the claim) clears the decision" "$(dec e-task)" ""

# --- intent (rules 8, 14) -----------------------------------------------------------------------------------------------------
py "lc.write_intent('i-1', 'idle', $$)"
is "an intent is written with why, at, pid and start time" "$(python3 -c "import json; d=json.load(open('$KITH_STATE/sessions/intent/i-1.json')); print(d['why'], d['pid']==$$, bool(d['at']), bool(d['procStart']))")" "idle True True True"
python3 "$SK" claim i-1 $$ >/dev/null 2>&1
is "a process taking the claim clears it" "$(intent i-1)" ""
rm -f "$REG/i-1.claim" "$REG/i-1.claim.lock"
is "no intent after a process ran: a crash" "$(py "print(lc.how_it_ended('i-1'))")" crash
py "lc.write_intent('i-2', 'idle', 111)"
is "an intent for another process is not this process' reason" "$(py "print(lc.how_it_ended('i-2', True, 222), lc.how_it_ended('i-2', True, 111))")" "crash idle"
is "no intent, never seen running (old data): unknown, not ended" "$(py "print(lc.how_it_ended('old-1', False))")" None

# --- the wrapper: sleeps only its own child (rule 3), after the idle time, with nothing outstanding (rule 7) ---------------------
cat > "$T/child.py" <<'PY'
#!/usr/bin/env python3
# a fake claude: registers its own session (pid = this process, which `run` forked) and then waits, or exits like the test says
import json, os, sys, time
sid, mode = sys.argv[1], sys.argv[2]
reg = os.environ['KITH_STATE'] + '/live/terminal'
e = json.load(open(f'{reg}/{sid}.json')); e['pid'] = os.getpid(); json.dump(e, open(f'{reg}/{sid}.json', 'w'))
if mode == 'quit': sys.exit(0)
if mode == 'crash': sys.exit(3)
time.sleep(60)
PY
chmod +x "$T/child.py"
wrap() {   # wrap <sid> <mode> → runs the wrapper in the background; $wp is its pid
  KITH_SLEEP_MINUTES=${3:-0.01} KITH_IDLE_POLL=0.2 python3 "$SK" run designer -- "$T/child.py" "$1" "$2" >"$T/wrap.out" 2>&1 &
  wp=$!
}
waitfor() { for _ in $(seq 100); do eval "$1" && return 0; sleep 0.1; done; return 1; }
stays() {   # stays <sid>: after a few seconds the wrapper's child is alive and nothing was written; then end it
  sleep 3
  is "$2" "$(intent "$1")/$(kill -0 $wp 2>/dev/null && echo alive)" "/alive"
  kill -TERM $wp
  wait $wp 2>/dev/null
}

fx w-idle 120 150000 "all done"
wrap w-idle sleep
waitfor '[[ -n $(intent w-idle) ]]'
is "an idle hour with nothing outstanding: the wrapper writes intent idle first" "$(intent w-idle)" idle
waitfor '! kill -0 $wp 2>/dev/null'
wait $wp 2>/dev/null
rc=$?
is "...then its own child ends and the wrapper returns (a SIGTERM death)" "$rc" 143

fx w-busy 120 150000 "all done"
python3 - "$TR/w-busy.jsonl" <<'PY'
import json, sys
open(sys.argv[1], 'a').write(json.dumps({'type': 'assistant', 'timestamp': '2020-01-01T00:00:00.000Z', 'message': {'content': [
    {'type': 'tool_use', 'id': 'toolu_1', 'name': 'Task', 'input': {}}]}}) + '\n')
PY
wrap w-busy sleep
stays w-busy "a running subagent: nothing is signalled, no intent"

fx w-side 120 150000 "all done"
mkdir -p "$TR/w-side/mcp-tasks"
echo '{"mcpTaskId":"t1"}' > "$TR/w-side/mcp-tasks/mcp-task-a.meta.json"
wrap w-side sleep
stays w-side "an open MCP task (sidecar): nothing is signalled"

fx w-sh 120 150000 "all done"
python3 - "$TR/w-sh.jsonl" <<'PY'
import json, sys
open(sys.argv[1], 'a').write(json.dumps({'type': 'user', 'timestamp': '2020-01-01T00:00:00.000Z', 'message': {'content': [
    {'type': 'tool_result', 'tool_use_id': 'x', 'content': 'Command running in background with ID: bg123. Output is being written to /x'}]}}) + '\n')
PY
wrap w-sh sleep
stays w-sh "a background shell with no task-notification: not signalled"

fx w-fresh 0 150000 "$Q"
wrap w-fresh sleep 5
stays w-fresh "a session with a recent turn is not slept"

fx w-quit 1 1000 "bye"
wrap w-quit quit
wait $wp 2>/dev/null
is "Kai's own /exit records intent quit" "$(intent w-quit)" quit
fx w-crash 1 1000 "bye"
wrap w-crash crash
wait $wp 2>/dev/null
is "an exit with an error and no intent reads as a crash" "$(intent w-crash)|$(py "print(lc.how_it_ended('w-crash'))")" "|crash"

# a bare claude (no wrapper): no sweep signals it, whatever its idle time
fx b-bare 600 150000 "$Q"
sleep 60 &
bare=$!
echo '{"sessionId":"b-bare"}' > "$CLAUDE_CONFIG_DIR/sessions/$bare.json"
python3 - "$REG/b-bare.json" "$bare" <<'PY'
import json, sys
e = json.load(open(sys.argv[1])); e['pid'] = int(sys.argv[2]); json.dump(e, open(sys.argv[1], 'w'))
PY
n=$(calls)
python3 "$LC" sweep --session b-bare >/dev/null
is "a bare claude is never slept or compacted by a sweep" "$(kill -0 $bare 2>/dev/null && echo alive)/$(intent b-bare)/$(( $(calls) - n ))" "alive//0"
kill $bare 2>/dev/null
wait $bare 2>/dev/null

# --- rule T and guests (rule 10) -----------------------------------------------------------------------------------------------
fx t-side 10 1000 "waiting on the task"
mkdir -p "$TR/t-side/mcp-tasks"
echo '{"mcpTaskId":"t9"}' > "$TR/t-side/mcp-tasks/mcp-task-b.meta.json"
python3 "$W" drain >/dev/null
is "rule T: Kith queues nothing for a sidecar task" "$(python3 "$W" ls --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')" 0
is "...and leaves the sidecar for Claude to deliver" "$([[ -f $TR/t-side/mcp-tasks/mcp-task-b.meta.json ]] && echo there)" there
is "...but counts it as outstanding work" "$(py "print(lc.outstanding('$TR/t-side.jsonl'))")" "['an MCP task is open']"
python3 "$W" wait --on mcp-task:t9 --session t-side --agent designer >/dev/null 2>&1
is "a wait on an MCP task is refused" "$?" 1
KITH_PERSON=anna python3 "$W" wait --on at:+1m --session g1 --agent coder >/dev/null 2>&1
is "a guest's waiter stays refused (no sandbox to run its check in)" "$?" 1

[[ $fail == 0 ]] && echo "all ok" || echo "FAILED"
exit $fail
