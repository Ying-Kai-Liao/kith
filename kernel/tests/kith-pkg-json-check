#!/usr/bin/env bash
# kith-pkg-json-check — `--json` on the agent package verbs: versions, history, pin / rollback / unpin, restore, install,
# share, deps, update / push / commit <agent>. CLI lines in, stdout / exit code / repo state out, so the same lines can
# check another implementation. Local git repos stand in for GitHub (file:// remotes), a fake gh; no network.
#
#   kernel/tests/kith-pkg-json-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-pkg-json-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_MODEL KITH_EFFORT KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
mkdir -p "$HOME" "$KITH_HOME/state" "$T/bin" "$T/remotes"
export KITH_STATE=$KITH_HOME/state
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com

# gh: logged in as "tester"; `repo create` makes a bare repo under remotes/ and wires origin; everything else succeeds.
cat > "$T/bin/gh" <<FAKE
#!/bin/sh
case "\$1 \$2" in
  "api user") echo tester ;;
  "repo create")
    repo=\$3; shift 3; src=
    while [ \$# -gt 0 ]; do case \$1 in --source) src=\$2; shift ;; esac; shift; done
    git init -q --bare "$T/remotes/\$repo.git"
    git -C "\$src" remote add origin "$T/remotes/\$repo.git" ;;
esac
exit 0
FAKE
chmod +x "$T/bin/gh"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
PKG=$KERNEL/bin/kith-pkg
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
export OUT=
jv() { python3 -c 'import json,os,sys; d=json.loads(os.environ["OUT"]); print(eval(sys.argv[1]))' "$1"; }
errshape() { jv '(d.get("ok"), "error" in d, len(d))' | grep -q '(False, True, 2)'; }
mkagent() {   # mkagent NAME: an agent with a git history and an upstream bare repo
  local a=$KITH_HOME/agents/$1/role
  mkdir -p "$a" "$KITH_HOME/agents/$1/memory"
  printf -- '---\nname: %s\ndescription: test agent\n---\nYou echo.\n' "$1" > "$a/agent.md"
  git -C "$a" init -q -b main && git -C "$a" add -A && git -C "$a" commit -qm init
  git init -q --bare "$T/up-$1.git"
  git -C "$a" remote add origin "$T/up-$1.git" && git -C "$a" push -q -u origin main
}
local_agent() {   # local_agent NAME BODY: a git repo with no remote at all
  mkdir -p "$KITH_HOME/agents/$1/role"
  printf -- '---\nname: %s\ndescription: test agent\n---\n%s\n' "$1" "$2" > "$KITH_HOME/agents/$1/role/agent.md"
  git -C "$KITH_HOME/agents/$1/role" init -q -b main && git -C "$KITH_HOME/agents/$1/role" add -A && git -C "$KITH_HOME/agents/$1/role" commit -qm init
}
A=$KITH_HOME/agents/echo/role
mkagent echo

# ---- versions / pin / unpin / rollback ----
"$PKG" resolve echo >/dev/null 2>&1   # the version store is made by a resolve
OUT=$("$KITH" versions echo --json); rc=$?
check "versions --json: agent, current, versions[{version,made,tags}]" "[ $rc = 0 ] && [ \"\$(jv '(d[\"agent\"], d[\"unreleased\"], len(d[\"versions\"]), sorted(d[\"versions\"][0]))')\" = \"('echo', False, 1, ['made', 'tags', 'version'])\" ]"
V1=$(jv 'd["versions"][0]["version"]')
check "versions (text) unchanged: version first on the line" "[ \"\$(\"\$KITH\" versions echo | awk '{print \$1}')\" = $V1 ]"
printf 'more\n' >> "$A/agent.md"; "$PKG" resolve echo >/dev/null 2>&1
OUT=$("$KITH" versions echo --json); V2=$(jv 'd["versions"][0]["version"]')
check "versions --json: newest first, two versions" "[ \"\$(jv 'len(d[\"versions\"])')\" = 2 ] && [ $V1 != $V2 ]"
OUT=$("$KITH" pin echo "$V1" --json); rc=$?
check "pin --json: ok, version, changed" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"version\"], d[\"changed\"], d[\"previous\"])')\" = \"(True, '$V1', True, None)\" ]"
OUT=$("$KITH" pin echo "$V1" --json)
check "pin to the pinned version: changed false" "[ \"\$(jv '(d[\"changed\"], d[\"previous\"])')\" = \"(False, '$V1')\" ]"
OUT=$("$KITH" versions echo --json)
check "versions --json shows the pin tag" "[ \"\$(jv '[v[\"version\"] for v in d[\"versions\"] if \"pinned\" in v[\"tags\"]]')\" = \"['$V1']\" ]"
OUT=$("$KITH" unpin echo --json); rc=$?
check "unpin --json: changed true, previous" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"changed\"], d[\"previous\"])')\" = \"(True, True, '$V1')\" ]"
OUT=$("$KITH" unpin echo --json)
check "unpin when not pinned: changed false" "[ \"\$(jv '(d[\"ok\"], d[\"changed\"], d[\"previous\"])')\" = '(True, False, None)' ]"
OUT=$("$KITH" rollback echo --json); rc=$?
check "rollback --json (no version): pins the older one" "[ $rc = 0 ] && [ \"\$(jv 'd[\"version\"]')\" = $V1 ]"
OUT=$("$KITH" pin echo nosuchversion --json 2>"$T/err"); rc=$?
check "pin bad version --json: error object, non-zero, nothing on stderr" "[ $rc != 0 ] && errshape && [ ! -s '$T/err' ]"
OUT=$("$KITH" versions ghost --json 2>"$T/err"); rc=$?
check "versions unknown agent --json: error object, non-zero, nothing on stderr" "[ $rc != 0 ] && errshape && [ ! -s '$T/err' ]"

# ---- history / restore ----
printf 'second\n' >> "$A/agent.md"; git -C "$A" commit -qam "second change"
OUT=$("$KITH" history echo --json); rc=$?
check "history --json: commits[{sha,date,subject}] newest first" "[ $rc = 0 ] && [ \"\$(jv '(len(d[\"commits\"]) >= 2, d[\"commits\"][0][\"subject\"], len(d[\"commits\"][0][\"sha\"]), sorted(d[\"commits\"][0]))')\" = \"(True, 'second change', 40, ['date', 'sha', 'subject'])\" ]"
OUT=$("$KITH" history echo 1 --json)
check "history echo 1 --json: limited to n" "[ \"\$(jv 'len(d[\"commits\"])')\" = 1 ]"
FIRST=$(git -C "$A" rev-list --max-parents=0 HEAD)
OUT=$("$KITH" restore echo "$FIRST" --json); rc=$?
check "restore --json: ok, changed, restored_to, a new commit" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"changed\"], d[\"restored_to\"], d[\"problems\"])')\" = \"(True, True, '$FIRST', [])\" ] && git -C '$A' log -1 --format=%s | grep -q 'restore to'"
C=$(git -C "$A" rev-list --count HEAD)
OUT=$("$KITH" restore echo "$FIRST" --json)
check "restore to the content it already has: changed false, no new commit" "[ \"\$(jv 'd[\"changed\"]')\" = False ] && [ \"\$(git -C '$A' rev-list --count HEAD)\" = $C ]"
OUT=$("$KITH" restore echo deadbeef --json 2>"$T/err"); rc=$?
check "restore bad ref --json: error object, non-zero" "[ $rc != 0 ] && errshape && [ ! -s '$T/err' ]"
OUT=$("$KITH" history ghost --json 2>"$T/err"); rc=$?
check "history unknown agent --json: error object, non-zero" "[ $rc != 0 ] && errshape"

# ---- commit / push / update ----
OUT=$("$KITH" commit echo --json)
check "commit with nothing to commit: changed false, exit 0" "[ \"\$(jv '(d[\"ok\"], d[\"agents\"][0][\"agent\"], d[\"agents\"][0][\"changed\"])')\" = \"(True, 'echo', False)\" ]"
printf 'edit\n' >> "$A/agent.md"
OUT=$("$KITH" commit echo -m "my edit" --json)
check "commit dirty tree: changed true, committed with the message" "[ \"\$(jv 'd[\"agents\"][0][\"changed\"]')\" = True ] && git -C '$A' log -1 --format=%s | grep -q 'my edit'"
OUT=$("$KITH" push echo --json); rc=$?
check "push --json: pushed true to origin" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"agents\"][0][\"pushed\"], d[\"agents\"][0][\"remote\"])')\" = \"(True, True, 'origin')\" ] && [ \"\$(git -C '$T/up-echo.git' rev-parse main)\" = \"\$(git -C '$A' rev-parse HEAD)\" ]"
# someone else pushes to upstream; update pulls it
git clone -q "$T/up-echo.git" "$T/other" && printf 'theirs\n' >> "$T/other/agent.md" && git -C "$T/other" commit -qam "their change" && git -C "$T/other" push -q origin main
OUT=$("$KITH" update echo --json); rc=$?
check "update <agent> --json: changed true, subject of upstream's commit" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"agents\"][0][\"changed\"], d[\"agents\"][0][\"subject\"])')\" = \"(True, True, 'their change')\" ]"
OUT=$("$KITH" update echo --json)
check "update again: changed false" "[ \"\$(jv 'd[\"agents\"][0][\"changed\"]')\" = False ]"
check "update <agent> --json is one object (kith-self-update did not run)" "[ \"\$(jv 'sorted(d)')\" = \"['agents', 'ok']\" ]"
git -C "$A" remote remove origin
OUT=$("$KITH" push echo --json)
check "push without a remote: pushed false with a note, exit 0" "[ \"\$(jv '(d[\"ok\"], d[\"agents\"][0][\"pushed\"], d[\"agents\"][0][\"note\"])')\" = \"(True, False, 'no remote')\" ]"
OUT=$("$KITH" update echo --json)
check "update a local-only agent: changed false, remote null" "[ \"\$(jv '(d[\"agents\"][0][\"changed\"], d[\"agents\"][0][\"remote\"])')\" = '(False, None)' ]"
OUT=$("$KITH" update ghost --json 2>"$T/err"); rc=$?
check "update unknown agent --json: error object, non-zero, nothing on stderr" "[ $rc != 0 ] && errshape && [ ! -s '$T/err' ]"

# ---- deps ----
printf 'requires:\n  nosuchprog-xyz: brew install nosuchprog-xyz  # for tests\n  sh: true\n' > "$A/capabilities.yaml"
OUT=$("$KITH" deps echo --json); rc=$?
check "deps --json reports a missing program, exit 0" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"agents\"][0][\"requires\"], [m[\"program\"] for m in d[\"agents\"][0][\"missing\"]])')\" = \"(True, 2, ['nosuchprog-xyz'])\" ]"
printf '#!/bin/sh\necho brewing\nexit 1\n' > "$T/bin/brew"; chmod +x "$T/bin/brew"
OUT=$("$KITH" deps echo --install --json 2>"$T/err"); rc=$?
check "deps --install --json, still missing: error object plus agents, non-zero, one object on stdout" "[ $rc != 0 ] && [ \"\$(jv '(d[\"ok\"], \"error\" in d, len(d[\"agents\"][0][\"missing\"]))')\" = '(False, True, 1)' ]"
printf 'requires:\n  sh: true\n' > "$A/capabilities.yaml"
OUT=$("$KITH" deps echo --json)
check "deps --json with everything present: empty missing" "[ \"\$(jv 'd[\"agents\"][0][\"missing\"]')\" = '[]' ]"
OUT=$("$KITH" deps ghost --json 2>"$T/err"); rc=$?
check "deps unknown agent --json: error object, non-zero" "[ $rc != 0 ] && errshape"

# ---- install (plain) ----
mkdir -p "$T/remotes/pal"
git init -q -b main "$T/remotes/pal/shared"
printf -- '---\nname: shared\ndescription: a shared one\n---\nHi.\n' > "$T/remotes/pal/shared/agent.md"
git -C "$T/remotes/pal/shared" add -A && git -C "$T/remotes/pal/shared" commit -qm init
OUT=$("$KITH" install "$T/remotes/pal/shared" --yes --json 2>"$T/err"); rc=$?
check "install <link> --json: --yes: installs without a prompt, {ok,name,path,version}" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"name\"], sorted(d))')\" = \"(True, 'shared', ['name', 'ok', 'path', 'version'])\" ] && [ -f '$KITH_HOME/agents/shared/role/agent.md' ]"
OUT=$("$KITH" install "$T/remotes/pal/shared" --yes --json 2>"$T/err"); rc=$?
check "install again --json: error object (already there), non-zero" "[ $rc != 0 ] && errshape"
OUT=$("$KITH" install "$T/remotes/pal" --yes --json 2>"$T/err"); rc=$?
check "install of a folder with no agent.md --json: error object, non-zero" "[ $rc != 0 ] && errshape"

# ---- share ----
local_agent solo "You are solo."
OUT=$("$KITH" share solo --json 2>"$T/err"); rc=$?
check "share --json (private): ok, repo, url, visibility, pushed" "[ $rc = 0 ] && [ \"\$(jv '(d[\"ok\"], d[\"repo\"], d[\"visibility\"], d[\"url\"])')\" = \"(True, 'tester/kith-agent-solo', 'private', 'https://github.com/tester/kith-agent-solo')\" ] && [ -d '$T/remotes/tester/kith-agent-solo.git' ]"
local_agent pub "You are pub."
OUT=$("$KITH" share pub --public --json 2>"$T/err"); rc=$?
check "share --public --json: visibility public" "[ $rc = 0 ] && [ \"\$(jv 'd[\"visibility\"]')\" = public ]"
local_agent leaky "See /Users/someone/secret."
OUT=$("$KITH" share leaky --public --json 2>"$T/err"); rc=$?
check "share --public of an agent with personal details: error object, non-zero" "[ $rc != 0 ] && errshape"
OUT=$("$KITH" share ghost --json 2>"$T/err"); rc=$?
check "share unknown agent --json: error object, non-zero" "[ $rc != 0 ] && errshape"

echo
[ $fails = 0 ] && echo "all ok" || { echo "$fails FAILED"; exit 1; }
