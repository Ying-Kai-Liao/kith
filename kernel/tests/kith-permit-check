#!/usr/bin/env bash
# kith-permit-check — a `claude -p` run asks for approval through a card instead of being refused: kith-permit (the
# --permission-prompt-tool MCP server) against a fake run socket, and bin/kith adding the flags to owner and guest runs.
#
#   kernel/tests/kith-permit-check     a few seconds; exits 1 when a check fails
#
# claude is a stub that prints its argv and the ask-token env; the host is a fake HTTP server (issueAskToken) and a fake
# unix socket (requestPermission). Throwaway HOME, KITH_HOME and KITH_STATE; nothing touches the real ~/.kith.
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-permit-check.XXXXXX")
T=$(cd "$T" && pwd -P)
PIDS=()
trap 'for p in ${PIDS[@]+"${PIDS[@]}"}; do kill "$p" 2>/dev/null; done; rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/kith" KITH_STATE=$T/state KITH_AUTH=$T/auth.json
unset KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE KITH_RESUME CLAUDE_CONFIG_DIR HQ_HOME HQ_STATE \
  KITH_SERVE_HOME KITH_RUN_TOKEN KITH_RUN_SOCKET KITH_ASK_TOKEN KITH_ASK_SOCKET KITH_VIA KITH_ASK_ID KITH_LAUNCH_ASK_ID HQ_ASK_ID \
  HQ_AGENT HQ_PERSON HQ_VIA CLAUDE_CODE_SESSION_ID
mkdir -p "$HOME" "$KITH_HOME/agents/echo/role" "$KITH_STATE/projects" "$KITH_STATE/logs" "$T/bin" "$T/serve" "$T/work"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$KITH_HOME/agents/echo/role/agent.md"
cat > "$T/bin/claude" <<'STUB'
#!/usr/bin/env bash
[[ $1 == --version ]] && { echo "2.1.309 (Claude Code)"; exit 0; }
[[ $1 == plugin ]] && { echo '[]'; exit 0; }
{ printf 'PID=%s\nASK=%s|%s\nRUN=%s|%s\nASKID=%s\n' "$$" "${KITH_ASK_TOKEN:-}" "${KITH_ASK_SOCKET:-}" "${KITH_RUN_TOKEN:-}" "${KITH_RUN_SOCKET:-}" "${KITH_ASK_ID:-}"
  printf 'ARG=%s\n' "$@"; } > "$STUB_OUT"
prev=; for a in "$@"; do [ "$prev" = --settings ] && cp "$a" "$STUB_OUT.settings" 2>/dev/null; prev=$a; done
STUB
chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH STUB_OUT=$T/stub.out

KITH=$KERNEL/bin/kith PERMIT=$KERNEL/bin/kith-permit
fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
is() { [[ $2 == "$3" ]] && ok "$1" || bad "$1" "got '$2', wanted '$3'"; }
has() { [[ $2 == *"$3"* ]] && ok "$1" || bad "$1" "'$3' not in: ${2: -400}"; }
hasnt() { [[ $2 != *"$3"* ]] && ok "$1" || bad "$1" "'$3' in: $2"; }

# --- the MCP server, against a fake run socket ----------------------------------------------------------------------
cat > "$T/mcp_test.py" <<'PY'
import importlib.machinery, importlib.util, json, os, socket, subprocess, sys, tempfile, threading
path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader('kith_permit', path)
spec = importlib.util.spec_from_loader('kith_permit', loader); kp = importlib.util.module_from_spec(spec); loader.exec_module(kp)
d = tempfile.mkdtemp(dir='/tmp'); sock = os.path.join(d, 's')
seen = []
reply = [None]
def serve():
    srv = socket.socket(socket.AF_UNIX); srv.bind(sock); srv.listen(5)
    while True:
        c, _ = srv.accept()
        buf = b''
        while not buf.endswith(b'\n'):
            x = c.recv(4096)
            if not x: break
            buf += x
        seen.append(json.loads(buf)); c.sendall(reply[0]); c.close()
threading.Thread(target=serve, daemon=True).start()
while not os.path.exists(sock): pass
import time; time.sleep(0.3)   # bind is done; listen follows at once
bad = 0
def check(name, got, want):
    global bad
    if got == want: print('ok   ' + name)
    else: print('FAIL %s: got %r, wanted %r' % (name, got, want)); bad = 1
guest = {'KITH_RUN_TOKEN': 'tok-g', 'KITH_RUN_SOCKET': sock}
owner = {'KITH_ASK_TOKEN': 'tok-o', 'KITH_ASK_SOCKET': sock}
inp = {'command': 'touch /tmp/x', 'timeout': 5}
reply[0] = b'{"ok":true,"behavior":"allow","message":""}\n'
check('allow: updatedInput is the input as asked', kp.decide('Bash', inp, guest), {'behavior': 'allow', 'updatedInput': inp})
check('allow: sent token, method, tool, input', seen[-1], {'token': 'tok-g', 'method': 'requestPermission', 'tool': 'Bash', 'input': inp})
check('owner: allow with the ask token', kp.decide('Bash', inp, owner)['behavior'], 'allow')
check('owner: sent the ask token', seen[-1]['token'], 'tok-o')
reply[0] = b'{"ok":true,"behavior":"deny","message":"waiting on Kai, end your turn"}\n'
check('deny: host message passed through', kp.decide('Bash', inp, guest), {'behavior': 'deny', 'message': 'waiting on Kai, end your turn'})
# A card past its window ("waiting"): a run kith ask started marks that ask parked (kith-ask then says "waiting").
reply[0] = b'{"ok":true,"behavior":"deny","waiting":true,"message":"waiting on Kai, end your turn"}\n'
parked = kp.ask_box() / 'ask-7.parked'
check('waiting, no ask id: the deny as it came', kp.decide('Bash', inp, owner)['behavior'], 'deny')
check('waiting, no ask id: nothing parked', list(kp.ask_box().glob('*.parked')) if kp.ask_box().is_dir() else [], [])
check('waiting with an ask id: still a deny', kp.decide('Bash', inp, dict(owner, KITH_ASK_ID='ask-7'))['behavior'], 'deny')
check('waiting with an ask id: the ask is parked', parked.exists(), True)
parked.unlink()
reply[0] = b'{"ok":true,"behavior":"deny","message":"No."}\n'
kp.decide('Bash', inp, dict(owner, KITH_ASK_ID='ask-7'))
check('a deny in the window: not parked', parked.exists(), False)
reply[0] = b'{"ok":false,"error":"bad token"}\n'
check('error reply: deny with the error', kp.decide('Bash', inp, guest), {'behavior': 'deny', 'message': 'bad token'})
for name, raw in (('not json', b'garbage\n'), ('a list', b'[1]\n'), ('allow without ok', b'{"behavior":"allow"}\n'), ('unknown behavior', b'{"ok":true,"behavior":"maybe"}\n'), ('empty', b'')):
    reply[0] = raw
    check('malformed (%s): deny' % name, kp.decide('Bash', inp, guest)['behavior'], 'deny')
check('no token: deny', kp.decide('Bash', inp, {})['behavior'], 'deny')
check('token without socket: deny', kp.decide('Bash', inp, {'KITH_RUN_TOKEN': 'x'})['behavior'], 'deny')
os.unlink(sock)
check('socket gone: deny', kp.decide('Bash', inp, guest)['behavior'], 'deny')
# The stdio protocol, as Claude Code speaks it.
reply[0] = b'{"ok":true,"behavior":"allow"}\n'
srv = socket.socket(socket.AF_UNIX); srv.bind(sock); srv.listen(5)
threading.Thread(target=lambda: None).start()
def serve2():
    while True:
        c, _ = srv.accept(); buf = b''
        while not buf.endswith(b'\n'):
            x = c.recv(4096)
            if not x: break
            buf += x
        seen.append(json.loads(buf)); c.sendall(reply[0]); c.close()
threading.Thread(target=serve2, daemon=True).start()
env = dict(os.environ, **guest)
p = subprocess.Popen([path], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=env)
def rpc(m):
    p.stdin.write(json.dumps(m) + '\n'); p.stdin.flush()
    return json.loads(p.stdout.readline())
check('mcp: initialize', rpc({'jsonrpc': '2.0', 'id': 1, 'method': 'initialize', 'params': {'protocolVersion': '2025-03-26'}})['result']['serverInfo']['name'], 'kithpermit')
p.stdin.write(json.dumps({'jsonrpc': '2.0', 'method': 'notifications/initialized'}) + '\n'); p.stdin.flush()
check('mcp: four tools (request_secret with a token)', [t['name'] for t in rpc({'jsonrpc': '2.0', 'id': 2, 'method': 'tools/list'})['result']['tools']], ['approve', 'request_access', 'report_bug', 'request_secret'])
reply[0] = b'{"ok":true,"carded":true,"message":"Asked Kai. End your turn now."}\n'
r = rpc({'jsonrpc': '2.0', 'id': 5, 'method': 'tools/call', 'params': {'name': 'request_access', 'arguments': {'path': '/Users/x/Documents', 'reason': 'read the notes'}}})
check('request_access: the host message is the tool result', r['result']['content'][0]['text'], 'Asked Kai. End your turn now.')
check('request_access: sent kind, target, reason, write', {k: v for k, v in seen[-1].items() if k != 'token'}, {'method': 'requestAccess', 'kind': 'path', 'target': '/Users/x/Documents', 'reason': 'read the notes', 'write': False})
r = rpc({'jsonrpc': '2.0', 'id': 6, 'method': 'tools/call', 'params': {'name': 'request_access', 'arguments': {'domain': 'pypi.org', 'reason': 'pip', 'write': True}}})
check('request_access: a domain', (seen[-1]['kind'], seen[-1]['target']), ('domain', 'pypi.org'))
n = len(seen)
r = rpc({'jsonrpc': '2.0', 'id': 7, 'method': 'tools/call', 'params': {'name': 'request_access', 'arguments': {'path': '/a', 'domain': 'b.org', 'reason': 'x'}}})
check('request_access: both a path and a domain is not sent', (len(seen), 'Give either' in r['result']['content'][0]['text']), (n, True))
reply[0] = b'{"ok":false,"error":"That is a secret or a login."}\n'
r = rpc({'jsonrpc': '2.0', 'id': 8, 'method': 'tools/call', 'params': {'name': 'request_access', 'arguments': {'path': '/Users/x/.kith/secrets', 'reason': 'x'}}})
check('request_access: a refusal reaches the agent', r['result']['content'][0]['text'], 'That is a secret or a login.')
reply[0] = b'{"ok":true,"behavior":"allow"}\n'
r = rpc({'jsonrpc': '2.0', 'id': 3, 'method': 'tools/call', 'params': {'name': 'approve', 'arguments': {'tool_name': 'Bash', 'input': inp, 'tool_use_id': 'u1'}}})
check('mcp: tools/call returns the decision as JSON text', json.loads(r['result']['content'][0]['text']), {'behavior': 'allow', 'updatedInput': inp})
r = rpc({'jsonrpc': '2.0', 'id': 4, 'method': 'tools/call', 'params': {'name': 'approve', 'arguments': {'tool_name': 'Bash'}}})
check('mcp: malformed call is a deny', json.loads(r['result']['content'][0]['text'])['behavior'], 'deny')
p.stdin.close(); p.wait(5)
sys.exit(bad)
PY
python3 "$T/mcp_test.py" "$PERMIT" > "$T/mcp.out" 2>&1 || fail=1
cat "$T/mcp.out"

# --- a fake host: issueAskToken over HTTP -----------------------------------------------------------------------------
cat > "$T/host.py" <<'PY'
import json, http.server, sys
out, portfile = sys.argv[1], sys.argv[2]
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
        with open(out, 'a') as f: f.write(json.dumps({'path': self.path, 'auth': self.headers.get('Authorization'), 'body': body}) + '\n')
        r = json.dumps({'token': 'issued-tok', 'socket': '/tmp/fake.sock', 'env': {'KITH_ASK_TOKEN': 'issued-tok', 'KITH_ASK_SOCKET': '/tmp/fake.sock'}, 'expiresInS': 21600}).encode()
        self.send_response(200); self.send_header('Content-Length', str(len(r))); self.end_headers(); self.wfile.write(r)
    def log_message(self, *a): pass
s = http.server.HTTPServer(('127.0.0.1', 0), H)
open(portfile, 'w').write(str(s.server_port))
s.serve_forever()
PY
echo "serve-bearer" > "$T/serve/token"
python3 "$T/host.py" "$T/host.log" "$T/host.port" & PIDS+=($!); disown
for _ in $(seq 50); do [[ -s $T/host.port ]] && break; sleep 0.1; done
export KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=$(cat "$T/host.port")

stub() { sed -n "s/^$1=//p" "$STUB_OUT"; }
args() { sed -n 's/^ARG=//p' "$STUB_OUT"; }
run() { rm -f "$STUB_OUT"; (cd "$T/work" && "$KITH" echo "$@" 2>"$T/stderr"); }
FLAG="--permission-prompt-tool"

# owner, fresh: a token for the session id chosen now, bound to the run's own pid (exec keeps it)
: > "$T/host.log"
run "do it" >/dev/null
a=$(args)
has "owner -p: prompt tool flag" "$a" "$FLAG"$'\n'"mcp__kithpermit__approve"
has "owner -p: mcp config for the server, next to the existing one" "$a" '"kithpermit"'
has "owner -p: the existing MCP config stays" "$a" "--strict-mcp-config"
sid=$(printf '%s\n' "$a" | grep -A1 -x -- '--session-id' | tail -1)
[[ $sid =~ ^[0-9a-f-]{36}$ ]] && ok "owner fresh run: --session-id is a uuid" || bad "owner fresh run: --session-id" "$sid"
is "owner -p: ask token in claude's env" "$(stub ASK)" "issued-tok|/tmp/fake.sock"
h=$(tail -1 "$T/host.log")
is "issueAskToken: path" "$(echo "$h" | python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])')" "/api/issueAskToken"
is "issueAskToken: serve bearer token" "$(echo "$h" | python3 -c 'import json,sys; print(json.load(sys.stdin)["auth"])')" "Bearer serve-bearer"
is "issueAskToken: agent, session and the claude pid" "$(echo "$h" | python3 -c 'import json,sys; b=json.load(sys.stdin)["body"]; print(b["agent"], b["session"], b["pid"])')" "echo $sid $(stub PID)"

# owner, resuming: the session being resumed
: > "$T/host.log"
KITH_RESUME=abc-123 run "go on" >/dev/null
is "owner resume: the session is the one resumed" "$(tail -1 "$T/host.log" | python3 -c 'import json,sys; print(json.load(sys.stdin)["body"]["session"])')" "abc-123"
hasnt "owner resume: no new --session-id" "$(args)" "--session-id"
has "owner resume: prompt tool flag" "$(args)" "$FLAG"

# kernel launch with a KITH_CLAUDE_ARGS permission flag: ours stays
KITH_CLAUDE_ARGS="--permission-mode acceptEdits --output-format json" run "task" >/dev/null
has "KITH_CLAUDE_ARGS flags: prompt tool still added" "$(args)" "$FLAG"

# no host: the run goes on without a prompt tool, one stderr line
(export KITH_SERVE_PORT=1; run "no host" >/dev/null; rc=$?
 [[ $rc == 0 && -e $STUB_OUT ]] && echo "ran" > "$T/ran"
 echo "$(args)" > "$T/args.nohost")
is "no host: owner run still runs" "$(cat "$T/ran" 2>/dev/null)" ran
hasnt "no host: no prompt tool" "$(cat "$T/args.nohost")" "$FLAG"
has "no host: one stderr line" "$(cat "$T/stderr")" "no approval cards"
is "no host: just one line from kith-permit" "$(grep -c 'no approval cards' "$T/stderr")" 1

# the ask token the host launched an owner run with (channels/run.rs) is used as given: no second token
: > "$T/host.log"
KITH_ASK_TOKEN=host-tok KITH_ASK_SOCKET=/tmp/h.sock run "host launched" >/dev/null
is "owner with KITH_ASK_TOKEN from the host: no issueAskToken" "$(wc -l < "$T/host.log" | tr -d ' ')" 0
is "owner with KITH_ASK_TOKEN from the host: kept" "$(stub ASK)" "host-tok|/tmp/h.sock"
has "owner with KITH_ASK_TOKEN from the host: prompt tool flag" "$(args)" "$FLAG"

# a run kith ask started (KITH_LAUNCH_ASK_ID): its token carries that ask and who asked (the ask's registration)
box=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from kith_paths import paths; print(paths()["KITH_MACHINE"] / "live" / "ask")' "$KERNEL/lib")
mkdir -p "$box" && printf '{"agent":"architect"}' > "$box/ask-1.reg"
: > "$T/host.log"
KITH_LAUNCH_ASK_ID=ask-1 run "asked" >/dev/null
is "asked run: replyTo and askedBy sent" "$(tail -1 "$T/host.log" | python3 -c 'import json,sys; b=json.load(sys.stdin)["body"]; print(b.get("replyTo"), b.get("askedBy"))')" "ask-1 architect"
is "asked run: KITH_ASK_ID in claude's env (kith-permit's)" "$(stub ASKID)" "ask-1"
: > "$T/host.log"
KITH_LAUNCH_ASK_ID=ask-2 run "asked from a terminal" >/dev/null
is "asked from a terminal: askedBy empty" "$(tail -1 "$T/host.log" | python3 -c 'import json,sys; b=json.load(sys.stdin)["body"]; print(b.get("replyTo"), repr(b.get("askedBy")))')" "ask-2 ''"
: > "$T/host.log"
KITH_ASK_ID=ask-1 run "not asked" >/dev/null
is "an inherited KITH_ASK_ID is dropped: no replyTo" "$(tail -1 "$T/host.log" | python3 -c 'import json,sys; print(json.load(sys.stdin)["body"].get("replyTo"))')" "None"
is "an inherited KITH_ASK_ID is dropped: not in claude's env" "$(stub ASKID)" ""

# nested: a helper started by a run never inherits the parent's token; it gets its own
: > "$T/host.log"
KITH_AGENT=parent KITH_ASK_TOKEN=parent-tok KITH_ASK_SOCKET=/tmp/p.sock run "helper" >/dev/null
is "nested owner helper: parent's token not inherited" "$(stub ASK)" "issued-tok|/tmp/fake.sock"
is "nested owner helper: asked the host for its own" "$(wc -l < "$T/host.log" | tr -d ' ')" 1
(export KITH_SERVE_PORT=1; KITH_AGENT=parent KITH_ASK_TOKEN=parent-tok KITH_ASK_SOCKET=/tmp/p.sock run "helper" >/dev/null)
is "nested owner helper, no host: token stripped, none passed" "$(stub ASK)" "|"
hasnt "nested owner helper, no host: no prompt tool" "$(args)" "$FLAG"

# guests: the host's run token and socket are used; no token, no tool
"$KERNEL/bin/kith-auth" person guest name=Guest >/dev/null 2>&1
"$KERNEL/bin/kith-auth" member echo guest mode=default >/dev/null 2>&1
: > "$T/host.log"
KITH_PERSON=guest KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=/tmp/run.sock run "guest" >/dev/null
a=$(args)
has "guest -p: prompt tool flag" "$a" "$FLAG"$'\n'"mcp__kithpermit__approve"
is "guest -p: run token reaches claude" "$(stub RUN)" "run-tok|/tmp/run.sock"
is "guest -p: no issueAskToken (never widened)" "$(wc -l < "$T/host.log" | tr -d ' ')" 0
KITH_PERSON=guest run "guest no token" >/dev/null
hasnt "guest without a run token: no prompt tool" "$(args)" "$FLAG"
is "guest without a run token: no issueAskToken" "$(wc -l < "$T/host.log" | tr -d ' ')" 0
KITH_PERSON=guest KITH_AGENT=parent KITH_ASK_TOKEN=owner-tok KITH_ASK_SOCKET=/tmp/p.sock run "guest nested" >/dev/null
is "non-owner run: KITH_ASK_* stripped" "$(stub ASK)" "|"
hasnt "non-owner run without run token: no prompt tool" "$(args)" "$FLAG"
KITH_PERSON=guest KITH_ASK_TOKEN=owner-tok KITH_ASK_SOCKET=/tmp/p.sock KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=/tmp/run.sock run "guest with both" >/dev/null
is "non-owner run with both: only the run token left" "$(stub ASK)/$(stub RUN)" "|/run-tok|/tmp/run.sock"

# --- escape grants (F11 step 2b): a yes-once widens the next launch only ------------------------------------------------------
# A fake run socket answers consumeAccess from a file it deletes when it hands it out, like the host's compare-and-set.
GD=$(mktemp -d /tmp/kpg.XXXXXX)
cat > "$T/grants.py" <<'PY'
import json, os, socket, sys
sock, src, log = sys.argv[1:4]
srv = socket.socket(socket.AF_UNIX); srv.bind(sock); srv.listen(5)
while True:
    c, _ = srv.accept(); buf = b''
    while not buf.endswith(b'\n'):
        x = c.recv(4096)
        if not x: break
        buf += x
    req = json.loads(buf)
    open(log, 'a').write(json.dumps(req) + '\n')
    if req.get('method') == 'consumeAccess' and os.path.exists(src):
        out = {'ok': True, 'grants': json.load(open(src))}; os.remove(src)
    elif req.get('method') == 'consumeAccess':
        out = {'ok': True, 'grants': {'read': [], 'write': [], 'domains': []}}
    else:
        out = {'ok': False, 'error': 'no'}
    c.sendall(json.dumps(out).encode() + b'\n'); c.close()
PY
python3 "$T/grants.py" "$GD/g.sock" "$T/grants.json" "$T/grants.log" & PIDS+=($!); disown
for _ in $(seq 50); do [[ -S $GD/g.sock ]] && break; sleep 0.1; done
mkdir -p "$T/granted" "$T/granted-rw" "$T/work/.claude" "$KITH_STATE/secrets"
set_ok() { python3 -c '
import json,sys
s=json.load(open(sys.argv[1])); fs=s["sandbox"]["filesystem"]
print(eval(sys.argv[2]))' "$STUB_OUT.settings" "$1"; }
grun() { rm -f "$STUB_OUT.settings"; KITH_PERSON=guest KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=$GD/g.sock run "guest" >/dev/null 2>&1; }
grun
is "no grant: the folder is not readable" "$(set_ok "'$T/granted' in fs['allowRead']")" False
printf '{"read": ["%s"], "write": ["%s"], "domains": ["pypi.org", "*.evil.com"]}' "$T/granted" "$T/granted-rw" > "$T/grants.json"
grun
is "yes once: the next launch reads it" "$(set_ok "'$T/granted' in fs['allowRead'] and '$T/granted' in s['permissions']['additionalDirectories']")" True
is "yes once: a read-only grant is closed to Edit" "$(set_ok "'Edit(/$T/granted/**)' in s['permissions']['deny'] and '$T/granted' not in fs['allowWrite']")" True
is "yes once: a write grant is writable and readable" "$(set_ok "'$T/granted-rw' in fs['allowWrite'] and '$T/granted-rw' in fs['allowRead']")" True
is "yes once: rule W is denied below a granted folder" "$(set_ok "'$T/granted-rw/**/.claude' in fs['denyWrite'] and 'Edit(/$T/granted-rw/**/.claude/**)' in s['permissions']['deny']")" True
is "yes once: a domain goes to allowedDomains, a wildcard doesn't" "$(set_ok "s['sandbox']['network']['allowedDomains']")" "['pypi.org']"
is "yes once: allowUnsandboxedCommands stays off" "$(set_ok "s['sandbox']['allowUnsandboxedCommands']")" False
grun
is "the activation after: nothing, the grant was one use" "$(set_ok "'$T/granted' in fs['allowRead'] or 'allowedDomains' in s['sandbox']['network']")" False
printf '{"read": ["%s", "%s/x"], "write": ["%s", "%s"], "domains": []}' "$KITH_STATE/secrets" "$KITH_STATE/serve" "$T/work/.claude" "$HOME/.zshrc" > "$T/grants.json"
grun
is "build-time re-check: secrets and rule W are never added, whatever the host said" "$(set_ok "not any(x in fs['allowRead'] + fs['allowWrite'] for x in ['$KITH_STATE/secrets', '$KITH_STATE/serve', '$T/work/.claude', '$HOME/.zshrc'])")" True
# a folder that holds the secrets is refused too (a grant of $KITH_STATE would reach secrets/)
printf '{"read": ["%s"], "write": ["%s"], "domains": []}' "$KITH_STATE" "$KITH_STATE" > "$T/grants.json"
grun
is "build-time re-check: a folder that holds the secrets is never added" "$(set_ok "'$KITH_STATE' not in fs['allowRead'] + fs['allowWrite']")" True
# the shared layout (no ~/.kith, KITH_STATE unset): the secrets folder is ~/.config/kith itself, all of it
mkdir -p "$HOME/.config/kith"
printf '{"read": ["%s", "%s/x", "%s", "%s"], "write": ["%s"], "domains": []}' "$HOME/.config/kith" "$HOME/.config/kith" "$HOME/.config" "$HOME" "$HOME/.config/kith" > "$T/grants.json"
mkdir -p "$KITH_HOME/kernel"   # the Kith folder around a kernel/: the link layout, so the machine folder is ~/.config/kith
(unset KITH_STATE HQ_STATE; grun)
is "shared layout: the whole config folder, below it and the folders above it are never added" "$(set_ok "not any(x in fs['allowRead'] + fs['allowWrite'] for x in ['$HOME/.config/kith', '$HOME/.config/kith/x', '$HOME/.config', '$HOME'])")" True
ln -sfn "$T/granted" "$T/moved"; printf '{"read": ["%s"], "write": [], "domains": []}' "$T/moved" > "$T/grants.json"
grun
is "build-time re-check: a grant that is a link now (it resolves elsewhere) is dropped" "$(set_ok "'$T/moved' not in fs['allowRead'] and '$T/granted' not in fs['allowRead']")" True
# The host's launch (--launch-json, an app chat's run) is the same activation: the grant is in the settings it is handed.
lj() { (cd "$T/work" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
s=json.load(sys.stdin)["settings"]; fs=s.get("sandbox", {}).get("filesystem", {})
print(eval(sys.argv[1]))' "$1"; }
printf '{"read": ["%s"], "write": [], "domains": ["pypi.org"]}' "$T/granted" > "$T/grants.json"
is "launch-json: a yes once is in the settings the host gets" "$(KITH_PERSON=guest KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=$GD/g.sock lj "'$T/granted' in fs['allowRead'] and '$T/granted' in s['permissions']['additionalDirectories'] and s['sandbox']['network']['allowedDomains'] == ['pypi.org']")" True
is "launch-json: the launch after has nothing, the grant was one use" "$(KITH_PERSON=guest KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=$GD/g.sock lj "'$T/granted' in fs['allowRead'] or 'allowedDomains' in s['sandbox']['network']")" False
printf '{"read": ["%s"], "write": [], "domains": []}' "$T/granted" > "$T/grants.json"
is "launch-json: no run token, nothing asked or added" "$(KITH_PERSON=guest lj "'$T/granted' in fs['allowRead']")/$([[ -f $T/grants.json ]] && echo kept)" False/kept
: > "$T/grants.log"; KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=$GD/g.sock lj True >/dev/null
is "launch-json: an owner launch asks nothing" "$(wc -c < "$T/grants.log" | tr -d ' ')" 0
rm -f "$T/grants.json"
: > "$T/grants.log"; KITH_PERSON=guest run "no token" >/dev/null 2>&1
is "a guest launch with no run token asks nothing" "$(wc -c < "$T/grants.log" | tr -d ' ')" 0
run "owner" >/dev/null 2>&1
is "an owner launch asks nothing" "$(grep -c consumeAccess "$T/grants.log")" 0
KITH_PERSON=guest KITH_RUN_TOKEN=run-tok KITH_RUN_SOCKET=$GD/g.sock run guest >/dev/null 2>&1
has "the guest may always ask: request_access is in the allowed tools" "$(args)" "mcp__kithpermit__request_access"
rm -rf "$GD"
exit $fail
