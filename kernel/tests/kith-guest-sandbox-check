#!/usr/bin/env bash
# kith-guest-sandbox-check — every run for anyone but the owner (an invited person, a bot) carries Claude Code's OS
# sandbox in its generated settings: enabled, fail closed, no escape hatch, no excluded commands, the credential folders
# (both spellings) and the membership's Read denials unreadable, only the run's own folders writable, no network but the
# host socket. The owner's settings carry no "sandbox" key at all. Inspects the JSON of `--launch-json`; no real claude,
# so it runs on Linux CI. Throwaway HOME and KITH_HOME; fake `claude` on PATH.
#
#   kernel/tests/kith-guest-sandbox-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
[ "${KITH_REAL_SANDBOX:-}" = 1 ] && TMPDIR=/tmp   # unix socket paths are short
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-guest-sandbox-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
REAL_HOME=$HOME
export HOME=$T/home KITH_HOME="$T/real root" KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME KITH_SERVE_HOME KITH_RUN_TOKEN KITH_RUN_SOCKET
mkdir -p "$HOME" "$KITH_HOME/agents/echo/role" "$KITH_HOME/agents/other/role" "$T/bin" "$T/real state/projects" "$T/real state/logs"
ln -s "$T/real state" "$T/linked state"   # the state folder as a link, with a space in the target
export KITH_STATE="$T/linked state"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$KITH_HOME/agents/echo/role/agent.md"
printf -- '---\nname: other\ndescription: another agent\n---\nYou other.\n' > "$KITH_HOME/agents/other/role/agent.md"
printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.309 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"; chmod +x "$T/bin/claude"
# A guest run refuses to start without a kith program that answers `memory hook` (fail closed, no unchecked memory writes);
# CI has no host build, so a stub stands in for it (macOS dev machines pass without one only because a real kith is installed).
printf '#!/bin/sh\n[ "$1 $2 $3" = "memory hook --help" ] && echo "usage: kith memory hook <phase>"\nexit 0\n' > "$T/bin/kith-stub"; chmod +x "$T/bin/kith-stub"
export KITH_BIN=$T/bin/kith-stub
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
AUTH=$KERNEL/bin/kith-auth
fails=0
expect() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got $2, want $3)"; fails=$((fails + 1)); fi; }

"$AUTH" person guest name=Guest >/dev/null 2>&1
"$AUTH" member echo guest mode=default 'deny=Read(//data/private/**),Read(//data/notes/*.md),Read(//data/exact.txt)' >/dev/null 2>&1
"$AUTH" bot bot-3f9a1c2e --of guest name=Bot >/dev/null 2>&1
"$AUTH" member echo bot-3f9a1c2e mode=default >/dev/null 2>&1

# settings: the generated settings of a run, as JSON ({} when the run does not start).
settings() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
json.dump(s,sys.stdout,sort_keys=True)'; }
# q: a python expression over the settings s (the sandbox block sb).
q() { SJ=$1 python3 -c '
import json,os,sys
s=json.loads(os.environ["SJ"]); sb=s.get("sandbox",{})
fs=sb.get("filesystem",{}); dr=fs.get("denyRead",[]); aw=fs.get("allowWrite",[])
print(eval(sys.argv[1]))' "$2"; }

OWNER=$(settings)
mcp_servers() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
print(sorted(json.load(sys.stdin).get("mcp_servers",{})))'; }
expect "guest: kith-permit is the only MCP server" "$(KITH_PERSON=guest mcp_servers)" "['kithpermit']"
expect "bot guest: kith-permit is the only MCP server" "$(KITH_PERSON=bot-3f9a1c2e mcp_servers)" "['kithpermit']"
expect "owner: MCP servers unchanged (no kith-permit forced)" "$(mcp_servers)" "[]"
expect "owner: no rule W denyWrite, no Edit deny on the home shell files" "$(q "$OWNER" "not any('.zshrc' in r for r in s['permissions']['deny'])")" True
expect "owner: no sandbox key" "$(q "$OWNER" '"sandbox" in s')" False
expect "owner: settings not empty" "$(q "$OWNER" 'bool(s.get("permissions"))')" True

# The Artifact tools are off under the SDK and -p unless CLAUDE_CODE_ARTIFACT=1: every Claude launch carries it, guests' included (they publish to the owner's account).
launch_env() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
print(json.load(sys.stdin).get("env",{}).get("CLAUDE_CODE_ARTIFACT","unset"))'; }
expect "owner: launch env enables the Artifact tools" "$(launch_env)" 1
expect "owner: no Bash hook that allows" "$(q "$OWNER" "any(h.get('matcher') == 'Bash' for h in s.get('hooks', {}).get('PreToolUse', []))")" False
lj() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c "import json,sys; j=json.load(sys.stdin); e=j.get('env',{}); print($1)"; }
WORKVARS="('TMPDIR','XDG_CACHE_HOME','UV_CACHE_DIR','npm_config_cache','PUPPETEER_CACHE_DIR','NODE_USE_ENV_PROXY')"
expect "owner: no workspace env, no limits note" "$(lj "[k for k in $WORKVARS + ('CLAUDE_CODE_TMPDIR','KITH_WORK','CLAUDE_ENV_FILE') if k in e], '<limits>' in j['system_prompt']")" "[] False"
# The guest writes its workspace, so only its sandboxed shell is pointed there (CLAUDE_ENV_FILE): Claude Code, its hooks
# and MCP servers (kith-auth exec passes its environment on) run outside the box, and would run an npx package or a
# Chrome planted in it. The launch env names the workspace once, as KITH_WORK, which only lib/guest-env.sh reads.
expect "guest: the launch env points its shell at the workspace and sets none of it for the run" "$(KITH_PERSON=guest lj "[k for k in $WORKVARS if k in e], e.get('KITH_WORK','').endswith('/people/guest/.work'), e.get('CLAUDE_ENV_FILE','').endswith('/lib/guest-env.sh')")" "[] True True"
expect "guest: nothing in the launch env but KITH_WORK is inside their folder" "$(KITH_PERSON=guest lj "sorted(k for k, v in e.items() if '/people/guest' in str(v))")" "['KITH_WORK']"
expect "guest: CLAUDE_ENV_FILE gives their shell the workspace" "$(KITH_WORK=/w sh -c '. "$1"; echo "$TMPDIR $XDG_CACHE_HOME $UV_CACHE_DIR $npm_config_cache $PUPPETEER_CACHE_DIR $NODE_USE_ENV_PROXY"' _ "$KERNEL/lib/guest-env.sh")" "/w/tmp /w/cache /w/cache/uv /w/cache/npm /w/cache/puppeteer 1"
expect "owner: CLAUDE_ENV_FILE changes nothing without KITH_WORK" "$(env -u KITH_WORK TMPDIR=/t sh -c '. "$1"; echo "$TMPDIR ${npm_config_cache:-unset}"' _ "$KERNEL/lib/guest-env.sh")" "/t unset"
expect "guest: guest-env.sh sets exactly the workspace vars kith_paths.py names" "$(env -i KITH_WORK=/w /bin/sh -c '. "$1"; env' _ "$KERNEL/lib/guest-env.sh" | python3 -c "
import sys; sys.path.insert(0, '$KERNEL/lib'); from kith_paths import GUEST_WORK_VARS
names = set(l.split('=', 1)[0] for l in sys.stdin.read().splitlines()) - set(['KITH_WORK', 'PWD', 'SHLVL', '_'])
print(names == set(GUEST_WORK_VARS))")" True
# A guest's MCP server starts through kith-auth exec, outside their sandbox: no variable that leads into a folder they
# write reaches it (by value, each entry of a list too), and it doesn't start in one of those folders.
mkdir -p "$KITH_HOME/agents/echo/role/services" "$KITH_HOME/agents/echo/files/people/guest/proj"
printf '{"kind": "mcp", "secrets": [], "mcp": {"command": "env"}}\n' > "$KITH_HOME/agents/echo/role/services/envsvc.json"
python3 -c 'import json,sys; a=json.load(open(sys.argv[1])); a["profiles"]["envsvc/t"]={}; json.dump(a,open(sys.argv[1],"w"))' "$KITH_AUTH"
"$AUTH" grant echo@guest envsvc envsvc/t >/dev/null 2>&1; "$AUTH" grant echo envsvc envsvc/t >/dev/null 2>&1
GW=$KITH_HOME/agents/echo/files/people/guest/.work
exec_env() { (cd "$KITH_HOME/agents/echo/files/people/guest/proj" && env "$@" TMPDIR="$GW/tmp" XDG_CACHE_HOME="$GW/cache" UV_CACHE_DIR="$GW/cache/uv" \
  npm_config_cache="$GW/cache/npm" PUPPETEER_CACHE_DIR="$GW/cache/puppeteer" KEEP_ME=/usr/lib LIST_VAR="/usr/bin:$GW/bin" \
  "$AUTH" exec --for echo envsvc -- env) | python3 -c '
import sys; e = dict(l.split("=", 1) for l in sys.stdin.read().splitlines() if "=" in l)
print([k for k in ("TMPDIR", "XDG_CACHE_HOME", "UV_CACHE_DIR", "npm_config_cache", "PUPPETEER_CACHE_DIR", "LIST_VAR") if k in e], e.get("KEEP_ME"), "/people/" in e.get("PWD", ""))'; }
expect "guest: kith-auth exec passes no path into their folders and leaves them as its working folder" "$(exec_env KITH_PERSON=guest)" "[] /usr/lib False"
expect "owner: kith-auth exec passes its environment on as before" "$(exec_env -u KITH_PERSON)" "['TMPDIR', 'XDG_CACHE_HOME', 'UV_CACHE_DIR', 'npm_config_cache', 'PUPPETEER_CACHE_DIR', 'LIST_VAR'] /usr/lib True"
expect "guest: told its limits at launch" "$(KITH_PERSON=guest lj "all(x in j['system_prompt'] for x in ('<limits>', 'request_access', 'ask_helper', '/people/guest'))")" True
# Claude Code keeps its own temp folder only when <dir>/claude-<uid> fits in 44 bytes; this test's folders are longer, so
# the run gets none (never /tmp) and its limits note says why.
expect "guest, Kith folder too long for Claude Code's temp: no CLAUDE_CODE_TMPDIR, said in the note" "$(KITH_PERSON=guest lj "'CLAUDE_CODE_TMPDIR' in e, 'fit in 44 bytes' in j['system_prompt']")" "False True"
expect "guest: launch env enables the Artifact tools" "$(KITH_PERSON=guest launch_env)" 1
expect "bot guest: launch env enables the Artifact tools" "$(KITH_PERSON=bot-3f9a1c2e launch_env)" 1

for who in guest bot-3f9a1c2e; do
  S=$(KITH_PERSON=$who settings)
  expect "$who: sandbox on, fail closed, no escape hatch" "$(q "$S" '(sb.get("enabled"), sb.get("failIfUnavailable"), sb.get("allowUnsandboxedCommands"))')" "(True, True, False)"
  expect "$who: no excluded commands" "$(q "$S" '"excludedCommands" in sb')" False
  expect "$who: no network but the fixed host socket (both spellings), even with no KITH_RUN_SOCKET" "$(q "$S" "sb['network']['allowUnixSockets'] == ['$T/linked state/run/host.sock', '$T/real state/run/host.sock']")" True
  expect "$who: no local servers (a stray one could take the host's port), no domains beyond the allowlist" "$(q "$S" '(sb["network"].get("allowLocalBinding"), "allowedDomains" in sb["network"])')" "(None, False)"
  W=$KITH_HOME/agents/echo/files/people/$who/.work
  expect "$who: the workspace is writable, given to the shell only" "$(q "$S" "'$W' in aw and s['env'].get('KITH_WORK') == '$W' and s['env'].get('CLAUDE_ENV_FILE','').endswith('/lib/guest-env.sh')")" True
  expect "$who: the settings env (Claude Code, hooks, MCP servers) holds no workspace var and no path inside their folder but KITH_WORK" "$(q "$S" "[k for k in $WORKVARS if k in s['env']], sorted(k for k, v in s['env'].items() if '/people/$who' in str(v))")" "([], ['KITH_WORK'])"
  expect "$who: nothing of <machine>/run is readable or writable but its socket" "$(q "$S" "not any('/run/t' in a or a.rstrip('/').endswith('/run') for a in aw + fs['allowRead'])")" True
  expect "$who: shell commands in the sandbox run without asking (a PreToolUse Bash hook allows)" "$(q "$S" "any(h.get('matcher') == 'Bash' and 'allow' in h['hooks'][0]['command'] for h in s['hooks']['PreToolUse'])")" True
  for root in "$T/linked state" "$T/real state"; do
    for f in index serve secrets browsers bridge room-ledger; do
      expect "$who: denyRead $root/$f" "$(q "$S" "'$root/$f' in dr")" True
    done
    expect "$who: the memory approval key is unreadable ($root)" "$(q "$S" "any('$root/secrets/memory-approvals.key'.startswith(d.rstrip('/') + '/') for d in dr if d != '/') and any(r.startswith('Read(') and r.endswith('secrets/**)') for r in s['permissions']['deny'])")" True
  done
  expect "$who: denyRead the other agent's folder (both spellings)" "$(q "$S" "'$KITH_HOME/agents/other' in dr")" True
  expect "$who: denyRead the owner user.md" "$(q "$S" "'$T/linked state/user.md' in dr and '$T/real state/user.md' in dr")" True
  expect "$who: allowWrite is the run's own folders, not the state root" "$(q "$S" "'$T/real state' not in aw and '$T/linked state' not in aw and any('/memory/' in a for a in aw)")" True
  expect "$who: reads are deny-by-default (denyRead /), with a narrow allowlist; never the home folder or ~/Library" "$(q "$S" "'/' in dr and len(fs['allowRead']) > 0 and '/' not in fs['allowRead'] and not any(a == '$HOME' or a == '$HOME/Library' or 'Keychains' in a for a in fs['allowRead'])")" True
  expect "$who: allowRead has the system folders and nothing of the owner's home but the dev tools" "$(q "$S" "all(x in fs['allowRead'] for x in ['/usr', '/bin', '/System', '/Library', '/private/etc', '/dev', '/opt/homebrew'])")" True
  expect "$who: allowRead has the kernel, the run's own memory and the working directory" "$(q "$S" "all(any(a == x for a in fs['allowRead']) for x in ['$KERNEL', '$KITH_HOME/agents/echo/memory/shared'])")" True
  expect "$who: the file tools are limited to the working directories" "$(q "$S" 's["permissions"].get("blockReadsOutsideWorkingDirectories")')" True
  expect "$who: the denies stay on top of the allowlist (index not allowed)" "$(q "$S" "not any(a == '$T/real state/index' or a == '$T/real state' for a in fs['allowRead'])")" True
  expect "$who: global config of the owner is not read" "$(q "$S" 's["env"]["GIT_CONFIG_GLOBAL"]')" /dev/null
  expect "$who: the link to the state folder is itself readable" "$(q "$S" "'$T/linked state' in fs['allowRead']")" True
  expect "$who: the owner's uv caches are not readable, its own one (in the workspace) is" "$(q "$S" "not any(a in fs['allowRead'] for a in ['$HOME/.cache/uv', '$HOME/Library/Caches/uv']) and s['env']['KITH_WORK'] in fs['allowRead']")" True
  expect "$who: rule W: denyWrite has the run-later paths at any depth, by both spellings, and the secrets" "$(q "$S" "all(x in fs['denyWrite'] for x in ['$KITH_HOME/agents/echo/files/people/$who/.git/hooks', '$KITH_HOME/agents/echo/files/people/$who/**/.git/hooks', '$KITH_HOME/agents/echo/files/people/$who/**/.git/hooks/**', '$KITH_HOME/agents/echo/files/people/$who/CLAUDE.md', '$KITH_HOME/agents/echo/files/people/$who/**/.claude', '$HOME/.zshrc', '$HOME/Library/LaunchAgents', '$HOME/.local/bin', '/opt/homebrew', '$T/real state/secrets', '$T/real state/serve'])")" True
  expect "$who: denyWrite never covers a folder the run writes in" "$(q "$S" "not any(w == a or a.startswith(w + '/') for w in fs['denyWrite'] for a in aw)")" True
  expect "$who: the file tools get the same list as Edit denies (deny beats allow), and the read-only folders are closed to Edit" "$(q "$S" "all(any(r == x for r in s['permissions']['deny']) for x in ['Edit(/$KITH_HOME/agents/echo/files/people/$who/**/.git/hooks/**)', 'Edit(/$KITH_HOME/agents/echo/files/people/$who/CLAUDE.md)', 'Edit(/$HOME/.zshrc)', 'Edit(/$KERNEL/**)', 'Edit(/$KITH_STATE/people/**)'])")" True
  expect "$who: the Read/Edit deny rules stay" "$(q "$S" 'any(r.startswith("Read(") for r in s["permissions"]["deny"])')" True
done

# the host socket: allowed when the run has one, and the names pass through the launch JSON env
SOCK=$T/real\ state/run/host.sock
S=$(KITH_PERSON=guest KITH_RUN_SOCKET=$SOCK KITH_RUN_TOKEN=tok settings)
expect "guest with the contract socket: no extra entry" "$(q "$S" "len(sb['network']['allowUnixSockets']) == 2 and '$SOCK' in sb['network']['allowUnixSockets']")" True
S2=$(KITH_PERSON=guest KITH_RUN_SOCKET=$T/elsewhere.sock settings)
expect "a KITH_RUN_SOCKET that differs is allowed too" "$(q "$S2" "'$T/elsewhere.sock' in sb['network']['allowUnixSockets'] and len(sb['network']['allowUnixSockets']) == 3")" True
expect "guest with a socket: the socket's folder is not denied" "$(q "$S" "not any('$SOCK'.startswith(d + '/') or '$SOCK' == d for d in dr)")" True
# globs in the membership Read rules deny the parent folder
S=$(KITH_PERSON=guest settings)
expect "glob rules: dir/** and dir/*.md deny the folder, an exact file denies itself" "$(q "$S" "all(x in dr for x in ['/data/private', '/data/notes', '/data/exact.txt'])")" True
ENVJ=$(cd "$KITH_HOME/agents/echo" && KITH_PERSON=guest KITH_RUN_SOCKET=$SOCK KITH_RUN_TOKEN=tok "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; e=json.load(sys.stdin)["env"]; print(e.get("KITH_RUN_SOCKET")=="'"$SOCK"'", e.get("KITH_RUN_TOKEN")=="tok")')
expect "launch JSON env carries KITH_RUN_SOCKET and KITH_RUN_TOKEN" "$ENVJ" "True True"
OWNER2=$(cd "$KITH_HOME/agents/echo" && KITH_RUN_SOCKET=$SOCK "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; s=json.load(sys.stdin)["settings"]; print("sandbox" in s)')
expect "owner with a socket set: still no sandbox" "$OWNER2" False

# The shared layout (no ~/.kith; the Kith folder around a kernel/): the secrets are two files among the machine things in
# ~/.config/kith, and the sandbox denies both there as well as the named folders.
mkdir -p "$KITH_HOME/kernel" "$HOME/.config/kith"
S=$(unset KITH_STATE HQ_STATE; KITH_PERSON=guest settings)
expect "shared layout: guest denyRead holds env and auth.json of ~/.config/kith" "$(q "$S" "'$HOME/.config/kith/env' in dr and '$HOME/.config/kith/auth.json' in dr")" True
rmdir "$KITH_HOME/kernel" 2>/dev/null

# KITH_SERVE_HOME elsewhere is denied too
mkdir -p "$T/elsewhere"
S=$(KITH_PERSON=guest KITH_SERVE_HOME=$T/elsewhere settings)
expect "KITH_SERVE_HOME: denied" "$(q "$S" "'$T/elsewhere' in dr")" True

# Architect review hardening (all for non-owner runs; the owner's settings stay as they were)
S=$(KITH_PERSON=guest settings)
for r in "$KITH_HOME" "$KITH_HOME/agents"; do
  expect "guest: denyRead $r (the repo and the agents folder, dotfiles included)" "$(q "$S" "'$r' in dr")" True
done
expect "guest: the agents .git is not in allowRead" "$(q "$S" "not any(a == '$KITH_HOME/agents/.git' or '$KITH_HOME/agents/.git'.startswith(a + '/') for a in fs['allowRead'])")" True
expect "guest: Edit denied on the kernel, the pinned package, the live role and the people files" "$(q "$S" "all(any(r == 'Edit(/%s/**)' % x for r in s['permissions']['deny']) for x in ['$KERNEL', '$KITH_HOME/agents/echo/role', '$KITH_STATE/people'])")" True
expect "guest: no write to skills/learned or the shared project files" "$(q "$S" "not any('skills/learned' in a or '/projects' in a for a in aw) and not any('skills/learned' in r or '/projects' in r for r in s['permissions']['allow'])")" True
expect "guest: own uv cache writable (in the workspace); the shared one is not" "$(q "$S" "s['env'].get('KITH_WORK','').endswith('/files/people/guest/.work') and s['env']['KITH_WORK'] in aw and not any(a.endswith('/.cache/uv') for a in aw)")" True
OWNER=$(settings)
expect "owner: skills/learned and the project files are writable, no uv cache of its own" "$(q "$OWNER" "any('skills/learned' in r for r in s['permissions']['allow']) and any('/projects/**' in r for r in s['permissions']['allow']) and not set(['UV_CACHE_DIR', 'KITH_WORK', 'CLAUDE_ENV_FILE']) & set(s.get('env', {}))")" True
expect "owner: no Edit deny on the kernel" "$(q "$OWNER" "not any(r == 'Edit(/%s/**)' % '$KERNEL' for r in s['permissions']['deny'])")" True
# the working directory: the home folder or a parent of a folder the run gets moves to the person's files folder
CWDJ=$(cd "$HOME" && KITH_PERSON=guest "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["cwd"])')
expect "guest started from the home folder works in their files folder" "$CWDJ" "$KITH_HOME/agents/echo/files/people/guest"
CWDJ=$(cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["cwd"])')
expect "owner keeps its working directory" "$CWDJ" "$KITH_HOME/agents/echo"
# KITH_RESUME: only a session the ledger has as theirs
# (a plain run, not --launch-json, which hands resuming to the host): a stub claude that logs its arguments
printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.309 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\ncase "$*" in *--append-system-prompt*) echo "$*" > "$ARGS_LOG";; esac\nexit 0\n' > "$T/bin/claude"
rargs() { rm -f "$T/args"; (cd "$KITH_HOME/agents/echo" && ARGS_LOG=$T/args KITH_RESUME=$2 KITH_PERSON=$1 "$KITH" echo "hi" 2>"$T/err" >/dev/null); [ -f "$T/args" ] && { case $(cat "$T/args") in *" --resume $2"*) echo True;; *) echo False;; esac; } || echo norun; }
expect "guest: KITH_RESUME of a session not in the ledger starts fresh" "$(rargs guest abc-123)" False
expect "guest: ... with a note on stderr" "$(grep -c 'starting a new one' "$T/err")" 1
mkdir -p "$T/ledger"; python3 -c '
import sqlite3, sys
c = sqlite3.connect(sys.argv[1] + "/cost.db")
c.execute("create table if not exists runs (session text primary key, agent text, version text, model text, effort text, via text, project text, started text, person text, provider text, account text)")
c.execute("insert or replace into runs (session, agent, person) values (?,?,?)", ("mine-1", "echo", "guest"))
c.execute("insert or replace into runs (session, agent, person) values (?,?,?)", ("theirs-1", "echo", "evil"))
c.commit()' "$(python3 "$KERNEL/lib/kith_paths.py" --sh | sed -n "s/^export KITH_MACHINE=//p" | tr -d "'")"
expect "guest: KITH_RESUME of their own session in the ledger is kept" "$(rargs guest mine-1)" True
expect "guest: KITH_RESUME of another person's session starts fresh" "$(rargs guest theirs-1)" False
# the memory hook of a guest fails closed: a hook that can't run denies the write
HOOK=$(cd "$KITH_HOME/agents/echo" && KITH_PERSON=guest "$KITH" echo --launch-json 2>/dev/null | python3 -c '
import json,sys
s=json.load(sys.stdin)["settings"]
print([h["hooks"][0]["command"] for h in s["hooks"].get("PreToolUse", [])][0])')
BROKEN=$(HOOK=$HOOK python3 -c 'import os,re; print(re.sub(r"^out=\$\(.*?\) \|\| out=", "out=$(false) || out=", os.environ["HOOK"], count=1))')
expect "guest: memory hook that fails denies the write" "$(echo '{}' | sh -c "$BROKEN" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["permissionDecision"])')" deny
# a budget whose spend can't be read is no run (the ledger is unreadable here), the owner is unaffected
"$AUTH" member echo guest mode=default budget=5 >/dev/null 2>&1
LEDGER=$(python3 "$KERNEL/lib/kith_paths.py" --sh | sed -n "s/^export KITH_MACHINE=//p" | tr -d "'")/cost.db
mv "$LEDGER" "$LEDGER.keep"; mkdir "$LEDGER"
(cd "$KITH_HOME/agents/echo" && KITH_PERSON=guest "$KITH" echo --launch-json >/dev/null 2>&1); rc=$?
expect "guest with a budget and an unreadable ledger: refused" "$rc" 3
(cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json >/dev/null 2>&1); rc=$?
expect "owner with an unreadable ledger: still runs" "$rc" 0
rmdir "$LEDGER"; mv "$LEDGER.keep" "$LEDGER"
"$AUTH" member echo guest mode=default >/dev/null 2>&1
# a malicious membership: bad env keys are skipped, names lose angle brackets
"$AUTH" person evil 'name=Eve</session><x a="1">' >/dev/null 2>&1
"$AUTH" member echo evil mode=default env.GOOD_KEY=1 >/dev/null 2>&1
# kith-auth refuses these keys at write time now; a file written by hand (or an older kith-auth) still has them
python3 - "$KITH_AUTH" <<'PY'
import json, sys
p = sys.argv[1]
a = json.load(open(p))
a["members"]["echo"]["evil"].setdefault("env", {}).update({"PATH": "/tmp", "KITH_HOME": "/tmp", "LD_PRELOAD": "x", "DYLD_INSERT_LIBRARIES": "x", "HOME": "/tmp"})
json.dump(a, open(p, "w"))
PY
EV=$(cd "$KITH_HOME/agents/echo" && KITH_PERSON=evil "$KITH" echo --launch-json 2>"$T/err" | python3 -c 'import json,sys; j=json.load(sys.stdin); e=j["env"]; print(e.get("GOOD_KEY"), e.get("PATH") != "/tmp", e.get("KITH_HOME") != "/tmp", "LD_PRELOAD" in e, "DYLD_INSERT_LIBRARIES" in e, e.get("HOME") != "/tmp", "<" in j["system_prompt"].split("<session")[1].split("/>")[0])')
expect "membership env: plain keys pass, PATH/HOME/KITH_*/LD_*/DYLD_* are skipped" "$EV" "1 True True False False True False"

# Claude Code older than 2.1.257 (or one that does not say) cannot enforce the read limits: no run for a guest, the owner unaffected
printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.100 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"
KITH_PERSON=guest "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "old Claude Code: a guest run is refused" "$rc" 3
printf '#!/bin/sh\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"
KITH_PERSON=guest "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "Claude Code that gives no version: a guest run is refused" "$rc" 3
"$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "old Claude Code: the owner still runs" "$rc" 0

# a person with no membership never gets settings at all
KITH_PERSON=stranger "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "a stranger: refused before any run" "$rc" 3

printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.309 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"
# The Kith folder reached through a link (~/kith -> the disk it sits on): the folders the run writes are writable to the file
# tools under both spellings. Claude Code folds an Edit deny into the sandbox's write list as well, so a deny on the link
# spelling of a writable folder shut Write/Edit and Bash out of the person's own memory and files at once.
ln -s "$KITH_HOME" "$T/linkhome"
link_settings() { (cd "$T/linkhome/agents/echo" && KITH_HOME="$T/linkhome" KITH_PERSON=$1 "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
json.dump(s,sys.stdout,sort_keys=True)'; }
for who in guest bot-3f9a1c2e; do
  S=$(link_settings $who)
  expect "$who, home through a link: nothing Edit-denied holds a folder the run may write (either spelling)" "$(SJ=$S python3 -c '
import json, os
s = json.loads(os.environ["SJ"])
real = os.path.realpath
def path(r):   # Edit(//abs/**) -> /abs
    return r[len("Edit("):-1][1:]
allow = [path(r)[:-3] for r in s["permissions"]["allow"] if r.startswith("Edit(") and r.endswith("/**)")]
deny = [path(r)[:-3] for r in s["permissions"]["deny"] if r.startswith("Edit(") and r.endswith("/**)") and "*" not in path(r)[:-3]]
aw = s["sandbox"]["filesystem"]["allowWrite"]
bad = [(d, a) for d in deny for a in allow + aw if real(a) == real(d) or real(a).startswith(real(d) + "/")]
print(len(allow) >= 4 and not bad or bad[:2])')" True
  expect "$who, home through a link: the slice and the shared memory are Edit-allowed under the link spelling" "$(q "$S" "all('Edit(/$T/linkhome/agents/echo/%s/**)' % x in s['permissions']['allow'] for x in ['files/people/$who', 'memory/shared'])")" True
  expect "$who, home through a link: rule W and the read-only folders stay denied" "$(q "$S" "all(any(r == x for r in s['permissions']['deny']) for x in ['Edit(/$T/linkhome/agents/echo/files/people/$who/**/.git/hooks/**)', 'Edit(/$KERNEL/**)', 'Edit(/$KITH_STATE/people/**)', 'Edit(/$KITH_HOME/agents/echo/role/**)'])")" True
  expect "$who, home through a link: the other agent's folder is denied under both spellings" "$(q "$S" "all('Read(/%s/agents/other/**)' % r in s['permissions']['deny'] for r in ['$T/linkhome', '$KITH_HOME'])")" True
done
# The run's outbox (KITH_RUN_OUTBOX): a guest writes and reads its own folder of <machine>/outbox and nothing else there.
mkdir -p "$KITH_STATE/outbox/r1" "$T/elsewhere"
BOX="$T/real state/outbox/r1"
S=$(KITH_PERSON=guest KITH_RUN_OUTBOX="$KITH_STATE/outbox/r1" settings)
expect "guest: its own outbox is writable and readable" "$(q "$S" "'$BOX' in aw and '$BOX' in fs['allowRead']")" True
expect "guest: nothing else in the outbox folder is" "$(q "$S" "not any(p.rstrip('/').endswith(' state/outbox') for p in aw + fs['allowRead'])")" True
for bad in "$KITH_STATE/outbox" "$T/elsewhere" "$KITH_STATE/outbox/r1/.."; do
  S=$(KITH_PERSON=guest KITH_RUN_OUTBOX="$bad" settings)
  expect "guest: KITH_RUN_OUTBOX=${bad#"$T/"} opens nothing" "$(q "$S" "not any(p.startswith(('$T/real state/outbox', '$T/linked state/outbox', '$T/elsewhere')) for p in aw + fs['allowRead'])")" True
done
expect "owner: no sandbox for the outbox either" "$(q "$(KITH_RUN_OUTBOX="$KITH_STATE/outbox/r1" settings)" '"sandbox" in s')" False
ALLOWED=$(cd "$KITH_HOME/agents/echo" && KITH_PERSON=guest "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print("mcp__kithpermit__ask_helper" in json.load(sys.stdin).get("allowed_tools",""))')
expect "guest: the launch's allowed tools carry mcp__kithpermit__ask_helper" "$ALLOWED" True
OWNER_ALLOWED=$(cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; print("mcp__kithpermit__ask_helper" in json.load(sys.stdin).get("allowed_tools",""))')
expect "owner: no ask_helper tool, nothing new" "$OWNER_ALLOWED" False

# Claude Code's temp folder, with a machine folder short enough for it: <machine>/run/t/<id> (an 8-hex hash for a long id),
# 0700 and theirs alone; a revoke, a removal or --clear-temp deletes it, and one recorded as someone else's is emptied first.
ST=$(mktemp -d /tmp/kXXX); ST=$(cd "$ST" && pwd -P)
trap 'rm -rf "$T" "$ST"' EXIT
LONG=someone-with-a-long-id
for p in "$LONG" gone; do "$AUTH" person $p name=P >/dev/null 2>&1; "$AUTH" member echo $p mode=default >/dev/null 2>&1; done
expect "guest: CLAUDE_CODE_TMPDIR is <machine>/run/t/<id>" "$(KITH_STATE=$ST KITH_PERSON=guest lj "e.get('CLAUDE_CODE_TMPDIR')")" "$ST/run/t/guest"
S=$(KITH_STATE=$ST KITH_PERSON=guest settings)
expect "guest: its temp folder is readable and writable, run/t around it is not" "$(q "$S" "'$ST/run/t/guest' in aw and '$ST/run/t/guest' in fs['allowRead'] and not any(a in ('$ST/run', '$ST/run/t', '$ST/run/t-who') for a in aw + fs['allowRead'])")" True
expect "guest: run/t, its folder and the records are 0700" "$(python3 -c 'import os,sys; print({oct(os.stat(p).st_mode & 0o777) for p in sys.argv[1:]})' "$ST/run/t" "$ST/run/t/guest" "$ST/run/t-who")" "{'0o700'}"
H=$(KITH_STATE=$ST KITH_PERSON=$LONG lj "e.get('CLAUDE_CODE_TMPDIR')")
expect "a long id: an 8-hex hash of it" "$(python3 -c 'import hashlib,sys; print(sys.argv[1] == sys.argv[2] + "/" + hashlib.sha256(sys.argv[3].encode()).hexdigest()[:8])' "$H" "$ST/run/t" "$LONG")" True
: > "$ST/run/t/guest/left"; echo other > "$ST/run/t-who/guest"
KITH_STATE=$ST KITH_PERSON=guest lj 1 >/dev/null
expect "a folder recorded as someone else's is emptied before the run, and recorded as theirs" "$([ -e "$ST/run/t/guest/left" ] && echo kept || echo gone) $(cat "$ST/run/t-who/guest")" "gone guest"
echo other > "$ST/run/t-who/guest"; KITH_STATE=$ST "$AUTH" person guest --clear-temp >/dev/null 2>&1
expect "--clear-temp leaves a folder recorded as someone else's" "$([ -d "$ST/run/t/guest" ] && echo kept || echo gone)" kept
"$AUTH" bot gbot --of guest >/dev/null 2>&1; KITH_STATE=$ST python3 "$KERNEL/lib/kith_paths.py" --guest-tmp gbot >/dev/null
expect "a bot of theirs has a temp folder of its own" "$([ -d "$ST/run/t/gbot" ] && echo there)" there
printf guest > "$ST/run/t-who/guest"; KITH_STATE=$ST "$AUTH" person guest --clear-temp >/dev/null 2>&1
expect "--clear-temp removes their own, record first" "$([ -e "$ST/run/t/guest" ] || [ -e "$ST/run/t-who/guest" ] && echo kept || echo gone)" gone
expect "--clear-temp removes their bots' too" "$([ -e "$ST/run/t/gbot" ] && echo kept || echo gone)" gone
"$AUTH" bot gbot --rm >/dev/null 2>&1
KITH_STATE=$ST KITH_PERSON=$LONG lj 1 >/dev/null; KITH_STATE=$ST "$AUTH" person "$LONG" --revoke >/dev/null 2>&1
expect "a revoke (no cloud link) removes it" "$([ -e "$H" ] && echo kept || echo gone)" gone
KITH_STATE=$ST KITH_PERSON=gone lj 1 >/dev/null; KITH_STATE=$ST "$AUTH" person gone --rm >/dev/null 2>&1
expect "person --rm removes it" "$([ -e "$ST/run/t/gone" ] && echo kept || echo gone)" gone
rm -rf "$ST"

# --- The real thing (KITH_REAL_SANDBOX=1, macOS, a logged-in claude): a guest run under Claude Code's own sandbox ------------
# Everything above reads the generated JSON; this runs a real `claude -p` as the guest (the model is told to run one probe
# script) and checks what the OS let the shell do. Throwaway KITH_HOME / KITH_STATE; the real home folder is only the
# place the probes try to read (listing and existence, never contents) and where claude finds its login. Costs one short
# model turn (KITH_REAL_MODEL, default haiku).
if [ "${KITH_REAL_SANDBOX:-}" = 1 ] && [ "$(uname)" = Darwin ]; then
  echo "-- real sandbox run"
  AH=$KITH_HOME/agents/echo; SLICE=$AH/files/people/guest; mkdir -p "$SLICE" "$AH/files/people/other" "$AH/memory/people/guest" "$AH/memory/shared"
  : > "$AH/files/people/other/private.txt"; mkdir -p "$KITH_STATE/secrets"
  mkdir -p "$SLICE/clone/.git/hooks" "$SLICE/clone/.claude" "$T/proj/.git/hooks" "$T/proj/.claude"
  echo hello > "$T/proj/README.md"; echo hi > "$SLICE/readable.txt"
  MACH=$(python3 "$KERNEL/lib/kith_paths.py" --sh | sed -n "s/^export KITH_MACHINE=//p" | tr -d "'")
  mkdir -p "$MACH/run"
  # the two sockets: the host's (fixed place) and a run socket elsewhere; plain listeners that answer nothing
  printf 'import socket, sys, time\nkeep = []\nfor p in sys.argv[1:]:\n    s = socket.socket(socket.AF_UNIX); s.bind(p); s.listen(5); keep.append(s)\ntime.sleep(240)\n' > "$T/listen.py"
  python3 "$T/listen.py" "$MACH/run/host.sock" "$T/run s.sock" "$T/other.sock" &
  LISTENER=$!
  trap 'kill $LISTENER 2>/dev/null; rm -rf "$T"' EXIT
  sleep 1
  BACKUP="/Volumes/Macos 1TB/Kath/.kith-migrate-backup-20261023-015558"
  {
    echo '#!/bin/bash'
    echo "out='$SLICE/probe.out'; : > \"\$out\""
    echo 'r() { local n=$1; shift; if "$@" >/dev/null 2>>"$out.err"; then echo "$n ok" >> "$out"; else echo "$n denied" >> "$out"; fi; }'
    echo "r read-ssh ls '$REAL_HOME/.ssh'"
    echo "r read-keychains ls '$REAL_HOME/Library/Keychains'"
    echo "r read-home ls '$REAL_HOME'"
    echo "r read-backup ls '$BACKUP'"
    echo "r read-other-slice ls '$AH/files/people/other'"
    echo "r read-state-secrets ls '$KITH_STATE/secrets'"
    echo "r read-package ls '$("$KERNEL/bin/kith-pkg" resolve echo)'"
    echo "r read-own-slice cat '$SLICE/readable.txt'"
    echo "r read-project ls '$T/proj'"
    echo "r read-project-git ls '$T/proj/.git'"
    echo "r read-kernel ls '$KERNEL/bin'"
    echo "r guest-sandbox python3 '$KERNEL/lib/kith_paths.py' --guest-sandbox"
    echo "r write-own-slice touch '$SLICE/new.txt'"
    echo "r write-hooks touch '$SLICE/clone/.git/hooks/pre-commit'"
    echo "r write-claude-dir touch '$SLICE/clone/.claude/settings.json'"
    echo "r write-claude-md touch '$SLICE/clone/CLAUDE.md'"
    echo "r write-envrc touch '$SLICE/clone/.envrc'"
    echo "r write-project touch '$T/proj/new.txt'"
    echo "r write-project-hooks touch '$T/proj/.git/hooks/pre-commit'"
    echo "r write-project-claude-md touch '$T/proj/CLAUDE.md'"
    echo "r write-project-claude-dir touch '$T/proj/.claude/settings.json'"
    echo "r write-zshrc touch '$REAL_HOME/.zshrc-probe-should-not-exist'"
    echo "r sock-host python3 -c \"import socket; s=socket.socket(socket.AF_UNIX); s.connect('$MACH/run/host.sock')\""
    echo "r sock-run python3 -c \"import socket; s=socket.socket(socket.AF_UNIX); s.connect('$T/run s.sock')\""
    echo "r sock-other python3 -c \"import socket; s=socket.socket(socket.AF_UNIX); s.connect('$T/other.sock')\""
    echo "r net-curl curl -sS -m 5 https://example.com"
    echo "r read-owner-uv-cache ls '$REAL_HOME/.cache/uv'"   # the owner's uv cache (uv's default place)
    echo "r uv-run uv run --no-project python -c pass"
    echo "r uv-own-cache test \"\$(uv cache dir)\" = '$SLICE/.work/cache/uv'"
    echo "r shell-workspace test \"\$TMPDIR \$npm_config_cache\" = '$SLICE/.work/tmp $SLICE/.work/cache/npm'"
  } > "$SLICE/probe.sh"
  (cd "$T/proj" && KITH_MODEL=${KITH_REAL_MODEL:-haiku} KITH_PERSON=guest KITH_RUN_SOCKET="$T/run s.sock" KITH_RUN_TOKEN=probe HOME=$REAL_HOME PATH=${PATH#"$T/bin:"} \
     perl -e 'alarm 240; exec @ARGV' "$KITH" echo "Run exactly this one Bash command and then reply done: bash '$SLICE/probe.sh'" < /dev/null > "$T/real.out" 2> "$T/real.err")
  echo "probe output:"; cat "$SLICE/probe.out.err" | cut -c1-200 | grep -v "xcode\|xcrun\|developer\|^See\|^If dev\|^Use" ; cat "$SLICE/probe.out" 2>/dev/null || { echo "(no probe output)"; tail -5 "$T/real.err"; tail -5 "$T/real.out"; }
  rexpect() { local got; got=$(sed -n "s/^$1 //p" "$SLICE/probe.out" 2>/dev/null); expect "real: $1 $2" "${got:-none}" "$2"; }
  for n in read-ssh read-keychains read-home read-backup read-other-slice read-state-secrets \
           write-hooks write-claude-dir write-claude-md write-envrc write-project write-project-hooks write-project-claude-md write-project-claude-dir write-zshrc net-curl sock-other read-owner-uv-cache; do rexpect $n denied; done
  for n in read-package read-own-slice read-project read-project-git read-kernel guest-sandbox write-own-slice sock-host sock-run uv-run uv-own-cache shell-workspace; do rexpect $n ok; done
  rm -f "$REAL_HOME/.zshrc-probe-should-not-exist"

  # --- escape cards (F11 step 2b): a denied folder is readable after a yes-once grant, in the next launch only ----------------
  # The run socket now answers: a stand-in for the host that hands out the grant in $T/grants.json once (it deletes the file
  # when it does, like the host's compare-and-set), as kith-permit apply asks for it between the session claim and exec.
  echo "-- escape grant"
  kill $LISTENER 2>/dev/null; sleep 0.5; rm -f "$T/run s.sock"
  GR=$T/granted; mkdir -p "$GR"; echo granted > "$GR/f.txt"
  cat > "$T/grants.py" <<'PY'
import json, os, socket, sys
sock, src = sys.argv[1:3]
srv = socket.socket(socket.AF_UNIX); srv.bind(sock); srv.listen(5)
while True:
    c, _ = srv.accept(); buf = b''
    while not buf.endswith(b'\n'):
        x = c.recv(4096)
        if not x: break
        buf += x
    g = {'read': [], 'write': [], 'domains': []}
    if os.path.exists(src):
        g = json.load(open(src)); os.remove(src)
    c.sendall(json.dumps({'ok': True, 'grants': g}).encode() + b'\n'); c.close()
PY
  python3 "$T/grants.py" "$T/run s.sock" "$T/grants.json" &
  GRANTER=$!
  trap 'kill $GRANTER 2>/dev/null; rm -rf "$T"' EXIT
  sleep 1
  printf '#!/bin/bash\nls "%s" >/dev/null 2>&1 && echo "read-granted ok" > "%s/probe2.out" || echo "read-granted denied" > "%s/probe2.out"\n' "$GR" "$SLICE" "$SLICE" > "$SLICE/probe2.sh"
  launch() { rm -f "$SLICE/probe2.out"; (cd "$T/proj" && KITH_MODEL=${KITH_REAL_MODEL:-haiku} KITH_PERSON=guest KITH_RUN_SOCKET="$T/run s.sock" KITH_RUN_TOKEN=probe HOME=$REAL_HOME PATH=${PATH#"$T/bin:"} \
     perl -e 'alarm 240; exec @ARGV' "$KITH" echo "Run exactly this one Bash command and then reply done: bash '$SLICE/probe2.sh'" < /dev/null > "$T/real2.out" 2> "$T/real2.err"); cat "$SLICE/probe2.out" 2>/dev/null || echo "none"; }
  expect "real: before the yes the folder is denied" "$(launch)" "read-granted denied"
  printf '{"read": ["%s"], "write": [], "domains": []}' "$(cd "$GR" && pwd -P)" > "$T/grants.json"
  expect "real: after a yes once the next launch reads it" "$(launch)" "read-granted ok"
  expect "real: the launch after that is denied again" "$(launch)" "read-granted denied"
fi
exit $((fails > 0))
