#!/usr/bin/env bash
# kith-auth-core-mirror-check — until M2-18, a revoke / undo / removal made through kith-auth also reaches the core's copy
# of people (the core's store): people.suspend / people.undo / people.removePerson over `kith kernel core-call`, after auth.json is
# written. No queue: a failed call only prints a warning (what to do, and whether the core may have applied it
# anyway) and the command still succeeds. With a fake `kith` program
# standing in for the core (a JSON file is its store):
#   1. core up: a revoke, an undo and a removal (--rm) reach it
#   2. core down, or no kith program: kith-auth exits 0, auth.json shows the person revoked, the warning is on stderr
#   3. a person the core doesn't know (refused, exit 4): the same warning; a lost answer (exit 5): "may not be updated"
#   4. bot --rm: a renamed bot is removed under every id it had; "x is a person" is not "already gone"
#   5. the fake refuses methods that are not in CORE_CALL_METHODS (read from serve/host/src/core_front.rs, as `kith kernel
#      core-call` does), so MIRROR_METHOD in kith-auth can not drift outside that list without this check failing
# The rules themselves: kith-auth-revoke-check. Throwaway dirs, never ~/.kith.
#
#   kernel/tests/kith-auth-core-mirror-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-mirror.XXXXXX"); T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export KITH_AUTH=$T/auth.json HOME=$T/home KITH_HOME=$T/kith KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=1
unset KITH_STATE HQ_STATE KITH_PERSON KITH_AGENT HQ_HOME CARGO_TARGET_DIR KITH_DEV_BIN
mkdir -p "$HOME" "$KITH_SERVE_DIR" "$T/state"
export KITH_STATE=$T/state KITH_WAKE_NO_KICK=1
mkdir -p "$KITH_HOME/agents/house/role"
printf -- '---\nname: house\ndescription: test\n---\nbody\n' > "$KITH_HOME/agents/house/role/agent.md"

# The fake kith: `memory hook --help` answers like a current program; `kernel core-call METHOD --params-stdin` is the core.
export FAKE_DIR=$T/fake; mkdir -p "$FAKE_DIR"
# The methods core-call allows: the real list, read from the host source.
export FAKE_ALLOWED=$(python3 -I - "$KERNEL/../serve/host/src/core_front.rs" <<'PY'
import re, sys
src = open(sys.argv[1]).read()
body = re.search(r'const CORE_CALL_METHODS: &\[&str\] =\s*&\[(.*?)\];', src, re.S).group(1)
print(' '.join(re.findall(r'"([^"]+)"', body)))
PY
)
cat > "$T/fakekith" <<'PY'
#!/usr/bin/env python3
import json, os, sys
d = os.environ['FAKE_DIR']
a = sys.argv[1:]
if a[:2] == ['memory', 'hook']:
    print('usage: kith memory hook --phase'); sys.exit(0)
if a[:2] != ['kernel', 'core-call']:
    sys.exit(2)
method, params = a[2], json.loads(sys.stdin.read() or '{}')
if method not in os.environ['FAKE_ALLOWED'].split():
    print(f'core-call: {method} is not one of ' + ', '.join(os.environ['FAKE_ALLOWED'].split()), file=sys.stderr); sys.exit(2)
if os.path.exists(d + '/down'):
    print('no core daemon answers', file=sys.stderr); sys.exit(3)
if os.path.exists(d + '/slow'):
    import time; time.sleep(30)
if os.path.exists(d + '/lost'):
    print('the answer was lost', file=sys.stderr); sys.exit(5)
pid = params['id']
with open(d + '/calls', 'a') as f:
    f.write(f'{method} {pid}\n')
db = json.load(open(d + '/core.json')) if os.path.exists(d + '/core.json') else {}
if method == 'people.removeBot' and pid in db and not db[pid].get('bot'):
    print(f"'{pid}' is a person, not a bot", file=sys.stderr); sys.exit(4)
if pid not in db:
    print((f"no bot '{pid}'" if method == 'people.removeBot' else f"no person '{pid}' (kith-auth person {pid} name=..)"), file=sys.stderr); sys.exit(4)
elif method in ('people.removePerson', 'people.removeBot'):
    db.pop(pid)
elif method == 'people.suspend':
    db[pid]['revoked'] = True
elif method == 'people.undo':
    db[pid]['revoked'] = False
json.dump(db, open(d + '/core.json', 'w'))
print(json.dumps({'lines': ['ok']}))
PY
chmod +x "$T/fakekith"
export KITH_BIN=$T/fakekith
# A program that was just written can take seconds to start the first time on macOS; kith-auth's wait is short on purpose.
"$T/fakekith" memory hook --help >/dev/null 2>&1; echo '{}' | "$T/fakekith" kernel core-call warm --params-stdin >/dev/null 2>&1; rm -f "$FAKE_DIR/calls" "$FAKE_DIR/core.json"

TELL="(run it again once kith serve is running)"
ORIG_PATH=$PATH
CF=core."db"   # the boundary check keeps that file's name out of source outside core/runtime
A() { python3 "$KERNEL/bin/kith-auth" "$@"; }
fail=0
check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
core_add() { python3 - "$FAKE_DIR/core.json" "$@" <<'PY'
import json, os, sys
f = sys.argv[1]
db = json.load(open(f)) if os.path.exists(f) else {}
for p in sys.argv[2:]:
    db.setdefault(p, {'revoked': False, 'bot': p.startswith('bot-')})
json.dump(db, open(f, 'w'))
PY
}
core_revoked() { python3 -c "import json; print(json.load(open('$FAKE_DIR/core.json')).get('$1', {}).get('revoked', 'absent'))"; }
auth_revoked() { python3 -c "import json; print('revoked' in json.load(open('$KITH_AUTH'))['people']['$1'])"; }
auth_has() { python3 -c "import json; print('$1' in json.load(open('$KITH_AUTH'))['people'])"; }
down() { touch "$FAKE_DIR/down"; }
up() { rm -f "$FAKE_DIR/down"; }

A person kai owner >/dev/null
for p in sam ann bob; do A person $p name=$p >/dev/null; A member house $p >/dev/null; done
core_add sam ann

# 1. core up
A person sam --revoke >"$T/out" 2>"$T/err"; rc=$?
check "up: the revoke succeeded" "[ $rc -eq 0 ] && grep -q 'access removed' $T/out"
check "up: auth.json says revoked" "[ \"\$(auth_revoked sam)\" = True ]"
check "up: the revoke reached the core" "grep -q 'people.suspend sam' $FAKE_DIR/calls && [ \"\$(core_revoked sam)\" = True ]"
check "up: no warning" "! grep -q '${CF} not updated' $T/err"
A person sam --unrevoke >/dev/null 2>&1
check "up: the undo reaches the core" "grep -q 'people.undo sam' $FAKE_DIR/calls && [ \"\$(core_revoked sam)\" = False ]"

# 2. core down
touch "$FAKE_DIR/down"
A person sam --revoke >"$T/out" 2>"$T/err"; rc=$?
check "down: the revoke still succeeds" "[ $rc -eq 0 ]"
check "down: auth.json is revoked" "[ \"\$(auth_revoked sam)\" = True ]"
check "down: the warning is on stderr" "grep -qx 'revoked in auth.json; ${CF} not updated (run it again once kith serve is running)' $T/err"
A person sam --unrevoke >/dev/null 2>"$T/err"
check "down: the undo warns too" "grep -qx 'unrevoked in auth.json; ${CF} not updated (run it again once kith serve is running)' $T/err"
rm -f "$FAKE_DIR/down"

# no kith program at all
export KITH_BIN=$T/nothing-here PATH=/usr/bin:/bin
A person ann --revoke >"$T/out" 2>"$T/err"; rc=$?
check "no kith program: exits 0, revoked, warned" "[ $rc -eq 0 ] && [ \"\$(auth_revoked ann)\" = True ] && grep -qx 'revoked in auth.json; ${CF} not updated (run it again once kith serve is running)' $T/err"

export KITH_BIN=$T/fakekith PATH=$ORIG_PATH
# 3. the core doesn't know the person (it refuses, exit 4): the same warning, exit 0
A person bob --revoke >"$T/out" 2>"$T/err"; rc=$?
check "unknown to the core: exits 0, revoked in auth.json, warned" "[ $rc -eq 0 ] && [ \"\$(auth_revoked bob)\" = True ] && grep -qx 'revoked in auth.json; ${CF} not updated ${TELL}' $T/err"
# a lost answer: the core may have applied it
touch "$FAKE_DIR/lost"
A person ann --unrevoke >"$T/out" 2>"$T/err"; rc=$?
check "lost answer: exits 0 and says it MAY not be updated" "[ $rc -eq 0 ] && grep -qx 'unrevoked in auth.json; ${CF} may not be updated ${TELL}' $T/err"
rm -f "$FAKE_DIR/lost"
# no answer inside the (short) wait: the same "may not", and the wait under the lock is capped
touch "$FAKE_DIR/slow"; t0=$SECONDS
A person ann --unrevoke >"$T/out" 2>"$T/err"; rc=$?
check "timeout: exits 0 in a few seconds, says it MAY not be updated" "[ $rc -eq 0 ] && [ $((SECONDS - t0)) -lt 12 ] && grep -qx 'unrevoked in auth.json; ${CF} may not be updated ${TELL}' $T/err"
rm -f "$FAKE_DIR/slow"
# running it again once the core is back is safe and now reaches it
A person ann --revoke >"$T/out" 2>"$T/err"; rc=$?
check "again with the core back: no warning, the core has it" "[ $rc -eq 0 ] && [ ! -s $T/err ] && [ \"\$(core_revoked ann)\" = True ]"

# 4. --rm
A person sam --rm >"$T/out" 2>"$T/err"; rc=$?
check "rm up: sam is gone from auth.json and the core, no warning" "[ $rc -eq 0 ] && [ \"\$(auth_has sam)\" = False ] && grep -q 'people.removePerson sam' $FAKE_DIR/calls && [ \"\$(core_revoked sam)\" = absent ] && [ ! -s $T/err ]"
down
A person ann --rm >"$T/out" 2>"$T/err"; rc=$?
check "rm down: still removed in auth.json, warned" "[ $rc -eq 0 ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"
up
A person bob --rm >"$T/out" 2>"$T/err"; rc=$?
check "rm of a person the core doesn't know: removed, warned" "[ $rc -eq 0 ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"
A person nobody --rm >"$T/out" 2>"$T/err"; rc=$?
check "rm of a person nobody knows: idempotent, and the core's refusal is the same warning" "[ $rc -eq 0 ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"

# 5. bot --rm
for b in bot-up bot-down bot-new bot-gone bot-none; do A bot $b --of kai >/dev/null; done
core_add bot-up bot-down bot-gone
A bot bot-up --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm up: gone from auth.json and the core, no warning" "[ $rc -eq 0 ] && [ \"\$(auth_has bot-up)\" = False ] && grep -q 'people.removeBot bot-up' $FAKE_DIR/calls && [ \"\$(core_revoked bot-up)\" = absent ] && [ ! -s $T/err ]"
down
A bot bot-down --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm down: still removed in auth.json, warned" "[ $rc -eq 0 ] && [ \"\$(auth_has bot-down)\" = False ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"
up
A bot bot-new --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm of a bot the core never imported: removed, no warning" "[ $rc -eq 0 ] && [ \"\$(auth_has bot-new)\" = False ] && [ ! -s $T/err ]"
A bot bot-gone --rm >/dev/null 2>&1; A bot bot-gone --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm twice: the second is refused by auth.json, core not called again" "[ $rc -ne 0 ] && [ \"\$(grep -c 'people.removeBot bot-gone' $FAKE_DIR/calls)\" = 1 ]"
export KITH_BIN=$T/nothing-here PATH=/usr/bin:/bin
A bot bot-none --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm with no kith program: removed, warned like person rm" "[ $rc -eq 0 ] && [ \"\$(auth_has bot-none)\" = False ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"
export KITH_BIN=$T/fakekith PATH=$ORIG_PATH


# 6. a renamed bot: the core still holds the old id (a rename is not mirrored), the new one is unknown there
A bot bot-old --of kai >/dev/null; core_add bot-old
A person bot-old id=bot-ren >"$T/out" 2>"$T/err"
check "rename: the bot is now bot-ren in auth.json" "[ \"\$(auth_has bot-ren)\" = True ]"
A bot bot-ren --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm after a rename: the old id leaves the core too, no warning" "[ $rc -eq 0 ] && grep -q 'people.removeBot bot-old' $FAKE_DIR/calls && [ \"\$(core_revoked bot-old)\" = absent ] && [ ! -s $T/err ]"
# a renamed bot the core never imported under either id: quiet
A bot bot-o2 --of kai >/dev/null; A person bot-o2 id=bot-r2 >/dev/null 2>&1
A bot bot-r2 --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm after a rename, unknown to the core under every id: quiet" "[ $rc -eq 0 ] && [ ! -s $T/err ]"
# the core holds the id as a person: not 'no such id', so the loud line
A bot bot-pp --of kai >/dev/null; python3 - "$FAKE_DIR/core.json" <<'PY'
import json, sys
db = json.load(open(sys.argv[1])); db['bot-pp'] = {'revoked': False, 'bot': False}; json.dump(db, open(sys.argv[1], 'w'))
PY
A bot bot-pp --rm >"$T/out" 2>"$T/err"; rc=$?
check "bot rm of an id the core holds as a person: warned, not silent" "[ $rc -eq 0 ] && grep -qx 'removed in auth.json; ${CF} not updated ${TELL}' $T/err"

# 6b. a new bot or person can not take an id that is some row's old id (rename refuses the same)
A bot bot-was1 --of kai >/dev/null; A person bot-was1 id=bot-was2 >/dev/null 2>&1
A bot bot-was1 --of kai >"$T/out" 2>"$T/err"; rc=$?
check "bot add of another row's old id: refused" "[ $rc -ne 0 ] && grep -q \"one's old id\" $T/err && [ \"\$(auth_has bot-was1)\" = False ]"
A person bot-was1 name=x >"$T/out" 2>"$T/err"; rc=$?
check "person add of another row's old id: refused" "[ $rc -ne 0 ] && [ \"\$(auth_has bot-was1)\" = False ]"
# older data: a row that is also some row's was-id; only new adds are refused, nothing on disk changes
python3 - "$KITH_AUTH" <<'PY'
import json, sys
a = json.load(open(sys.argv[1])); a['people']['bot-was2']['was'].append('bot-clash'); a['people']['bot-clash'] = {'bot_of': 'kai'}
json.dump(a, open(sys.argv[1], 'w'))
PY
A bot bot-clash --of kai >"$T/out" 2>"$T/err"; rc=$?
check "re-adding a row that already clashes (older data) is an update: allowed, row kept" "[ $rc -eq 0 ] && [ \"\$(auth_has bot-clash)\" = True ]"

# 6c. a hung core: stop after the first timeout (not 4 s per id), still the loud line
A bot bot-h1 --of kai >/dev/null; A person bot-h1 id=bot-h2 >/dev/null 2>&1; A person bot-h2 id=bot-h3 >/dev/null 2>&1
touch "$FAKE_DIR/slow"; t0=$SECONDS
A bot bot-h3 --rm >"$T/out" 2>"$T/err"; rc=$?
rm -f "$FAKE_DIR/slow"
check "bot rm with a hung core: one timeout, not one per id, and the loud line" "[ $rc -eq 0 ] && [ $((SECONDS - t0)) -lt 7 ] && grep -qx 'removed in auth.json; ${CF} may not be updated ${TELL}' $T/err"

# 7. drift: every method kith-auth mirrors is on the core-call allow list (the fake above refuses the rest, exit 2)
mirror_drift() { python3 -I - "$KERNEL/bin/kith-auth" <<'PY'
import os, re, sys
src = open(sys.argv[1]).read()
body = re.search(r'MIRROR_METHOD = \{(.*?)\}', src, re.S).group(1)
mirrored = set(re.findall(r"'(people\.[A-Za-z]+)'", body))
assert mirrored and mirrored <= set(os.environ['FAKE_ALLOWED'].split()), mirrored
PY
}
check "every MIRROR_METHOD is on CORE_CALL_METHODS" "mirror_drift"
A person ann --revoke >/dev/null 2>&1   # a mirrored method outside the list would have warned in every row above

[ $fail -eq 0 ] && echo "all ok" || echo "FAILED"
exit $fail
