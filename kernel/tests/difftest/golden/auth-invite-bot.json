[
 {
  "name": "golden-auth-who",
  "command": "auth",
  "env": {
   "KITH_AUTH": "{KITH_HOME}/auth.json"
  },
  "setup": [
   {
    "mkdir": "kith/state"
   },
   {
    "write": "kith/agents/house/role/agent.md",
    "text": "---\nname: house\ndescription: test agent\nmodel: sonnet\n---\nbody\n"
   },
   {
    "write": "kith/auth.json",
    "text": "{\n  \"people\": {\n    \"kai\": {\n      \"owner\": true,\n      \"name\": \"Kai\",\n      \"handles\": {\n        \"telegram\": \"1001\",\n        \"slack\": \"U1\"\n      }\n    },\n    \"sam\": {\n      \"name\": \"Sam\",\n      \"handles\": {\n        \"telegram\": \"2002\"\n      },\n      \"was\": [\n        \"samuel\"\n      ]\n    },\n    \"ola\": {\n      \"name\": \"Ola\",\n      \"revoked\": {\n        \"at\": 5\n      },\n      \"handles\": {\n        \"telegram\": \"3003\"\n      }\n    },\n    \"bot-a1\": {\n      \"bot_of\": \"sam\",\n      \"name\": \"Scout\"\n    }\n  },\n  \"members\": {\n    \"house\": {\n      \"sam\": {\n        \"model\": \"haiku\"\n      }\n    }\n  },\n  \"grants\": {},\n  \"env\": {},\n  \"profiles\": {},\n  \"presets\": {},\n  \"invites\": {}\n}\n"
   }
  ],
  "run": [
   [
    "auth",
    "who",
    "telegram",
    "1001"
   ],
   [
    "auth",
    "who",
    "telegram",
    "2002"
   ],
   [
    "auth",
