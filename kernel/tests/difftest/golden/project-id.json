    "run": [
     "git",
     "remote",
     "add",
     "origin",
     "https://github.com/owner/repo.git"
    ],
    "cwd": "home/clone-https"
   },
   {
    "run": [
     "git",
     "init",
     "-q",
     "clone-ssh"
    ],
    "cwd": "home"
   },
   {
    "run": [
     "git",
     "remote",
     "add",
     "origin",
     "ssh://git@github.com/OWNER/REPO"
    ],
    "cwd": "home/clone-ssh"
   },
   {
    "run": [
     "git",
     "init",
     "-q",
     "clone-scp-port"
    ],
    "cwd": "home"
   },
   {
    "run": [
     "git",
     "remote",
     "add",
     "origin",
     "ssh://git@github.com:22/owner/repo/"
    ],
    "cwd": "home/clone-scp-port"
   },
   {
    "run": [
     "git",
     "init",
     "-q",
     "clone-none"
    ],
    "cwd": "home"
   },
   {
    "run": [
     "git",
     "init",
     "-q",
     "clone-other"
    ],
    "cwd": "home"
   },
   {
    "run": [
     "git",
     "remote",
     "add",
     "origin",
     "https://github.com/owner/other.git"
    ],
    "cwd": "home/clone-other"
   }
  ],
  "run": [
   [
    "--register",
    "beta",
    "{HOME}/my repo",
    "--home",
    ""
   ],
   [
    "{HOME}/my repo"
   ],
   [
    "{HOME}/my repo/sub dir"
   ],
   [
    "{HOME}/clone-https"
   ],
   [
    "{HOME}/clone-ssh"
   ],
   [
    "{HOME}/clone-scp-port"
   ],
   [
    "{HOME}/clone-none"
   ],
   [
    "{HOME}/clone-other"
   ],
   [
    "--list"
   ],
   [
    "--where",
    "beta"
   ]
  ]
