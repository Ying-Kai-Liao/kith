[
 {
  "name": "launch-exec-owner-state-skips-out",
  "command": "launch-whole",
  "needs": "rust",
  "new_prog": "rust",
  "bin_both": true,
  "env": {
   "KITH_STATE": "{HOME}/.kith"
  },
  "run_old": [
   [
    "echo",
    "do",
    "it"
   ]
  ],
  "run_new": [
   [
    "kernel",
    "launch",
    "echo",
    "--plan-exec",
    "do",
    "it",
    "--kernel",
    "{KERNEL}"
   ]
  ],
  "run": [
   [
    "echo",
    "do",
    "it"
   ]
  ],
  "normalize": [
   [
    "[^\"\\n]*kith-room-ledger (pre|post) --agent",
    "<LEDGERHOOK> \\1 --agent"
   ],
   [
    "[^\"\\n]*kernel room-ledger --kernel [^\\n]*? (pre|post) --agent",
    "<LEDGERHOOK> \\1 --agent"
   ],
   [
    "(?:'[^']*kith-permit'|[^\\s'\\\"]*kith-permit) (denied|once) --dir",
    "<PERMITHOOK-PYTHON> \\1 --dir"
   ],
   [
    "(?:'[^']*'|[^\\s'\\\"]+) kernel permit --kernel (?:'[^']*'|[^\\s'\\\"]+) (denied|once) --dir",
    "<PERMITHOOK-RUST> \\1 --dir"
   ],
   [
    "\"command\": \"[^\"]*kernel cost --kernel [^\"]* tag\"",
    "\"command\": \"<COSTTAG-RUST>\""
   ],
   [
    "^[^\"]*kernel cost --kernel [^\"]* tag$",
    "<COSTTAG-RUST>"
   ],
   [
    "\"command\": \"\\\\\"[^\"]*kith-sessions\\\\\" record\"",
    "\"command\": \"<SESSIONSHOOK-PYTHON>\""
   ],
   [
    "\"command\": \"[^\"]*kernel threads --kernel [^\"]* record\"",
    "\"command\": \"<SESSIONSHOOK-RUST>\""
   ],
   [
    "^\"[^\"]*kith-sessions\" record$",
    "<SESSIONSHOOK-PYTHON>"
   ],
   [
    "^[^\"]*kernel threads --kernel [^\"]* record$",
    "<SESSIONSHOOK-RUST>"
   ],
   [
    "(?<![0-9a-zA-Z])[0-9a-f]{10}(?![0-9a-zA-Z])",
    "<h>"
   ],
   [
    "(?<![0-9a-zA-Z])[0-9a-f]{32}(?![0-9a-zA-Z])",
    "<uuid>"
   ]
  ],
  "stderr": false,
  "ignore": [
   "/\\.runs/",
   "/run/once/",
   "/state/store/",
   "/run/t",
   "/store/",
   "/core/locks/",
   "/live/terminal/"
  ],
  "setup": [
   {
    "mkdir": "kith/state"
   },
   {
    "write": "kith/agents/echo/role/agent.md",
    "text": "---\nname: echo\ndescription: test agent\n---\nYou are echo.\n"
   },
   {
    "run": [
     "git",
     "init",
     "-q"
    ],
    "cwd": "kith/agents/echo/role"
   },
   {
    "run": [
     "git",
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "add",
     "-A"
    ],
    "cwd": "kith/agents/echo/role"
   },
   {
    "run": [
     "git",
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "commit",
     "-qm",
     "init",
     "--allow-empty"
    ],
    "cwd": "kith/agents/echo/role"
   },
   {
    "write": "kith/state/user.md",
    "text": "About the owner.\n"
   },
   {
    "write": "kith/agents/other/role/agent.md",
    "text": "---\nname: other\ndescription: another\n---\nOther.\n"
   },
   {
    "write": "kith/agents/other/memory/MEMORY.md",
    "text": "other memory\n"
   },
   {
    "write": "kith/agents/echo/memory/MEMORY.md",
    "text": "owner memory\n"
   },
   {
    "write": "kith/agents/echo/memory/shared/MEMORY.md",
    "text": "shared craft\n"
   },
   {
    "write": "kith/agents/echo/memory/people/sam/MEMORY.md",
    "text": "sam likes tea\n"
   },
   {
    "write": "kith/agents/echo/memory/people/ann/MEMORY.md",
    "text": "ann likes coffee\n"
   },
   {
    "write": "kith/agents/echo/files/people/ann/note.md",
    "text": "ann file\n"
   },
   {
    "write": "kith/agents/echo/files/report.md",
    "text": "owner output\n"
   },
   {
    "write": "kith/state/people/sam.md",
    "text": "Sam.\n"
   },
   {
    "write": "kith/state/people/ann.md",
    "text": "Ann.\n"
   },
   {
    "write": "kith/state/secrets/auth.json",
    "text": "{\"profiles\": {}, \"grants\": {}, \"env\": {}, \"people\": {\"kai\": {\"owner\": true, \"name\": \"Kai\"}, \"sam\": {\"name\": \"Sam\", \"lang\": \"en\"}, \"ann\": {\"name\": \"Ann\"}, \"bot-ab12cd34\": {\"bot_of\": \"sam\", \"name\": \"Samsbot\"}}, \"members\": {\"echo\": {\"sam\": {\"mode\": \"acceptEdits\", \"deny\": [\"Bash(curl:*)\", \"Read(/tmp/nope/**)\"]}, \"ann\": {\"mode\": \"bypassPermissions\", \"trusted\": true}, \"bot-ab12cd34\": {}}}}"
   },
   {
    "fake": "claude",
    "script": "#!/bin/sh\ncase \"$1 $2\" in\n  \"auth status\") echo '{\"loggedIn\":true}'; exit 0 ;;\n  \"plugin list\") echo \"[]\"; exit 0 ;;\n  \"--version \"*) echo \"2.1.309 (Claude Code)\"; exit 0 ;;\nesac\necho \"claude-run account_id=$KITH_ACCOUNT_ID provider=$KITH_PROVIDER cfg=${CLAUDE_CONFIG_DIR:-}\"\nexit 0\n"
   },
   {
    "mkdir": "home/.kith/accounts/claude/work"
   },
   {
    "mkdir": "home/.kith/accounts/claude/other"
   },
   {
    "write": "home/.kith/settings.json",
    "text": "{\"accounts\": [\"claude:work\", \"claude\"], \"agents\": {}}"
   },
   {
    "write": "home/.kith/accounts/state.json",
    "text": "{\"version\": 1, \"accounts\": {\"claude:work\": {\"out_until\": 4102444800, \"reason\": \"rate_limit\", \"since\": 1}}}"
   }
  ]
 },
