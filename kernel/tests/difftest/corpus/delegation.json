 {
  "name": "delegation-record-read",
  "command": "delegation",
  "needs": "rust",
  "program": {
   "old": [
    "python3",
    "{KERNEL}/tests/difftest/delegation-old.py"
   ],
   "new": [
    "{BIN}",
    "kernel",
    "delegation",
    "--kernel",
    "{KERNEL}"
   ]
  },
  "env": {
   "KITH_STATE": "{HOME}/.kith"
  },
  "setup": [
   {
    "write": "home/.kith/live/ask/new.reg",
    "text": "{\"asked\": \"echo\", \"chain\": \"c1\", \"hop\": 2, \"cross_hops\": 1, \"crossed\": true, \"cost\": 0.5, \"cost_base\": 1.0, \"state\": \"capped\", \"reply_to\": {\"session\": \"s\", \"ask\": \"p\"}}"
   },
   {
    "write": "home/.kith/live/ask/old.reg",
    "text": "{\"session\": \"s-old\", \"asked\": \"echo\"}"
   },
   {
    "write": "home/.kith/live/ask/old-done.reg",
    "text": "{\"session\": \"s-old\", \"done\": true}"
   },
   {
    "write": "home/.kith/live/ask/bare.reg",
    "text": "{}"
   },
   {
    "write": "home/.kith/live/ask/damaged.reg",
    "text": "{not json"
   },
   {
    "write": "home/.kith/live/ask/listy.reg",
    "text": "[1,2]"
   }
  ],
  "run": [
   [
    "record",
    "new"
   ],
   [
    "record",
    "old"
   ],
   [
    "record",
    "old-done"
   ],
   [
    "record",
    "bare"
   ],
   [
    "record",
    "damaged"
   ],
   [
    "record",
    "listy"
   ],
   [
    "record",
    "missing"
   ],
   [
    "record",
    "../x"
   ]
  ]
