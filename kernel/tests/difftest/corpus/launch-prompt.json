   [
    "echo",
    "-p",
    "alpha",
    "--launch-json"
   ]
  ],
  "run_new": [
   [
    "kernel",
    "launch",
    "prompt",
    "echo",
    "--kernel",
    "{KERNEL}",
    "--pkg",
    "{KITH_HOME}/state/store/echo@0123456789",
    "--json",
    "--project",
    "alpha"
   ]
  ],
  "run": [
   [
    "echo",
    "-p",
    "alpha",
    "--launch-json"
   ]
  ],
  "pick": {
   "old": "system_prompt",
   "new": "prompt"
  },
  "normalize": [
   [
    "(?<![0-9a-zA-Z])[0-9a-f]{10}(?![0-9a-zA-Z])",
