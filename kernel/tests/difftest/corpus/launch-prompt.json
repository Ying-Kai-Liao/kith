[
 {
  "name": "launch-prompt-owner-memory",
  "command": "launch-prompt",
  "needs": "rust",
  "new_prog": "rust",
  "bin_both": true,
  "setup": [
   {
    "mkdir": "kith/state"
   },
   {
    "write": "kith/agents/echo/role/agent.md",
    "text": "---\nname: echo\ndescription: test agent\n---\nYou are echo.\nHome is {{HOME_DIR}}.\n"
   },
   {
    "run": [
     "git",
     "init",
     "-q"
    ],
    "cwd": "kith/agents/echo/role"
   },
   {
    "run": [
     "git",
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "commit",
     "-qm",
     "init",
     "--allow-empty"
    ],
    "cwd": "kith/agents/echo/role"
   },
   {
    "write": "kith/state/user.md",
    "text": "About the owner.\n"
   },
   {
    "write": "kith/agents/echo/memory/MEMORY.md",
    "text": "owner memory zebra\n"
   },
   {
    "write": "kith/agents/echo/memory/shared/MEMORY.md",
    "text": "shared craft tip\n"
   },
   {
    "write": "kith/agents/echo/memory/people/sam/MEMORY.md",
    "text": "sam likes tea\n"
   },
   {
    "write": "kith/agents/echo/memory/rooms/grp1/MEMORY.md",
    "text": "grp1 room note\n"
   },
   {
    "write": "kith/agents/echo/memory/sessions/s1.md",
    "text": "session log\n"
   },
   {
    "write": "kith/agents/echo/memory/projects/alpha/README.md",
    "text": "alpha index note\n"
   }
  ],
  "env": {
   "KITH_STATE": "{KITH_HOME}/state"
  },
  "run_old": [
   [
    "echo",
    "--launch-json"
   ]
  ],
  "run_new": [
   [
    "kernel",
    "launch",
    "prompt",
    "echo",
    "--kernel",
    "{KERNEL}",
    "--pkg",
    "{KITH_HOME}/state/store/echo@0123456789",
    "--json"
   ]
  ],
  "run": [
   [
    "echo",
    "--launch-json"
   ]
  ],
  "pick": {
   "old": "system_prompt",
   "new": "prompt"
  },
  "normalize": [
   [
    "(?<![0-9a-zA-Z])[0-9a-f]{10}(?![0-9a-zA-Z])",
    "<h>"
   ]
  ],
  "only": [
   "pick",
   "exit"
  ],
  "stderr": false
 },
