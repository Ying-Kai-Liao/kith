[
  {
    "name": "accounts-launch-env-no-accounts",
    "command": "accounts",
    "needs": "rust",
    "program": {
      "old": [
        "python3",
        "{KERNEL}/lib/kith_accounts.py"
      ],
      "new": [
        "{BIN}",
        "kernel",
        "accounts",
        "--kernel",
        "{KERNEL}"
      ]
    },
    "env": {
      "KITH_STATE": "{HOME}/.kith"
    },
    "setup": [
      {
        "write": "kith/agents/echo/role/agent.md",
        "text": "---\nname: echo\ndescription: test agent\nharness: claude-code\n---\nYou are echo.\n"
      },
      {
        "write": "kith/agents/cdx/role/agent.md",
        "text": "---\nname: cdx\ndescription: test agent\nharness: codex\n---\nYou are cdx.\n"
      },
      {
        "fake": "claude",
        "script": "#!/bin/sh\necho \"claude $* cfg=${CLAUDE_CONFIG_DIR:-}\" >> \"$DIFFTEST_FAKELOG\"\ncase \"$1 $2\" in\n  \"auth status\") case \"${CLAUDE_CONFIG_DIR:-}\" in *work|\"\") echo '{\"loggedIn\":true}'; exit 0;; *other) echo '{\"loggedIn\":false}'; exit 0;; *) exit 1;; esac ;;\nesac\nexit 0\n"
      },
      {
        "fake": "codex",
        "script": "#!/bin/sh\necho \"codex $* home=${CODEX_HOME:-}\" >> \"$DIFFTEST_FAKELOG\"\ncase \"$1 $2\" in\n  \"login status\") case \"${CODEX_HOME:-}\" in *b) echo 'Logged in'; exit 0;; *) echo 'Not logged in'; exit 1;; esac ;;\nesac\nexit 0\n"
      }
    ],
    "run": [
      [
        "launch-env",
        "echo",
        "claude"
      ],
      [
        "launch-env",
        "echo",
        "codex"
      ],
      [
        "launch-env",
        "echo",
        "claude:work"
      ],
      [
        "launch-env",
        "echo",
        "gemini"
      ],
      [
        "launch-env",
        "echo",
        "bad id"
      ],
      [
        "launch-env",
        "echo",
        "claude-api"
      ],
      [
        "launch-env",
        "echo",
        "claude@bad model!"
      ]
    ]
  },
