[
  {"case": "engines-list", "facet": "step*", "why": "host engines join the kernel's list (A2): the core lists all of its table with names, aliases, ACP modes and what each enforces; the Python side lists harness.py's engines and claude"},
  {"case": "engines-install-login", "facet": "step*", "why": "host engines join the kernel's list (A2): install and login print a command from the core's table, which the Python side does not have"},
  {"case": "run-once-*", "facet": "fakes", "why": "A2b-1: the one-shot goes over the engine's ACP mode (`qwen --acp`) instead of its own `qwen -o json -p` flags; the log of fake calls shows the other command line"},
  {"case": "run-once-*", "facet": "step*.stderr", "why": "A2b-1: ACP sessions have one working directory, so the run says which of the agent's extra directories it goes without (native qwen takes --include-directories)"},
  {"case": "run-once-qwen-cost", "facet": "state:kith/state/cost.db", "why": "A2b-1: the ledger row carries the cost the engine reports over ACP; qwen's own JSON output reports none, so the native row has cost null (the row's shape is the same)"},
  {"case": "launch-settings-*-home-amp", "facet": "step*.pick", "why": "A3-4: bash's sed fill treats & in the replacement as the matched text, so a home folder with & in it puts the placeholder `{{USER_HOME}}` into the rules; Rust writes the path literally"},
  {"case": "launch-settings-*-home-backslash", "facet": "step*.pick", "why": "A3-4: bash's sed fill drops a backslash in the replacement (a\\b becomes ab); Rust writes the path literally"},
  {"case": "launch-whole-*-home-amp", "facet": "step*.json", "why": "A3-4: bash's sed fill treats & in the replacement as the matched text, so a home folder with & in it puts the placeholder `{{USER_HOME}}` into the rules; Rust writes the path literally"},
  {"case": "launch-whole-*-home-backslash", "facet": "step*.json", "why": "A3-4: bash's sed fill drops a backslash in the replacement (a\\b becomes ab); Rust writes the path literally"},
  {"case": "launch-whole-owner-allowed-broken", "facet": "step*.stderr", "why": "A3-5: the text of the JSON parse error of a damaged allowed.json is serde's, not Python's (the warning and the skip are the same)"},
  {"case": "launch-whole-guest-old-claude", "facet": "step*.stderr", "why": "A3-5: bash prints the version twice when Claude Code is too old (`version 2.0.12.0.1`, a quoting slip in the script); Rust prints it once"},
  {"case": "launch-whole-owner-no-such-agent", "facet": "step*.stderr", "why": "A3-5: after \"no agent named\" bash adds a spelling suggestion (\"Did you mean: ...\") or \"Run kith ls to see your agents.\"; the verb has only the first line, because the router and the host call it only for an agent that exists"},
  {"case": "threads-claim-pid-not-a-number-*", "facet": "*", "why": "A4-2: kith-sessions dies with a traceback (exit 1) on a claim file whose pid is no number, because its second pid_alive() shadows the first and does not catch TypeError; so does every other claim taken in a folder holding such a file (prune_stale visits it). Rust reads the claim as damaged: stale, replaced. Python is not changed in this PR"},
  {"case": "threads-resolve-glob-thread", "facet": "*", "why": "A4-2: kith-sessions looks a raw thread up with the glob `*/<thread>.jsonl`, so the thread `*` resolves to any transcript and claims `*.claim`; Rust accepts only a Claude session id (letters, digits, dashes) and says unknown thread"},
