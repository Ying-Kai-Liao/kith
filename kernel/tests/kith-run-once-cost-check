#!/usr/bin/env bash
# kith-run-once-cost-check — a one-shot over ACP that crashes or times out still reports what the engine had spent:
# `kith kernel run-once --json` puts cost_usd in its error, harness.py takes it into the result (total_cost_usd), so
# kith ask settles it and a delegation's cap counts it. An older host binary sends none: no cost, no crash.
# Also: a codex one-shot runs over its registry adapter with its MCP servers by name, in the run's session mode; `kith kernel accounts` notes
# reach core.log.
# Needs the Rust kith program (KITH_BIN, else a build under CARGO_TARGET_DIR / serve/host/target, before any installed one); skips without one.
#
#   kernel/tests/kith-run-once-cost-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
BIN=$(KITH_DEV_BIN=1 KITH_CORE=rust python3 "$KERNEL/lib/kith_paths.py" --bin)
if [ -z "$BIN" ]; then
  # Under CI a missing binary means the build step moved: fail, never pass by skipping.
  if [ -n "${CI:-}" ]; then echo "FAIL no Rust kith program under CI (build serve/host or set KITH_BIN)"; exit 1; fi
  echo "skip: no Rust kith program (build serve/host or set KITH_BIN)"; exit 0
fi
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-run-once-cost-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/state KITH_BIN=$BIN KITH_CORE=rust
unset KITH_PERSON KITH_AGENT KITH_HARNESS KITH_MODEL KITH_EFFORT HQ_HOME HQ_STATE CODEX_HOME
mkdir -p "$HOME" "$KITH_HOME" "$KITH_STATE" "$T/bin"
cp "$KERNEL/tests/difftest/fakes/qwen" "$T/bin/qwen"   # `qwen --acp` is the fake ACP agent
mkdir -p "$T/fakes" && cp "$KERNEL/tests/fakes/fake-acp-agent" "$T/fakes/"
sed -i.bak "s#/../../fakes/fake-acp-agent#/../fakes/fake-acp-agent#" "$T/bin/qwen"
export PATH=$T/bin:$PATH
echo "You echo." > "$T/prompt.md"; export KITH_RUN_PROMPT=$T/prompt.md

fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
# prints "<is_error> <total_cost_usd>" of the run's last JSON line
run() {
  python3 "$KERNEL/adapters/harness.py" qwen --output json -- hello 2>"$T/err" |
    python3 -c 'import json,sys; d=json.loads(sys.stdin.read().splitlines()[-1]); print(d["is_error"], d["total_cost_usd"])'
}

check "a crash after 0.25 spent: an error that carries the cost (kith ask settles it)" "[ \"\$(FAKE_ACP_MODE=crash FAKE_ACP_COST=0.25 run)\" = 'True 0.25' ]"
check "a crash with nothing spent: an error, no cost, no traceback" "[ \"\$(FAKE_ACP_MODE=crash run)\" = 'True None' ]"
check "a good run still reports its cost" "[ \"\$(FAKE_ACP_COST=0.25 run)\" = 'False 0.25' ]"

# codex has no ACP mode of its own: the one-shot starts its registry adapter (codex-acp, here through a fake uvx), and
# an MCP server goes as an ACP field, so a name like jev-browser reaches the engine as it is (codex's own -c keys kept
# the quotes and dropped the server).
printf '#!/bin/sh\nexit 0\n' > "$T/bin/codex"
printf '#!/bin/sh\nexec python3 "%s/fakes/fake-acp-agent"\n' "$T" > "$T/bin/uvx"
chmod +x "$T/bin/codex" "$T/bin/uvx"
mkdir -p "$T/serve"
echo '{"agents": [{"id": "codex-acp", "name": "Codex", "distribution": {"uvx": {"package": "codex-acp"}}}]}' > "$T/serve/registry.json"
echo '{"mcpServers": {"jev-browser": {"command": "node", "args": ["x.js"]}}}' > "$T/mcp.json"
KITH_SERVE_HOME=$T/serve KITH_RUN_MCP=$T/mcp.json FAKE_ACP_LOG=$T/acp.log \
  python3 "$KERNEL/adapters/harness.py" codex --output json -- hello 2>"$T/err" | tail -1 > "$T/codex.json"
check "codex one-shot: answered over its registry adapter" "python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert not d[\"is_error\"] and \"hello\" in d[\"result\"]' '$T/codex.json' 2>/dev/null"
check "codex one-shot: the jev-browser MCP server reaches the engine by its own name" "python3 -c 'import json,sys; s=[json.loads(l) for l in open(sys.argv[1])]; n=[m[\"params\"][\"mcpServers\"] for m in s if m[\"method\"]==\"session/new\"]; assert [x[\"name\"] for x in n[0]]==[\"jev-browser\"]' '$T/acp.log' 2>/dev/null"

# The session runs in the mode the native one-shot had, never codex-acp's default "agent" (its own reviewer answers
# escalations): workspace-write, or full access for a bypass run.
codex_mode() {
  rm -f "$T/mode.log"
  KITH_SERVE_HOME=$T/serve FAKE_ACP_LOG=$T/mode.log FAKE_ACP_MODES=agent,read-only,workspace-write,agent-full-access \
    python3 "$KERNEL/adapters/harness.py" codex --output json "$@" -- hello >/dev/null 2>"$T/err"
  python3 -c 'import json,sys; print(",".join(m["params"]["modeId"] for m in map(json.loads, open(sys.argv[1])) if m["method"]=="session/set_mode"))' "$T/mode.log"
}
check "codex one-shot: workspace-write, as native codex exec" "[ \"\$(codex_mode)\" = workspace-write ]"
check "codex one-shot: bypass gets full access" "[ \"\$(codex_mode --permission-mode bypassPermissions)\" = agent-full-access ]"

# `kith kernel accounts` exits before the verbs that run through the core, yet its notes (a state write or a settings
# migration it could not do) still go to core.log: the hook is set once for every kernel verb.
if [ "$(id -u)" != 0 ]; then
  mkdir -p "$KITH_STATE/logs"
  chmod 500 "$KITH_STATE"   # the verb can't make its lock file
  "$BIN" kernel accounts list >/dev/null 2>&1
  chmod 700 "$KITH_STATE"
  check "kernel accounts: a note the verb could not write reaches core.log" "grep -q 'settings migration' '$KITH_STATE/logs/core.log'"
fi

[ "$fails" = 0 ]
