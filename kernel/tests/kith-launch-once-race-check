#!/usr/bin/env bash
# kith-launch-once-race-check — two launches at once of a helper on one "just this once" grant (docs/plans/one-bot-model.md
# A3): `KITH_PERSON=sam KITH_AGENT=echo kith other --launch-json` twice in parallel, the grant being sam's
# helper_once for `other`. Exactly one consumes it (exit 0), the other is refused (exit 3), the grant is gone, and auth.json
# is still valid JSON with its other contents. The same on the Python path and, with a kith program, on the Rust path
# (switched through lib/core-switched.txt), and with one launch on each path racing for the one grant. The router falls
# back to Python without a word, so the Rust path is proved by a marker: the kith program is reached through a wrapper
# that records each `kernel launch` it is asked to run. Throwaway HOME / KITH_HOME; a fake claude.
#
#   kernel/tests/kith-launch-once-race-check          a few seconds; prints each check, exits 1 when one fails
#   KITH_DIFFTEST_BIN=/path/to/kith                   also the Rust path (else a build under $CARGO_TARGET_DIR / serve/host/target)
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-launch-once-race-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
fail=0
check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }

BIN=${KITH_DIFFTEST_BIN:-}
if [[ -z $BIN ]]; then
  for t in "${CARGO_TARGET_DIR:-}" "$KERNEL/../serve/host/target"; do
    for k in debug release; do [[ -n $t && -x $t/$k/kith ]] && { BIN=$t/$k/kith; break 2; }; done
  done
fi

mkdir -p "$T/bin"
printf '#!/bin/sh\n[ "$1" = --version ] && { echo "2.1.300 (Claude Code)"; exit 0; }\necho claude "$@"\n' > "$T/bin/claude"
chmod +x "$T/bin/claude"

# The kith program as the launches find it (KITH_BIN): a wrapper that notes each `kernel launch` and runs the real one,
# so a launch the router quietly gave to Python leaves no note.
if [[ -n $BIN ]]; then
  printf '#!/bin/sh\n[ "$1 $2" = "kernel launch" ] && echo launch >> "%s/rust-ran"\nexec "%s" "$@"\n' "$T" "$BIN" > "$T/bin/kith-wrapped"
  chmod +x "$T/bin/kith-wrapped"
fi

# One fresh world per run: two agents, sam a member of echo with one "just this once" for other.
world() {
  rm -rf "$T/w"; mkdir -p "$T/w/home" "$T/w/kith/state" "$T/w/tmp"
  for a in echo other; do
    mkdir -p "$T/w/kith/agents/$a/role"
    printf -- '---\nname: %s\ndescription: test agent\n---\nYou are %s.\n' "$a" "$a" > "$T/w/kith/agents/$a/role/agent.md"
    ( cd "$T/w/kith/agents/$a/role" && git init -q && git -c user.name=t -c user.email=t@example.com add -A \
        && git -c user.name=t -c user.email=t@example.com commit -qm init )
  done
  mkdir -p "$T/w/kith/state/secrets"
  printf '%s' '{"profiles": {}, "grants": {}, "env": {}, "people": {"kai": {"owner": true, "name": "Kai"}, "sam": {"name": "Sam"}}, "members": {"echo": {"sam": {"helper_once": {"other": 4102444800000}, "mode": "acceptEdits"}}}}' \
    > "$T/w/kith/state/secrets/auth.json"
}

# race CORE0 CORE1: run both launches at once, the first under KITH_CORE=CORE0 and the second under CORE1; sets $codes,
# $out0/$out1 and $rust_ran (how many of them the Rust path really ran)
race() {
  local cores=("$1" "$2") i
  world
  rm -f "$T/rust-ran"
  codes=()
  for i in 0 1; do
    ( cd "$T/w" && env -i HOME="$T/w/home" KITH_HOME="$T/w/kith" KITH_STATE="$T/w/kith/state" TMPDIR="$T/w/tmp" \
        PATH="$T/bin:/usr/bin:/bin:$(dirname "$(command -v python3)")" LANG=C.UTF-8 KITH_CORE="${cores[$i]}" ${BIN:+KITH_BIN="$T/bin/kith-wrapped"} \
        GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com \
        KITH_PERSON=sam KITH_AGENT=echo "$KERNEL/bin/kith" other --launch-json > "$T/out$i" 2> "$T/err$i"; echo $? > "$T/code$i" ) &
  done
  wait
  rust_ran=0; [[ -f $T/rust-ran ]] && rust_ran=$(wc -l < "$T/rust-ran" | tr -d ' ')
  codes=("$(cat "$T/code0")" "$(cat "$T/code1")")
}

AUTH=$T/w/kith/state/secrets/auth.json

# round NAME CORE0 CORE1 RUST_LAUNCHES: one race and the checks on it
round() {
  local name=$1 want=$4 sorted won
  race "$2" "$3"
  sorted=$(printf '%s\n' "${codes[@]}" | sort | tr '\n' ' ')
  check "$name: one launch took the grant, the other was refused (exits: $sorted)" "[ '$sorted' = '0 3 ' ]"
  won=1; [[ ${codes[0]} == 0 ]] && won=0
  check "$name: the winner printed a launch object" "python3 -c 'import json,sys; json.load(open(sys.argv[1]))' '$T/out$won'"
  check "$name: the loser printed nothing on stdout" "[ ! -s '$T/out$((1 - won))' ]"
  check "$name: the grant is used up and auth.json is valid" \
    "python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); m=d[\"members\"][\"echo\"][\"sam\"]; sys.exit(1 if m.get(\"helper_once\", {}).get(\"other\") else 0 if m.get(\"mode\") == \"acceptEdits\" and \"kai\" in d[\"people\"] else 1)' '$AUTH'"
  if [[ -n $BIN ]]; then
    check "$name: the Rust path ran in $want of the launches (it ran in $rust_ran)" "[ '$rust_ran' = '$want' ]"
  fi
}

for core in python rust; do
  if [[ $core == rust ]]; then
    if [[ -z $BIN ]]; then echo "skip rust path (no kith program: KITH_DIFFTEST_BIN)"; continue; fi
    check "the kith program lists launch" "'$BIN' kernel version | grep -q '\"launch\"'"
  fi
  for n in 1 2 3; do round "$core round $n" "$core" "$core" "$([[ $core == rust ]] && echo 2 || echo 0)"; done
done

# One launch on each path, in both orders: whichever takes the grant, the other is refused.
if [[ -n $BIN ]]; then
  for n in 1 2 3; do
    round "mixed round $n (python, rust)" python rust 1
    round "mixed round $n (rust, python)" rust python 1
  done
fi
exit $fail
