#!/usr/bin/env bash
# kith-auth-check — the `kith` account handle (a Clerk user id) and bot persons (never more than their owner's), in a
# throwaway auth.json (KITH_AUTH), never ~/.kith.
#
#   kernel/tests/kith-auth-check     a second or two; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-auth-check.XXXXXX")
trap 'rm -rf "$T"' EXIT
export KITH_AUTH=$T/auth.json HOME=$T/home KITH_HOME=$T/kith
unset KITH_STATE HQ_STATE KITH_PERSON KITH_AGENT HQ_HOME
mkdir -p "$HOME"
for a in house garden; do
  mkdir -p "$KITH_HOME/agents/$a/role"
  printf -- '---\nname: %s\ndescription: test\n---\nbody\n' "$a" > "$KITH_HOME/agents/$a/role/agent.md"
done
A() { python3 "$KERNEL/bin/kith-auth" "$@"; }
J() { python3 -c "import json,sys; d=json.load(sys.stdin); print(($1))"; }
R() { A resolve house --person "$1" | J "$2"; }   # R <person> <python expr over d>
fail=0
check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
A person kai owner >/dev/null 2>&1
A person bob >/dev/null 2>&1
check "kith handle takes a Clerk user id" "A handle kai kith user_2AbC123"
check "who finds the owner by it" "A who kith user_2AbC123 | grep -q '\"owner\": true'"
check "a Clerk id is refused on telegram" "! A handle kai telegram user_2AbC123"
check "a username is refused on kith" "! A handle kai kith kai"
check "another person can't take a bound kith id" "! A handle bob kith user_2AbC123"
check "handle --rm clears it" "A handle kai kith --rm && ! A whois kith user_2AbC123"

# --- bot persons: kai is the owner, sam an invitee; each bot belongs to one of them
A person sam >/dev/null 2>&1
A member house,garden sam budget=20 >/dev/null 2>&1
check "a bot of the owner" "A bot bot-k --of kai name=Rex provider=grok"
check "a bot of an invitee" "A bot bot-s --of sam name=Scout"
check "unknown parent refused" "! A bot bot-x --of nobody"
check "bot of a bot refused" "! A bot bot-y --of bot-s"
check "a real person's id is not a bot id" "! A bot sam --of kai"
check "moving a bot to another owner is refused" "! A bot bot-s --of kai"
check "same id twice updates, no duplicate" \
  "A bot bot-s --of sam name=Scout2 && [ \"\$(A people --json | J 'sum(1 for x in d if x[\"id\"]==\"bot-s\")')\" = 1 ] && A people --json | grep -q Scout2"
check "a bot with no row has no access" "! A may bot-s house"
A member house bot-s >/dev/null 2>&1
check "a bot with a row and an owner who holds the agent" "A may bot-s house"
A member garden bot-s >/dev/null 2>&1
A member garden sam --rm >/dev/null 2>&1
check "a row on an agent its owner lacks gives nothing" "! A may bot-s garden"
A member garden sam budget=20 >/dev/null 2>&1
A member house sam --rm >/dev/null 2>&1
check "the owner loses an agent: the bot is denied at once" "! A may bot-s house && [ \"\$(R bot-s 'd[\"allowed\"]')\" = False ]"
A member house sam budget=20 >/dev/null 2>&1
check "access returns with the owner's" "A may bot-s house"
A member house bot-k >/dev/null 2>&1
check "a bot of the owner passes with a row" "A may bot-k house"
A member garden '*' >/dev/null 2>&1
check "the everyone row never reaches a bot" "! A may bot-k garden"
check "a preset other than guest is refused" "! A member house bot-k preset=member"
check "budget= is refused with the reason" "! A member house bot-k budget=5 && [[ \$(A member house bot-k budget=5 2>&1) == *\"spends from its owner's budget\"* ]]"
check "people lists the bot under its parent" "A people | grep -A12 '^sam' | grep -q '└ bot-s'"
check "people --json: the bot right after its parent" \
  "[ \"\$(A people --json | J '[x[\"id\"] for x in d if x[\"id\"] in (\"sam\",\"bot-s\")]')\" = \"['sam', 'bot-s']\" ]"

A member house bot-s deny=Bash model=haiku helpers=garden env.TOKEN=abc >/dev/null 2>&1
A member house sam budget=20 deny=WebFetch model=sonnet helpers=house >/dev/null 2>&1
check "resolve: guest mode" "[ \"\$(R bot-s 'd[\"mode\"]')\" = default ]"
check "resolve: deny is guest + row + the parent's" "[ \"\$(R bot-s 'sorted(d[\"deny\"])')\" = \"['Bash', 'WebFetch']\" ]"
check "resolve: model is the row's" "[ \"\$(R bot-s 'd[\"model\"]')\" = haiku ]"
check "resolve: helpers are cut to the parent's" "[ \"\$(R bot-s 'd[\"helpers\"]')\" = '[]' ]"
check "resolve: env is the row's own" "[ \"\$(R bot-s 'd[\"env\"]')\" = \"{'TOKEN': 'abc'}\" ]"
check "resolve: budget is the parent's, for that agent" "[ \"\$(R bot-s 'd[\"budget\"], d[\"budget_agent\"]')\" = \"('20', 'house')\" ]"
A member house bot-s model= >/dev/null 2>&1
check "resolve: model falls back to the parent's" "[ \"\$(R bot-s 'd[\"model\"]')\" = sonnet ]"
A bot bot-s2 --of sam >/dev/null 2>&1
A member house bot-s2 >/dev/null 2>&1
A person sam id=samuel >/dev/null 2>&1
check "resolve: was is the parent, its old id and its other bots" "[ \"\$(R bot-s 'sorted(d[\"was\"])')\" = \"['bot-s2', 'sam', 'samuel']\" ]"
check "renaming the parent carries its bots along" "[ \"\$(A people --json | J '[x for x in d if x[\"id\"]==\"bot-s\"][0][\"bot_of\"]')\" = samuel ]"
check "the bot still works after the rename" "A may bot-s house"

check "an owner's bot has no cap by default" "[ \"\$(R bot-k 'd[\"budget\"]')\" = '' ]"
check "bots-cap sets it" "A bots-cap 50 | grep -q 50"
check "owner's bot: budget is the cap, over every agent" "[ \"\$(R bot-k 'd[\"budget\"], d[\"budget_agent\"]')\" = \"('50', '')\" ]"
A bot bot-k2 --of kai >/dev/null 2>&1
check "owner's bot: was is the other bots, never the owner" "[ \"\$(R bot-k 'd[\"was\"]')\" = \"['bot-k2']\" ]"
check "an invitee's bot ignores bots-cap" "[ \"\$(R bot-s 'd[\"budget\"]')\" = 20 ]"
check "bots-cap off" "A bots-cap off && [ \"\$(R bot-k 'd[\"budget\"]')\" = '' ]"
check "bots-cap refuses junk" "! A bots-cap lots"

check "removing the parent removes its bots" "A person samuel --rm >/dev/null && ! A people --json | grep -q bot-s"
check "bot --rm removes it and its rows" \
  "A bot bot-k --rm >/dev/null && ! A people --json | grep -q '\"bot-k\"' && ! grep -q '\"bot-k\"' \"\$KITH_AUTH\""
python3 - <<'PY'
import json, os
p = os.environ['KITH_AUTH']
d = json.load(open(p))
d['people']['bot-z'] = {'bot_of': 'ghost'}
d['members'] = {'house': {'bot-z': {}}}
json.dump(d, open(p, 'w'))
PY
check "a stale bot whose parent is gone is denied" "! A may bot-z house && [ \"\$(R bot-z 'd[\"allowed\"]')\" = False ]"

# --- F11: auto is a free shell like bypassPermissions: refused without --trusted, resolves to default when stored without it
A person eve >/dev/null 2>&1
A member house eve >/dev/null 2>&1
check "mode=auto without --trusted is refused" "! A member house eve mode=auto"
check "mode=bypassPermissions without --trusted is still refused" "! A member house eve mode=bypassPermissions"
check "mode=acceptEdits needs no --trusted" "A member house eve mode=acceptEdits"
check "mode=dontAsk needs no --trusted" "A member house eve mode=dontAsk"
check "mode=auto with --trusted is stored and runs as auto" "A member house eve mode=auto --trusted && [ \"\$(R eve 'd[\"mode\"], d[\"trusted\"]')\" = \"('auto', True)\" ]"
python3 - <<'PY'
import json, os
p = os.environ['KITH_AUTH']; a = json.load(open(p))
a['members']['house']['eve'] = {'mode': 'auto'}   # set by hand, before --trusted existed for auto
json.dump(a, open(p, 'w'))
PY
check "a stored auto row without trusted resolves to default" "[ \"\$(R eve 'd[\"mode\"], d[\"trusted\"]')\" = \"('default', False)\" ]"
check "the listing marks the downgraded row" "A people eve | grep -q 'mode=auto runs as default: set with --trusted to allow'"
check "an owner is never downgraded" "[ \"\$(R kai 'd[\"owner\"]')\" = True ]"

# --- an auth.json from before bots reads and behaves the same
cat > "$KITH_AUTH" <<'JSON'
{"people": {"kai": {"owner": true}, "bob": {}}, "members": {"house": {"bob": {"preset": "guest", "budget": "5"}}}}
JSON
check "old auth.json: a member resolves as before" "[ \"\$(R bob 'd[\"budget\"], d[\"was\"]')\" = \"('5', [])\" ]"
check "old auth.json: people --json has no bots" "[ \"\$(A people --json | J 'sum(1 for x in d if x[\"bot_of\"])')\" = 0 ]"
# --- "always" on an escape card (F11 step 2b): a place or website beyond the box, per membership, never more than held
mkdir -p "$T/docs/sub" "$T/more"
TR=$(cd "$T" && pwd -P)
A person ann >/dev/null 2>&1
A member house ann >/dev/null 2>&1
A bot bot-a --of ann name=Aide >/dev/null 2>&1
A bot bot-k2 --of kai name=Kbot >/dev/null 2>&1
A member house bot-a bot-k2 >/dev/null 2>&1
A member house bot-a >/dev/null 2>&1
A member house bot-k2 >/dev/null 2>&1
ACC() { R ann "d['access']"; }
check "access: a folder, a folder to write and a domain go in" "A access house ann read '$TR/docs' && A access house ann write '$TR/more' && A access house ann domain pypi.org"
check "access: resolve lists them" "[ \"\$(ACC)\" = \"{'read': ['$TR/docs'], 'write': ['$TR/more'], 'domains': ['pypi.org']}\" ]"
check "access: the same entry twice is one" "A access house ann read '$TR/docs' && [ \"\$(R ann 'len(d[\"access\"][\"read\"])')\" = 1 ]"
check "access: a secret is refused" "! A access house ann read \"\$(python3 \$KERNEL/lib/kith_paths.py --sh | sed -n \"s/^export KITH_SECRETS=//p\" | tr -d \"'\")\""
# Both layouts: ~/.config/kith is the secrets folder itself in the shared one (this fake home has no ~/.kith), ~/.kith/secrets in the other.
refused() { [[ "$(A access house ann "$@" 2>&1)" == *'never granted' ]]; }
CFG=$HOME/.config/kith
mkdir -p "$CFG"
for tgt in "$CFG" "$CFG/anything" "$HOME/.config" "$HOME"; do
  for kind in read write; do
    check "access: shared layout, $kind of ${tgt#$T/} is refused as a secret" "refused $kind '$tgt'"
  done
done
H2=$T/home2
mkdir -p "$H2/.kith/secrets"
for tgt in "$H2/.kith/secrets" "$H2/.kith/secrets/env" "$H2/.kith" "$H2"; do
  check "access: ~/.kith layout, read of ${tgt#$T/} is refused as a secret" "HOME='$H2' refused read '$tgt'"
done
check "access: a folder beside the secrets is still granted" "mkdir -p '$T/docs2' && A access house ann read '$T/docs2'"
check "access: rule W is refused (a project's .claude, the shell rc)" "! A access house ann write '$TR/docs/.claude/settings.json' && ! A access house ann write '$HOME/.zshrc'"
check "access: a relative path, a wildcard domain, an address are refused" "! A access house ann read docs && ! A access house ann domain '*.org' && ! A access house ann domain 1.2.3.4"
check "access: the owner needs none" "! A access house kai read '$TR/docs'"
A person carl >/dev/null 2>&1
check "access: someone who is not a person, or has no row of their own, is refused" "! A access house nobody read '$TR/docs' && ! A access garden ann read '$TR/docs' && ! A access house carl read '$TR/docs'"
check "access: a bot of the owner may hold any, a bot of an invitee only what the invitee holds" "A access house bot-k2 read '$TR/docs/sub' && A access house bot-a read '$TR/docs/sub' && ! A access house bot-a read '$TR/elsewhere' && ! A access house bot-a domain example.org"
check "access: a bot of an invitee loses it when the invitee does" "A access house ann read '$TR/docs' --rm && [ \"\$(R bot-a 'd[\"access\"][\"read\"]')\" = '[]' ]"
check "access: --rm takes one entry away" "A access house ann domain pypi.org --rm && [ \"\$(R ann 'd[\"access\"][\"domains\"]')\" = '[]' ]"
check "ledger: each grant with its key, person and when it was given" "A ledger --json | J \"sorted((g['kind'], g['target'], g['name'], isinstance(g['since'], int), g['key'] == g['kind'] + ':house:ann:' + g['target']) for g in d if g['person'] == 'ann') == [('read', '$TR/docs2', '', True, True), ('write', '$TR/more', '', True, True)] and ('bot-k2', 'Kbot') in [(g['person'], g['name']) for g in d]\" | grep -qx True"
A grant house@ann notion notion/ann >/dev/null 2>&1
A grant house@kai notion notion/kai >/dev/null 2>&1
A member garden ann >/dev/null 2>&1
A access garden ann domain example.com >/dev/null 2>&1
check "ledger: a person's own service grant is in it, the owner's isn't" "A ledger --json | J \"[(g['kind'], g['agent'], g['person'], g['target'], g['key']) for g in d if g['kind'] == 'service'] == [('service', 'house', 'ann', 'notion/ann', 'service:house:ann:notion/ann')]\" | grep -qx True"
check "ledger: --agent keeps one agent's" "A ledger --agent garden --json | J \"[(g['person'], g['kind'], g['target']) for g in d] == [('ann', 'domain', 'example.com')]\" | grep -qx True"
check "ledger: --person keeps one person's, on every agent" "A ledger --person ann --json | J \"sorted({g['agent'] for g in d}) == ['garden', 'house'] and all(g['person'] == 'ann' for g in d) and len(d) == 4\" | grep -qx True"
check "ledger: --person and --agent together" "A ledger --person bot-k2 --agent house --json | J \"[(g['person'], g['kind']) for g in d] == [('bot-k2', 'read')]\" | grep -qx True"
check "ledger: --agent of an agent with none is empty" "[ \"\$(A ledger --agent nowhere --json)\" = '[]' ]"
check "ledger: --rm <key> takes that one away, and the rest stay" "A ledger --rm 'service:house:ann:notion/ann' && A ledger --rm 'domain:garden:ann:example.com' && A ledger --person ann --json | J \"sorted(g['kind'] for g in d) == ['read', 'write']\" | grep -qx True && [ \"\$(A granted --for house@ann notion)\" = '' ]"
check "ledger: --rm of a key it doesn't hold fails, a malformed key too" "! A ledger --rm 'domain:garden:ann:example.com' && ! A ledger --rm 'exec:house:ann:/bin' && ! A ledger --rm 'read:house'"
check "access: --rm takes away a path that no longer exists" "mkdir -p '$TR/gone' && A access house ann read '$TR/gone' && rmdir '$TR/gone' && A access house ann read '$TR/gone' --rm && [ \"\$(R ann \"'$TR/gone' in d['access']['read']\")\" = False ]"
check "ledger: --rm takes away a path that no longer exists, by its key" "mkdir -p '$TR/gone' && A access house ann read '$TR/gone' && rmdir '$TR/gone' && A ledger --rm 'read:house:ann:$TR/gone' && [ \"\$(R ann \"'$TR/gone' in d['access']['read']\")\" = False ]"
check "access: removing the person removes it" "A person ann --rm >/dev/null 2>&1; ! A access house ann read '$TR/docs'"
# --- approved_by (M3): who approved an always; a person only while a member, checked in the same step; a demotion takes theirs
A person mia >/dev/null 2>&1
A member house mia preset=member >/dev/null 2>&1
A bot bot-m --of mia >/dev/null 2>&1
A member house bot-m >/dev/null 2>&1
mkdir -p "$TR/m1" "$TR/m2" "$TR/m3" "$TR/m4"
BY() { A ledger --person "$1" --agent house --json | J "sorted((g['target'].rsplit('/', 1)[-1], g['approved_by']) for g in d)"; }
check "approved_by: the owner's yes is 'owner', a member's own is their id" "A access house mia read '$TR/m1' && A access house mia read '$TR/m2' --by mia && A access house mia domain m.example --by mia && [ \"\$(BY mia)\" = \"[('m.example', 'mia'), ('m1', 'owner'), ('m2', 'mia')]\" ]"
check "approved_by: --by the owner is the owner" "A access house bob read '$TR/m3' --by kai && [ \"\$(BY bob)\" = \"[('m3', 'owner')]\" ]"
check "approved_by: a member approves for their own bot" "A access house bot-m read '$TR/m2' --by mia && [ \"\$(BY bot-m)\" = \"[('m2', 'mia')]\" ]"
check "approved_by: not for someone else, and a guest never" "! A access house bob read '$TR/m4' --by mia && [[ \"\$(A access house bob read '$TR/m4' --by bob 2>&1)\" == *'not a member of house now'* ]]"
check "approved_by: a person's yes never replaces the owner's, the owner's replaces a person's" "A access house mia read '$TR/m1' --by mia && A access house mia read '$TR/m4' --by mia && A access house mia read '$TR/m4' && [ \"\$(BY mia)\" = \"[('m.example', 'mia'), ('m1', 'owner'), ('m2', 'mia'), ('m4', 'owner')]\" ]"
check "approved_by: --by takes a person and no --rm" "! A access house mia read '$TR/m1' --by && ! A access house mia read '$TR/m1' --rm --by mia"
check "demotion: member -> guest says what went" "[[ \"\$(A member house mia preset=guest)\" == *'3 always entries they approved went'* ]]"
check "demotion: their own yeses go, on their bot's row too; the owner's stay" "[ \"\$(BY mia)\" = \"[('m1', 'owner'), ('m4', 'owner')]\" ] && [ \"\$(BY bot-m)\" = '[]' ]"
check "demotion: a guest can't approve one again" "! A access house mia read '$TR/m2' --by mia"
check "demotion: made a member again, nothing comes back" "A member house mia preset=member && [ \"\$(BY mia)\" = \"[('m1', 'owner'), ('m4', 'owner')]\" ]"
check "demotion: a change that keeps them a member drops nothing" "A access house mia read '$TR/m2' --by mia && A member house mia budget=5 && [ \"\$(BY mia)\" = \"[('m1', 'owner'), ('m2', 'mia'), ('m4', 'owner')]\" ]"
check "removed from the agent: what they approved for their bot goes too" "A member house bot-m >/dev/null && A access house bot-m read '$TR/m2' --by mia && [[ \"\$(A member house mia --rm)\" == *'(2 always entries they approved went)'* ]] && [ \"\$(BY bot-m)\" = '[]' ]"
check "renamed: their yeses follow the new id, and a demotion still takes them" "A member house mia preset=member && A access house mia read '$TR/m2' --by mia && A person mia id=mio && [ \"\$(BY mio)\" = \"[('m2', 'mio')]\" ] && A member house mio preset=guest && [ \"\$(BY mio)\" = '[]' ]"
A person lea >/dev/null 2>&1
A member house lea preset=member >/dev/null 2>&1
A access house lea read "$TR/m1" >/dev/null 2>&1
A access house lea read "$TR/m2" --by lea >/dev/null 2>&1
python3 - <<'PY'
import json, os
p = os.environ['KITH_AUTH']; a = json.load(open(p))
a['members']['house']['lea'].pop('access_by')   # entries written before approved_by was recorded
json.dump(a, open(p, 'w'))
PY
check "approved_by: an entry from before it was recorded is null, and a demotion leaves it" "[ \"\$(BY lea)\" = \"[('m1', None), ('m2', None)]\" ] && A member house lea preset=guest && [ \"\$(BY lea)\" = \"[('m1', None), ('m2', None)]\" ]"
# a member's yes racing their demotion: whichever runs first under the lock, no guest keeps a yes of their own
bad=0
for i in $(seq 1 15); do
  A person "d$i" >/dev/null 2>&1
  A member house "d$i" preset=member >/dev/null 2>&1
  ( A access house "d$i" domain "d$i.example" --by "d$i" >/dev/null 2>&1 ) &
  ( A member house "d$i" preset=guest >/dev/null 2>&1 ) &
  wait
  [ "$(BY "d$i")" = '[]' ] || bad=$((bad + 1))
done
check "15 parallel approve-vs-demote races: no guest keeps their own yes ($bad bad)" "[ $bad = 0 ]"
# --- holders: who on this Mac holds a service (the host's "ask the agent that holds it")
A grant house notion notion/kai >/dev/null 2>&1
A grant garden slack slack/kai >/dev/null 2>&1
check "holders: the agents granted a profile of the service, as lines and as json" "[ \"\$(A holders notion)\" = house ] && [ \"\$(A holders notion --json)\" = '[{\"agent\": \"house\", \"profiles\": [\"notion/kai\"]}]' ]"
check "holders: a service nobody holds is empty, a bad name is refused" "[ \"\$(A holders nothing --json)\" = '[]' ] && ! A holders 'No/Way'"
A person hal >/dev/null 2>&1
A member house hal >/dev/null 2>&1
A person carl >/dev/null 2>&1
A grant house@hal slack slack/hal >/dev/null 2>&1
check "holders: a person's own agent@person grant makes no holder" "[ \"\$(A holders slack)\" = garden ]"
A grant ghost notion notion/kai >/dev/null 2>&1
check "holders: a name that is not an agent here is no holder" "[ \"\$(A holders notion)\" = house ]"
check "holders: a guest sees only the holders it may use" "[ \"\$(KITH_PERSON=hal A holders notion)\" = house ] && [ \"\$(KITH_PERSON=carl A holders slack)\" = '' ]"
A revoke house notion >/dev/null 2>&1
check "holders: a revoked grant is no longer a holder" "[ \"\$(A holders notion)\" = '' ]"
A grant house notion notion/kai >/dev/null 2>&1
check "holders: granted again, it is a holder again" "[ \"\$(A holders notion)\" = house ]"
A person hal --revoke >/dev/null 2>&1
check "holders: a revoked guest sees none, and undo brings back what it saw" "[ \"\$(KITH_PERSON=hal A holders notion)\" = '' ] && A person hal --unrevoke >/dev/null 2>&1 && [ \"\$(KITH_PERSON=hal A holders notion)\" = house ]"
exit $fail
