# another writer's live claim (the host's app turn, a terminal) holds the session: refused, never written over
sleep 30 & holder=$!
printf '{"pid":%s,"procStart":"%s","at":"x","kind":"app"}' "$holder" "$(LC_ALL=C ps -o lstart= -p $holder | xargs)" > "$REG/os3.claim"
out=$(cd "$T/work/a" && KITH_RESUME=os3 STUB_OUT=$T/os-e.out KITH_CLAIM_WAIT=0 "$KERNEL/bin/kith" designer "x" 2>&1); is "one-shot resume: host's claim holds" "$?" 1
[[ $out == *"held by app (pid $holder)"* ]] && ok "one-shot resume: names the host's claim" || bad "host claim message" "$out"
kill $holder 2>/dev/null; wait $holder 2>/dev/null

exit $fail
