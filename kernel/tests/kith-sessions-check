#!/usr/bin/env bash
# kith-sessions-check — continue anywhere, the kernel side: `kith <agent>` terminal sessions are recorded for the host
# (bin/kith-sessions record), `kith <agent> --resume <thread>` picks one up, and a take-over leaves a note.
#
#   kernel/tests/kith-sessions-check     a few seconds; prints each check, exits 1 when one fails
#
# claude is a stub on PATH (it fires the SessionStart hook the way Claude Code does, then exits or waits); the host is a
# stub http server on a free port. Nothing touches the real ~/.kith or ~/.claude.
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-sessions-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'kill $HOSTPID 2>/dev/null; rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/state CLAUDE_CONFIG_DIR=$T/claude
unset KITH_PROJECT KITH_PERSON KITH_AGENT KITH_PERMISSION_MODE HQ_HOME HQ_STATE KITH_VIA KITH_HIDE_SESSION KITH_RESUME KITH_CLAUDE_ARGS
mkdir -p "$HOME" "$KITH_STATE" "$KITH_HOME/agents/designer/role" "$CLAUDE_CONFIG_DIR/sessions" "$CLAUDE_CONFIG_DIR/projects/p" "$T/bin" "$T/work/a" "$T/serve"
printf -- '---\nname: designer\ndescription: test agent\n---\nbody\n' > "$KITH_HOME/agents/designer/role/agent.md"
SK=$KERNEL/bin/kith-sessions
REG=$KITH_STATE/live/terminal
fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
is() { [[ $2 == "$3" ]] && ok "$1" || bad "$1" "got '$2', wanted '$3'"; }
field() { python3 -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2]); print("" if v is None else v)' "$1" "$2"; }

hook() {   # hook <sid> <cwd> <source> [VAR=value ...] — the SessionStart hook, run from a child of a fake "claude" process
  local sid=$1 cwd=$2 src=$3; shift 3
  printf '{"session_id":"%s","transcript_path":"%s/%s.jsonl","cwd":"%s","source":"%s"}' "$sid" "$CLAUDE_CONFIG_DIR/projects/p" "$sid" "$cwd" "$src" |
    env KITH_STATE=$KITH_STATE KITH_AGENT=designer KITH_TERMINAL_SESSION=1 "$@" python3 "$SK" record
}

# --- the listable / not listable matrix ---------------------------------------------------------------------------------
hook s-ok "$T/work/a" startup;                                   [[ -f $REG/s-ok.json ]] && ok "listable: written" || bad "listable: written"
hook s-oneshot "$T/work/a" startup KITH_TERMINAL_SESSION=;      [[ ! -e $REG/s-oneshot.json ]] && ok "-p one-shot (flag unset): nothing" || bad "-p one-shot writes"
hook s-person "$T/work/a" startup KITH_PERSON=anna;             [[ ! -e $REG/s-person.json ]] && ok "KITH_PERSON: nothing" || bad "person writes"
hook s-serve "$T/work/a" startup KITH_VIA=serve;                [[ ! -e $REG/s-serve.json ]] && ok "KITH_VIA=serve: nothing" || bad "via serve writes"
hook s-term "$T/work/a" startup KITH_VIA=terminal;              [[ -f $REG/s-term.json ]] && ok "KITH_VIA=terminal: written" || bad "via terminal"
hook s-hide "$T/work/a" startup KITH_HIDE_SESSION=1;            [[ ! -e $REG/s-hide.json ]] && ok "KITH_HIDE_SESSION: nothing" || bad "hide writes"
# one-shots of the owner's (bin/kith sets KITH_RUN_KIND for exactly that run): listed with their kind and who started them
hook s-ask "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=ask KITH_RUN_KIND=ask KITH_RUN_LABEL=architect
is "ask: kind" "$(field $REG/s-ask.json kind)" ask
is "ask: label" "$(field $REG/s-ask.json label)" "asked by architect"
hook s-ask0 "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=ask KITH_RUN_KIND=ask
is "ask from a terminal: label" "$(field $REG/s-ask0.json label)" "asked from a terminal"
hook s-sched "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=schedule KITH_RUN_KIND=schedule KITH_RUN_LABEL=daily
is "schedule: kind and label" "$(field $REG/s-sched.json kind)/$(field $REG/s-sched.json label)" "schedule/scheduled: daily"
hook s-help "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=terminal KITH_RUN_KIND=helper KITH_RUN_LABEL=architect
is "helper: kind and label" "$(field $REG/s-help.json kind)/$(field $REG/s-help.json label)" "helper/helper of architect"
is "terminal: kind" "$(field $REG/s-ok.json kind)" terminal
is "one-shot records the claude process start" "$([[ -n $(field $REG/s-ask.json procStart) ]] && echo yes || echo no)" "$([[ -n $(field $REG/s-ask.json pid) ]] && echo yes || echo no)"
hook s-ask-person "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=ask KITH_RUN_KIND=ask KITH_PERSON=anna
[[ ! -e $REG/s-ask-person.json ]] && ok "ask with KITH_PERSON: nothing" || bad "person's ask written"
hook s-ask-hide "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_RUN_KIND=ask KITH_HIDE_SESSION=1
[[ ! -e $REG/s-ask-hide.json ]] && ok "ask with KITH_HIDE_SESSION: nothing" || bad "hidden ask written"
hook s-ask-wt "$T/x/.claude/worktrees/w1" startup KITH_TERMINAL_SESSION= KITH_RUN_KIND=ask
[[ ! -e $REG/s-ask-wt.json ]] && ok "ask in an agent worktree: nothing" || bad "worktree ask written"
hook s-ask-serve "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_VIA=serve
[[ ! -e $REG/s-ask-serve.json ]] && ok "host run (KITH_VIA=serve, no kind): nothing" || bad "serve run written"
hook s-ask-bad "$T/work/a" startup KITH_TERMINAL_SESSION= KITH_RUN_KIND=serve
[[ ! -e $REG/s-ask-bad.json ]] && ok "unknown kind: nothing" || bad "unknown kind written"
hook s-term-kind "$T/work/a" startup KITH_RUN_KIND=ask
is "interactive terminal ignores a stray kind" "$(field $REG/s-term-kind.json kind)" terminal
hook s-wt "$T/x/.claude/worktrees/w1" startup;                  [[ ! -e $REG/s-wt.json ]] && ok "worktree cwd: nothing" || bad "worktree writes"
hook s-noagent "$T/work/a" startup KITH_AGENT=;                 [[ ! -e $REG/s-noagent.json ]] && ok "no agent: nothing" || bad "no agent writes"
printf '{"session_id":"s-nostate","cwd":"/x","source":"startup"}' | env -u KITH_STATE KITH_AGENT=designer KITH_TERMINAL_SESSION=1 python3 "$SK" record
[[ $? == 0 ]] && ok "no KITH_STATE: skipped, exit 0" || bad "no KITH_STATE"
printf 'not json' | python3 "$SK" record 2>/dev/null; [[ $? == 0 ]] && ok "bad stdin: exit 0" || bad "bad stdin"

# --- the file: contract fields, modes, no temp files left ----------------------------------------------------------------
f=$REG/s-ok.json
is "sessionId" "$(field $f sessionId)" s-ok
is "agent" "$(field $f agent)" designer
is "cwd" "$(field $f cwd)" "$T/work/a"
is "transcriptPath" "$(field $f transcriptPath)" "$CLAUDE_CONFIG_DIR/projects/p/s-ok.jsonl"
is "source" "$(field $f source)" startup
is "v" "$(field $f v)" 1
is "resumedFrom null" "$(field $f resumedFrom)" ""
is "file mode 0600" "$(stat -f %Lp $f)" 600
is "dir mode 0700" "$(stat -f %Lp $REG)" 700
is "no tmp files left" "$(ls -A $REG | grep -c '\.tmp$')" 0
hook s-res "$T/work/a" resume KITH_RESUMED_FROM=abc KITH_PROJECT=proj
is "resumedFrom" "$(field $REG/s-res.json resumedFrom)" abc
is "project" "$(field $REG/s-res.json project)" proj
# compact rewrites the same file and keeps when it began; a pid is found from the parent chain (the fake claude's sessions file)
sleep 300 & SLEEPPID=$!
printf '{"pid":%s,"sessionId":"s-pid"}' "$SLEEPPID" > "$CLAUDE_CONFIG_DIR/sessions/$SLEEPPID.json"
hook s-pid "$T/work/a" startup; started=$(field $REG/s-pid.json startedAt)
sleep 1.1; hook s-pid "$T/work/a" compact
is "compact keeps startedAt" "$(field $REG/s-pid.json startedAt)" "$started"
is "compact source" "$(field $REG/s-pid.json source)" compact
kill $SLEEPPID 2>/dev/null; wait $SLEEPPID 2>/dev/null

# --- the launcher: stub claude, stub host -------------------------------------------------------------------------------
cat > "$T/bin/claude" <<'STUB'
#!/usr/bin/env bash
# plugin list: nothing; otherwise record how it was called, fire the SessionStart hook as Claude Code does, wait for a
# marker if asked, then exit with STUB_EXIT.
[[ $1 == plugin ]] && { echo '[]'; exit 0; }
# The session is STUB_SID, else the one claude was told (--session-id, else --resume), as Claude Code does. Line 5: the writer
# claim on it as claude starts, "<kind>:self" (claude's own pid, exec'd) or "<kind>:parent" (kith-sessions run), else empty.
sid=${STUB_SID:-}; given="" resumed="" prev=""
for x in "$@"; do [[ $prev == --session-id ]] && given=$x; [[ $prev == --resume ]] && resumed=$x; prev=$x; done
sid=${sid:-${given:-${resumed:-stub-sid}}}
c=$KITH_STATE/live/terminal/$sid.claim; held=""
[[ -f $c ]] && held=$(python3 -c 'import json,sys; c=json.load(open(sys.argv[1])); p=c["pid"]
print(c["kind"] + ":" + ("self" if p == int(sys.argv[2]) else "parent" if p == int(sys.argv[3]) else str(p)))' "$c" $$ $PPID)
a=$*; printf '%s\n' "$PWD" "${a//$'\n'/ }" "${KITH_RESUMED_FROM:-}" "${KITH_TERMINAL_SESSION:-}" "$held" > "$STUB_OUT"
printf '{"pid":%s,"sessionId":"%s"}' "$$" "$sid" > "$CLAUDE_CONFIG_DIR/sessions/$$.json"
printf '{"session_id":"%s","transcript_path":"%s/p/%s.jsonl","cwd":"%s","source":"startup"}' "$sid" "$CLAUDE_CONFIG_DIR/projects" "$sid" "$PWD" |
  python3 -c 'import json,sys,subprocess; h=json.load(sys.stdin); import os
cmd=json.load(open(os.environ["SETTINGS"]))["hooks"]["SessionStart"][-1]["hooks"][0]["command"]
subprocess.run(cmd, shell=True, input=json.dumps(h).encode())' 2>/dev/null
[[ -n ${STUB_WAIT:-} ]] && { while [[ ! -e $STUB_WAIT ]]; do sleep 0.1; done; }
exit ${STUB_EXIT:-0}
STUB
chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH STUB_OUT=$T/stub.out
# the settings file the launcher builds is in the run files, which are removed at exit: copy it from --settings when the stub runs
mv "$T/bin/claude" "$T/bin/claude.real"
cat > "$T/bin/claude" <<'WRAP'
#!/usr/bin/env bash
[[ $1 == plugin ]] && exec "$(dirname "$0")/claude.real" "$@"
prev=""; for a in "$@"; do [[ $prev == --settings ]] && cp "$a" "$STUB_SETTINGS"; prev=$a; done
export SETTINGS=$STUB_SETTINGS
exec "$(dirname "$0")/claude.real" "$@"
WRAP
chmod +x "$T/bin/claude"
export STUB_SETTINGS=$T/settings.json

tty() { script -q /dev/null "$@" >"$T/tty.out" 2>&1 < <(sleep 20); }   # a terminal for the interactive run; stdout/err captured to a file

# the SessionStart hook list keeps kith-cost first and adds kith-sessions
rm -rf "$REG"; (cd "$T/work/a" && STUB_SID=run1 tty "$KERNEL/bin/kith" designer)
cmds=$(python3 -c 'import json; print("|".join(h["hooks"][0]["command"].rsplit("/",1)[-1] for h in json.load(open("'$T/settings.json'"))["hooks"]["SessionStart"]))')
[[ $cmds == *"kith-cost\" tag|kith-sessions\" record"* ]] && ok "settings: kith-cost tag then kith-sessions record" || bad "hook list" "$cmds"
[[ -f $REG/run1.json ]] && ok "interactive run: registered" || bad "interactive run: registered"
is "interactive: claude's cwd" "$(sed -n 1p $T/stub.out)" "$T/work/a"
is "interactive: flag set for the hook" "$(sed -n 4p $T/stub.out)" 1
is "no resume: no resumedFrom" "$(field $REG/run1.json resumedFrom)" ""
is "pid is the claude process" "$(python3 -c 'import json;print("ok" if json.load(open("'$REG/run1.json'"))["pid"] else "none")')" ok

# a one-shot never sets the flag and never registers
rm -rf "$REG"; (cd "$T/work/a" && STUB_SID=once "$KERNEL/bin/kith" designer "say hi" >/dev/null 2>&1)
is "-p one-shot: flag unset" "$(sed -n 4p $T/stub.out)" ""
[[ ! -e $REG/once.json ]] && ok "-p one-shot: not registered" || bad "-p one-shot registered"

# exit code passes through
(cd "$T/work/a" && STUB_EXIT=7 tty "$KERNEL/bin/kith" designer); is "exit code passes through" "$?" 7

# --resume flag parsing and the host
cat > "$T/host.py" <<'PY'
import json, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
ANSWERS = json.load(open(sys.argv[2]))
OLD = len(sys.argv) > 3 and sys.argv[3] == "old"   # a host from before continue-anywhere: no resolveThread
class H(BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if OLD:
            self.send_response(404); self.end_headers(); self.wfile.write(b'{"error":"unknown method"}'); return
        ok = self.headers.get("Authorization") == "Bearer tok" and self.path == "/api/resolveThread"
        a = ANSWERS.get(body["thread"], {"error": "unknown thread"}) if ok else {"error": "no"}
        self.send_response(200 if ok and "error" not in a else 400); self.end_headers(); self.wfile.write(json.dumps(a).encode())
    def log_message(self, *a): pass
HTTPServer(("127.0.0.1", int(sys.argv[1])), H).serve_forever()
PY
mkdir -p "$T/work/b"
cat > "$T/answers.json" <<JSON
{"th-1": {"botId":"b","threadId":"th-1","agent":"designer","sessionId":"app-sid","cwd":"$T/work/b","hostBusy":false,"claims":1},
 "app-sid": {"botId":"b","threadId":"th-1","agent":"designer","sessionId":"app-sid","cwd":"$T/work/b","hostBusy":false,"claims":1},
 "th-busy": {"botId":"b","threadId":"th-busy","agent":"designer","sessionId":"busy-sid","cwd":"$T/work/b","hostBusy":true,"claims":1},
 "busy-sid": {"botId":"b","threadId":"th-busy","agent":"designer","sessionId":"busy-sid","cwd":"$T/work/b","hostBusy":true,"claims":1},
 "th-noclaims": {"botId":"b","threadId":"th-noclaims","agent":"designer","sessionId":"nc-sid","cwd":"$T/work/b","hostBusy":false},
 "th-other": {"botId":"b","threadId":"th-other","agent":"coder","sessionId":"o-sid","cwd":"$T/work/b","hostBusy":false,"claims":1}}
JSON
PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
echo tok > "$T/serve/token"
python3 "$T/host.py" "$PORT" "$T/answers.json" & HOSTPID=$!
sleep 0.5
export KITH_SERVE_DIR=$T/serve KITH_SERVE_PORT=$PORT

(cd "$T/work/a" && STUB_SID=app-sid tty "$KERNEL/bin/kith" designer --resume th-1); rc=$?
is "--resume thread: exit" "$rc" 0
is "--resume: runs in the thread's cwd" "$(sed -n 1p $T/stub.out)" "$T/work/b"
[[ "$(sed -n 2p $T/stub.out)" == *"--resume app-sid"* ]] && ok "--resume: claude gets --resume <sessionId>" || bad "--resume args" "$(sed -n 2p $T/stub.out)"
is "--resume: resumedFrom in the registry" "$(field $REG/app-sid.json resumedFrom)" app-sid
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume th-busy 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"answering in that thread"* ]] && ok "--resume: refuses while the app is replying" || bad "hostBusy" "$rc $err"
# a refusal must stop the launcher: under a tty, claude never ran (eval of the empty output used to succeed)
rm -f "$T/stub.out"; (cd "$T/work/a" && tty "$KERNEL/bin/kith" designer --resume th-busy)
[[ ! -e $T/stub.out ]] && ok "--resume refused (host busy): claude never started" || bad "refusal started claude"
rm -f "$T/stub.out"; (cd "$T/work/a" && tty "$KERNEL/bin/kith" designer --resume th-noclaims)
[[ ! -e $T/stub.out ]] && ok "host without claims: refused, claude never started" || bad "no-claims host started claude"
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume th-noclaims 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"update kith serve"* ]] && ok "host without claims: treated like an old host" || bad "no-claims message" "$rc $err"
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume th-other 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"belongs to coder"* ]] && ok "--resume: refuses another agent's thread" || bad "agent mismatch" "$rc $err"
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"--resume needs"* ]] && ok "--resume without a value" || bad "no value" "$rc $err"
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume nope 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"unknown thread"* ]] && ok "--resume: unknown thread" || bad "unknown" "$rc $err"
# the claim: a finished run gives it back, a refusal because the app is busy gives it back, a second writer is refused
is "--resume: claim given back when claude exits" "$(ls $REG | grep -c '\.claim$')" 0
is "--resume refused (host busy): no claim left" "$(ls $REG | grep -c '\.claim$')" 0
claimcli() {   # claimcli <fn> <args...> — a kith-sessions function, called from python
  python3 - "$SK" "$@" <<'PY'
import importlib.machinery, importlib.util, json, os, sys
l = importlib.machinery.SourceFileLoader('ks', sys.argv[1]); m = importlib.util.module_from_spec(importlib.util.spec_from_loader('ks', l)); l.exec_module(m)
fn, args = sys.argv[2], sys.argv[3:]
if fn == 'take':      # take SID PID -> "taken" or "held <pid>"
    h = m.take_claim(args[0], int(args[1])); print('taken' if h is None else f'held {h["pid"]}')
elif fn == 'mode':
    print(oct(os.stat(m.claim_path(args[0])).st_mode & 0o777))
PY
}
sleep 300 & C1=$!; sleep 300 & C2=$!
is "claim: first taker wins" "$(claimcli take cs-1 $C1)" taken
is "claim: second taker refused, names the holder" "$(claimcli take cs-1 $C2)" "held $C1"
is "claim file mode 0600" "$(claimcli mode cs-1)" 0o600
is "claim holds the claimer's pid" "$(field $REG/cs-1.claim pid)" "$C1"
[[ -n $(field $REG/cs-1.claim procStart) ]] && ok "claim has procStart" || bad "claim procStart"
[[ -n $(field $REG/cs-1.claim at) ]] && ok "claim has at" || bad "claim at"
is "no claim temp files left" "$(ls -A $REG | grep -c 'tmp$\|stale')" 0
# the start time is the same text in any locale: a claim taken under zh_TW is live for a reader in C
is "claim taken in another locale" "$(LC_ALL=zh_TW.UTF-8 claimcli take cs-loc $C1)" taken
is "claim read in the C locale is live (not stale)" "$(LC_ALL=C claimcli take cs-loc $C2)" "held $C1"
is "claim read in another locale is live" "$(LC_ALL=zh_TW.UTF-8 claimcli take cs-loc $C2)" "held $C1"
kill $C1 2>/dev/null; wait $C1 2>/dev/null
is "claim of a dead claimer is stale: taken over" "$(claimcli take cs-1 $C2)" taken
is "the new claimer owns it" "$(field $REG/cs-1.claim pid)" "$C2"
python3 - "$REG/cs-1.claim" "$C2" <<'PY'
import json, sys
json.dump({"pid": int(sys.argv[2]), "procStart": "Mon Jan  1 00:00:00 2001", "at": "x"}, open(sys.argv[1], "w"))
PY
is "claim of a reused pid (other procStart) is stale" "$(claimcli take cs-1 $C2)" taken
# a one-shot's claim carries the person it runs for (the revoke sweep finds it by that); the owner's has none
python3 "$SK" claim cs-pers "$C1" guest-sam; is "claim: a person's one-shot names the person" "$(field $REG/cs-pers.claim person)" guest-sam
is "claim: the one-shot kind is kept" "$(field $REG/cs-pers.claim kind)" oneshot
python3 "$SK" claim cs-own "$C1"; is "claim: the owner's has no person" "$(field $REG/cs-own.claim person)" ""
is "claim: a person's one-shot names the agent" "$(python3 "$SK" claim cs-ag "$C1" guest-sam money; field $REG/cs-ag.claim agent)" money
python3 "$SK" proc "$C1" guest-sam money
is "proc claim: names the person" "$(field $REG/proc-$C1.claim person)" guest-sam
is "proc claim: names the agent" "$(field $REG/proc-$C1.claim agent)" money
is "proc claim: names the pid" "$(field $REG/proc-$C1.claim pid)" "$C1"
is "proc claim: kind the host reads (no session held)" "$(field $REG/proc-$C1.claim kind)" app
sleep 300 & C9=$!; python3 "$SK" proc "$C9" guest-sam money; kill $C9; wait $C9 2>/dev/null; python3 "$SK" proc "$C1" guest-sam money
[[ ! -e $REG/proc-$C9.claim ]] && ok "proc claim: a dead run's claim is pruned" || bad "stale proc claim kept"
rm -f $REG/cs-pers.claim $REG/cs-own.claim
rm -f $REG/proc-*.claim
# a second terminal --resume on a claimed session is refused, before anything starts
python3 - "$REG/cs-2.claim" "$C2" <<'PY'
import json, subprocess, sys
ps = ' '.join(subprocess.run(['ps', '-o', 'lstart=', '-p', sys.argv[2]], capture_output=True, text=True, env={'LC_ALL': 'C'}).stdout.split())
json.dump({"pid": int(sys.argv[2]), "procStart": ps, "at": "x", "kind": "terminal"}, open(sys.argv[1], "w"))
PY
printf '{"cwd":"%s","type":"user"}\n' "$T/work/b" > "$CLAUDE_CONFIG_DIR/projects/p/cs-2.jsonl"
err=$(cd "$T/work/a" && "$KERNEL/bin/kith" designer --resume cs-2 2>&1 >/dev/null); rc=$?
[[ $rc != 0 && $err == *"open in another writer (pid $C2"* ]] && ok "--resume: a claimed session is refused (second terminal)" || bad "claimed" "$rc $err"
[[ ! -e $REG/cs-2.json ]] && ok "refused: claude never started" || bad "claude started"
# -r <id>, -r (picked) and -c reach the same claim: a claimed session is refused and claude never starts. The names come from the
# cost ledger (a run with a transcript); the later started time makes the session the newest begun here.
export KITH_MACHINE=$(python3 "$KERNEL/lib/kith_paths.py" --json | python3 -c 'import json, sys; print(json.load(sys.stdin)["KITH_MACHINE"])')
mkdir -p "$KITH_MACHINE"
sqlite3 "$KITH_MACHINE/cost.db" "create table if not exists runs (session text primary key, agent text, version text, model text, effort text, via text, project text, started text, person text, provider text, account text);
  insert into runs (session, agent, via, project, started) values ('cs-2', 'designer', 'terminal', 'p', '2026-10-23T12:00:00');"
rm -f "$T/stub.out"; (cd "$T/work/b" && tty "$KERNEL/bin/kith" designer -r cs-2); err=$(cat "$T/tty.out")
[[ ! -e $T/stub.out && $err == *"open in another writer"* ]] && ok "-r <id>: a claimed session is refused, claude never started" || bad "-r id claimed" "$err"
rm -f "$T/stub.out"; (cd "$T/work/b" && tty "$KERNEL/bin/kith" designer -c); err=$(cat "$T/tty.out")
[[ ! -e $T/stub.out && $err == *"open in another writer"* ]] && ok "-c: the latest session, claimed elsewhere, is refused; claude never started" || bad "-c claimed" "$err"
(cd "$T/work/b" && "$KERNEL/bin/kith" designer -c >/dev/null 2>&1); rc=$?
is "-c: refusal exits 1" "$rc" 1
# the picker with nothing chosen (stdin at EOF) is an exit, never a fresh claude
rm -f "$T/stub.out"; (cd "$T/work/b" && "$KERNEL/bin/kith" designer -r </dev/null >/dev/null 2>&1); rc=$?
