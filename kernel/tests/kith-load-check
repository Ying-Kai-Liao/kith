#!/usr/bin/env bash
# kith-load-check — the memory a run starts with (the load filter of docs/memory-context.md), through `kith <agent> --print`
# in a throwaway HOME and KITH_HOME with fixture memory (the real ~/.kith is never read or written).
#
#   kernel/tests/kith-load-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-load-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_STATE=$T/dot KITH_AUTH=$T/dot/auth.json
unset KITH_AGENT KITH_PERSON KITH_ROOM HQ_STATE HQ_HOME KITH_PROJECT
mkdir -p "$HOME" "$KITH_STATE"
# people first: an id with memory already under it is a removed person's, and a new person is refused it
KA=$KERNEL/bin/kith-auth K=$KERNEL/bin/kith
python3 "$KA" person kai owner >/dev/null; python3 "$KA" person sam >/dev/null
M=$KITH_HOME/agents/echo/memory
mkdir -p "$M/shared" "$M/people/sam" "$M/projects/alpha" "$M/projects/beta" "$M/sessions" "$M/rooms/grp1" \
  "$KITH_STATE/people" "$KITH_HOME/agents/echo/role"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou test.\n' > "$KITH_HOME/agents/echo/role/agent.md"
python3 "$KA" member echo sam >/dev/null
echo 'owner memory zebra' > "$M/MEMORY.md"
echo 'shared craft tip' > "$M/shared/MEMORY.md"
echo 'sam likes tea' > "$M/people/sam/MEMORY.md"
echo 'alpha index note' > "$M/projects/alpha/README.md"
echo 'alpha extra note' > "$M/projects/alpha/extra.md"
echo 'beta only note' > "$M/projects/beta/README.md"
printf -- '---\nkind: project-detail\n---\nalpha detail log\n' > "$M/projects/alpha/detail.md"
echo 'session log' > "$M/sessions/s1.md"
echo 'gamma flat note' > "$M/projects/gamma.md"
echo 'grp1 room note' > "$M/rooms/grp1/MEMORY.md"
echo 'about the owner' > "$KITH_STATE/user.md"
echo 'about sam' > "$KITH_STATE/people/sam.md"
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
# the prompt of a run, as the env given (VAR=value ...)
P() { env "$@" "$K" echo --print 2>&1; }

OWN=$(P)
check "owner 1:1: about you, memory, shared, in that order" \
  "[ \"\$(grep -n -o 'about the owner\|owner memory zebra\|shared craft tip' <<<\"\$OWN\" | cut -d: -f2 | paste -sd, -)\" = 'about the owner,owner memory zebra,shared craft tip' ]"
check "owner 1:1: no room, project or session notes without a project" "! grep -qE 'grp1 room|alpha|session log' <<<\"\$OWN\""
check "owner 1:1: no withheld line" "! grep -q 'ask me in our 1:1' <<<\"\$OWN\""
check "owner 1:1: the session line counts what loaded" "grep -q '<session project=\"none\" loaded=\"3\"' <<<\"\$OWN\""

mkdir -p "$T/alpha"; "$KERNEL/bin/project-id" --register alpha "$T/alpha" >/dev/null 2>&1
PR=$(env "$K" echo -p alpha --print 2>&1)
check "project: its index first, other notes after; project-detail never" \
  "[ \"\$(grep -n -o 'alpha index note\|alpha extra note' <<<\"\$PR\" | cut -d: -f2 | paste -sd, -)\" = 'alpha index note,alpha extra note' ] && ! grep -q 'alpha detail log\|beta only' <<<\"\$PR\""

mkdir -p "$T/gamma"; "$KERNEL/bin/project-id" --register gamma "$T/gamma" >/dev/null 2>&1
PG=$(env "$K" echo -p gamma --print 2>&1)
check "project flat layout: projects/<ID>.md loads for its project, once, not for another" \
  "[ \"\$(grep -c 'gamma flat note' <<<\"\$PG\")\" = 1 ] && ! grep -q 'gamma flat note' <<<\"\$PR\""
mkdir -p "$M/projects/gamma"; echo 'gamma folder note' > "$M/projects/gamma/README.md"
PG2=$(env "$K" echo -p gamma --print 2>&1)
check "project in both layouts: both load, no duplicates" \
  "[ \"\$(grep -c 'gamma flat note' <<<\"\$PG2\")\" = 1 ] && [ \"\$(grep -c 'gamma folder note' <<<\"\$PG2\")\" = 1 ]"
check "owner output without that project is unchanged" "[ \"\$(P)\" = \"\$OWN\" ]"

SAM=$(P KITH_PERSON=sam)
check "invitee 1:1: shared then their own memory, and about them" \
  "[ \"\$(grep -n -o 'about sam\|shared craft tip\|sam likes tea' <<<\"\$SAM\" | cut -d: -f2 | paste -sd, -)\" = 'about sam,shared craft tip,sam likes tea' ]"
check "invitee 1:1: never the owner's" "! grep -qE 'owner memory|about the owner|alpha' <<<\"\$SAM\""
check "invitee 1:1: their memory tag keeps its scope" "grep -q 'scope=\"sam\"' <<<\"\$SAM\""

GO=$(P KITH_ROOM=grp1)
check "group room, owner asking: shared only, the rest withheld" \
  "grep -q 'shared craft tip' <<<\"\$GO\" && ! grep -qE 'owner memory|about the owner|grp1 room' <<<\"\$GO\" && grep -q 'ask me in our 1:1' <<<\"\$GO\""
check "the withheld line says nothing of what was kept out" "! grep 'ask me in our 1:1' <<<\"\$GO\" | grep -qE 'zebra|owner memory'"
GS=$(P KITH_PERSON=sam KITH_ROOM=grp1)
check "group room, invitee asking: shared only, withheld line" \
  "grep -q 'shared craft tip' <<<\"\$GS\" && ! grep -qE 'sam likes tea|about sam|owner memory' <<<\"\$GS\" && grep -q 'ask me in our 1:1' <<<\"\$GS\""
check "another person's 1:1 room id is a group room (fail closed)" \
  "! P KITH_PERSON=sam KITH_ROOM=1:1:echo:kai | grep -q 'sam likes tea'"
check "own 1:1 room named explicitly changes nothing" "[ \"\$(P KITH_PERSON=sam KITH_ROOM=1:1:echo:sam)\" = \"\$SAM\" ]"
check "a room id that is not a valid id loads shared only" "! P KITH_ROOM='a b' | grep -q 'owner memory'"

# a helper agent inherits the caller's room (1:1:<parent>:<person>): still one reader, so the 1:1 load
check "helper agent, owner: the parent's 1:1 room is still a 1:1" "grep -q 'owner memory zebra' <<<\"\$(P KITH_ROOM=1:1:parent:owner)\""
check "helper agent, invitee: their memory loads" "grep -q 'sam likes tea' <<<\"\$(P KITH_PERSON=sam KITH_ROOM=1:1:parent:sam)\""
check "a 1:1 naming another person stays closed" "! grep -q 'owner memory zebra' <<<\"\$(P KITH_ROOM=1:1:parent:sam)\""
check "group runs say so on the session line" "grep -qE 'loaded=\"[0-9]+\" room=\"group\"' <<<\"\$GO\" && ! grep -qE 'loaded=\"[0-9]+\" room=\"group\"' <<<\"\$OWN\""
check "a channel group chat with no KITH_ROOM is a group (like recall)" \
  "! grep -q 'owner memory zebra' <<<\"\$(P KITH_VIA=telegram)\" && grep -qE 'loaded=\"[0-9]+\" room=\"group\"' <<<\"\$(P KITH_VIA=telegram)\""

# KITH_ROOM_MEMBERS: the members of a group room, from the environment (kith_facets.py load)
LM() { env "$@" python3 "$KERNEL/lib/kith_facets.py" load --agent echo --home "$KITH_HOME/agents/echo" \
  --person-file "$KITH_STATE/people/sam.md" --kind person --person sam --rooms "${RM-grp1}" --room grp1; }
# The write-time record: the room-note ledger kith-room-ledger keeps (the hook of every run, from the host's env)
LEDGER=$KERNEL/bin/kith-room-ledger
# W <pre|post> <note under memory/> VAR=value...: the hook as the run with that env writes the note
W() { local mode=$1 rel=$2; shift 2; printf '{"tool_input":{"file_path":"%s/%s"}}' "$M" "$rel" \
  | env "$@" python3 "$LEDGER" "$mode" --agent echo --home "$KITH_HOME/agents/echo"; }
LO() { env "$@" python3 "$KERNEL/lib/kith_facets.py" load --agent echo --home "$KITH_HOME/agents/echo" \
  --person-file "$KITH_STATE/user.md" --kind owner --rooms '' --room "${ROOM-grp1}"; }
W post rooms/grp1/MEMORY.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam
echo 'grp1 solo note' > "$M/rooms/grp1/solo.md"; W post rooms/grp1/solo.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_OWNER_ONLY=1
echo 'grp1 old note' > "$M/rooms/grp1/old.md"   # written before the ledger: no record
check "room members: a member of the room loads the room note" "LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 room note'"
check "room members: a reader the member list does not name (a stranger) gets shared only" "! RM= LM KITH_ROOM_MEMBERS=eve | grep -q 'grp1 room note'"
check "room members: none given stays shared only" "! LM KITH_ROOM_MEMBERS= | grep -q 'grp1 room note'"

# owner-only groups and the ledger
check "owner-only marker: the owner loads the room notes written before and by the owner alone" \
  "LO KITH_ROOM_OWNER_ONLY=1 | grep -q 'grp1 room note' && LO KITH_ROOM_OWNER_ONLY=1 | grep -q 'grp1 solo note'"
check "owner-only marker: an old note with no record loads (nobody else is there)" "LO KITH_ROOM_OWNER_ONLY=1 | grep -q 'grp1 old note'"
check "owner-only marker: the owner's own memory loads too" "LO KITH_ROOM_OWNER_ONLY=1 | grep -q 'owner memory zebra'"
check "no marker and no members: shared only, as before" "! LO | grep -q 'grp1 room note'"
check "empty members with the marker blank: shared only" "! LO KITH_ROOM_MEMBERS= | grep -q 'grp1 solo note'"
check "marker beside a member list is ignored: the list rules" "! LO KITH_ROOM_OWNER_ONLY=1 KITH_ROOM_MEMBERS=sam | grep -q 'grp1 solo note'"
check "marker with a channel via is ignored" "! LO KITH_ROOM_OWNER_ONLY=1 KITH_VIA=telegram | grep -q 'grp1 room note'"
check "marker value other than 1 is ignored" "! LO KITH_ROOM_OWNER_ONLY=yes | grep -q 'grp1 room note'"
check "spoofing: a person run that sets the marker is not widened" \
  "! LM KITH_ROOM_OWNER_ONLY=1 | grep -q 'grp1 room note' && ! LM KITH_ROOM_OWNER_ONLY=1 | grep -q 'sam likes tea'"
check "a note written when only the owner was there stays hidden from a member" "! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 solo note'"
check "an unrecorded (old) note stays hidden when a person is present" "! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 old note'"
check "a guest who joined later does not see what was said before" \
  "LO KITH_ROOM_MEMBERS=sam | grep -q 'grp1 room note' && ! LO KITH_ROOM_MEMBERS=sam,eve | grep -q 'grp1 room note'"
echo 'grp1 late note' > "$M/rooms/grp1/late.md"; W post rooms/grp1/late.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam,eve
check "a guest present at the write sees the note, and so does one of the members alone" \
  "LO KITH_ROOM_MEMBERS=sam,eve | grep -q 'grp1 late note' && LO KITH_ROOM_MEMBERS=sam | grep -q 'grp1 late note'"
check "the owner alone sees a note written with guests present" "LO KITH_ROOM_OWNER_ONLY=1 | grep -q 'grp1 late note'"
W post rooms/grp1/late.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam
check "an edit with fewer people present narrows the record to the intersection" \
  "! LO KITH_ROOM_MEMBERS=sam,eve | grep -q 'grp1 late note'"
W post rooms/grp1/late.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam,eve
check "an edit with more people present never widens it" "! LO KITH_ROOM_MEMBERS=sam,eve | grep -q 'grp1 late note'"
W pre rooms/grp1/old.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam; W post rooms/grp1/old.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam
check "editing an old unrecorded note does not record it wider than owner-only" "! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 old note'"
echo 'grp1 shell note' > "$M/rooms/grp1/shell.md"; W post rooms/grp1/shell.md KITH_OWNER=1 KITH_ROOM=other KITH_ROOM_MEMBERS=sam
check "a write from a run of another room records the owner alone" "! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 shell note'"
echo 'grp1 blind note' > "$M/rooms/grp1/blind.md"; W post rooms/grp1/blind.md KITH_OWNER=1 KITH_ROOM=grp1
check "a write with the members unknown records the owner alone" "! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 blind note'"
check "the ledger lives in the state folder, not in the note" \
  "[ -f \"$KITH_STATE/room-ledger/echo/grp1.json\" ] && ! grep -rq 'sam' \"$M/rooms/grp1/solo.md\""
check "a note that claims its own members in frontmatter gains nothing" \
  "printf -- '---\naudience: room:grp1\nmembers: [sam, eve]\n---\ngrp1 forged note\n' > \"$M/rooms/grp1/forged.md\" && ! LM KITH_ROOM_MEMBERS=sam | grep -q 'grp1 forged note'"
check "the hook is silent and never fails on bad input" "echo 'not json' | python3 \"$LEDGER\" post --agent echo --home \"$KITH_HOME/agents/echo\"; [ \$? = 0 ]"
check "a write outside rooms/ is not recorded" \
  "W post MEMORY.md KITH_OWNER=1 KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam; python3 -c \"import json,sys; sys.exit(0 if all(k.startswith('rooms/grp1/') for k in json.load(open('$KITH_STATE/room-ledger/echo/grp1.json'))) else 1)\""

# A member's own run in the group (bin/kith, kith-auth resolve): the host's member list is where room membership lives
GM=$(P KITH_PERSON=sam KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam)
check "a member's own group run loads the room notes written while they were there" "grep -q 'grp1 room note' <<<\"\$GM\""
check "a member's own group run: notes outside the ledger rules stay out" \
  "! grep -qE 'grp1 (solo|old|shell|blind|forged) note' <<<\"\$GM\" && ! grep -qE 'owner memory|about the owner' <<<\"\$GM\""
check "a member's own group run: a note written with someone else there stays out" \
  "! grep -q 'grp1 late note' <<<\"\$(P KITH_PERSON=sam KITH_ROOM=grp1 KITH_ROOM_MEMBERS=sam,eve)\""
check "a person the member list does not name is not in the room" "! P KITH_PERSON=sam KITH_ROOM=grp1 KITH_ROOM_MEMBERS=eve | grep -q 'grp1 room note'"
check "a member's run with the members unknown stays shared only" "! P KITH_PERSON=sam KITH_ROOM=grp1 | grep -q 'grp1 room note'"

# the filter itself: members known, caps, ordering, guests
export OWNER='{"kind":"owner"}' SAMR='{"kind":"person","id":"sam","rooms":["grp1"]}' GUEST='{"kind":"guest","id":"bot-ab12","rooms":["grp1"]}' STRAY='{"kind":"guest","id":"bot-ab12"}' EVE='{"kind":"person","id":"eve"}'
F() { python3 -c "import sys, os, json; sys.path.insert(0,'$KERNEL/lib'); import kith_facets as k; R={n: json.loads(os.environ[n]) for n in ('OWNER','SAMR','GUEST','STRAY','EVE')}; $1"; }
check "group with known members: the intersection (shared, and the room's notes)" \
  "[ \"\$(F \"print(sorted(k.load_audiences(R['OWNER'],'grp1','echo',[R['SAMR']])))\")\" = \"['room:grp1', 'shared']\" ]"
check "group with a member outside the room: shared only" \
  "[ \"\$(F \"print(sorted(k.load_audiences(R['OWNER'],'grp1','echo',[R['EVE']])))\")\" = \"['shared']\" ]"
check "the room's own notes load when everyone present is in the room" \
  "F \"r=k.load_memory('echo','$KITH_HOME/agents/echo','$KITH_STATE/user.md',R['OWNER'],'grp1',[],8000,[R['SAMR']]); print(r['block'])\" | grep -q 'grp1 room note'"
check "a bot guest: shared and its own room's notes, never the owner's or a person's" \
  "[ \"\$(F \"print(sorted(k.load_audiences(R['GUEST'],'grp1','echo')))\")\" = \"['room:grp1', 'shared']\" ] && [ \"\$(F \"print(sorted(k.load_audiences(R['STRAY'],'','echo')))\")\" = \"['shared']\" ]"
check "a guest's KITH_ROOM is not trusted: a room kith-auth does not list gives shared only" \
  "[ \"\$(F \"print(sorted(k.load_audiences(R['STRAY'],'grp1','echo')))\")\" = \"['shared']\" ]"
check "a guest loads its room's notes and no one else's" \
  "F \"r=k.load_memory('echo','$KITH_HOME/agents/echo','$KITH_STATE/user.md',R['GUEST'],'grp1',[]); print(r['block'])\" | grep -q 'grp1 room note' && ! F \"r=k.load_memory('echo','$KITH_HOME/agents/echo','$KITH_STATE/user.md',R['GUEST'],'grp1',[]); print(r['block'])\" | grep -qE 'owner memory|sam likes|about'"
check "over the cap the project notes go first (oldest first); about you and memory never" \
  "[ \"\$(F \"r=k.load_memory('echo','$KITH_HOME/agents/echo','$KITH_STATE/user.md',R['OWNER'],'1:1:echo:owner',['alpha'],60); print(r['more'], 'about the owner' in r['block'], 'owner memory' in r['block'])\")\" = '2 True True' ]"
check "the cap is the agent's setting" \
  "printf -- '---\nname: echo\ndescription: t\nmemory_cap: 60\n---\nYou test.\n' > \"$KITH_HOME/agents/echo/role/agent.md\" && \"$K\" echo -p alpha --print 2>&1 | grep -q 'more=\"2\"'"

echo
if [ $fails = 0 ]; then echo "all passed"; else echo "$fails failed"; exit 1; fi
