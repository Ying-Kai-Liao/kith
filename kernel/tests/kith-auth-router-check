for m, p in writes.items():
    assert p['viaSwitch'] is True and p['dies'] is True, (m, p)
assert methods.count('people.secretSet') == 1 and methods.count('people.secretEnv') == 1 and methods.count('people.agentAccess') == 1
so = [json.loads(b) for m, b in rows if m == 'people.secretOwner']
