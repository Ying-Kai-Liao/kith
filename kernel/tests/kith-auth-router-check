  if cmp -s "$T/post.core" "$T/post.file"; then ok "rollback: the file answers what the core answered"; else
    bad "rollback: the file differs from the core's last answers" "$(diff "$T/post.core" "$T/post.file" | head -30)"; fi
  if python3 - "$AUTHJ" <<'PY'
