# --- 2b. the card writes ----------------------------------------------------------------------------------------------------------
# One sequence of writes and the reads that show their effect. Stdout, exit code and stderr (with the home's path taken out and
# the clock's milliseconds) are what is compared: the file, then the daemon, must give the same.
cw() {   # OUT
  local out=$1
  : > "$out"
  run() {
    local o rc
    o=$("$@" 2>"$out.e"); rc=$?
    { echo "\$ $*"; [[ -n $o ]] && echo "$o"; echo "rc=$rc"; sed 's/^/err: /' "$out.e"; } | sed -e "s#$HOME#<H>#g" -e "s#$KERNEL#<K>#g" >> "$out"
  }
  mkdir -p "$HOME/shared"
  run A access house samuel domain docs.example.com
  run A access house samuel domain docs.example.com                     # the same always twice: one entry
  run A access house samuel read "$HOME/shared"
  run A access house samuel write "$HOME/shared/out"
  run A access house samuel read "$HOME/shared/out/x" --by samuel       # a member approves for themselves
  run A access house samuel read "$HOME/shared/y" --by kai              # the owner's yes outlasts a person's
  run A access house kai domain a.example.com                           # the owner: refused
  run A access house '*' domain a.example.com                           # the everyone row: refused
  run A access house amy domain a.example.com --by samuel               # only for themselves or their own bot
  run A access house eve domain a.example.com --by eve
  run A access house dan domain a.example.com --by dan                  # on a deleted preset: the rules have no answer
  run A access house tim domain a.example.com                           # revoked, no row of their own
  run A access house timbot domain a.example.com                        # a bot of a revoked person
  run A access house botty domain docs.example.com                      # samuel's bot, within what samuel holds
  run A access house botty domain other.example.com                     # above its owner: refused
  run A access house botty read "$HOME/shared/out/z" --by samuel
  run A access house nobody domain a.example.com
  run A access house samuel domain '*.example.com'                      # not a plain host
  run A access house samuel read relative/path
  run A access house samuel read "$KITH_HOME/secrets/auth.json"         # a secret
  run A access house samuel write "$HOME/.cargo/bin/x"                  # rule W
  run A access house samuel read "$KERNEL/bin"                          # the kernel is rule W
  run A access house samuel --by samuel
  run A access house samuel domain docs.example.com --rm
  run A access house samuel read "$HOME/shared/out/x" --rm
  run A access house tim read /nowhere --rm                             # a removal checks nothing
  run A helper house amy helper
  run A helper house amy helper                                         # twice: one entry
  run A helper house amy writer --once
  run A helper house botty writer                                       # more than samuel holds: refused
  run A helper house kai helper
  run A helper house amy nothere
  run A helper house amy house
  run A helper house tim helper
  run A helper house amy helper --rm
  run A helper house tim helper --rm
  run A helper house amy
  run A job house eve edit --decline h1
  run A job house eve edit --decline h1
  run A job house eve edit --decline h2
  run A job house eve nope --decline h1
  run A job house amy edit --decline h1                                 # amy never ticked it
  run A job house kai edit --decline h1
  run A job house eve edit --rm
  run A job house eve edit --rm
  run A job house amy edit                                              # a tick at share: the job as the package declares it
  run A jobs house --person amy --json
  run A job house amy edit --shown '{"helpers": ["helper", "gone"], "domains": ["x.example"]}'   # cut to what the package holds now
  run A jobs house --person amy --json
  run A job house amy edit --shown 'nope'                               # not JSON
  run A job house amy edit --shown '[1]'                                # not an object
  run A job house amy nope                                              # no such job
  run A job house kai edit                                              # the owner
  run A job house tim edit                                              # revoked, no row of their own
  run A job house nobody edit
  run A job house '*' edit                                              # the everyone row is no row of their own
  run A job 'bad name' amy edit
  run A job house botty edit                                            # a bot's own tick, within its owner
  run A job house amy edit --rm
  run A job house botty edit --rm
  run A agent-access house --json
  run A jobs house --person eve --json
  run A ledger --json
  sed -i.bak -E 's/[0-9]{13}/<ms>/g' "$out" && rm -f "$out.bak" "$out.e"
}
cw_ledger() { A ledger --json 2>&1 | sed -E 's/[0-9]{13}/<ms>/g'; }
use_home "$T/gs"; cw "$T/cw.golden"
[[ $(grep -c '^\$' "$T/cw.golden") -gt 40 ]] && ok "card writes, file: $(grep -c '^\$' "$T/cw.golden") calls" || bad "card writes, file: too few calls"
grep -q 'samuel may domain docs.example.com beyond the box for house' "$T/cw.golden" && grep -q "kai is the owner" "$T/cw.golden" \
  && grep -q 'rule W' "$T/cw.golden" && grep -q 'is a secret' "$T/cw.golden" && grep -q 'more than its owner' "$T/cw.golden" \
  && grep -q 'approves only for themselves' "$T/cw.golden" && grep -q 'stays as it was ticked' "$T/cw.golden" \
  && ok "card writes, file: the grants and every kind of refusal are in the sequence" || bad "card writes, file: the sequence misses a case"
# embedded: no daemon, so every write exits 3 and nothing changes (a grant must never run in an embedded core)
use_home "$T/sw1"
before=$(cw_ledger)
cw "$T/cw.sw1"
if [[ $(cw_ledger) == "$before" ]] && ! grep -q 'may domain\|may call\|stays as it was' "$T/cw.sw1" && grep -c '^rc=3$' "$T/cw.sw1" | grep -q '^[1-9]'; then
  ok "card writes, embedded core: the writes exit 3 and change nothing"
else bad "card writes, embedded core: a write ran" "$(grep -B1 -A2 'may domain\|may call' "$T/cw.sw1" | head; diff <(echo "$before") <(cw_ledger) | head -5)"; fi
if [[ -n $DPID ]] && kill -0 "$DPID" 2>/dev/null; then
  use_home "$T/sw2"; seq_once "$T/once.sw2"
  cmp -s "$T/once.golden" "$T/once.sw2" && ok "take-once, daemon: the same answers" || bad "take-once, daemon" "$(diff "$T/once.golden" "$T/once.sw2")"
  iso "daemon"
  # `kith doctor` on the stepped home: iso turned the service of `later/main` personal after the import stored it with no owner, so the
  # core reads it as shared, where the file read it as the owner's: doctor says so. The file home (iso did the same there) says nothing.
  python3 "$KERNEL/bin/kith-doctor" > "$T/doctor.sw2" 2>&1
  if grep -q 'profiles: later/main names no owner in the core' "$T/doctor.sw2"; then ok "doctor: a profile with no owner on a service that is personal now is flagged on the stepped home"; else
    bad "doctor: later/main not flagged" "$(grep -i 'profile\|switched\|core' "$T/doctor.sw2" | head -5)"; fi
  use_home "$T/gs"; python3 "$KERNEL/bin/kith-doctor" > "$T/doctor.gs" 2>&1
  ! grep -q 'names no owner in the core' "$T/doctor.gs" && ok "doctor: the file home has no such warning" || bad "doctor: the file home was flagged"
  use_home "$T/sw2"
  # the core says where a value lives, never the value: no secret, no invite code, no chat handle in what it answers
  printf '{"viaSwitch": true, "kernel": "%s", "home": "%s"}' "$KERNEL" "$HOME" | "$BIN" kernel core-call people.secretsView --params-stdin > "$T/view.out" 2>/dev/null
  if grep -q 'env:RT_WORK' "$T/view.out" && ! grep -Eq 'sec-work|sec-kai|pass-owner|pass-sam|pass-lent|"handles"|telegram' "$T/view.out"; then
    ok "secretsView: references and env only, no value, no handle"
  else bad "secretsView: what the core answers" "$(head -c 600 "$T/view.out")"; fi
  # the card writes through the daemon: after everything above, which reads the home it changes
  use_home "$T/sw2"
  cw "$T/cw.sw2"
  if cmp -s "$T/cw.golden" "$T/cw.sw2"; then ok "card writes, through a daemon: every line, refusal and exit code is the file's"; else
    bad "card writes, through a daemon: differs from the file" "$(diff "$T/cw.golden" "$T/cw.sw2" | head -30)"; fi
  # --- 2c. S-b, the secret writers --------------------------------------------------------------------------------------------
  # set, grant, revoke, connect, disconnect, env and `agent-access ... domain` on the file, through the daemon (must be the
  # file's, state included) and on the embedded core (every write exits 3, nothing changes). A fake `security` keeps the
  # Keychain's items in a folder, so `set` runs for real and the check can see what was stored and where.
  profile_names() {   # the profiles the home holds: auth.json's, or on the tombstone the core's
    if grep -q kith_tombstone "$AUTHJ" 2>/dev/null; then
      printf '{"viaSwitch": true, "kernel": "%s", "home": "%s"}' "$KERNEL" "$HOME" | "$BIN" kernel core-call people.secretsView --params-stdin 2>/dev/null \
        | python3 -c 'import json,sys; print(" ".join(sorted(json.load(sys.stdin)["auth"]["profiles"])))'
    else
      python3 -c 'import json,sys; print(" ".join(sorted(json.load(open(sys.argv[1]))["profiles"])))' "$AUTHJ"
    fi
  }
  sb() {   # OUT: the writers, then the reads that show their effect
    local out=$1
    : > "$out"
    export FAKE_KC_DIR=$out.kc
    rm -rf "$FAKE_KC_DIR"; mkdir -p "$FAKE_KC_DIR"
    run() {
      local o rc
      o=$("$@" 2>"$out.e"); rc=$?
      { echo "\$ $*"; [[ -n $o ]] && echo "$o"; echo "rc=$rc"; sed 's/^/err: /' "$out.e"; } | sed -e "s#$HOME#<H>#g" -e "s#$KERNEL#<K>#g" >> "$out"
    }
    runi() {   # STDIN-TEXT command...: the text is never printed (it holds a value)
      local in=$1 o rc; shift
      o=$(printf '%s' "$in" | "$@" 2>"$out.e"); rc=$?
      { echo "\$ <stdin> $*"; [[ -n $o ]] && echo "$o"; echo "rc=$rc"; sed 's/^/err: /' "$out.e"; } | sed -e "s#$HOME#<H>#g" -e "s#$KERNEL#<K>#g" >> "$out"
    }
    runi "{\"TOKEN\": \"$SENT-1\"}" A set echo/new --stdin-json
    runi "{\"TOKEN\": \"$SENT-1\"}" A set echo/new --stdin-json                    # the same set twice: the same result
    runi "{\"TOKEN\": \"$SENT-2\"}" A set echo/new --stdin-json --grant house
    runi "{\"TOKEN\": \"$SENT-2\"}" A set echo/new --stdin-json --grant house      # ... and the same grant
    runi "{\"TOKEN\": \"$SENT-3\"}" A set echo/second --stdin-json --grant writer  # a list of three after the fixture's two
    runi "{\"PASS\": \"$SENT-4\"}" A set login/mine --stdin-json                   # a personal service: the owner's profile
    runi "{\"PASS\": \"$SENT-4\"}" A set login/mine --stdin-json --grant helper
    runi "{\"TOKEN\": \"$SENT-5\"}" A set echo/team --stdin-json                   # an existing profile keeps what it has
    runi "{\"TOKEN\": \"$SENT-6\"}" A set echo --stdin-json                        # not <service>/<account>
    runi "{\"TOKEN\": \"$SENT-6\"}" A set Echo/x --stdin-json
    runi "{\"NOPE\": \"$SENT-6\"}" A set echo/x --stdin-json                       # a name the service does not declare
    runi "{\"TOKEN\": \"\"}" A set echo/x --stdin-json
    runi "{\"TOKEN\": 5}" A set echo/x --stdin-json
    runi 'not json' A set echo/x --stdin-json
    runi "{\"TOKEN\": \"$SENT-6\"}" A set echo/x --stdin-json --grant 'no good'
    runi "{\"TOKEN\": \"$SENT-6\"}" A set nosuch/x --stdin-json
    run A grant house echo echo/work,echo/kai
    run A grant writer@samuel echo echo/kai
    run A grant writer@nobody echo echo/kai                                        # no such person now
    run A grant house echo login/x                                                 # not an echo profile
    run A grant house nosuch work
    run A grant --all echo echo/new
    run A grant house,helper echo echo/new,echo/second --json
    run A grant nobody echo echo/new --json                                        # an agent this Mac has no package for
    run A grant nobody echo echo/new                                               # (the text form never refused it)
    run A grant house calendar calendar/host
    run A grant house echo echo/ghost --json
    run A connect house echo
    run A connect writer echo --profile echo/work
    run A connect writer echo --profile echo/work --json
    run A connect writer echo --profile bad
    run A connect house echo --profile echo/nothing
    run A connect house nothere
    run A connect house login
    run A connect helper calendar
    run A connect helper calendar --json
    run A connect writer@samuel echo
    run A disconnect helper calendar
    run A disconnect helper calendar --json
    run A disconnect writer echo
    run A disconnect house nothere --json
    run A disconnect house@x echo
    run A connect writer calendar
    run A disconnect writer calendar
    echo "host profiles: $(profile_names | tr ' ' '\n' | grep '/host$' | tr '\n' ' ')" >> "$out"   # calendar/host, held by house
    run A disconnect house calendar                                                # the last holder: the host profile goes with it
    echo "host profiles: $(profile_names | tr ' ' '\n' | grep '/host$' | tr '\n' ' ')" >> "$out"
    run A disconnect house calendar                                                # nothing held now
    run A revoke writer echo --profile echo/work
    run A revoke writer echo --profile echo/work --json
    run A revoke house echo --profile echo/new --json
    run A revoke helper echo
    run A revoke helper echo --json
    run A revoke ghost echo --json                                                 # an agent that never existed
    run A revoke oldagent echo --json                                              # a retired agent's row can still go
    run A revoke house
    run A env house echo
    run A env house echo NEW=1 Z=zz A=
    run A env house echo M= NEW=2 B=b
    run A env house echo NEW= NEW=again
    run A env house nothere X=1
    run A env house echo bad
    run A env writer echo W=
    run A env oldagent echo Q=
    run A agent-access house domain new.example.com
    run A agent-access house domain new.example.com
    run A agent-access house domain '*.example.com'
    run A agent-access house domain new.example.com --rm
    run A agent-access house domain never.example.com --rm
    run A agent-access house
    # the profile writers: whose a profile is, who it is lent to, a browser profile. The lines are the file's, and so is what
    # the reads show after them (`keys` names each profile's owner, `holders` who holds it); a refusal writes nothing
    run A owner echo/work samuel
    run A owner echo/work -
    run A owner echo/work default
    run A owner login/main amy
    run A owner login/main default
    run A owner login/unset tim
    run A owner echo/work nobody                                                   # no such person now
    run A owner nosuch/x samuel                                                    # no such profile
    run A owner echo/work
    run A share echo/work samuel,amy
    run A share echo/work amy,tim,samuel
    run A share echo/work amy --rm
    run A share echo/work samuel,amy --rm
    run A share echo/work samuel,,tim
    run A share echo/work tim --rm
    run A share echo/work nobody
    run A share nosuch/x samuel
    run A share echo/work samuel --nope
    run A browser work
    run A browser work chrome
    run A browser browser/work edge                                                # a note: it was made in chrome
    run A browser browser/work edge
    run A browser other
    run A keys --json
    run A holders echo
    run A holders login --json
    run A granted echo
    run A granted --for writer echo
    run A granted --for house echo --json
    run A mcp-config house
    run A account-state house echo --json
    run A account-state helper login --json
    run A ledger --json
    run A agent-access house --json
    echo "kc: $(ls "$FAKE_KC_DIR" | sort | tr '\n' ' ')" >> "$out"
    sed -i.bak -E -e 's/[0-9]{13}/<ms>/g' -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}/<t>/g' "$out" && rm -f "$out.bak" "$out.e"
  }
  sb_state() { { A keys --json; A ledger --json; A granted echo; A holders login; A mcp-config house; A agent-access house --json; } 2>&1 | sed -E -e 's/[0-9]{13}/<ms>/g' -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}/<t>/g'; }

  # the file's answers (gs is a file home), then the daemon's
