    if [[ $way == file ]]; then A person eve --revoke >/dev/null 2>&1; else cc people.suspend; fi
    door_rows "$out" revoked
    if [[ $way == file ]]; then A person eve --unrevoke >/dev/null 2>&1; else cc people.undo; fi
    door_rows "$out" restored
    if [[ $way == file ]]; then A person eve --rm >/dev/null 2>&1; else cc people.removePerson; fi
    door_rows "$out" removed
