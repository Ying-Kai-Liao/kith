grep -q 'not switched' "$T/e" && ok "not switched: the core's line is on stderr" || bad "not switched: no line" "$(cat "$T/e")"
[[ $(calls "$T/wv2") == 1 ]] && ok "not switched: asked once, the file was not read again" || bad "not switched: calls" "$(calls "$T/wv2")"
sw_variant v3; printf 'state=stepping\nat=1\n' > "$T/v3/home/.kith/core/cutover/authority.switch"
mkwrap "$T/wv3" pass; use_home "$T/v3" "$T/wv3/kith"; refuses "stepping" A may samuel house
sw_variant v4; printf 'garbage\n' > "$T/v4/home/.kith/core/cutover/authority.switch"
mkwrap "$T/wv4" pass; use_home "$T/v4" "$T/wv4/kith"; refuses "damaged record" A may samuel house
sw_variant v5; printf 'state=rolling-back\nat=1\n' > "$T/v5/home/.kith/core/cutover/authority.switch"
mkwrap "$T/wv5" pass; use_home "$T/v5" "$T/wv5/kith"
out=$(A may samuel house 2>/dev/null); rc=$?
[[ $rc == 0 && $out == member ]] && ok "rolling back: reads still answered" || bad "rolling back" "rc=$rc out=$out"

# the core held by another process that is no daemon: nothing answers, exit 3 (never an answer from the file)
sw_variant v6
python3 - "$T/v6/home/.kith/core/core."lock <<'PY' &
import fcntl, sys, time
f = open(sys.argv[1], 'a')
fcntl.flock(f, fcntl.LOCK_EX)
time.sleep(25)
PY
HOLD=$!
sleep 1
use_home "$T/v6"; refuses "core held by another process" A may samuel house
kill "$HOLD" 2>/dev/null; wait "$HOLD" 2>/dev/null

# no kith program at all
use_home "$T/sw4"; unset KITH_BIN
out=$(PATH=/usr/bin:/bin CARGO_TARGET_DIR=$T/none A may samuel house 2>"$T/e"); rc=$?
if [[ $rc == 3 && -z $out ]] && grep -q 'no kith program' "$T/e"; then ok "no kith program: exit 3"
else bad "no kith program" "rc=$rc out=$out err=$(cat "$T/e")"; fi

# what the core-call does wrong: a timeout, a lost answer, a refusal, no daemon, junk, noCore. Each is exit 3, and a take-once
# is sent once whatever happens.
profiles_before=$(sqlite3 "$T/sw4/home/.kith/core/$DBF" "SELECT * FROM secret_profiles")
for mode in sleep garbage array nocore exit3 exit4 exit5; do
  mkwrap "$T/m-$mode" "$mode"
  use_home "$T/sw4" "$T/m-$mode/kith"
  refuses "core-call $mode: may" A may samuel house
  refuses "core-call $mode: who" A who telegram 222
  refuses "core-call $mode: mcp-config" A mcp-config house
  refuses "core-call $mode: get" A get --for house echo TOKEN
  refuses "core-call $mode: exec (the command does not run)" A exec --for house echo -- touch "$T/ran-$mode"
  [[ ! -e $T/ran-$mode ]] || bad "core-call $mode: exec ran its command"
  refuses "core-call $mode: access" A access house samuel domain a.example.com --by samuel
  refuses "core-call $mode: helper --rm" A helper house amy helper --rm
  refuses "core-call $mode: job --decline" A job house eve edit --decline h1
  refuses "core-call $mode: agent-access" A agent-access house
  refuses "core-call $mode: owner" A owner echo/work samuel
  refuses "core-call $mode: share" A share echo/work samuel
  refuses "core-call $mode: browser" A browser work chrome
  refuses "core-call $mode: jobs" A jobs house --json
  refuses "core-call $mode: door" A door house eve "$DOOR" --json
  refuses "core-call $mode: mcp-names" A mcp-names house
  refuses "core-call $mode: ls" A ls
  out=$(A ls --json 2>/dev/null); rc=$?   # a refusal of ls --json is JSON on stdout, as granted --json is
  [[ $rc == 3 && $out == '{"ok": false, "error": '* ]] && ok "core-call $mode: ls --json refused: JSON error on stdout, exit 3" || bad "core-call $mode: ls --json" "rc=$rc $out"
  # the helper hook never passes a tool it could not check: the decision, and exactly one JSON object, granted or not
  [[ $(helper_hook house ask mcp__echo__say) == ask && $(helper_hook helper ask mcp__echo__say) == ask \
     && $(KITH_PERSON=samuel helper_hook house deny mcp__echo__say) == deny ]] \
    && ok "core-call $mode: helper-mcp gives the decision (ask for the owner, deny for a guest), never a pass" \
    || bad "core-call $mode: helper-mcp" "$(helper_hook house ask mcp__echo__say) $(helper_hook helper ask mcp__echo__say) $(KITH_PERSON=samuel helper_hook house deny mcp__echo__say)"
  refuses "core-call $mode: connectors" A connectors --json
  refuses "core-call $mode: job tick" A job house amy edit
  refuses "core-call $mode: take-once" A resolve helper --person amy --via house --take-once
  [[ $(grep -c 'people.resolve' "$T/m-$mode/calls") == 1 ]] && ok "core-call $mode: the take-once was sent once" \
    || bad "core-call $mode: the take-once was repeated" "$(cat "$T/m-$mode/calls")"
done

[[ $(sqlite3 "$T/sw4/home/.kith/core/$DBF" "SELECT * FROM secret_profiles") == "$profiles_before" ]] \
  && ok "core-call failures: owner, share and browser wrote nothing" || bad "core-call failures: a profile writer changed a row"

# --json mode: a refusal is the {"ok": false, "error"} on stdout that json_run gives, with the same exit code
use_home "$T/sw4" "$T/m-exit3/kith"
out=$(A granted fly --json 2>/dev/null); rc=$?
[[ $rc == 3 && $out == '{"ok": false, "error": '* ]] && ok "granted --json refused: JSON error on stdout, exit 3" || bad "granted --json refused" "rc=$rc out=$out"

# what is sent: viaSwitch on every call, takeOnce only with a caller, the person only when named
mkwrap "$T/ws" pass
use_home "$T/sw4" "$T/ws/kith"
A may samuel house >/dev/null 2>&1; A who telegram 111 >/dev/null 2>&1; A granted github >/dev/null 2>&1; A bots-cap --json >/dev/null 2>&1
A people --json >/dev/null 2>&1; A retired zed >/dev/null 2>&1; A budgets house --json >/dev/null 2>&1; A ledger --json >/dev/null 2>&1
A resolve house --person samuel --via writer --take-once >/dev/null 2>&1
A resolve house --person samuel --take-once >/dev/null 2>&1
A mcp-config house >/dev/null 2>&1; A get --for house echo TOKEN >/dev/null 2>&1; A holders echo >/dev/null 2>&1
A keys --json >/dev/null 2>&1; A account-state house echo --json >/dev/null 2>&1; A exec --for house echo -- true >/dev/null 2>&1
# the card writes: every call is a write the core fences (viaSwitch), asked to answer a refusal as an answer (dies), never
# repeated; a read of the view carries viaSwitch too
mkwrap "$T/wc" pass
use_home "$T/sw4" "$T/wc/kith"
A access house samuel domain a.example.com --by samuel >/dev/null 2>&1
A access house samuel read /nowhere/x --rm >/dev/null 2>&1
A helper house amy helper --once >/dev/null 2>&1
A job house eve edit --decline h9 >/dev/null 2>&1
A agent-access house --json >/dev/null 2>&1; A jobs house >/dev/null 2>&1
if python3 - "$T/wc/calls" <<'PY'
import json, sys
rows = [l.split(' ', 1) for l in open(sys.argv[1]).read().splitlines()]
assert [m for m, _ in rows] == ['people.access', 'people.access', 'people.helper', 'people.job', 'people.secretsView', 'people.secretsView'], rows
for method, body in rows:
    p = json.loads(body)
    assert p['viaSwitch'] is True, (method, p)
    assert 'kernel' in p and 'home' in p, (method, p)
    if method != 'people.secretsView':
        assert p['dies'] is True, (method, p)
a, rm, h, j = [json.loads(b) for m, b in rows[:4]]
assert (a['agent'], a['person'], a['kind'], a['value'], a['by']) == ('house', 'samuel', 'domain', 'a.example.com', 'samuel') and 'remove' not in a, a
assert rm['remove'] is True and 'by' not in rm, rm
assert h['once'] is True and 'remove' not in h, h
assert j['decline'] == 'h9' and j['job'] == 'edit', j
PY
then ok "card writes: viaSwitch and dies on every call, the removal marked remove, by and once only when given"; else bad "card writes: what was sent" "$(cat "$T/wc/calls")"; fi

if python3 - "$T/ws/calls" <<'PY'
import json, sys
rows = [l.split(' ', 1) for l in open(sys.argv[1]).read().splitlines()]
assert len(rows) == 16, len(rows)
assert [m for m, _ in rows].count('people.secretsView') == 6, rows
for method, body in rows:
    p = json.loads(body)
    assert p['viaSwitch'] is True, (method, p)
    assert 'kernel' in p and 'home' in p, (method, p)
took = [json.loads(b) for m, b in rows if m == 'people.resolve']
assert took[0].get('takeOnce') is True and took[0]['via'] == 'writer', took[0]
assert 'takeOnce' not in took[1] and 'via' not in took[1], took[1]
PY
then ok "calls: every one carries viaSwitch; takeOnce only with a caller"; else bad "calls: what was sent" "$(cat "$T/ws/calls")"; fi

# a member on a deleted preset: `resolve` has no answer and dies, the router prints what kith-auth prints and exits as it does
use_home "$T/gs"; A resolve house --person dan >"$T/o1" 2>"$T/e1"; r1=$?
use_home "$T/sw4"; A resolve house --person dan >"$T/o2" 2>"$T/e2"; r2=$?
if [[ $r1 == "$r2" && -s $T/e1 ]] && cmp -s "$T/o1" "$T/o2" && cmp -s "$T/e1" "$T/e2"; then ok "deleted preset: dies with the same line and exit code ($r1)"
else bad "deleted preset" "file rc=$r1 $(cat "$T/e1"); core rc=$r2 $(cat "$T/e2")"; fi

echo
[[ $fail == 0 ]] && echo "all ok" || echo "FAILED"
exit $fail
