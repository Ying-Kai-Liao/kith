  printf '{"TOKEN": "%s-guest"}' "$SENT" | KITH_PERSON=samuel A set echo/guest --stdin-json >"$T/o-guest" 2>"$T/e-guest"; rc=$?
  if [[ $rc == 2 && -z $(ls "$FAKE_KC_DIR") ]] && grep -q 'not available to this run' "$T/e-guest" && ! grep -q 'people.secretSet' "$T/wo1/calls"; then
