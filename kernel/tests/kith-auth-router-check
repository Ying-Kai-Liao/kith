  # person --revoke) and through the daemon (the host's people.suspend / undo / removePerson: kith-auth is app-only there).
  door_rows() {   # OUT HEADING: the door of five people, text and --json
    local out=$1 who
    echo "== $2" >> "$out"
    for who in eve amy botty samuel kai; do
