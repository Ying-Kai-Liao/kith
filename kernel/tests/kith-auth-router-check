  mkwrap_set() {   # DIR MODE: the probe answers (a switched daemon); the core's set does as MODE says; the rest goes to the real program
    mkdir -p "$1"
    cat > "$1/kith" <<EOF
#!/bin/sh
if [ "\$1 \$2" = "kernel core-call" ]; then
  params=\$(cat)
  printf '%s %s\n' "\$3" "\$params" >> "$1/calls"
  case "\$3" in
    people.revision) echo '{"digest":"0123456789abcdef"}'; exit 0 ;;
