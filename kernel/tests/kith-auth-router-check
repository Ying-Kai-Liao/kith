  rm -f "$(dirname "$AUTHJ")/auth.log"
  post_state "$T/post.core"
  [[ $(grep -c . "$T/post.core") -gt 40 ]] && ok "rollback: the core's answers after its writes are recorded" || bad "rollback: too few answers" "$(head -5 "$T/post.core")"
