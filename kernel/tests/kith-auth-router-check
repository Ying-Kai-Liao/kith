    && grep -q 'helper may no longer use calendar' "$T/sb.golden" \
    && grep -q 'declares' "$T/sb.golden" && grep -q "no person 'nobody'" "$T/sb.golden" \
    && grep -q 'every guest of house may reach new.example.com' "$T/sb.golden" \
