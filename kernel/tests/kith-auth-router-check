    bad "doors, through a daemon: differs from the file" "$(diff "$T/door.golden" "$T/door.sw2" | head -30)"; fi
  exec 7>&-; wait "$DPID" 2>/dev/null; DPID=

  # --- 4. the way back: rollback after the core's own writes --------------------------------------------------------------------
