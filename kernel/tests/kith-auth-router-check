  if python3 - "$T/wsb/calls" "$SENT" <<'PY'
import json, sys
text = open(sys.argv[1]).read()
assert sys.argv[2] not in text
rows = [l.split(' ', 1) for l in text.splitlines()]
methods = [m for m, _ in rows]
assert methods.count('people.revision') == 1 and methods.index('people.revision') < methods.index('people.secretSet'), methods
