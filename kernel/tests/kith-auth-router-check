  else bad "secret writers, embedded core: a write ran" "$(grep -B1 -A2 'may now use\|"vars": \["[A-Z]*"\], "granted"' "$T/sb.sw1" | head; diff <(echo "$before") <(sb_state) | head -5; ls "$T/sb.sw1.kc")"; fi
