  printf '{"TOKEN": "%s-sent"}' "$SENT" | A set echo/sent --stdin-json --grant house >/dev/null 2>&1
  A grant writer echo echo/sent >/dev/null 2>&1
  A connect writer echo --profile echo/work >/dev/null 2>&1
  A revoke writer echo --profile echo/work >/dev/null 2>&1
  A connect helper calendar >/dev/null 2>&1                                         # a grant that is held ...
  A disconnect helper calendar >/dev/null 2>&1                                      # ... and taken back
  A disconnect writer echo >/dev/null 2>&1                                          # nothing held: nothing sent
  A env house echo K=v >/dev/null 2>&1
  A agent-access house domain sent.example.com >/dev/null 2>&1
  A owner echo/work samuel >/dev/null 2>&1
  A share echo/work samuel,amy >/dev/null 2>&1
