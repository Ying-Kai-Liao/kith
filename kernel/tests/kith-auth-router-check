  esac
  printf '%s' "\$params" | "$BIN" "\$@"; exit \$?
fi
exec "$BIN" "\$@"
EOF
    chmod +x "$1/kith"
    : > "$1/calls"
  }
  setone() {   # NAME PROFILE: one `set` with a fresh Keychain folder; the exit code
    export FAKE_KC_DIR=$T/kc-$1; rm -rf "$FAKE_KC_DIR"; mkdir -p "$FAKE_KC_DIR"
