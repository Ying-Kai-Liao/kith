  if ! grep -rqa --exclude='*.sock' "$SENT" "$T/sw2/home/.kith/core"; then ok "secret writers: no value is in the core's files"; else bad "secret writers: a value reached the core's files"; fi
  [[ $(sqlite3 "$T/sw2/home/.kith/core/$DBF" "SELECT source FROM secret_vars WHERE profile = 'echo/new'") == "keychain:kith/echo/new#TOKEN" ]] \
    && grep -q "$SENT-2" "$T/sb.sw2.kc/kith_echo_new#TOKEN" && ok "secret writers: the core holds the reference and the Keychain the value" \
    || bad "secret writers: reference and value" "$(sqlite3 "$T/sw2/home/.kith/core/$DBF" "SELECT * FROM secret_vars" | head -5)"
  # the core refuses a guest's run itself (the file never did; a guest's MCP server runs outside the box)
  use_home "$T/sw2"
  before=$(sb_state)
  KITH_PERSON=samuel A grant house echo echo/work >"$T/o-g" 2>"$T/e-g"; rc=$?
  KITH_PERSON=samuel A env house echo GUEST=1 >"$T/o-g2" 2>"$T/e-g2"; rc2=$?
  KITH_PERSON=samuel A owner echo/work samuel >"$T/o-g3" 2>"$T/e-g3"; rc3=$?
  KITH_PERSON=samuel A share echo/work samuel >"$T/o-g4" 2>"$T/e-g4"; rc4=$?
