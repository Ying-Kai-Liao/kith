#!/usr/bin/env bash
# kith-auth-router-check — M2-23 slice 1: once auth.json is the authority tombstone, kith-auth answers its READ verbs from the
# core (`kith kernel core-call`, always marked viaSwitch) and everything else still exits 3 with the tombstone's own text.
#
#   1. Golden vs switched. A fixture auth.json (an owner, a renamed person, a bot with `was`, a revoked person, a member on a
#      deleted preset, a member with a "just this once" helper, a member with a ticked job that grants a helper, a retired id,
#      grants, budgets, chat handles) answers every routed verb over persons x agents x `--via` as a real file. A copy of the
#      home is imported into a core (`kith kernel core-migrate --authority`), given the switched record and the tombstone, and
#      must answer byte for byte the same (stdout and exit code): once with no daemon (the embedded core) and once through a
#      daemon. The copies are stepped for real (`kith migrate step authority`: import, same answer, marker, tombstone), and
#      section 4 rolls one back after the core's own writes: the file must then answer what the core did.
#   2. Sequences: the take-once (the first launch is allowed "(just this once)", the second refused, on both homes) and `who`
#      with `handles_stale` set (exit 3 on a switched home, never a wrong person).
#   2b. C-a / C-b, the card writes: `access` (the always of an escape card, with --by and its refusals), `helper`, `job
#      --decline`/`--rm` and the removals. The same sequence runs on the file, on the daemon (the lines and refusals must be
#      the file's, state included), and on the embedded core, where every write exits 3 and changes nothing. The reads
#      `agent-access` and `jobs` are in the matrix above.
#   3. Negatives: no route (the writers, the lists that need the file, `door`, bare `bots-cap`), a tombstone of another
#      module, no core, a core that is not switched, a core held by another process, no kith program, a timeout, a lost
#      answer, a refusal, a malformed answer, `noCore`: all exit 3 and never an answer. A take-once is sent once and never
#      repeated, only with a caller, and every call carries viaSwitch.
#
#   KITH_BIN=/path/to/kith kernel/tests/kith-auth-router-check     skips without a kith program (KITH_BIN or KITH_DIFFTEST_BIN,
#                                                                 else under $CARGO_TARGET_DIR / serve/host/target)
set -uo pipefail
KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
find_bin() {
  local t k
  for t in "${CARGO_TARGET_DIR:-}" "$KERNEL/../serve/host/target" "$KERNEL/../target"; do
    for k in debug release; do [[ -n $t && -x $t/$k/$1 ]] && { echo "$t/$k/$1"; return 0; }; done
  done
  return 1
}
BIN=${KITH_BIN:-${KITH_DIFFTEST_BIN:-$(find_bin kith)}}
[[ -n $BIN && -x $BIN ]] || { echo "skip: needs the kith program (KITH_BIN)"; exit 0; }
command -v sqlite3 >/dev/null || { echo "skip: needs sqlite3"; exit 0; }
[[ $(uname) == Darwin || $(uname) == Linux ]] || { echo "skip: Unix only"; exit 0; }

# A short path: the daemon's sockets live under it and a Unix socket path is at most ~100 bytes.
T=$(mktemp -d /tmp/krc.XXXXXX)
T=$(cd "$T" && pwd -P)
DPID=
cleanup() {
  [[ -n $DPID ]] && kill "$DPID" 2>/dev/null
  exec 7>&- 2>/dev/null
  sleep 0.3
  [[ -n ${ROUTER_KEEP:-} ]] && echo "kept: $T" || rm -rf "$T"
}
trap cleanup EXIT
export PYTHONPYCACHEPREFIX=$T/pycache PYTHONDONTWRITEBYTECODE=1 TZ=UTC
unset KITH_PERSON KITH_AGENT KITH_AUTH HQ_HOME HQ_STATE KITH_CORE KITH_DEV_BIN CARGO_TARGET_DIR KITH_MACHINE KITH_STATE KITH_AGENTS

fail=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1${2:+: $2}"; fail=1; }

# use_home DIR: the environment of one home (auth.json under DIR/home/.kith/secrets, the core under DIR/home/.kith/core).
use_home() {
  export HOME=$1/home KITH_HOME=$1/home/.kith KITH_BIN=${2:-$BIN}
  export KITH_STATE=$KITH_HOME KITH_MACHINE=$KITH_HOME KITH_AGENTS=$KITH_HOME/agents KITH_SERVE_DIR=$1/serve \
    KITH_SERVE_PORT=1 KITH_WAKE_NO_KICK=1
  AUTHJ=$KITH_HOME/secrets/auth.json
  CORE=$KITH_HOME/core
}
A() { python3 "$KERNEL/bin/kith-auth" "$@"; }
DBF=core."db"   # the boundary check keeps that file's name out of source outside core/runtime
SENT=sentinel-4c1d9e7a   # a key's value: it must reach the (fake) Keychain and no row, call or answer of the core
# A `security` that keeps items in $FAKE_KC_DIR (FAKE_KC_FAIL=1: it takes nothing), so `set` runs for real.
mkdir -p "$T/bin"
cat > "$T/bin/fakesec" <<'PY'
#!/usr/bin/env python3
import os, sys
d = os.environ.get('FAKE_KC_DIR') or '/nonexistent'
def path(kc, var):
    return os.path.join(d, (kc + '#' + var).replace('/', '_'))
if sys.argv[1:2] == ['-i']:
    t = sys.stdin.read().split()
    if os.environ.get('FAKE_KC_FAIL'):
        sys.exit(0)
    kc, var, hx = t[t.index('-s') + 1], t[t.index('-a') + 1], t[t.index('-X') + 1]
    open(path(kc, var), 'w').write(bytes.fromhex(hx).decode())
elif sys.argv[1:2] == ['find-generic-password']:
    kc, var = sys.argv[sys.argv.index('-s') + 1], sys.argv[sys.argv.index('-a') + 1]
    try:
        print(open(path(kc, var)).read())
    except OSError:
        sys.exit(44)
PY
chmod +x "$T/bin/fakesec"
export KITH_SECURITY_BIN=$T/bin/fakesec

# --- the fixture, as a real auth.json ---------------------------------------------------------------------------------------
G=$T/g
mkdir -p "$G/home" "$G/serve"
use_home "$G"
for a in house writer helper; do
  mkdir -p "$KITH_HOME/agents/$a/role"
  printf -- '---\nname: %s\ndescription: test\n---\nbody\n' "$a" > "$KITH_HOME/agents/$a/role/agent.md"
done
# house's package: a helper, a job, and a job that holds a door (a guest's box; doors are for people an agent is shared with)
house_caps() {   # [needs-line]
  printf '%shelpers: [helper]\ndoors:\n  - name: render\n    npm: [hyperframes@0.4.1]\n    lockfile: render.lock.json\n    tools: [node]\n    bin: hyperframes/bin/hyperframes.mjs\n    args: [render]\n    writes: [renders]\njobs:\n  - name: edit\n    label: Edit things\n    helpers: [helper]\n  - name: draw\n    label: Draw things\n    doors: [render]\n' "${1:-}" > "$KITH_HOME/agents/house/role/capabilities.yaml"
}
house_caps
echo '{"lockfileVersion":3}' > "$KITH_HOME/agents/house/role/render.lock.json"
A person kai owner name=Kai >/dev/null
A person sam name=Sam >/dev/null
A person sam id=samuel >/dev/null                    # renamed: sam is an old id of samuel
A person tim name=Tim >/dev/null
A person amy name=Amy >/dev/null
A person dan name=Dan >/dev/null
A person eve name=Eve >/dev/null
A person zed name=Zed >/dev/null
A person zed --rm >/dev/null                         # a retired id
A preset member mode=default >/dev/null
A preset ghost mode=default >/dev/null
A bot samuelbot --of samuel >/dev/null
A person samuelbot id=botty >/dev/null               # a bot with `was`
A bot timbot --of tim >/dev/null
A bot kaibot --of kai >/dev/null
A person kaibot id=kaib >/dev/null                   # one of the owner's bots, renamed (bots-cap --json lists its old id too)
# the core keeps memberships ordered by agent and person, not as the file was written: the rows of an agent go in in that
# order, so the verbs that list a table (budgets, ledger) read the same on both sides
A member house '*' preset=member >/dev/null          # everyone: "member (everyone)" for a person, never for a bot
A member house amy preset=member helpers=writer >/dev/null
A member house botty >/dev/null
A member house dan preset=ghost >/dev/null
A member house eve preset=member >/dev/null
A member house samuel preset=member budget=5 >/dev/null
A member house timbot >/dev/null                     # a bot of the revoked tim: cut off through bot_of
A member writer samuel preset=member >/dev/null
A helper house amy helper --once >/dev/null          # a "just this once" on a helper
A job house eve edit >/dev/null                      # a ticked job that grants the helper
A job house eve draw >/dev/null                      # ... and one that grants the door: eve may start it
A job house amy draw --shown '{"doors": []}' >/dev/null   # ticked when it showed no door: the package has one now (widened)
A job house botty draw >/dev/null                    # a bot's own tick, its owner (samuel) has none: owner-lacks
A person tim --revoke >/dev/null
A agent-access house domain kept.example.com >/dev/null   # a host kept for every guest of house
A bots-cap 50 >/dev/null
A handle kai telegram 111 >/dev/null
A handle samuel telegram 222 >/dev/null
A handle tim telegram 333 >/dev/null
A handle botty telegram 444 >/dev/null
# what the CLI has no verb for: a preset deleted under a member, a grant, a list of grants
python3 - "$AUTHJ" <<'PY'
import json, sys
p = sys.argv[1]
a = json.load(open(p))
a['presets'].pop('ghost', None)
a['members']['house']['amy']['helper_once']['helper'] = 4102444800000   # year 2100: the verb's five minutes would run out in a slow CI run
a['grants'] = {'house': {'github': 'work', 'fly': ['a', 'b'], 'echo': 'echo/work', 'login': 'login/main', 'later': 'later/main'},
               'writer': {'github': 'other', 'echo': ['echo/kai', 'echo/work']},
               'house@samuel': {'login': 'login/samuel', 'echo': 'echo/kai'},   # a person's own grants, looked up first
               'house@amy': {'login': 'login/lent'},                            # the owner's login, lent to amy
               'house@eve': {'login': 'login/main'},                            # the owner's login, NOT lent: refused
               'oldagent': {'echo': 'echo/work'}}                               # an agent that is gone
# S-a: the profiles (where a value lives, here `env:` references the check exports), a login that is personal (the owner's
# unless named), one lent to amy, a shared one, and the env that mcp-config and exec read (an agent that is gone too)
a['profiles'] = {'echo/work': {'TOKEN': 'env:RT_WORK'},
                 'echo/kai': {'TOKEN': 'env:RT_KAI', 'person': 'kai'},
                 'echo/team': {'TOKEN': 'env:RT_TEAM', 'person': '*'},
                 'login/main': {'PASS': 'env:RT_OWNER_PASS'},
                 'login/samuel': {'PASS': 'env:RT_SAM_PASS', 'person': 'samuel'},
                 'login/lent': {'PASS': 'env:RT_LENT_PASS', 'with': ['amy']},
                 'login/shared': {'PASS': 'env:RT_SHARED_PASS', 'person': '*'},
                 'login/unset': {},
                 'later/main': {'K': 'env:RT_LATER'}}   # unmarked, on a service that is not personal yet
a['env'] = {'house': {'echo': {'Z': 'z-$KITH_AGENT', 'A': 'a', 'M': '3'}}, 'writer': {'echo': {'W': 'w'}},
            'oldagent': {'echo': {'Q': 'q'}}}
json.dump(a, open(p, 'w'), indent=2)
PY
mkdir -p "$KITH_HOME/services"
printf '{"kind": "mcp", "secrets": ["TOKEN"], "mcp": {"command": "echo", "args": ["serve", "$KITH_AGENT"], "env": {"BASE": "b-$KITH_AGENT"}}}\n' > "$KITH_HOME/services/echo.json"
printf '{"kind": "login", "secrets": ["PASS"]}\n' > "$KITH_HOME/services/login.json"
printf '{"kind": "cli", "secrets": ["K"]}\n' > "$KITH_HOME/services/later.json"   # not personal, until iso turns it
printf '{"kind": "connector", "description": "a host connector"}\n' > "$KITH_HOME/services/calendar.json"   # no secrets: its profile is the host's
house_caps $'needs: [echo]\n'
printf 'needs: [echo]\n' > "$KITH_HOME/agents/writer/role/capabilities.yaml"
export RT_WORK=sec-work RT_KAI=sec-kai RT_TEAM=sec-team RT_OWNER_PASS=pass-owner RT_SAM_PASS=pass-sam RT_LENT_PASS=pass-lent RT_SHARED_PASS=pass-shared RT_LATER=sec-later
[[ -f $AUTHJ ]] && ok "setup: the fixture auth.json is there" || bad "setup: no auth.json"

DOOR=$(A jobs house --json | python3 -c 'import json,sys; print(next(d for j in json.load(sys.stdin)["jobs"] for d in j["doors"]))')
[[ $DOOR == render@* ]] && ok "setup: the door piece is $DOOR" || bad "setup: no door piece" "$DOOR"

PERSONS=(kai samuel sam tim timbot amy dan eve botty samuelbot kaib kaibot zed nobody)
AGENTS=(house writer helper nothere)
[[ -n ${ROUTER_QUICK:-} ]] && { PERSONS=(kai samuel); AGENTS=(house writer); }   # while writing the check
# matrix OUTFILE: every routed verb over the fixture, "$ command", stdout, "rc=N". Stderr is left out (it names paths).
matrix() {
  local out=$1 p a v
  : > "$out"; : > "$out.err"
  # a linked Mac whose lease ran out: `held` is true for everyone but the owner (the serve folder is the caller's KITH_SERVE_DIR)
  printf '{"linked": true, "until": 1}\n' > "$KITH_SERVE_DIR/cloud-sync.json"
  run() { { echo "\$ $*"; "$@" 2>>"$out.err"; echo "rc=$?"; } >> "$out"; }
  run_as() { local who=$1; shift; { echo "\$ KITH_PERSON=$who $*"; KITH_PERSON=$who "$@" 2>>"$out.err"; echo "rc=$?"; } >> "$out"; }
  for p in "${PERSONS[@]}"; do
    for a in "${AGENTS[@]}"; do
      run A may "$p" "$a"
      run A resolve "$a" --person "$p"
      for v in house writer helper; do
        [[ $v == "$a" ]] && continue
        run A may "$p" "$a" --via "$v"
        run A may "$p" "$a" --via "$v" --once
        run A resolve "$a" --person "$p" --via "$v"
      done
    done
    run A people --json
  done
  for p in kai samuel sam botty; do run_as "$p" A resolve house; run_as "$p" A resolve writer --via house; done
  for h in "telegram 111" "telegram 222" "telegram 333" "telegram 444" "telegram 999" "slack U1" "discord 1"; do
    run A who $h
    run A whois $h
  done
  run A granted github
  run A granted fly
  run A granted --for writer github
  run A granted --for house nothing
  run A granted fly --json
  run A granted --for writer github --json
  run A granted --json nothing
  run A bots-cap --json
  run A people --json
  run A retired zed
  run A retired samuel
  run A retired sam
  run A retired stranger
  run A budgets house --json
  run A budgets writer --json
  run A ledger --json
  run A ledger --person samuel --json
  run A ledger --person sam --agent house --json
  run A ledger --agent house --json
  run A ledger --agent nobody --json
  # S-a, the secret reads: who sees which profile, whose env, over owner / a person with their own grant / a guest lent the
  # owner's login / a guest refused it / a bot / nobody. keys comes first and the hand-out log starts empty, so `last_used`
  # is the same on both sides (the log names the second, which differs from run to run).
  rm -f "$(dirname "$AUTHJ")/auth.log"
  run A keys --json
  run A holders echo
  run A holders login --json
  for p in kai samuel amy eve botty nobody; do
    run_as "$p" A holders echo --json
    run_as "$p" A holders login
    for a in house writer oldagent; do
      run_as "$p" A mcp-config "$a"
      run_as "$p" A account-state "$a" echo --json
      run_as "$p" A get --for "$a" echo TOKEN
      run_as "$p" A get --for "$a" login PASS
    done
    run_as "$p" A account-state house login --json
    run_as "$p" A get --for house echo PASS
    run_as "$p" A exec --for house echo -- sh -c 'echo "T=$TOKEN B=$BASE Z=$Z A=$A M=$M W=$W Q=$Q"'
    run_as "$p" A exec --for writer echo -- sh -c 'echo "T=$TOKEN B=$BASE Z=$Z A=$A M=$M W=$W Q=$Q"'
    run_as "$p" A exec --for house login -- sh -c 'echo "P=$PASS"'
  done
  # C-b: the edge card's listing and the jobs lists the launch reads, over kith-auth's own code
  for a in house writer nothere; do
    run A agent-access "$a"
    run A agent-access "$a" --json
    run A jobs "$a"
    run A jobs "$a" --json
    for p in eve samuel amy; do run A jobs "$a" --person "$p" --json; done
  done
  run A jobs house --domain a.example --json
  # the routed listings: the owner's `ls`, the connectors, the servers an agent would start (kith-info lists them)
  run A ls
  run A ls --json
  run A connectors
  run A connectors --json
  for a in house writer helper; do
    run A connectors "$a"
    run A connectors "$a" --json
    for p in kai amy; do run_as "$p" A mcp-names "$a"; done
  done
  run A mcp-names oldagent
  run A mcp-names nothere
  # the door: may this person's run of the agent start it now (a guest's door, the start and the sweep of kith_door.py). On a
  # linked Mac whose lease ran out (here) every guest is `held`; the rows after the lease is back show the real states.
  for p in "${PERSONS[@]}"; do run A door house "$p" "$DOOR"; run A door house "$p" "$DOOR" --json; done
  run A jobs house --helper helper --person eve
  KITH_AUTH_PROFILE=echo/work run A get --for writer echo TOKEN
  run A get --for writer --profile echo/kai echo TOKEN
  run A account-state house nothere --json
  rm -f "$KITH_SERVE_DIR/cloud-sync.json"
  for p in kai samuel tim; do run A resolve house --person "$p"; done   # and once more with no cloud-sync file: never linked
  # the door with the lease back: ok (eve), widened (amy), owner-lacks (botty), not-ticked (samuel), the owner, a revoked person
  # and the bot of one (their door is closed), a person that does not exist, and the pieces the package does not hold
  for p in "${PERSONS[@]}"; do run A door house "$p" "$DOOR"; run A door house "$p" "$DOOR" --json; done
  run A door house eve render@000000000000 --json    # the package changed since this chat started
  run A door house eve render@000000000000
  run A door house eve nodoor@abc123 --json          # no job of the agent has it
  run A door house eve render --json                 # a name is no piece
  run A door writer eve "$DOOR" --json               # an agent that holds no such door
  run A door nothere eve "$DOOR" --json
}
matrix "$T/golden.out"
rows=$(grep -c '^\$' "$T/golden.out")
[[ $rows -gt 300 || -n ${ROUTER_QUICK:-} ]] && ok "golden: $rows routed calls over the file" || bad "golden: too few calls ($rows)"
grep -q 'rc=2$' "$T/golden.out" && bad "golden: a call was a usage error" "$(grep -B2 'rc=2$' "$T/golden.out" | head -6)"
grep -q '^{"person": "samuel"' "$T/golden.out" && ok "golden: who finds the renamed person" || bad "golden: who"
grep -q '"held": true' "$T/golden.out" && grep -q '"held": false' "$T/golden.out" && ok "golden: held is true and false in the matrix" || bad "golden: held"
grep -qi 'just this once' "$T/golden.out" && bad "golden: matrix must not use up a once" || ok "golden: no once used by the matrix"

# --- the switched copies -------------------------------------------------------------------------------------------------------
# A copy of the home, stepped for real.
TOMB='{"kith_tombstone": 1, "module": "authority", "message": "this data moved to the Kith core (module authority); the old reader must not use this file", "rollback": "kith rollback authority"}'
switch_copy() {   # NAME
  local d=$T/$1
  mkdir -p "$d" && cp -R "$G/home" "$d/home" && cp -R "$G/serve" "$d/serve"
  use_home "$d"
  local mig
  # The real step (M2-23 lift): import, same answer, the marker, the record and the tombstone, under auth.json's lock.
  mig=$(KITH_KERNEL="$KERNEL" "$BIN" migrate step authority 2>&1) || { bad "setup $1: migrate step authority" "$mig"; return 1; }
  grep -q '"kith_tombstone"' "$AUTHJ" || { bad "setup $1: auth.json is not a tombstone after the step" "$mig"; return 1; }
}
switch_copy sw1 && ok "setup: the embedded copy is switched" || exit 1
switch_copy sw2 && ok "setup: the daemon copy is switched" || exit 1
switch_copy sw3 || exit 1
switch_copy sw4 || exit 1

use_home "$T/sw1"
matrix "$T/sw1.out"
if cmp -s "$T/golden.out" "$T/sw1.out"; then ok "switched, embedded: all $rows routed calls answer as the file does"; else
  bad "switched, embedded: differs from the file" "$(diff "$T/golden.out" "$T/sw1.out" | head -20; sort "$T/sw1.out.err" | uniq -c | sort -rn | head -5)"; fi

use_home "$T/sw2"
mkfifo "$T/stdin"
"$BIN" kernel core-daemon < "$T/stdin" > "$T/daemon.out" 2>&1 &
DPID=$!
exec 7> "$T/stdin"
for _ in $(seq 100); do grep -q '^ready' "$T/daemon.out" 2>/dev/null && break; sleep 0.1; done
if grep -q '^ready' "$T/daemon.out"; then
  matrix "$T/sw2.out"
  if cmp -s "$T/golden.out" "$T/sw2.out"; then ok "switched, through a daemon: all $rows routed calls answer as the file does"; else
    bad "switched, through a daemon: differs from the file" "$(diff "$T/golden.out" "$T/sw2.out" | head -20)"; fi
else
  bad "the core daemon did not start" "$(cat "$T/daemon.out")"
fi

# --- 2. sequences ----------------------------------------------------------------------------------------------------------------
# The take-once: the first helper launch is allowed on the "just this once" and uses it up, the second is refused; the file does
# it in one locked step, the core in one transaction, and the answers are the same. Run on the file, the embedded core and the daemon.
seq_once() {   # OUT
  local out=$1
  : > "$out"
  { echo "\$ first";  A resolve helper --person amy --via house --take-once 2>/dev/null; echo "rc=$?"
    echo "\$ second"; A resolve helper --person amy --via house --take-once 2>/dev/null; echo "rc=$?"
    echo "\$ after";  A may amy helper --via house --once 2>/dev/null; echo "rc=$?"
    echo "\$ no caller"; A resolve helper --person amy --take-once 2>/dev/null; echo "rc=$?"; } >> "$out"
}
# Guest isolation: a guest run never gets a profile that is the owner's unless it was lent to them. `get` hands out the value,
# so the answers are compared with what each person may have: the owner's login for the owner, the lent one for amy, samuel's
# own grant for samuel (looked up before the agent's), and nothing for eve (the owner's login, not lent) or a stranger.
iso() {   # WHERE
  local where=$1 who want got rc
  for row in "kai:pass-owner" "amy:pass-lent" "samuel:pass-sam" "eve:" "nobody:" "botty:"; do
    who=${row%%:*}; want=${row#*:}
    got=$(KITH_PERSON=$who A get --for house login PASS 2>/dev/null); rc=$?
    if [[ -n $want ]]; then
      [[ $got == "$want" && $rc == 0 ]] && ok "isolation, $where: $who gets $want" || bad "isolation, $where: $who" "rc=$rc got=$got"
    else
      [[ -z $got && $rc != 0 ]] && ok "isolation, $where: $who gets no login" || bad "isolation, $where: $who was handed something" "rc=$rc got=$got"
    fi
  done
  # a profile nobody named, on a service that turns personal after the import: it is the owner's now, never a guest's
  printf '{"kind": "cli", "personal": true, "secrets": ["K"]}\n' > "$KITH_HOME/services/later.json"
  got=$(KITH_PERSON=eve A get --for house later K 2>/dev/null); rc=$?
  [[ -z $got && $rc != 0 ]] && ok "isolation, $where: an unmarked profile of a service that turned personal is not eve's" || bad "isolation, $where: later, eve" "rc=$rc got=$got"
  got=$(KITH_PERSON=kai A get --for house later K 2>/dev/null); rc=$?
  [[ $got == sec-later && $rc == 0 ]] && ok "isolation, $where: ... and is still the owner's" || bad "isolation, $where: later, kai" "rc=$rc got=$got"
  got=$(KITH_PERSON=eve A exec --for house login -- sh -c 'echo "P=$PASS"' 2>/dev/null); rc=$?
  [[ -z $got && $rc != 0 ]] && ok "isolation, $where: exec for eve starts nothing with the owner's login" || bad "isolation, $where: exec for eve" "rc=$rc got=$got"
  got=$(KITH_PERSON=samuel A exec --for writer echo -- sh -c 'echo "T=$TOKEN"' 2>/dev/null); rc=$?
  [[ -z $got && $rc != 0 ]] && ok "isolation, $where: exec for samuel is refused the owner's key" || bad "isolation, $where: exec for samuel" "rc=$rc got=$got"
}
mkdir -p "$T/gs" && cp -R "$G/home" "$T/gs/home" && cp -R "$G/serve" "$T/gs/serve"
use_home "$T/gs"; seq_once "$T/once.golden"
