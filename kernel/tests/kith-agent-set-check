#!/usr/bin/env bash
# kith-agent-set-check — `kith <agent> set model|effort`, `--json` on every `kith <agent> set ...`, and a model per backup
# entry (harness[:account]@model). CLI lines in, stdout / exit code / agent.md / commits / launch env out, so the same lines
# can check another implementation. Throwaway HOME and KITH_HOME, fake claude/codex.
#
#   kernel/tests/kith-agent-set-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-agent-set-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME=$T/kith KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_MODEL KITH_EFFORT KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
A=$KITH_HOME/agents/echo/role
mkdir -p "$HOME/.claude" "$HOME/.codex" "$KITH_HOME/state" "$A" "$T/bin"
export KITH_STATE=$KITH_HOME/state
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$A/agent.md"
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
git -C "$A" init -q && git -C "$A" add -A && git -C "$A" commit -qm init

for h in claude codex; do printf '#!/bin/sh\necho "%s $*"\n' "$h" > "$T/bin/$h"; chmod +x "$T/bin/$h"; done
touch "$HOME/.claude/.fake-login" "$HOME/.codex/.fake-login"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
fm() { awk 'NR==1{next} /^---$/{exit} {print}' "$A/agent.md" | grep -E '^(harness|model|effort):' | tr '\n' ' '; }
commits() { git -C "$A" rev-list --count HEAD; }
# jq-free: j '<python expr on d>' reads JSON from stdin
export OUT=
jv() { python3 -c 'import json,os,sys; d=json.loads(os.environ["OUT"]); print(eval(sys.argv[1]))' "$1"; }
j() { python3 -c 'import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1]))' "$1"; }
launch() { "$KITH" echo --launch-json "$@" 2>"$T/err" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["harness"], d["model"], d["effort"])'; }

# ---- set effort ----
OUT=$("$KITH" echo set effort high); rc=$?
check "set effort high: exit 0, one line, written" "[ $rc = 0 ] && [ \"\$(fm)\" = 'effort: high ' ] && echo '$OUT' | grep -q 'effort is high'"
check "set effort: committed in the agent's repo" "git -C '$A' log -1 --format=%s | grep -q 'echo: effort high'"
C=$(commits)
OUT=$("$KITH" echo set effort high --json)
check "same effort again: --json says unchanged, no empty commit" "[ \"\$(jv 'd[\"changed\"]')\" = False ] && [ \"\$(commits)\" = $C ]"
OUT=$("$KITH" echo set effort max --json)
check "set effort --json shape" "[ \"\$(jv '(d[\"agent\"],d[\"setting\"],d[\"value\"],d[\"previous\"],d[\"changed\"])')\" = \"('echo', 'effort', 'max', 'high', True)\" ]"
BEFORE=$(cat "$A/agent.md")
"$KITH" echo set effort loud >/dev/null 2>"$T/err"; rc=$?
check "bad effort: non-zero, lists the valid ones on stderr, file untouched" "[ $rc != 0 ] && grep -q 'low, medium, high, xhigh, max' '$T/err' && [ \"\$(cat '$A/agent.md')\" = \"\$BEFORE\" ]"
OUT=$("$KITH" echo set effort loud --json 2>"$T/err"); rc=$?
check "bad effort --json: error object on stdout, nothing on stderr, non-zero" "[ $rc != 0 ] && jv '(d.get(\"ok\"), \"error\" in d, len(d))' | grep -q '(False, True, 2)' && [ ! -s '$T/err' ]"
"$KITH" echo set effort default >/dev/null
check "effort default removes the line" "[ \"\$(fm)\" = '' ]"

# ---- set model ----
"$KITH" echo set model sonnet >/dev/null
check "set model on a file with no model line adds it, after the description" "[ \"\$(fm)\" = 'model: sonnet ' ] && sed -n 3,4p '$A/agent.md' | tr '\n' ' ' | grep -q 'description: test agent model: sonnet'"
OUT=$("$KITH" echo set model opus --json)
check "set model --json: previous and value" "[ \"\$(jv '(d[\"setting\"],d[\"value\"],d[\"previous\"])')\" = \"('model', 'opus', 'sonnet')\" ] && [ \"\$(fm)\" = 'model: opus ' ]"
check "launch sees model and effort" "[ \"\$(launch)\" = 'claude opus None' ]"
"$KITH" echo set effort medium >/dev/null
check "effort lands after the model line" "[ \"\$(fm)\" = 'model: opus effort: medium ' ] && [ \"\$(launch)\" = 'claude opus medium' ]"
"$KITH" echo set model 'bad model!' >/dev/null 2>&1; rc=$?
check "not a model name: refused" "[ $rc = 2 ] && [ \"\$(fm)\" = 'model: opus effort: medium ' ]"

# a non-Claude model on a Claude harness is allowed (the claude CLI reports it)
"$KITH" echo set model gpt-5 >/dev/null; rc=$?
check "non-Claude model on claude: allowed" "[ $rc = 0 ] && [ \"\$(fm)\" = 'model: gpt-5 effort: medium ' ]"
"$KITH" echo set model sonnet >/dev/null

# ---- set harness --json, and the Claude model on a non-Claude harness ----
OUT=$("$KITH" echo set harness codex --json)
check "set harness --json: value, previous, model dropped" "[ \"\$(jv '(d[\"setting\"],d[\"value\"],d[\"previous\"],d[\"model\"],d[\"previous_model\"],d[\"changed\"])')\" = \"('harness', 'codex', 'claude', None, 'sonnet', True)\" ]"
"$KITH" echo set model sonnet >/dev/null 2>"$T/err"; rc=$?
check "Claude model on codex refused, names the harness and the way out" "[ $rc = 2 ] && grep -q 'runs on codex' '$T/err' && grep -q 'set harness claude --model sonnet' '$T/err' && [ \"\$(fm)\" = 'harness: codex effort: medium ' ]"
OUT=$("$KITH" echo set model opus --json 2>"$T/err"); rc=$?
check "same refusal with --json" "[ $rc = 2 ] && jv '(d[\"ok\"], len(d))' | grep -q '(False, 2)' && jv 'd[\"error\"]' | grep -q 'Claude model' && [ ! -s '$T/err' ]"
"$KITH" echo set harness codex --model sonnet >/dev/null 2>&1; rc=$?
check "set harness codex --model <Claude model> refused" "[ $rc = 2 ]"
"$KITH" echo set model gpt-5 >/dev/null
check "codex model accepted" "[ \"\$(fm)\" = 'harness: codex model: gpt-5 effort: medium ' ]"
"$KITH" echo set harness claude --model opus >/dev/null
check "back on claude" "[ \"\$(fm)\" = 'model: opus effort: medium ' ]"
"$KITH" echo set harness nope --json >"$T/out" 2>"$T/err"; rc=$?
check "set harness bad --json: error object" "[ $rc = 2 ] && j '(d[\"ok\"], len(d))' < '$T/out' | grep -q '(False, 2)' && j 'd[\"error\"]' < '$T/out' | grep -q 'unknown harness' && [ ! -s '$T/err' ]"

# ---- settings commands with --json ----
OUT=$("$KITH" echo set permission plan --json)
check "set permission --json" "[ \"\$(jv '(d[\"setting\"],d[\"value\"],d[\"previous\"],d[\"changed\"])')\" = \"('permission', 'plan', None, True)\" ]"
OUT=$("$KITH" echo set permission '' --json)
check "set permission '' --json: forgotten" "[ \"\$(jv '(d[\"value\"],d[\"previous\"])')\" = \"(None, 'plan')\" ]"
OUT=$("$KITH" echo set call-model haiku --json)
check "set call-model --json" "[ \"\$(jv '(d[\"setting\"],d[\"value\"])')\" = \"('call-model', 'haiku')\" ]"
OUT=$("$KITH" echo set limit 20 --json)
check "set limit --json" "[ \"\$(jv '(d[\"setting\"],d[\"value\"],d[\"previous\"])')\" = \"('limit', 20, None)\" ]"
OUT=$("$KITH" echo set limit none --json)
check "set limit none --json" "[ \"\$(jv '(d[\"value\"],d[\"previous\"])')\" = \"(None, 20)\" ]"
OUT=$("$KITH" echo set at-limit hold --json)
check "set at-limit --json" "[ \"\$(jv '(d[\"setting\"],d[\"value\"])')\" = \"('at-limit', 'hold')\" ]"
OUT=$("$KITH" echo set at-limit sometimes --json 2>"$T/err"); rc=$?
check "set at-limit bad --json: error object, non-zero" "[ $rc != 0 ] && jv '(d.get(\"ok\"), \"error\" in d, len(d))' | grep -q '(False, True, 2)' && [ ! -s '$T/err' ]"
OUT=$("$KITH" ghost set effort low --json 2>"$T/err"); rc=$?
check "unknown agent --json: error object, exit 1" "[ $rc = 1 ] && jv '(d[\"ok\"], len(d))' | grep -q '(False, 2)' && jv 'd[\"error\"]' | grep -q 'no agent' && [ ! -s '$T/err' ]"
"$KITH" echo set effort >/dev/null 2>"$T/err"; rc=$?
check "usage text lists model, effort and --json" "[ $rc = 2 ] && grep -q 'set model' '$T/err' && grep -q 'set effort' '$T/err' && grep -q -- '--json' '$T/err'"

# ---- one error shape for every set command: {"ok": false, "error": ...}, stdout only ----
shape() { python3 -c 'import json,sys; d=json.loads(sys.stdin.read()); print(d.get("ok") is False and isinstance(d.get("error"), str) and len(d) == 2)'; }
for line in "set effort loud" "set model 'bad model!'" "set harness nope" "set at-limit sometimes" "set permission nonsense" "set limit abc" "set call-model 'x y'" "set bogus x" "set effort"; do
  eval "OUT=\$(\"\$KITH\" echo $line --json 2>'$T/err')"; rc=$?
  check "error shape [$line]: {ok:false,error}, non-zero, nothing on stderr" "[ $rc != 0 ] && [ \"\$(echo \"\$OUT\" | shape)\" = True ] && [ ! -s '$T/err' ]"
done

# ---- a model per backup entry ----
mkdir -p "$KITH_STATE/accounts/claude/school"
"$KITH" backup add claude@sonnet --agent echo >/dev/null 2>&1
"$KITH" backup add claude:school@haiku --agent echo >/dev/null 2>&1
"$KITH" backup add codex --agent echo >/dev/null 2>&1
"$KITH" backup add codex@sonnet --agent echo >/dev/null 2>"$T/err"; rc=$?
check "backup add codex@<Claude model> refused" "[ $rc != 0 ] && grep -q 'Claude model' '$T/err'"
"$KITH" backup add 'claude@' --agent echo >/dev/null 2>&1; rc=$?
check "backup add with an empty model refused" "[ $rc != 0 ]"
OUT=$("$KITH" backup list --agent echo --json)
check "backup list --json: model as its own field, plain ids stay plain" "[ \"\$(jv '[(b[\"id\"],b[\"model\"]) for b in d[\"backups\"]]')\" = \"[('claude@sonnet', 'sonnet'), ('claude:school@haiku', 'haiku'), ('codex', None)]\" ]"
OUT=$("$KITH" echo --backups-json)
check "--backups-json: ids round-trip with the model, model field" "[ \"\$(jv '[(c[\"id\"],c[\"model\"]) for c in d[\"chain\"]]')\" = \"[('claude', None), ('claude@sonnet', 'sonnet'), ('claude:school@haiku', 'haiku'), ('codex', None)]\" ]"

printf -- '---\nname: echo\ndescription: test agent\nmodel: opus\neffort: medium\n---\nYou echo.\n' > "$A/agent.md"
check "launch without --backup: the agent's own model" "[ \"\$(launch)\" = 'claude opus medium' ]"
check "--backup claude@sonnet: the entry's model, the agent's effort" "[ \"\$(launch --backup claude@sonnet)\" = 'claude sonnet medium' ]"
check "--backup claude (no model) finds claude@sonnet" "[ \"\$(launch --backup claude)\" = 'claude sonnet medium' ]"
OUT=$("$KITH" echo --launch-json --backup claude@sonnet 2>/dev/null)
check "launch json: backup id as given, account_id without the model" "[ \"\$(jv '(d[\"backup\"],d[\"account_id\"],d[\"env\"][\"KITH_MODEL\"])')\" = \"('claude@sonnet', 'claude', 'sonnet')\" ]"
check "--backup claude:school@haiku" "[ \"\$(launch --backup claude:school@haiku)\" = 'claude haiku medium' ]"
check "--backup codex (no model): a Claude model never reaches it" "[ \"\$(launch --backup codex)\" = 'codex None medium' ]"
"$KITH" backup remove claude@sonnet --agent echo >/dev/null
"$KITH" backup add claude --agent echo >/dev/null 2>&1
check "an old plain entry behaves as before: the agent's own model" "[ \"\$(launch --backup claude)\" = 'claude opus medium' ]"

[ $fails = 0 ] && echo "all agent-set checks passed" || { echo "$fails check(s) failed"; exit 1; }
