#!/usr/bin/env bash
# kith-new — scaffold a new kith agent with the repo's conventions; the builder agent fills in the judgement parts.
#
#   kith-new <name> "<description>"     create the agent in the agents folder as its own git repo (fails if it exists)
#
# Creates agent.md (frontmatter + section skeleton), capabilities.yaml, settings.json (every installed plugin off
# except kith: an agent carries only its own tools), skills/learned/, and its state (memory/) in the state folder
# (<home>/state; lib/kith_paths.py). No mcp.json: add one only if the
# agent needs MCP servers. Kith serve's Discord channel creates #<name> within a minute.
set -euo pipefail

# Follow the script's own symlinks but keep the repo's logical path (it may be a symlink to a path with spaces).
src=$0; while [ -L "$src" ]; do t=$(readlink "$src"); case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac; done
KITH="$(cd "$(dirname "$src")/.." && pwd)"
name=${1:-}; desc=${2:-}
[[ $name =~ ^[a-z][a-z0-9-]{1,30}$ ]] || { echo "kith-new: name must be lowercase letters, digits, dashes (got '$name')" >&2; exit 2; }
[[ $name != kith ]] || { echo "kith-new: an agent can't be called 'kith' (it is the command's own name)" >&2; exit 2; }
[[ -n $desc && $desc != *": "* ]] || { echo "kith-new: give a one-line description without ': ' in it" >&2; exit 2; }
eval "$(python3 "$KITH/lib/kith_paths.py" --sh)"   # KITH_HOME, KITH_STATE, KITH_AGENTS
agents=$KITH_AGENTS
# The agent's folder: role/ (its own repo, what it is) next to memory/, data/, files/ (what it has lived).
[[ -e $agents/$name ]] && { echo "kith-new: agent '$name' already exists" >&2; exit 1; }
home="$agents/$name/role"
state="$agents/$name"

mkdir -p "$home/skills/learned" "$state/memory/projects" "$state/memory/sessions"
touch "$home/skills/learned/.keep"

cat > "$home/agent.md" <<EOF
---
name: $name
description: $desc
memory: user
---

You are the user's $name specialist. TODO(builder): one paragraph on who you are and what you are for.

## How you work
- TODO(builder): 3–6 bullets: how you approach the work, what is state (read from source every time) vs memory,
  what needs the user's approval.

## Your skills
Your skills are not installed globally. Read a skill's \`SKILL.md\` when the task needs it, then follow it. Paths are
relative to \`{{AGENT_DIR}}/skills/\`.

| Task | Skill |
|---|---|
| Skills you wrote yourself | \`{{PACKAGE}}/skills/learned/\` (listed in your MEMORY.md) |

## Not yours
TODO(builder): what belongs to other agents (name them), and what you never do.
EOF

cat > "$home/capabilities.yaml" <<'EOF'
# Declarations only. Credentials come from the runtime, never from here.
needs: []          # shared services (kernel/services/), e.g. [jev-browser, notion]; grant with kith-auth grant
tools: []          # e.g. web-fetch, sqlite
state: []          # where its data lives; read from the source every time
access: read       # what it may change without asking
EOF

python3 - "$home/settings.json" <<'EOF'
import json, re, subprocess, sys
try:
    listing = subprocess.run(['claude', 'plugin', 'list'], capture_output=True, text=True, timeout=30).stdout
except (OSError, subprocess.TimeoutExpired):
    listing = ''
plugins = sorted(set(re.findall(r'([a-z0-9][\w.-]*@[\w.-]+)', listing)) - {'kith@kith'})
json.dump({
    '$comment': "Merged over your global ~/.claude/settings.json for this agent's runs (kith --settings). Narrow here: "
                "model, plugins, permissions. MCP servers come from shared services in capabilities.yaml needs "
                "(granted with kith-auth), or mcp.json next to this file. Placeholders: {{KITH}}, {{AGENT_DIR}} "
                "(pinned package), {{AGENTS}} (all installed agents), {{PACKAGE}} (live package: skills/learned/), {{HOME_DIR}} (memory, data), {{HOME_REAL}} (same, symlinks resolved: use in permission rules), "
                "{{STATE}} (the state folder: user.md, projects/), {{USER_HOME}} ($HOME).",
    'autoMemoryEnabled': False,
    'enabledPlugins': {p: False for p in plugins},
    'permissions': {'allow': [f'Edit(/{{{{{h}}}}}/memory/**)' for h in ('HOME_DIR', 'HOME_REAL')] + ['Edit(/{{PACKAGE}}/skills/learned/**)']},
}, open(sys.argv[1], 'w'), indent=2)
open(sys.argv[1], 'a').write('\n')
EOF

cat > "$state/memory/MEMORY.md" <<EOF
# $name: long-term memory index

## Lessons
(none yet)

## Learned skills
(none yet; add \`skills/learned/<name>/SKILL.md\` entries here)
EOF

cat > "$home/.gitignore" <<'EOF'
# state lives in the state folder (kith-state), never in the package
/memory/
/data/
.editing
__pycache__/
.DS_Store
node_modules/
EOF
git -C "$home" init -q && git -C "$home" add -A && git -C "$home" commit -q -m "$name: scaffold (kith-new)"

echo "created $home (its own git repo): agent.md (TODOs for the builder), capabilities.yaml, settings.json, skills/; state in $state"
