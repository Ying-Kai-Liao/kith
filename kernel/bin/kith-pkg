#!/usr/bin/env python3
"""kith-pkg — versioned agent packages. Every run is pinned to a snapshot; edits become a new version for the next run.

  kith-pkg resolve <agent>|--all [--json]   the pinned package dir to run (makes the snapshot if the agent changed)
  kith-pkg versions <agent>                 versions on disk, newest first (marks current, good, pinned)
  kith-pkg pin <agent> [VERSION]            run this version until unpinned (default: the previous good one)
  kith-pkg unpin <agent>                    back to following the latest edits
  kith-pkg check <agent>                    validate the working copy without snapshotting it
  kith-pkg check --share [agent...]         personal details a package must not carry before it is shared: home paths,
                                          email addresses, words listed in <state>/private-words (reports; never
                                          blocks a run)
  kith-pkg promote <agent> <skill>          move a private skill (<state>/agents/<a>/skills/learned/) into the
                                          package's skills/learned/, so it versions and shares with the agent
  kith-pkg fetch <agent>|--all [--force]    download the third-party skills skills.json names (a run does it on first
                                          use; install.sh does it for every agent)
  kith-pkg list [--json]                    installed agents and where each one lives
  kith-pkg deps <agent>|--all [--install]   the programs an agent runs (requires: in capabilities.yaml) that this Mac
                                          lacks, with the command that installs each; --install runs them

History (each agent is its own git repo; a version that passes checks is committed there automatically):
  kith-pkg install <github-link> [--as NAME] [--yes]  clone an agent (owner/repo, a github.com URL, .../tree/<ref>/<path>),
                                          show what it would do here and ask before keeping it (--yes: no question)
  kith-pkg install --saved                  install every agent <state>/agents.json lists that isn't here (a new Mac)
  kith-pkg save                             write <state>/agents.json: each installed agent and its GitHub link
  kith-pkg update <agent>|--all             pull the agent's upstream (fast-forward only; never touches local edits)
  kith-pkg commit <agent>|--all [-m MSG]    commit the agent's pending edits now (runs do it for every good version)
  kith-pkg push <agent>|--all               commit, then push every agent that has a remote
  kith-pkg history <agent> [N]              the agent's commits, newest first
  kith-pkg restore <agent> <commit>         make the package what it was at <commit>, as a new commit (undo with
                                          another restore); the next run uses it
  kith-pkg market [WORDS] [--new]          agents people shared publicly, most starred first (no GitHub login
                                          needed): pick any by number to install; --new hides the ones you have
  kith-pkg search [WORDS] [--mine]          agents on GitHub (repos tagged kith-agent, or the older hq-agent): yours, private ones included, and
                                          public ones from anyone; --mine for yours only
  kith-pkg share <agent> [--public]         put the agent on GitHub as <you>/kith-agent-<name> (tagged kith-agent), private unless --public;
                                          --public refuses while the package or its history has personal details
  kith-pkg share <agent> --public --fresh [--repo NAME]
                                          a public copy without the history, at <you>/kith-<name> (or NAME), remote
                                          `public`: one commit per publish; the agent's own repo keeps every version

Agents live in the agents folder, <home>/agents/<name>/ (lib/kith_paths.py), each its own git repo; the kith repo
holds only the kernel. The package is that folder, including the skills the agent learned (skills/learned/); memory
and data are state and live under the state folder, never in the package. Skills the user keeps off the package
(never shared) go in the state folder's agents/<name>/skills/learned/. Whoever edits it (you, the agent learning a skill,
another code agent) changes the working copy; the next run sees a new fingerprint, validates it, and snapshots it
into ~/.kith/store/<name>@<version>/ (an APFS clone on the same disk, else hard links to the last one). Running sessions keep the snapshot they started on, so upgrades
never wait for anyone. A version that fails validation is not used; the last good one runs instead.

Third-party skills are links, not copies: agents/<name>/skills.json names each one's GitHub repo, path and pinned
commit, and fetch downloads just that folder into skills/<name>/ (git-ignored; .source records what is there). A
package whose linked skills aren't fetched fails its checks like any other problem; changing a pin is a new version.

Multi-file edits: touch agents/<name>/.editing while changing a package and delete it when done; runs keep using
the last good version meanwhile (the marker is ignored after an hour, so a forgotten one can't freeze an agent).

Inside a snapshot: prompt.md (agent.md body + PROTOCOL.md) and settings.json, both still templates: bin/kith and the
adapter fill {{KITH}} repo, {{AGENTS}} the agents folder, {{PACKAGE}} the agent's live folder (where it
writes learned skills), {{AGENT}} name, {{AGENT_DIR}} the pinned package, {{HOME_DIR}} the live agent folder,
{{HOME_REAL}} that folder with symlinks resolved (for permission rules), {{STATE}} the state folder, {{USER_HOME}} $HOME at run time, so a snapshot doesn't depend on the path it was made through. .home names the live agent folder.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# The repo's logical path (not resolved): it may be a symlink to a path with spaces, which agents should never see.
# os.path.abspath would resolve the cwd physically, and __file__ is already resolved: join argv[0] onto $PWD.
KITH = Path(os.environ.get('KITH_ROOT') or os.path.dirname(os.path.dirname(
    os.path.normpath(os.path.join(os.environ.get('PWD') or os.getcwd(), sys.argv[0])))))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from kith_paths import paths  # noqa: E402  the one place that knows where kith's folders are
import kith_settings  # noqa: E402
# The state folder and the agents folder, <home>/state and <home>/agents (lib/kith_paths.py). Each agent's role/ is a git
# checkout (or a symlink into one, for an agent that lives in a folder of a bigger repo).
STATE_ROOT, AGENTS = paths()['KITH_STATE'], paths()['KITH_AGENTS']
# Snapshots: ~/.kith/store (this Mac's, rebuildable: every good version is also in the agent's repo). On the agents'
# disk each is an APFS clone; on another disk, unchanged files are hard links to the previous snapshot's.
STORE = paths()['KITH_STORE']
STATE = ('memory', 'data')                                   # live state, never snapshotted
STATE_NESTED = set()                                         # learned skills are package: they version with it
FORMAT = '2'                                                 # bump when snapshot contents change (e.g. .home)
SKIP = {'__pycache__', '.DS_Store', 'node_modules', '.editing', '.git'}
PLACEHOLDERS = {'KITH', 'HQ', 'AGENTS', 'PACKAGE', 'AGENT', 'AGENT_DIR', 'HOME_DIR', 'HOME_REAL', 'STATE', 'MACHINE', 'USER_HOME'}
EDITING_MAX_AGE = 3600                                       # a stale .editing marker stops holding releases back
KEEP = 2                                                     # newest versions kept besides good/pinned/running/recent


EINTR_TRIES, EINTR_SLEEP = 4, 0.25
EFFORTS = ('low', 'medium', 'high', 'xhigh', 'max')


def die(msg, code=1):
    print(f'kith-pkg: {msg}', file=sys.stderr)
    sys.exit(code)


def retry_eintr(fn, what):
    """fn() again when the disk answers EINTR (macOS does that while it blocks access to an external disk); a clear
    one-line exit when it keeps failing, instead of a traceback that leaves the caller reading empty output."""
    for attempt in range(EINTR_TRIES):
        try:
            return fn()
        except InterruptedError as e:
            if attempt == EINTR_TRIES - 1:
                die(f'cannot read {what}: {e.strerror or e} (errno {e.errno}); the disk may be blocked, try again')
            time.sleep(EINTR_SLEEP)


def installed():
    """{name: package folder}: the agents folder first, then the repo's own agents/ (older installs)."""
    def scan():
        out = {}
        for root in (AGENTS, KITH / 'agents'):
            for d in sorted(root.iterdir()) if root.is_dir() else []:
                pkg = d / 'role' if (d / 'role' / 'agent.md').is_file() else d   # role/ next to the agent's life
                if not d.name.startswith('.') and (pkg / 'agent.md').is_file():
                    out.setdefault(d.name, pkg)
        return out
    return retry_eintr(scan, AGENTS)   # the whole walk: is_dir/is_file can get EINTR as well


def life(agent):
    """Where an agent's life is (memory, data, files): its folder in the agents folder, next to role/; older layouts:
    <state>/agents/<name>."""
    return AGENTS / agent if (AGENTS / agent / 'role').is_dir() else STATE_ROOT / 'agents' / agent


def agent_home(agent):
    home = installed().get(agent)
    if not home:
        die(f"no agent '{agent}' (kith-pkg list)")
    return home


def package_files(home):
    for root, dirs, files in os.walk(home):
        rel = Path(root).relative_to(home)
        dirs[:] = sorted(d for d in dirs if d not in SKIP and not (rel == Path('.') and d in STATE)
                         and rel / d not in STATE_NESTED)
        for f in sorted(files):
            if f not in SKIP:
                yield Path(root) / f


def fingerprint(home):
    where = home.parent if home.name == 'role' else STATE_ROOT
    h = hashlib.sha1(f'format {FORMAT}\nstate {where}\n'.encode())   # .home names where the life is
    for p, label in [*((p, p.relative_to(home)) for p in package_files(home)),
                     (KITH / 'PROTOCOL.md', 'PROTOCOL.md')]:
        st = p.stat()
        h.update(f'{label}\0{st.st_size}\0{st.st_mtime_ns}\n'.encode())
    return h.hexdigest()[:10]


def frontmatter(text):
    m = re.match(r'^---\n(.*?)\n---\n?', text, re.S)
    if not m:
        return {}, text
    fields = dict(re.findall(r'^([A-Za-z_-]+):\s*(.*)$', m.group(1), re.M))
    return fields, text[m.end():]


def problems(home):
    """Reasons a working copy must not become the running version. Empty list = good."""
    out = []
    fields, body = frontmatter((home / 'agent.md').read_text())
    if not fields.get('description'):
        out.append('agent.md: frontmatter has no description')
    if fields.get('effort') and fields['effort'] not in EFFORTS:
        out.append(f'agent.md: effort {fields["effort"]!r} is not one of {", ".join(EFFORTS)}')
    if fields.get('model') and not re.fullmatch(r'[\w.\[\]-]+', fields['model']):
        out.append(f'agent.md: model {fields["model"]!r} is not a model name or alias')
    for name in ('settings.json', 'mcp.json'):
        f = home / name
        if f.exists():
            try:
                json.loads(f.read_text())
            except ValueError as e:
                out.append(f'{name}: invalid JSON ({e})')
    for name in ('agent.md', 'settings.json'):
        f = home / name
        unknown = set(re.findall(r'\{\{([A-Z_]+)\}\}', f.read_text())) - PLACEHOLDERS if f.exists() else set()
        if unknown:
            out.append(f'{name}: unknown placeholder(s) {", ".join(sorted(unknown))}')
    caps = home / 'capabilities.yaml'
    if caps.exists() and re.search(r'^needs:', caps.read_text(), re.M) and \
            not re.search(r'^needs:\s*\[[^\]]*\]', caps.read_text(), re.M):
        out.append('capabilities.yaml: write needs as a one-line list, needs: [a, b]')
    try:
        linked = external_skills(home)
    except ValueError as e:
        out.append(str(e))
        linked = {}
    for name, src in linked.items():
        if read(home / 'skills' / name / '.source') != source_line(src):
            out.append(f'skills/{name} is not fetched at {src["ref"][:12]} (kith-pkg fetch {home.name})')
    for skill in re.findall(r'`([\w./-]+/SKILL\.md)`', body):
        skill = skill[len('skills/'):] if skill.startswith('skills/') else skill
        if not (home / 'skills' / skill).is_file():
            out.append(f'agent.md names skills/{skill}, which does not exist')
    for svc in needs(home):
        if not (KITH / 'services' / f'{svc}.json').is_file() and not (home / 'services' / f'{svc}.json').is_file():
            out.append(f'capabilities.yaml needs service {svc!r}, not in kernel/services/ or its own services/')
    for f in sorted((home / 'services').glob('*.json')) if (home / 'services').is_dir() else []:
        try:
            if not json.loads(f.read_text()).get('kind'):
                out.append(f'services/{f.name}: no kind (mcp, cli or login)')
        except ValueError as e:
            out.append(f'services/{f.name}: invalid JSON ({e})')
    return out + must_ask_problems(home)


def must_ask_problems(home):
    """Routine a package declares (settings.json permissions.allow and autoMode.allow) that a must-ask class covers: the
    run asks for it anyway (kith_guard.must_ask_rules), so declaring it is a mistake to fix in the package."""
    import kith_guard
    try:
        s = json.loads((home / 'settings.json').read_text())
    except (OSError, ValueError):
        return []
    agent = home.parent.name if home.name == 'role' else home.name
    life_dir = str(life(agent))
    p = paths()
    values = {'KITH': str(KITH), 'HQ': str(KITH), 'AGENTS': str(p['KITH_AGENTS']), 'PACKAGE': str(home), 'AGENT': agent,
              'AGENT_DIR': str(home), 'HOME_DIR': life_dir, 'HOME_REAL': os.path.realpath(life_dir),
              'STATE': str(p['KITH_STATE']), 'MACHINE': str(p['KITH_MACHINE']), 'USER_HOME': str(Path.home())}
    fill = lambda t: re.sub(r'\{\{([A-Z_]+)\}\}', lambda m: values.get(m.group(1), m.group(0)), t)  # noqa: E731
    places = kith_guard.Places(package=home)
    out = []
    perms = s.get('permissions') if isinstance(s.get('permissions'), dict) else {}
    for rule in perms.get('allow') or []:
        c = isinstance(rule, str) and kith_guard.must_ask_rule(rule, fill, places)
        if c:
            out.append(f'settings.json: allow {rule} is must-ask ({c}); the run asks for it whatever allows it')
    auto = s.get('autoMode') if isinstance(s.get('autoMode'), dict) else {}
    for line in auto.get('allow') or []:
        c = isinstance(line, str) and line != '$defaults' and kith_guard.sentence_class(line)
        if c:
            out.append(f'settings.json: autoMode.allow names a must-ask class ({c}): {line[:80]}')
    return out


def needs(home):
    """`needs: [a, b]` from capabilities.yaml: the shared services this agent asks for (granted in auth.json)."""
    f = home / 'capabilities.yaml'
    m = re.search(r'^needs:\s*\[([^\]]*)\]', f.read_text(), re.M) if f.exists() else None
    return [s.strip() for s in m.group(1).split(',') if s.strip()] if m else []


def requires(home):
    """`requires:` in capabilities.yaml: programs the agent runs, one per line, `name: install command  # why`. The
    name is a command on PATH, or a path (/... or ~/...) that must exist, e.g. an app."""
    f = home / 'capabilities.yaml'
    out, inside = [], False
    for line in (f.read_text().splitlines() if f.exists() else []):
        if re.match(r'^requires:', line):
            inside = True
            continue
        if inside and line.strip() and not line[0].isspace():
            break
        m = re.match(r'^\s+(?:-\s*)?([^:#]+?):\s*([^#]*?)\s*(?:#\s*(.*))?$', line) if inside else None
        if m:
            out.append((m.group(1).strip(), m.group(2).strip(), (m.group(3) or '').strip()))
    return out


def missing(home):
    def present(name):
        if name.startswith(('/', '~')):
            return Path(os.path.expanduser(name)).exists()
        return bool(shutil.which(name))
    return [r for r in requires(home) if not present(r[0])]


def install_missing(name, miss):
    """Run each missing program's install command, showing its output; True when all are there afterwards."""
    for prog, cmd, _ in miss:
        if cmd.startswith('brew ') and not shutil.which('brew'):
            print(f'  {prog}: needs Homebrew first (https://brew.sh), then: kith deps {name} --install')
            continue
        print(f'  $ {cmd}')
        subprocess.run(cmd, shell=True)
    left = missing(agent_home(name))
    for prog, cmd, _ in left:
        print(f'  ✗ {prog} still missing: {cmd}')
    return not left


def show_missing(name, miss):
    print(f'  it runs programs this Mac doesn\'t have yet:')
    width, cw = max(len(p) for p, _, _ in miss), max(len(c) for _, c, _ in miss)
    for prog, cmd, why in miss:
        print(f'    {prog.ljust(width)}  {cmd.ljust(cw)}  {why}'.rstrip())


def cmd_deps(names, install):
    short = False
    for name in names:
        miss = missing(agent_home(name))
        if not miss:
            if len(names) == 1:
                print(f'{name}: has everything it runs' if requires(agent_home(name)) else f'{name}: requires nothing')
            continue
        print(name)
        show_missing(name, miss)
        short = not install_missing(name, miss) if install else True
    sys.exit(1 if short else 0)


def snapshot(agent, home, version):
    dest = STORE / f'{agent}@{version}'
    if dest.exists():
        return dest
    STORE.mkdir(parents=True, exist_ok=True)
    tmp = STORE / f'.tmp-{agent}-{version}-{os.getpid()}'
    tmp.mkdir()
    # APFS clones, one cp per top-level entry: instant and copy-on-write, so a snapshot never changes when the
    # working copy does. Then drop what the fingerprint ignores.
    entries = [str(e) for e in sorted(home.iterdir()) if e.name not in STATE and e.name not in SKIP]
    cloned = subprocess.run(['cp', '-c', '-R', '-p', *entries, str(tmp)], capture_output=True).returncode == 0
    if not cloned:                        # another disk: no clones, so share what didn't change instead
        shutil.rmtree(tmp)
        tmp.mkdir()
        prev = next(iter(all_versions(agent)), None)
        for p in package_files(home):
            target = tmp / p.relative_to(home)
            target.parent.mkdir(parents=True, exist_ok=True)
            if not (prev and link_same(p, prev / p.relative_to(home), target)):
                shutil.copy2(p, target)
    for nested in STATE_NESTED:
        shutil.rmtree(tmp / nested, ignore_errors=True)
    for root, dirs, files in os.walk(tmp):
        for d in [d for d in dirs if d in SKIP]:
            shutil.rmtree(os.path.join(root, d), ignore_errors=True)
            dirs.remove(d)
        for f in [f for f in files if f in SKIP]:
            os.unlink(os.path.join(root, f))
    _, body = frontmatter((home / 'agent.md').read_text())
    protocol = (KITH / 'PROTOCOL.md').read_text()
    for name in ('prompt.md', '.home', '.meta.json'):   # written below: never through a link into an older snapshot
        (tmp / name).unlink(missing_ok=True)
    (tmp / 'prompt.md').write_text(f'{body.strip()}\n\n{protocol}')
    if not (tmp / 'settings.json').exists():
        (tmp / 'settings.json').write_text('{}\n')
    (tmp / '.home').write_text(f'{life(agent)}\n')
    (tmp / '.meta.json').write_text(json.dumps({'agent': agent, 'version': version, 'made': time.time(),
                                                'needs': needs(home)}))
    for root, _, files in os.walk(tmp):   # read-only files: a run can't edit its own snapshot by accident
        for f in files:                   # (executables keep their execute bit, so tools/<x> still runs)
            p = os.path.join(root, f)
            os.chmod(p, 0o555 if os.stat(p).st_mode & 0o111 else 0o444)
    try:
        tmp.rename(dest)
    except OSError:                       # another run made the same version first
        shutil.rmtree(tmp, ignore_errors=True)
    return dest


def link_same(src, old, target):
    """Hard-link target to the previous snapshot's copy when the file didn't change (same size and mtime, as rsync
    decides). Snapshot files are read-only, so sharing one between versions is safe."""
    try:
        a, b = src.stat(), old.stat()
        if a.st_size != b.st_size or int(a.st_mtime) != int(b.st_mtime):
            return False
        os.link(old, target)
        return True
    except OSError:
        return False


def pointers(agent):
    d = STORE / '.pointers'
    d.mkdir(parents=True, exist_ok=True)
    return d / f'{agent}.good', d / f'{agent}.pin'


def read(p):
    try:
        return p.read_text().strip()
    except OSError:
        return ''


def write_atomic(p, text):
    tmp = p.with_name(f'.{p.name}.{os.getpid()}')
    tmp.write_text(text + '\n')
    tmp.rename(p)


def external_skills(home):
    """{folder name: {repo, path, ref, license}} from skills.json: third-party skills linked, not copied."""
    f = home / 'skills.json'
    if not f.exists():
        return {}
    try:
        skills = json.loads(f.read_text()).get('skills', {})
    except ValueError as e:
        raise ValueError(f'skills.json: invalid JSON ({e})')
    for name, src in skills.items():
        if not re.fullmatch(r'[a-z0-9][\w.-]*', name):
            raise ValueError(f'skills.json: bad skill folder name {name!r}')
        if not re.fullmatch(r'[\w.-]+/[\w.-]+', src.get('repo', '')):
            raise ValueError(f'skills.json: {name}: repo must be owner/name')
        if not re.fullmatch(r'[0-9a-f]{40}', src.get('ref', '')):
            raise ValueError(f'skills.json: {name}: ref must be a full commit sha (pinned, never a branch)')
        if not src.get('path') or '..' in src['path'].split('/'):
            raise ValueError(f'skills.json: {name}: path must be a folder in the repo ("." for the repo itself)')
    return skills


def source_line(src):
    return f'{src["repo"]}@{src["ref"]}:{src["path"].strip("/") or "."}'


def fetch(home, force=False):
    """Download each linked skill that isn't already there at its pinned commit. Returns the names fetched."""
    skills = external_skills(home)
    todo = {n: s for n, s in skills.items() if force or read(home / 'skills' / n / '.source') != source_line(s)}
    groups = {}
    for name, src in todo.items():
        groups.setdefault((src['repo'], src['ref']), []).append((name, src['path'].strip('/') or '.'))
    env = {**os.environ, 'GIT_TERMINAL_PROMPT': '0'}
    for (repo, ref), items in groups.items():
        # A shallow, blob-less, sparse fetch of one commit: only these folders' files come down, however big the repo.
        with tempfile.TemporaryDirectory(prefix='kith-fetch-') as tmp:
            git = lambda *a: subprocess.run(['git', '-C', tmp, *a], env=env, capture_output=True, text=True,
                                            timeout=300)
            whole = any(p == '.' for _, p in items)     # a repo that is itself the skill
            steps = [('init', '-q'), ('remote', 'add', 'origin', f'https://github.com/{repo}.git'),
                     *([] if whole else [('sparse-checkout', 'set', '--no-cone', *[f'/{p}/' for _, p in items])]),
                     ('fetch', '-q', '--depth', '1', '--filter=blob:none', 'origin', ref),
                     ('checkout', '-q', 'FETCH_HEAD')]
            for step in steps:
                r = git(*step)
                if r.returncode:
                    raise RuntimeError(f'fetching {repo}@{ref[:12]}: git {step[0]} failed: {r.stderr.strip()}')
            for name, path in items:
                src = Path(tmp) / path
                if not (src / 'SKILL.md').is_file():
                    raise RuntimeError(f'{repo}@{ref[:12]} has no {path}/SKILL.md')
                dest = home / 'skills' / name
                part = home / 'skills' / f'.{name}.part'
                shutil.rmtree(part, ignore_errors=True)
                shutil.copytree(src, part, ignore=shutil.ignore_patterns('.git'))
                (part / '.source').write_text(source_line(skills[name]) + '\n')
                shutil.rmtree(dest, ignore_errors=True)
                part.rename(dest)
    if skills:   # fetched folders are not part of the repo; rewritten only on change (its mtime is in the fingerprint)
        ignore = home / 'skills' / '.gitignore'
        text = ('# third-party skills fetched from skills.json (kith-pkg fetch); not committed\n'
                + ''.join(f'/{n}/\n' for n in sorted(skills)))
        if read(ignore) != text.strip():
            ignore.write_text(text)
    return sorted(todo)


def resolve(agent):
    """Returns (package dir, note). note is set when the run doesn't use the latest edits."""
    home = agent_home(agent)
    good, pin = pointers(agent)
    pinned = read(pin)
    if pinned and (STORE / f'{agent}@{pinned}').is_dir():
        return STORE / f'{agent}@{pinned}', f'pinned to {pinned} (kith unpin {agent} to follow edits)'
    last = read(good)
    editing = home / '.editing'
    if editing.exists() and time.time() - editing.stat().st_mtime < EDITING_MAX_AGE and \
            last and (STORE / f'{agent}@{last}').is_dir():
        return STORE / f'{agent}@{last}', f'being edited (.editing), running {last}'
    try:
        fetch(home)       # first run after install, or a changed pin: download what skills.json links
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
        print(f'kith: {agent}: {e}', file=sys.stderr)   # the checks below then fail and the last good version runs
    version = fingerprint(home)
    if (STORE / f'{agent}@{version}').is_dir():
        running(STORE / f'{agent}@{version}')   # clears records of finished runs
        if (STORE / f'{agent}@{version}' / '.unchecked').exists():
            return STORE / f'{agent}@{version}', 'no good version yet, running unchecked edits'
        write_atomic(good, version)
        gc(agent)
        return STORE / f'{agent}@{version}', ''
    bad = problems(home)
    if bad:
        detail = '; '.join(bad)
        if last and (STORE / f'{agent}@{last}').is_dir():
            return STORE / f'{agent}@{last}', f'latest edits fail checks, running {last}: {detail}'
        dest = snapshot(agent, home, version)
        (dest / '.unchecked').write_text(detail + '\n')
        return dest, f'no good version yet, running unchecked edits: {detail}'
    dest = snapshot(agent, home, version)
    write_atomic(good, version)
    gc(agent)
    commit(home, f'{agent} {version}')   # every good version is in the agent's history, to restore later
    return dest, ''


def running(pkg):
    """True while a run started from this snapshot is alive; clears records of finished runs."""
    alive = False
    runs = pkg / '.runs'
    for f in runs.glob('*') if runs.is_dir() else []:
        pid = f.name.split('.', 1)[0]
        try:
            os.kill(int(pid), 0)
            alive = True
        except (ValueError, ProcessLookupError):
            f.unlink(missing_ok=True)
        except PermissionError:
            alive = True
    return alive


def made(d):
    """When a version was made. Not the folder's mtime: that moves whenever a run is recorded in it."""
    try:
        return json.loads((d / '.meta.json').read_text())['made']
    except (OSError, ValueError, KeyError):
        return d.stat().st_mtime


def all_versions(agent):
    dirs = [d for d in STORE.glob(f'{agent}@*') if d.is_dir()]
    return sorted(dirs, key=made, reverse=True)


def gc(agent):
    good, pin = pointers(agent)
    keep = {read(good), read(pin)}
    for d in all_versions(agent)[KEEP:]:
        # Subagent sessions don't record runs, so anything made in the last two days stays too.
        recent = time.time() - made(d) < 2 * 86400
        if d.name.split('@', 1)[1] not in keep and not recent and not running(d):
            shutil.rmtree(d, ignore_errors=True)


def cmd_versions(agent):
    agent_home(agent)
    good, pin = pointers(agent)
    current = fingerprint(agent_home(agent))
    for d in all_versions(agent):
        v = d.name.split('@', 1)[1]
        tags = [t for t, on in (('latest', v == current), ('good', v == read(good)), ('pinned', v == read(pin)),
                                ('running', running(d))) if on]
        when = time.strftime('%Y-%m-%d %H:%M', time.localtime(made(d)))
        print(f'{v}  {when}  {" ".join(tags)}')
    if not (STORE / f'{agent}@{current}').is_dir():
        print(f'{current}  (unreleased edits; the next run checks and snapshots them)')


def cmd_pin(agent, version):
    agent_home(agent)
    good, pin = pointers(agent)
    if not version:
        versions = [d.name.split('@', 1)[1] for d in all_versions(agent)]
        current = read(pin) or read(good)
        older = versions[versions.index(current) + 1:] if current in versions else versions[1:]
        if not older:
            die(f'no older version of {agent} to roll back to')
        version = older[0]
    if not (STORE / f'{agent}@{version}').is_dir():
        die(f'no version {version} of {agent} here (kith-pkg versions {agent}); older ones are in its history: '
            f'kith-pkg history {agent}, then kith-pkg restore {agent} <commit>')
    write_atomic(pin, version)
    print(f'{agent} pinned to {version}; new runs use it, running ones keep theirs')


def private_patterns():
    words_file = STATE_ROOT / 'private-words'
    words = [w.strip() for w in (words_file.read_text().splitlines() if words_file.is_file() else [])
             if w.strip() and not w.startswith('#')]
    pats = [(re.compile(r'/Users/[A-Za-z0-9._-]+/'), 'home path'),
            (re.compile(r'[\w.+-]+@(?!example\.)[\w-]+(\.[\w-]+)*\.[A-Za-z]{2,}\b'), 'email address')]
    return pats + [(re.compile(r'(?<![\w-])' + re.escape(w) + r'(?![\w-])', re.I), 'private word') for w in words]


def personal(line, pats):
    for pat, kind in pats:
        m = pat.search(line)
        if m and not (kind == 'email address' and m.group().endswith(('.png', '.svg', '.js', '.css'))):
            return f'{kind} {m.group()!r}'


def share_problems(home):
    """Personal details in a package's text files. Not a run check: they only matter when the package is shared."""
    pats = private_patterns()
    out = []
    linked = set(external_skills(home)) if (home / 'skills.json').exists() else set()
    for f in package_files(home):
        rel = f.relative_to(home).parts
        if len(rel) > 2 and rel[0] == 'skills' and rel[1] in linked:
            continue      # third-party, fetched from its source; not part of what is shared
        if f.stat().st_size > 2_000_000:
            continue
        try:
            text = f.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        for n, line in enumerate(text.splitlines(), 1):
            hit = personal(line, pats)
            if hit:
                out.append(f'{home.name}/{f.relative_to(home)}:{n}: {hit}')
    return out


def cmd_promote(agent, skill):
    home = agent_home(agent)
    src = life(agent) / 'skills' / 'learned' / skill
    dest = home / 'skills' / 'learned' / skill
    if not (src / 'SKILL.md').is_file():
        die(f'no learned skill {src}/SKILL.md')
    if dest.exists():
        die(f'{dest} already exists')
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dest))
    print(f'{agent}: {skill} is now part of the package (skills/learned/{skill}/); the next good version is committed. '
          f'Fix its path in memory/MEMORY.md\'s learned list.')


# ---- history: each agent is its own git repo ----

GITIGNORE = """# state lives in the state folder (kith-state), never in the package
/memory/
/data/
.editing
__pycache__/
.DS_Store
node_modules/
"""


def git(home, *args, check=False, timeout=120):
    r = subprocess.run(['git', '-C', str(home), *args], capture_output=True, text=True, timeout=timeout,
                       env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'})
    if check and r.returncode:
        die(f'git {args[0]} in {home}: {(r.stderr or r.stdout).strip()}')
    return r


def owned(home):
    """True when the agent has a history of its own: it lives in the agents folder and is inside a git repo.
    The repo's legacy agents/ is never committed to (that is the public kernel repo)."""
    inside = home.parent == AGENTS or (home.name == 'role' and home.parent.parent == AGENTS)
    return inside and git(home, 'rev-parse', '--is-inside-work-tree').stdout.strip() == 'true'


def repo_root(home):
    return Path(git(home, 'rev-parse', '--show-toplevel', check=True).stdout.strip())


def commit(home, msg):
    """Commit the package's pending edits (this folder only, for an agent inside a bigger repo). Never fails a run."""
    try:
        if not owned(home):
            return False
        git(home, 'add', '-A', '--', '.')
        if git(home, 'diff', '--cached', '--quiet', '--', '.').returncode == 0:
            return False
        return git(home, 'commit', '-q', '-m', msg, '--', '.').returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def parse_link(link):
    """(clone url, ref, path, default name) from owner/repo, a github.com URL, .../tree/<ref>/<path>, or a local repo."""
    if os.path.isdir(os.path.expanduser(link)):
        p = Path(os.path.expanduser(link)).resolve()
        return str(p), '', '', p.name
    m = re.fullmatch(r'(?:https?://)?(?:www\.)?(?:github\.com[/:])?([\w.-]+)/([\w.-]+?)(?:\.git)?'
                     r'(?:/tree/([^/]+)(?:/(.+?))?)?/?(?:@([\w./-]+))?', link.replace('git@github.com:', ''))
    if not m:
        die(f'not a GitHub link: {link} (owner/repo, https://github.com/owner/repo[/tree/REF/PATH])', 2)
    owner, repo, ref, path, at = m.groups()
    path = (path or '').strip('/')
    name = path.rsplit('/', 1)[-1] if path else re.sub(r'^(kith|hq)-(agent-)?', '', repo)
    return f'https://github.com/{owner}/{repo}.git', ref or at or '', path, name


def review(home):
    """What an agent would do on this Mac, from its own files: shown before installing someone's agent."""
    fields, _ = frontmatter((home / 'agent.md').read_text())
    lines = [f'  {fields.get("description", "(no description)")}']
    if fields.get('model') or fields.get('effort'):
        lines.append(f'  model {fields.get("model", "yours")}, effort {fields.get("effort", "yours")}')
    try:
        settings = json.loads((home / 'settings.json').read_text()) if (home / 'settings.json').exists() else {}
    except ValueError:
        settings = {}
    perms = settings.get('permissions', {})
    if perms.get('defaultMode'):
        lines.append(f'  suggested permission mode: {perms["defaultMode"]}'
                     + ('  ← runs every tool without asking' if perms['defaultMode'] == 'bypassPermissions' else ''))
    allow = perms.get('allow', [])
    if allow:
        lines.append(f'  allowed without asking: {", ".join(allow[:8])}' + (' …' if len(allow) > 8 else ''))
    hooks = [h.get('command', '') for event in settings.get('hooks', {}).values() for m in event
             for h in m.get('hooks', [])]
    if hooks:
        lines.append(f'  hooks (commands that run on their own): {"; ".join(hooks[:4])}')
    try:
        mcp = json.loads((home / 'mcp.json').read_text()).get('mcpServers', {}) if (home / 'mcp.json').exists() else {}
    except ValueError:
        mcp = {}
    if mcp:
        lines.append('  MCP servers it starts: ' + ', '.join(f'{k} ({v.get("command", v.get("url", "?"))})'
                                                         for k, v in mcp.items()))
    tools = sorted(str(f.relative_to(home)) for f in (home / 'tools').rglob('*')
                   if f.is_file() and '__pycache__' not in f.parts) if (home / 'tools').is_dir() else []
    if tools:
        lines.append(f'  its tools ({len(tools)}): {", ".join(tools[:6])}' + (' …' if len(tools) > 6 else ''))
    skills = sorted(d.name for d in (home / 'skills').iterdir() if d.is_dir()) if (home / 'skills').is_dir() else []
    if skills:
        lines.append(f'  skills ({len(skills)}): {", ".join(skills[:10])}' + (' …' if len(skills) > 10 else ''))
    try:
        linked = external_skills(home)
    except ValueError:
        linked = {}
    if linked:
        lines.append('  skills fetched from other repos: ' + ', '.join(f'{k} ({v["repo"]})' for k, v in linked.items()))
    progs = requires(home)
    if progs:
        lines.append(f'  programs it runs: {", ".join(p for p, _, _ in progs)}'
                     + (f' (missing here: {", ".join(p for p, _, _ in missing(home))})' if missing(home) else ''))
    svc = needs(home)
    if svc:
        own = [x for x in svc if (home / 'services' / f'{x}.json').is_file()]
        lines.append(f'  asks for services: {", ".join(svc)}' + (f' (it defines {", ".join(own)})' if own else '')
                     + ': nothing is shared until you grant it')
    return '\n'.join(lines)


def choose_mode(name, home):
    """Someone's agent only suggests its permission mode (settings.json defaultMode): the mode it starts in on this Mac
    is the installer's, kept in kith's settings so an update of theirs can't change it. bypassPermissions needs a yes."""
    try:
        mode = kith_settings.current(json.loads((home / 'settings.json').read_text()).get('permissions', {}).get('defaultMode'))
    except (OSError, ValueError):
        mode = None
    if not mode:
        return
    yours = kith_settings.get('permission_mode')
    keep = mode != 'bypassPermissions'
    if mode != yours and sys.stdin.isatty():
        answer = input(f'  its author suggests permission mode {mode}; yours is {yours}. Start it in {mode}? '
                       + ('[Y/n] ' if keep else '[y/N] ')).strip().lower()
        keep = answer.startswith('y') if answer else keep
    chosen = mode if keep else yours
    try:
        kith_settings.choose(name, 'permission_mode', chosen)
    except (OSError, ValueError) as e:
        print(f'kith-pkg: {name}: mode not saved ({e}): it starts in {mode}', file=sys.stderr)
        return
    print(f'  {name} starts in {chosen} (agents.{name}.permission_mode in {kith_settings.FILE})')


def cmd_install(link, name=None, ask=False):
    url, ref, path, default = parse_link(link)
    name = name or default
    if name == 'kith':   # the command's own name: `kith kith` can't be an agent
        die("an agent can't be called 'kith' (it is the command's own name); pick another with --as NAME", 2)
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', name):
        die(f'agent name {name!r}: use lowercase letters, digits and dashes (--as NAME)', 2)
    if name in installed():
        die(f"there is already an agent '{name}' at {installed()[name]}")
    AGENTS.mkdir(parents=True, exist_ok=True)
    if path:   # an agent in a folder of a bigger repo: clone the repo once, link the folder in
        slug = re.sub(r'\W+', '-', url.split('github.com/')[-1].removesuffix('.git'))
        checkout = AGENTS / '.repos' / slug
        if not checkout.exists():
            git(AGENTS, 'clone', '-q', url, str(checkout), check=True, timeout=600)
        if ref:
            git(checkout, 'checkout', '-q', ref, check=True)
        if not (checkout / path / 'agent.md').is_file():
            die(f'{link}: no agent.md in {path}/')
        (AGENTS / name).mkdir(exist_ok=True)   # may already hold its life (memory, data) from the agents repo
        (AGENTS / name / 'role').symlink_to(checkout / path)
    else:
        (AGENTS / name).mkdir(exist_ok=True)
        git(AGENTS / name, 'clone', '-q', url, 'role', check=True, timeout=600)
        home = AGENTS / name / 'role'
        if ref:
            git(home, 'checkout', '-q', ref, check=True)
        if not (home / 'agent.md').is_file():
            shutil.rmtree(home)
            die(f'{link} has no agent.md at its root; for an agent in a folder, link .../tree/<ref>/<folder>')
        if not (home / '.gitignore').exists():
            (home / '.gitignore').write_text(GITIGNORE)
    home = AGENTS / name / 'role'
    state = AGENTS / name
    if ask:   # someone's agent, installed by hand: show what it would do here before keeping it
        print(f'{name} ({link}):\n{review(home)}')
        if sys.stdin.isatty() and input('install it? [Y/n] ').strip().lower().startswith('n'):
            (state / 'role').unlink() if (state / 'role').is_symlink() else shutil.rmtree(state / 'role')
            if not any(state.iterdir()):
                state.rmdir()
            print(f'{name}: not installed')
            return
        choose_mode(name, home)
    for d in ('memory/projects', 'memory/sessions'):
        (state / d).mkdir(parents=True, exist_ok=True)
    try:
        fetch(home)
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
        print(f'kith-pkg: {name}: {e} (the first run retries)', file=sys.stderr)
    bad = problems(home)
    print(f'installed {name} from {link} -> {home}' + (f'\n  checks: {"; ".join(bad)}' if bad else ''))
    svc = needs(home)
    if svc:
        print(f'  it asks for: {", ".join(svc)} (grant with: kith auth grant {name} <service>)')
    miss = missing(home)
    if miss:
        show_missing(name, miss)
        if ask and sys.stdin.isatty() and not input('  install them now? [Y/n] ').strip().lower().startswith('n'):
            install_missing(name, miss)
        else:
            print(f'  later: kith deps {name} --install')


def upstream(home):
    remotes = git(home, 'remote').stdout.split()
    return 'upstream' if 'upstream' in remotes else 'origin' if 'origin' in remotes else ''


def cmd_update(agent):
    home = agent_home(agent)
    if not owned(home):
        die(f'{agent} is not in the agents folder ({AGENTS}); nothing to update from')
    remote = upstream(home)
    if not remote:
        print(f'{agent}: no remote, nothing to update')
        return
    commit(home, f'{agent}: local edits before update')
    r = git(home, 'pull', '-q', '--ff-only', remote, git(home, 'branch', '--show-current').stdout.strip() or 'HEAD')
    if r.returncode:
        die(f'{agent}: could not fast-forward from {remote} (your edits and theirs differ: merge in {repo_root(home)}): '
            f'{r.stderr.strip()}')
    print(f'{agent}: {git(home, "log", "-1", "--format=%h %s").stdout.strip()}')


def cmd_push(agent):
    home = agent_home(agent)
    if not owned(home):
        return
    commit(home, f'{agent}: edits')
    if 'origin' not in git(home, 'remote').stdout.split():
        print(f'{agent}: no remote (kith-pkg share {agent} puts it on GitHub)')
        return
    r = git(home, 'push', '-q', '-u', 'origin', 'HEAD')
    print(f'{agent}: ' + ('pushed' if r.returncode == 0 else f'push failed: {r.stderr.strip()}'))
    return r.returncode == 0


def cmd_history(agent, n=20):
    home = agent_home(agent)
    if not owned(home):
        die(f'{agent} has no history of its own (not a git repo in {AGENTS})')
    print(git(home, 'log', f'-{n}', '--date=format:%Y-%m-%d %H:%M', '--format=%h  %ad  %s', '--', '.').stdout.rstrip())


def cmd_restore(agent, ref):
    home = agent_home(agent)
    if not owned(home):
        die(f'{agent} has no history of its own (not a git repo in {AGENTS})')
    full = git(home, 'rev-parse', '--verify', '-q', f'{ref}^{{commit}}').stdout.strip()
    if not full:
        die(f'no commit {ref} in {agent} (kith-pkg history {agent})')
    commit(home, f'{agent}: edits before restoring {ref}')
    git(home, 'restore', f'--source={full}', '--staged', '--worktree', '--', '.', check=True)
    if not commit(home, f'{agent}: restore to {full[:9]}'):
        print(f'{agent} is already at {full[:9]}')
        return
    bad = problems(home)
    print(f'{agent} restored to {full[:9]} as a new commit; new runs use it, running ones keep theirs'
          + (f'\n  checks fail, so the last good version keeps running: {"; ".join(bad)}' if bad else ''))


def history_problems(home):
    """Personal details in lines the package's history ever added: a public repo shows every old commit."""
    pats, out = private_patterns(), []
    log = git(home, 'log', '-p', '--format=commit %h', '--', '.', timeout=300).stdout
    sha = ''
    for line in log.splitlines():
        if line.startswith('commit '):
            sha = line[7:]
        elif line.startswith('+') and not line.startswith('+++'):
            hit = personal(line[1:], pats)
            if hit:
                out.append(f'{sha}: {hit}')
    return sorted(set(out))


README = """# {name}

{description}

An agent for [kith](https://github.com/Ying-Kai-Liao/kith): a specialist that runs in Claude Code with its own memory,
skills and tools, on your own Mac.

```
kith install {link}
```
{needs}
`kith install` shows what it may do on your Mac (permissions, tools, services) before keeping it. Its memory and data
stay yours; updating it (`kith update {name}`) never touches them.
"""


def ensure_readme(home, agent, link):
    """A README for the agent's GitHub page, from agent.md, unless the author wrote one."""
    f = home / 'README.md'
    if f.exists():
        return
    fields, _ = frontmatter((home / 'agent.md').read_text())
    svc = needs(home)
    f.write_text(README.format(
        name=agent, link=link, description=fields.get('description', '').strip(),
        needs=(f'\nIt asks for these services, used only once you grant them (`kith auth grant {agent} <service> '
               f'<profile>`): {", ".join(svc)}.\n' if svc else '')))


def cmd_publish(agent, repo_name=None):
    """A public copy without the history: one commit per publish, holding the agent as it is now. The agent's own
    repo (origin) keeps every version and stays as private as it is."""
    home = agent_home(agent)
    if not owned(home) or repo_root(home).resolve() != home.resolve():
        die(f'{agent}: only an agent that is its own repo in the agents folder can be published')
    url = git(home, 'remote', 'get-url', 'public').stdout.strip()
    if url:   # published before: the same place
        m = re.search(r'github\.com[/:]([\w.-]+/[\w.-]+?)(?:\.git)?$', url)
        repo = m.group(1) if m else url
    else:
        me = subprocess.run(['gh', 'api', 'user', '-q', '.login'], capture_output=True, text=True).stdout.strip()
        if not me:
            die('gh is not logged in (gh auth login)')
        repo = f'{me}/{repo_name or "kith-" + agent}'
    ensure_readme(home, agent, repo)
    commit(home, f'{agent}: edits')
    bad = share_problems(home)
    if bad:
        die(f'{agent} carries personal details, so it is not published:\n  ' + '\n  '.join(bad[:30]))
    if not url:
        desc = frontmatter((home / 'agent.md').read_text())[0].get('description', '')[:300]
        r = subprocess.run(['gh', 'repo', 'create', repo, '--public', '--description', desc],
                           capture_output=True, text=True)
        if r.returncode and 'already exists' not in r.stderr:
            die(f'gh repo create {repo}: {r.stderr.strip()}')
        git(home, 'remote', 'add', 'public', f'https://github.com/{repo}.git', check=True)
    git(home, 'fetch', '-q', 'public')
    parent = git(home, 'rev-parse', '-q', '--verify', 'public/main').stdout.strip()
    tree = git(home, 'rev-parse', 'HEAD^{tree}', check=True).stdout.strip()
    if parent and git(home, 'rev-parse', f'{parent}^{{tree}}').stdout.strip() == tree:
        print(f'{agent}: https://github.com/{repo} is already this version')
        return
    msg = f'{agent} {fingerprint(home)}'
    new = git(home, 'commit-tree', tree, *(['-p', parent] if parent else []), '-m', msg, check=True).stdout.strip()
    r = git(home, 'push', '-q', 'public', f'{new}:refs/heads/main')
    if r.returncode:
        die(f'{agent}: push to {repo} failed: {r.stderr.strip()}')
    if '/' in repo and not repo.startswith('/'):
        subprocess.run(['gh', 'repo', 'edit', repo, '--add-topic', TOPIC], capture_output=True)
    print(f'{agent}: published https://github.com/{repo} (one commit, no history); others install it with: '
          f'kith install {repo}')


def cmd_share(agent, public):
    home = agent_home(agent)
    if not owned(home):
        die(f'{agent} is not in the agents folder ({AGENTS})')
    root = repo_root(home)
    if root.resolve() != home.resolve():
        die(f'{agent} lives in a folder of {root}; share that repo with git/gh directly')
    me_ = subprocess.run(['gh', 'api', 'user', '-q', '.login'], capture_output=True, text=True).stdout.strip()
    ensure_readme(home, agent, f'{me_}/kith-agent-{agent}' if me_ else agent)
    commit(home, f'{agent}: edits')
    if public:
        bad = share_problems(home) + [f'history {x}' for x in history_problems(home)]
        if bad:
            die(f'{agent} still carries personal details, so it stays private:\n  ' + '\n  '.join(bad[:30])
                + ('\n  ...' if len(bad) > 30 else '')
                + f'\nFix the files; for old commits, publish a copy without the history: kith share {agent} --public --fresh')
    me = subprocess.run(['gh', 'api', 'user', '-q', '.login'], capture_output=True, text=True).stdout.strip()
    if not me:
        die('gh is not logged in (gh auth login)')
    url = git(home, 'remote', 'get-url', 'origin').stdout.strip()
    mine = re.search(rf'github\.com[/:]{re.escape(me)}/([\w.-]+?)(?:\.git)?$', url)
    if url and not mine:   # installed from someone else: theirs becomes upstream, yours becomes origin
        git(home, 'remote', 'rename', 'origin', 'upstream', check=True)
    if mine:
        repo = f'{me}/{mine.group(1)}'
    else:
        repo = f'{me}/kith-agent-{agent}'
        r = subprocess.run(['gh', 'repo', 'create', repo, '--private', '--source', str(home), '--remote', 'origin',
                            '--description', frontmatter((home / 'agent.md').read_text())[0].get('description', '')[:300]],
                           capture_output=True, text=True)
        if r.returncode:
            die(f'gh repo create {repo}: {r.stderr.strip()}')
    if not cmd_push(agent):
        die(f'{agent}: created {repo} but the push failed')
    # the topic is how agents are found: kith-pkg search, github.com/topics/kith-agent
    subprocess.run(['gh', 'repo', 'edit', repo, '--add-topic', TOPIC], capture_output=True)
    if public:
        subprocess.run(['gh', 'repo', 'edit', repo, '--visibility', 'public',
                        '--accept-visibility-change-consequences'], check=True, capture_output=True)
    print(f'{agent}: https://github.com/{repo} ({"public" if public else "private"}); '
          f'others install it with: kith install {repo}')


def cmd_save():
    """<state>/agents.json: which agents this install has and where they come from, so the state repo can bring
    them back on another Mac (install --saved)."""
    out = {}
    for name, home in installed().items():
        if owned(home):
            url = git(home, 'remote', 'get-url', 'origin').stdout.strip()
            root = repo_root(home)
            sub = '' if root.resolve() == home.resolve() else str(home.resolve().relative_to(root.resolve()))
            out[name] = {'repo': url, **({'path': sub} if sub else {})} if url else {'repo': None}
    f = STATE_ROOT / 'agents.json'
    text = json.dumps({'agents': out}, indent=2) + '\n'
    if read(f) + '\n' != text:
        f.write_text(text)


def cmd_install_saved():
    f = STATE_ROOT / 'agents.json'
    saved = json.loads(f.read_text()).get('agents', {}) if f.is_file() else {}
    have = installed()
    for name, src in saved.items():
        if name in have:
            continue
        if not src.get('repo'):
            print(f'{name}: never backed up, so it stays on the Mac it was made on (kith backup there brings it)', file=sys.stderr)
            continue
        repo = src['repo'] if os.path.isdir(src['repo']) else src['repo'].removesuffix('.git')   # a local repo stays a path
        link = repo + (f'/tree/HEAD/{src["path"]}' if src.get('path') else '')
        try:
            cmd_install(link, name)
        except SystemExit:
            print(f'{name}: install failed; retry with kith install {link} --as {name}', file=sys.stderr)


TOPIC = 'kith-agent'
OLD_TOPIC = 'hq-agent'   # agents shared before the rename: still found and installed


def cmd_search(words, mine):
    """Repos tagged kith-agent (or the older hq-agent): the agent catalogue. GitHub search includes the private repos you can see."""
    found, seen = [], set()
    for topic in (TOPIC, OLD_TOPIC):
        args = ['gh', 'search', 'repos', *words, '--topic', topic, '--limit', '100', '--sort', 'updated',
                '--json', 'fullName,description,visibility,updatedAt']
        if mine:
            me = subprocess.run(['gh', 'api', 'user', '-q', '.login'], capture_output=True, text=True).stdout.strip()
            args += ['--owner', me]
        r = subprocess.run(args, capture_output=True, text=True)
        if r.returncode:
            die(f'gh search failed: {r.stderr.strip() or "is gh logged in? (gh auth login)"}')
        for x in json.loads(r.stdout):
            if x['fullName'].lower() not in seen:
                seen.add(x['fullName'].lower())
                found.append(x)
    have = {}
    for name, home in installed().items():
        url = git(home, 'remote', 'get-url', 'origin').stdout.strip() if owned(home) else ''
        m = re.search(r'github\.com[/:]([\w.-]+/[\w.-]+?)(?:\.git)?$', url)
        if m:
            have[m.group(1).lower()] = name
    if not found:
        print(f'no repos tagged {TOPIC}' + (f' matching {" ".join(words)}' if words else ''))
    for x in found:
        mark = f'installed as {have[x["fullName"].lower()]}' if x['fullName'].lower() in have else 'kith install ' + x['fullName']
        vis = '' if x['visibility'] == 'public' else f' ({x["visibility"]})'
        print(f'{x["fullName"]}{vis}  {mark}\n    {(x["description"] or "").strip()[:110]}')


def cmd_market(words, new_only):
    """The public catalogue: repos tagged kith-agent (or hq-agent), read from GitHub's search without a login, to install by number."""
    import urllib.parse
    import urllib.request
    color = sys.stdout.isatty() and not os.environ.get('NO_COLOR')

    def paint(code, text):
        return f'\033[{code}m{text}\033[0m' if color else text
    found, seen = [], set()
    for topic in (TOPIC, OLD_TOPIC):
        q = urllib.parse.quote(' '.join([*words, f'topic:{topic}']))
        req = urllib.request.Request(f'https://api.github.com/search/repositories?q={q}&sort=stars&per_page=50',
                                     headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'kith'})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                items = json.load(r).get('items', [])
        except (OSError, ValueError) as e:
            die(f'GitHub is not reachable ({e}); try again later')
        for x in items:
            if x['full_name'].lower() not in seen:
                seen.add(x['full_name'].lower())
                found.append(x)
    found.sort(key=lambda x: -x.get('stargazers_count', 0))
    have = {}
    for name, home in installed().items():
        for remote in (git(home, 'remote').stdout.split() if owned(home) else []):
            m = re.search(r'github\.com[/:]([\w.-]+/[\w.-]+?)(?:\.git)?$', git(home, 'remote', 'get-url', remote).stdout)
            if m:
                have[m.group(1).lower()] = name

    def short(repo):
        return re.sub(r'^(kith|hq)-(agent-)?', '', repo.split('/')[1])
    rows = [(x['full_name'], (x.get('description') or '').split('. ')[0].rstrip('.'), x.get('stargazers_count', 0),
             have.get(x['full_name'].lower()) or (short(x['full_name']) if short(x['full_name']) in installed() else ''))
            for x in found]
    if new_only:
        rows = [r for r in rows if not r[3]]
    if not rows:
        print(('     · no new agents' if new_only else f'     · no shared agents') + (f' matching {" ".join(words)}' if words else '')
              + ' yet')
        return
    width = max(len(short(r[0])) for r in rows)
    aw = min(60, max(len(r[1]) for r in rows))
    pickable = []
    for repo, about, stars, mine in rows:
        if mine:
            print(f'     {paint("32", "✓")}  {short(repo).ljust(width)}  {about[:aw].ljust(aw)}  {paint("2", "installed")}')
            continue
        pickable.append(repo)
        n = paint('38;5;79', str(len(pickable)).rjust(2))
        print(f'    {n}  {short(repo).ljust(width)}  {about[:aw].ljust(aw)}  '
              + paint('2', repo.split('/')[0] + (f'  ★{stars}' if stars else '')))
    if not pickable or not sys.stdin.isatty():
        if pickable:
            print('  install one: kith install <owner>/<repo>')
        return
    pick = input(f'     {paint("38;5;79", "?")} Install any? {paint("2", "(numbers like 1 3, or empty to skip)")} ')
    for n in dict.fromkeys(re.findall(r'\d+', pick)):
        if 0 < int(n) <= len(pickable):
            print()
            cmd_install(pickable[int(n) - 1], ask=True)


def cmd_list(as_json):
    out = {}
    for name, home in installed().items():
        good = read(pointers(name)[0])
        o = {'dir': str(home), 'version': good}
        if owned(home):
            o['remote'] = git(home, 'remote', 'get-url', 'origin').stdout.strip()
            o['dirty'] = bool(git(home, 'status', '--porcelain', '--', '.').stdout.strip())
            ahead = git(home, 'rev-list', '--count', '@{u}..HEAD').stdout.strip()
            o['unpushed'] = int(ahead) if ahead.isdigit() else None
        else:
            o['legacy'] = True
        out[name] = o
    if as_json:
        print(json.dumps(out))
        return
    for name, o in out.items():
        where = 'in the kith repo (legacy)' if o.get('legacy') else (o['remote'].removeprefix('https://github.com/')
                                                                   .removesuffix('.git') or 'local only')
        flags = [f for f, on in (('edits', o.get('dirty')), (f'{o.get("unpushed")} unpushed', o.get('unpushed')))
                 if on]
        print(f'{name:<12} {o["version"] or "-":<11} {where}{"  (" + ", ".join(flags) + ")" if flags else ""}')


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    as_json = '--json' in rest
    rest = [a for a in rest if a != '--json']
    if cmd == 'resolve':
        names = sorted(installed()) if rest == ['--all'] else rest[:1]
        if not names:
            die('resolve <agent>|--all', 2)
        out = {}
        for name in names:
            try:
                pkg, note = resolve(name)
            except Exception as e:   # one broken agent must not block the others; run it live instead
                pkg, note = installed()[name], f'snapshot failed ({e}); running the live folder'
            out[name] = {'dir': str(pkg), 'version': pkg.name.split('@', 1)[-1], 'note': note}
            if note and not as_json:
                print(f'kith: {name}: {note}', file=sys.stderr)
        print(json.dumps(out) if as_json else '\n'.join(v['dir'] for v in out.values()))
    elif cmd == 'versions' and rest:
        cmd_versions(rest[0])
    elif cmd == 'pin' and rest:
        cmd_pin(rest[0], rest[1] if len(rest) > 1 else '')
    elif cmd == 'unpin' and rest:
        agent_home(rest[0])
        pointers(rest[0])[1].unlink(missing_ok=True)
        print(f'{rest[0]} follows the latest edits again')
    elif cmd == 'fetch' and rest:
        names = sorted(installed()) if rest[0] == '--all' else rest[:1]
        failed = False
        for name in names:
            try:
                got = fetch(agent_home(name), force='--force' in rest)
                if got:
                    print(f'{name}: fetched {", ".join(got)}')
            except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
                print(f'kith-pkg: {name}: {e}', file=sys.stderr)
                failed = True
        sys.exit(1 if failed else 0)
    elif cmd == 'deps' and rest:
        cmd_deps(sorted(installed()) if rest[0] == '--all' else rest[:1], '--install' in rest)
    elif cmd == 'promote' and len(rest) == 2:
        cmd_promote(*rest)
    elif cmd == 'check' and rest[:1] == ['--share']:
        names = rest[1:] or sorted(installed())
        found = [x for name in names for x in share_problems(agent_home(name))]
        print('\n'.join(found) or 'ok: nothing personal found')
        sys.exit(1 if found else 0)
    elif cmd == 'list':
        cmd_list(as_json)
    elif cmd == 'install' and rest == ['--saved']:
        cmd_install_saved()
    elif cmd == 'save':
        cmd_save()
    elif cmd == 'install' and rest:
        name = rest[rest.index('--as') + 1] if '--as' in rest else None
        cmd_install(rest[0], name, ask='--yes' not in rest)
    elif cmd in ('update', 'commit', 'push') and rest:
        msg = rest[rest.index('-m') + 1] if '-m' in rest else ''
        names = sorted(installed()) if rest[0] == '--all' else rest[:1]
        for name in names:
            if cmd == 'update':
                if owned(agent_home(name)) or rest[0] != '--all':
                    cmd_update(name)
            elif cmd == 'push':
                cmd_push(name)
            elif commit(agent_home(name), msg or f'{name}: edits'):
                print(f'{name}: committed')
    elif cmd == 'market':
        cmd_market([w for w in rest if w != '--new'], '--new' in rest)
    elif cmd == 'search':
        cmd_search([w for w in rest if w != '--mine'], '--mine' in rest)
    elif cmd == 'history' and rest:
        cmd_history(rest[0], int(rest[1]) if len(rest) > 1 else 20)
    elif cmd == 'restore' and len(rest) == 2:
        cmd_restore(*rest)
    elif cmd == 'share' and rest:
        if '--fresh' in rest:
            cmd_publish(rest[0], rest[rest.index('--repo') + 1] if '--repo' in rest else None)
        else:
            cmd_share(rest[0], '--public' in rest)
    elif cmd == 'check' and rest:
        bad = problems(agent_home(rest[0]))
        print('\n'.join(bad) or 'ok')
        sys.exit(1 if bad else 0)
    else:
        die(f'unknown command: {" ".join(argv)} (kith-pkg --help)', 2)


if __name__ == '__main__':
    main(sys.argv[1:])
