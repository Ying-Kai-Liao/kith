#!/usr/bin/env python3
"""kith-permit — the permission prompt tool of every `claude -p` run kith starts (claude --permission-prompt-tool).

  kith-permit                          stdio MCP server with one tool, approve(tool_name, input, tool_use_id)
  kith-permit issue AGENT SESSION PID  ask the host for an owner ask token bound to PID; prints export lines for sh
  kith-permit apply SETTINGS_FILE      a guest run's launch, after its session claim (or a --launch-json run's, whose settings
                                       go to the host): ask the host for the access this session was given (a yes on an
                                       escape card, an "always") and add it to the settings file

A second tool, request_access(path|domain, reason), is the way out of the guest sandbox (F11 step 2b): after an EPERM the run
asks for the place instead of working around it, and ends its turn. The host gets
  {"token", "method": "requestAccess", "kind": "path"|"domain", "target", "reason"}
refuses secrets and rule W, and otherwise makes a card for whoever may answer. A yes cannot widen a process that is already
running, so it is applied at the next activation of the session: `apply` above, which asks `consumeAccess` once per run.

A third tool, report_bug(title, details), files a bug as a redacted GitHub issue for a guest's agent, whose Bash has no gh
login: kith-permit (the owner's user, outside the sandbox) scrubs the report, returns the draft to the agent to show the
person, and asks the owner a card (requestPermission, tool mcp__kithpermit__report_bug, input = the exact draft). Only a
clear allow files it (kernel/lib/kith_bug.py); any other answer keeps the draft and says so.

A fourth tool, ask_helper(agent, task), is how a guest's run reaches a helper its membership grants (kith-auth member ...
helpers=): the guest's shell cannot start another run (the OS sandbox closes the network, the login and the other agents'
folders), so kith-permit, outside the sandbox, runs `kith ask AGENT` as the run's own person and agent (from its environment,
which the guest cannot change). The kernel decides as for any helper call: one granted (the row's helpers=, or a ticked
job's) runs with the caller's membership, never looser, in its own guest sandbox. One not granted is asked of the owner on
a card first (requestPermission, tool mcp__kithpermit__ask_helper, input {agent, task}), which this call waits for: the
host writes "just this once" or "always for <person>" through kith-auth (helper ...) before it answers yes, and the launch
checks that grant again with revoke and uses up a once (`kith-auth resolve --take-once`).

A fifth tool, run_door(door, path), runs a door of the run's pinned package (kernel/lib/kith_door.py: a fixed command in
a sandbox of its own, e.g. video's render) on one folder of the person's files. A door is granted only by a ticked job:
one not ticked, or ticked at another version of the door, is asked of the owner on a card (tool mcp__kithpermit__run_door,
input {door, path}) whose only yes turns the job on; the start checks the tick again under the kith-auth lock. A door not
prepared on this Mac asks the owner a second card (mcp__kithpermit__prepare_door) before it downloads anything.

When Claude Code reaches a permission prompt in a run nobody is watching (an "ask" rule, a tool the mode doesn't allow),
it calls approve instead of refusing. The tool sends the host one line over the run socket,
  {"token", "method": "requestPermission", "tool", "input"}
and takes one line back, {"ok", "behavior": "allow"|"deny", "message"}. The host turns the ask into an approval card
for whoever may answer it, waits its live window, and says no with "waiting on <approver>, end your turn" when nobody
answered (with "waiting": true), so the agent ends its turn instead of hanging; a run `kith ask` started (KITH_ASK_ID)
then marks that ask parked, and kith ask says "waiting" with its id instead of an answer. Anything that is not a clear allow is a deny: no socket, no
token, a reply that doesn't parse. On allow, updatedInput is the input exactly as asked: the grant is what the card showed.

Which token: a guest run has KITH_RUN_TOKEN and KITH_RUN_SOCKET (the host gave them); an owner run has KITH_ASK_TOKEN
and KITH_ASK_SOCKET (the host gave them, or `issue` got them for a run kith started itself). Secrets and logins are
never carded: the host denies them at once. See kernel/PROTOCOL.md.
"""
import json, os, re, socket, subprocess, sys

SERVER, TOOL = 'kithpermit', 'approve'
# The host waits its live window (default 90 s, at most 600) before it answers; a little longer than that.
WAIT_S = 660


def credentials(env=os.environ):
    """(token, socket path) of this run, the guest's pair first; (None, None) when it has none."""
    for t, s in (('KITH_RUN_TOKEN', 'KITH_RUN_SOCKET'), ('KITH_ASK_TOKEN', 'KITH_ASK_SOCKET')):
        if env.get(t) and env.get(s):
            return env[t], env[s]
    return None, None


def deny(message):
    return {'behavior': 'deny', 'message': message}


def decide(tool, tool_input, env=os.environ):
    """The permission decision for one ask: the dict Claude Code reads (behavior allow|deny)."""
    token, path = credentials(env)
    if not token:
        return deny('No approval channel for this run: the action was refused. Say so and carry on without it.')
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(WAIT_S)
            s.connect(path)
            s.sendall(json.dumps({'token': token, 'method': 'requestPermission', 'tool': tool, 'input': tool_input}).encode() + b'\n')
            buf = b''
            while not buf.endswith(b'\n'):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.decode())
    except (OSError, ValueError, UnicodeDecodeError):
        return deny('Could not reach the approval service, so the action was refused. End your turn and say what you needed.')
    if not isinstance(reply, dict):
        return deny('The approval service gave no clear answer; the action was refused.')
    message = reply.get('message')
    message = message if isinstance(message, str) and message else None
    if reply.get('waiting') is True:
        park(env)
    if reply.get('ok') is True and reply.get('behavior') == 'allow':
        return {'behavior': 'allow', 'updatedInput': tool_input}
    if reply.get('ok') is True and reply.get('behavior') == 'deny':
        return deny(message or 'Not approved.')
    err = reply.get('error')
    return deny(message or (err if isinstance(err, str) and err else 'The approval service refused the request.'))


def ask_box():
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
    from kith_paths import paths
    return paths()['KITH_MACHINE'] / 'live' / 'ask'


def asked_by(mid):
    """The agent whose kith ask mid is (its registration), '' for a terminal."""
    try:
        reg = json.loads((ask_box() / ('%s.reg' % mid)).read_text())
    except (OSError, ValueError):
        return ''
    who = reg.get('agent') if isinstance(reg, dict) else None
    return who if isinstance(who, str) and re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,63}', who) else ''


def park(env=os.environ):
    """The card outlived its live window and the run is ending its turn on it: the kith ask that started the run (KITH_ASK_ID)
    gets "waiting" and the card's later answer instead of this turn's words (kith-ask)."""
    mid = env.get('KITH_ASK_ID') or ''
    if not re.fullmatch(r'[A-Za-z0-9._-]{1,64}', mid):
        return
    try:
        box = ask_box()
        box.mkdir(parents=True, exist_ok=True)
        (box / ('%s.parked' % mid)).write_text('')
    except OSError:
        pass


def tool_def():
    return {'name': TOOL, 'description': 'Ask for approval of a tool call that needs a permission prompt.',
            'inputSchema': {'type': 'object', 'properties': {'tool_name': {'type': 'string'}, 'input': {'type': 'object'},
                                                             'tool_use_id': {'type': 'string'}},
                            'required': ['tool_name', 'input']}}


ACCESS = 'request_access'


def access_def():
    return {'name': ACCESS,
            'description': 'Ask the owner for a folder, file or website your sandbox blocks (a command failed with "Operation '
                           'not permitted", or the network was refused). Give the absolute path, or the host name, and why. '
                           'The answer comes at your next turn: after this call, end your turn and say what you are waiting for.',
            'inputSchema': {'type': 'object',
                            'properties': {'path': {'type': 'string', 'description': 'absolute path of the file or folder'},
                                           'domain': {'type': 'string', 'description': 'host name, e.g. pypi.org'},
                                           'reason': {'type': 'string'},
                                           'write': {'type': 'boolean', 'description': 'also write there (default: read only)'}},
                            'required': ['reason']}}


SECRET = 'request_secret'


def secret_def():
    return {'name': SECRET,
            'description': 'Ask the owner for a key or token of a service you need (one the service declares) and are not '
                           'allowed to use yet. The owner picks an existing account or types the key into a card; you never see '
                           'it. The answer comes at your next turn: after this call, end your turn and say what you are '
                           'waiting for.',
            'inputSchema': {'type': 'object',
                            'properties': {'service': {'type': 'string', 'description': 'service name, e.g. github'},
                                           'purpose': {'type': 'string', 'description': 'what you need it for'}},
                            'required': ['service', 'purpose']}}


BUG = 'report_bug'


def bug_def():
    return {'name': BUG,
            'description': "Report a bug in Kith itself (not in the person's own work). Give a short title and what happened. "
                           'It is scrubbed of secrets and personal details, shown to the owner on a card, and filed on GitHub only if '
                           'they say yes. Tell the person what you reported and that it waits on the owner.',
            'inputSchema': {'type': 'object',
                            'properties': {'title': {'type': 'string'},
                                           'details': {'type': 'string', 'description': 'what happened, what you expected'}},
                            'required': ['title']}}


def report_bug(a, env=os.environ):
    """The text the agent is told for one report_bug call: the redacted draft and what became of it."""
    if not isinstance(a.get('title'), str) or not a['title'].strip():
        return 'Give a title.'
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
        import kith_bug
        d = kith_bug.build_draft(a['title'], a.get('details') if isinstance(a.get('details'), str) else '', 'agent', env)
        _, text = kith_bug.file_draft(d, lambda tool, inp: decide(tool, inp, env), env)
    except Exception as e:  # noqa: BLE001 - never takes the run down
        return 'Could not prepare the bug report (%s); nothing was filed.' % type(e).__name__
    return 'Redacted draft:\n\n%s\n\n%s' % (kith_bug.draft_text(d), text)


HELPER = 'ask_helper'
HELPER_WAIT_S = 900


def helper_def():
    return {'name': HELPER,
            'description': 'Ask a helper agent your membership grants and get its answer, as `kith ask AGENT "task"` does '
                           'for an owner. A shell in this run cannot start another agent, so use this tool. Give the helper '
                           'agent and the whole task; it sees nothing of this conversation. A helper you are not granted '
                           'asks the owner first, and runs only if they say yes.',
            'inputSchema': {'type': 'object',
                            'properties': {'agent': {'type': 'string', 'description': 'the helper agent, e.g. personal'},
                                           'task': {'type': 'string', 'description': 'what to ask it, self-contained'}},
                            'required': ['agent', 'task']}}


def ask_helper(a, env=os.environ):
    """The text the agent is told for one ask_helper call: the helper's answer, or why there is none."""
    agent, task = a.get('agent'), a.get('task')
    if not (isinstance(agent, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', agent) and isinstance(task, str) and task.strip()):
        return 'Give the helper agent and the task.'
    if len(task) > 20000:
        return 'The task is too long.'
    # who is asking comes from this process's environment, which the run's shell cannot change; kith-auth checks the rest
    if not (env.get('KITH_PERSON') and env.get('KITH_AGENT')):
        return "Helpers are asked from a guest's run only."
    if agent == env['KITH_AGENT']:
        return 'You are %s; ask another agent.' % agent
    child = {k: v for k, v in env.items() if k not in ('KITH_ASK_TOKEN', 'KITH_ASK_SOCKET', 'HQ_ASK_TOKEN', 'HQ_ASK_SOCKET')}
    refused = helper_card(env['KITH_PERSON'], env['KITH_AGENT'], agent, task, child)
    if refused:
        return refused
    try:
        r = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), 'kith-ask'), agent, '--', task],
                           env=child, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=HELPER_WAIT_S)
    except subprocess.TimeoutExpired:
        return '%s did not answer in time; carry on without it.' % agent
    except OSError as e:
        return 'Could not ask %s (%s).' % (agent, e.strerror or type(e).__name__)
    if r.returncode != 0:
        return 'Could not ask %s: %s' % (agent, (r.stderr or r.stdout or 'no answer').strip()[-1500:])
    return r.stdout.strip() or '%s gave no answer.' % agent


def helper_card(person, caller, agent, task, env):
    """A helper the caller's membership doesn't grant is asked of the owner on a card while this call waits (<helper>, once,
    for <person>'s <agent> in the next 5 minutes; Always for <person>; No): the host writes the grant through kith-auth before it answers yes, and the helper's launch
    checks it again (and uses up a once) with revoke. None: go on and ask; else what the agent is told. A person who may
    not use the caller gets no card: kith ask refuses them in its own words."""
    auth = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'kith-auth')

    def may(*args):
        try:
            return subprocess.run([auth, 'may', *args], env=env, stdin=subprocess.DEVNULL, capture_output=True,
                                  timeout=30).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return True     # kith ask asks kith-auth again and says why
    if may(person, agent, '--via', caller, '--once') or not may(person, caller):
        return None
    d = decide('mcp__kithpermit__ask_helper', {'agent': agent, 'task': task[:2000]}, env)
    return None if d['behavior'] == 'allow' else d['message']


DOOR = 'run_door'


def door_def():
    return {'name': DOOR,
            'description': 'Run a door your agent declares (a fixed command, such as a video render, that your shell '
                           'cannot run) on one folder of your person\'s files, and wait for it to end. It has no internet: '
                           'download assets into the project first. A door the person\'s jobs don\'t turn on asks the '
                           'owner first.',
            'inputSchema': {'type': 'object',
                            'properties': {'door': {'type': 'string', 'description': 'the door, e.g. render'},
                                           'path': {'type': 'string', 'description': 'the project folder, absolute'}},
                            'required': ['door', 'path']}}


def run_door(a, env=os.environ):
    """The text the agent is told for one run_door call: how the door ended and its output's tail, or why it didn't run."""
    name, path = a.get('door'), a.get('path')
    if not (isinstance(name, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}', name) and isinstance(path, str)
            and path.startswith('/')):
        return 'Give the door and the absolute path of the project folder.'
    person, agent = env.get('KITH_PERSON'), env.get('KITH_AGENT')
    if not (person and agent and env.get('KITH_AGENT_DIR')):
        return "Doors are run from a guest's run only."
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
    import kith_door
    from kith_paths import guest_scrub
    # nothing of the guest's folders goes to kith-auth, npm or the door's supervisor
    env = guest_scrub(dict(env), person)
    try:
        decl = kith_door.declared(os.path.join(env['KITH_AGENT_DIR'], 'capabilities.yaml'), name)
        real = os.path.realpath(path)
        if not (kith_door.in_slice(real, agent, person) and os.path.isdir(real)):
            return "The folder must be one of %s's folders under files/people/%s." % (person, person)
        v = kith_door.check(agent, person, kith_door.piece(decl), env)
        if v.get('state') == 'held':
            return 'Access is being changed right now; try again in a minute.'
        if v.get('state') in ('not-ticked', 'widened'):
            d = decide('mcp__kithpermit__run_door', {'door': name, 'path': real}, env)
            if d['behavior'] != 'allow':
                return d['message']
        elif not v.get('ok'):
            return v.get('why') or 'This door is not on for %s.' % person
        if not kith_door.ready(agent, decl):
            d = decide('mcp__kithpermit__prepare_door', {'door': name, 'downloads': kith_door.describe(decl)}, env)
            if d['behavior'] != 'allow':
                return d['message']
            kith_door.prepare(agent, decl, env=env)
        code, tail = kith_door.run(agent, person, decl, real, env)
    except kith_door.DoorError as e:
        return 'The door did not run: %s' % e
    if code == 0:
        return '%s ended. Its output, last lines:\n%s' % (name, tail)
    return '%s %s. Its output, last lines:\n%s' % (name, 'failed (exit %s)' % code if code is not None else 'was stopped', tail)


def call_host(method, body, env=os.environ, timeout=30):
    """One request to the host over the run socket: the reply dict, or None when there is no token, no socket or no answer."""
    token, path = credentials(env)
    if not token:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(path)
            s.sendall(json.dumps(dict(body, token=token, method=method)).encode() + b'\n')
            buf = b''
            while not buf.endswith(b'\n'):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.decode())
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    return reply if isinstance(reply, dict) else None


def request_access(a, env=os.environ):
    """The text the agent is told for one request_access call."""
    path, domain = a.get('path'), a.get('domain')
    if bool(path) == bool(domain) or not all(isinstance(x, str) for x in (path or domain, a.get('reason'))):
        return 'Give either an absolute path or a domain, and a reason.'
    kind, target = ('path', path) if path else ('domain', domain)
    body = {'kind': kind, 'target': target, 'reason': a['reason'], 'write': a.get('write') is True}
    reply = call_host('requestAccess', body, env)
    if reply is None:
        return 'No approval channel for this run: access was not requested. Say what you needed and carry on without it.'
    msg = reply.get('message') or reply.get('error')
    return msg if isinstance(msg, str) and msg else 'The approval service gave no clear answer; nothing was requested.'


def request_secret(a, env=os.environ):
    """The text the agent is told for one request_secret call."""
    if not all(isinstance(a.get(k), str) and a[k].strip() for k in ('service', 'purpose')):
        return 'Give the service and what you need it for.'
    reply = call_host('requestSecret', {'service': a['service'].strip(), 'purpose': a['purpose']}, env)
    if reply is None:
        return 'No approval channel for this run: no key was requested. Say what you needed and carry on without it.'
    msg = reply.get('message') or reply.get('error')
    return msg if isinstance(msg, str) and msg else 'The approval service gave no clear answer; nothing was requested.'


def apply(settings_file, env=os.environ):
    """Adds the access this session was given to a guest run's settings file. Never fails the run: no answer is no access."""
    import tempfile
    reply = call_host('consumeAccess', {}, env, timeout=10)
    grants = reply.get('grants') if reply and reply.get('ok') is True else None
    if not isinstance(grants, dict) or not any(grants.get(k) for k in ('read', 'write', 'domains')):
        return 0
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
        import kith_guard
        from kith_paths import paths
        p = paths()
        s = json.load(open(settings_file))
        done = kith_guard.apply_grants(
            s, {k: [x for x in grants.get(k, []) if isinstance(x, str)] for k in ('read', 'write', 'domains')},
            os.path.expanduser('~'), kith_guard.whole_secret_paths([str(p['KITH_STATE']), str(p['KITH_MACHINE'])],
                                                                   str(p['KITH_SECRETS']), str(p['KITH_MACHINE'])))
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(settings_file))
        with os.fdopen(fd, 'w') as f:
            json.dump(s, f, indent=1)
        os.replace(tmp, settings_file)
        for kind, v in done:
            print('kith: access given: %s %s' % (kind, v), file=sys.stderr)
    except Exception as e:  # noqa: BLE001
        print('kith: could not add the granted access (%s); the run goes on without it' % e, file=sys.stderr)
    return 0


def handle(msg, env=os.environ):
    """One JSON-RPC message in, the reply out (None for a notification)."""
    method, mid = msg.get('method'), msg.get('id')
    if mid is None:
        return None
    if method == 'initialize':
        ver = (msg.get('params') or {}).get('protocolVersion') or '2024-11-05'
        result = {'protocolVersion': ver, 'capabilities': {'tools': {}}, 'serverInfo': {'name': SERVER, 'version': '1'}}
    elif method == 'tools/list':
        # a key card needs a host to ask, so request_secret is only offered to a run that has a token
        result = {'tools': [tool_def(), access_def(), bug_def()] + ([secret_def()] if credentials(env)[0] else [])
                           + ([helper_def(), door_def()] if env.get('KITH_PERSON') else [])}
    elif method == 'ping':
        result = {}
    elif method == 'tools/call':
        p = msg.get('params') or {}
        a = p.get('arguments') or {}
        if p.get('name') == ACCESS:
            result = {'content': [{'type': 'text', 'text': request_access(a, env)}]}
        elif p.get('name') == SECRET:
            result = {'content': [{'type': 'text', 'text': request_secret(a, env)}]}
        elif p.get('name') == HELPER:
            result = {'content': [{'type': 'text', 'text': ask_helper(a, env)}]}
        elif p.get('name') == DOOR:
            result = {'content': [{'type': 'text', 'text': run_door(a, env)}]}
        elif p.get('name') == BUG:
            result = {'content': [{'type': 'text', 'text': report_bug(a, env)}]}
        else:
            if p.get('name') != TOOL or not isinstance(a.get('tool_name'), str) or not isinstance(a.get('input'), dict):
                d = deny('Malformed permission request.')
            else:
                d = decide(a['tool_name'], a['input'], env)
            result = {'content': [{'type': 'text', 'text': json.dumps(d)}]}
    else:
        return {'jsonrpc': '2.0', 'id': mid, 'error': {'code': -32601, 'message': 'method not found'}}
    return {'jsonrpc': '2.0', 'id': mid, 'result': result}


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
            out = handle(msg) if isinstance(msg, dict) else None
        except ValueError:
            out = {'jsonrpc': '2.0', 'id': None, 'error': {'code': -32700, 'message': 'parse error'}}
        if out is not None:
            sys.stdout.write(json.dumps(out) + '\n')
            sys.stdout.flush()
    return 0


def host_call(method, body, timeout=8):
    """The host's local API over loopback with the serve token (as kith-recall does). None when it can't be reached."""
    import urllib.request
    from pathlib import Path
    try:
        data, port = os.environ.get('KITH_SERVE_DIR'), os.environ.get('KITH_SERVE_PORT')
        if not (data and port):
            d, p = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), 'kith-serve'), 'endpoint'],
                                  capture_output=True, text=True, timeout=4, check=True).stdout.split()
            data, port = data or d, port or p
        token = (Path(data) / 'token').read_text().strip()
        req = urllib.request.Request('http://127.0.0.1:%s/api/%s' % (port, method), json.dumps(body).encode(),
                                     {'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except Exception:  # noqa: BLE001
        return None


def issue(agent, session, pid):
    """export lines for sh, or exit 1 with one stderr line. Never raises: an owner run goes on without a prompt tool."""
    import shlex
    body = {'agent': agent, 'session': session, 'pid': int(pid)}
    # A run `kith ask` started: its cards remember that ask, and who asked (its registration), so a later answer goes back
    # to it (kith-ask).
    mid = os.environ.get('KITH_ASK_ID') or ''
    if re.fullmatch(r'[A-Za-z0-9._-]{1,64}', mid):
        body.update(replyTo=mid, askedBy=asked_by(mid))
    r = host_call('issueAskToken', body)
    env = r.get('env') if isinstance(r, dict) else None
    if not (isinstance(env, dict) and env.get('KITH_ASK_TOKEN') and env.get('KITH_ASK_SOCKET')):
        print('kith: no approval cards for this run (the Kith host gave no ask token); asks are refused', file=sys.stderr)
        return 1
    for k in ('KITH_ASK_TOKEN', 'KITH_ASK_SOCKET'):
        print('export %s=%s' % (k, shlex.quote(str(env[k]))))
    return 0


if __name__ == '__main__':
    if len(sys.argv) == 5 and sys.argv[1] == 'issue':
        sys.exit(issue(*sys.argv[2:]))
    if len(sys.argv) == 3 and sys.argv[1] == 'apply':
        sys.exit(apply(sys.argv[2]))
    sys.exit(serve())
