#!/usr/bin/env python3
"""kith-state — commit what kith and its agents have lived: two private repos, plus each agent's role.

  kith-state path      print the state folder (~/.kith; lib/kith_paths.py)
  kith-state dump      write every agent's data/*.db as a text dump next to it (<name>.sql), for git
  kith-state commit    dump, then commit and push (when there is a remote) the state folder (kith's knowledge: user.md,
                     projects, agents.json, rules) and the agents folder (each agent's memory and data; role/ and
                     files/ are not in it); then commit and push every agent's role repo (kith-pkg push --all)
  kith-state backup [--yes]
                     (kith backup run) everything to GitHub: a private repo for each piece that has none yet (the state,
                     the agents' memories as <you>/hq-agents, each agent of yours as <you>/hq-agent-<name>), asking
                     first unless --yes; then commit and push it all
  kith-state backup --nightly [off]
                     (kith backup run --nightly) the same every night at 03:00, or when the Mac wakes after it: the
                     LaunchAgent dev.kith.backup, log ~/.kith/logs/backup.log; off removes it
  kith-state backup --check|--json
                     one line saying what is backed up and what is not (exit 1 when something is not), or each
                     piece as JSON (kith init and kith doctor use it)

Databases are committed as dumps, not binaries: they diff, merge by hand, and restore with
`sqlite3 NEW.db < NAME.sql`. The state repo holds personal data; keep its remote private.
"""
import datetime as dt
import json
import os
import plistlib
import re
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path

KITH = Path(os.environ.get('KITH_ROOT') or os.path.dirname(os.path.dirname(
    os.path.normpath(os.path.join(os.environ.get('PWD') or os.getcwd(), sys.argv[0])))))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import kith_launchd  # noqa: E402
from kith_paths import paths, retire_old_job, launcher as kith_launcher  # noqa: E402  the one place that knows where kith's folders are
STATE, AGENTS = paths()['KITH_STATE'], paths()['KITH_AGENTS']
sys.stdout.reconfigure(line_buffering=True)   # in order with the tools it runs, also when piped
LABEL = 'dev.kith.backup'
PLIST = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')


def dump():
    n = 0
    dbs = {p.resolve(): p for p in [*AGENTS.glob('*/data/*.db'), *STATE.glob('agents/*/data/*.db')]}
    for db in sorted(dbs.values()):
        out = db.with_suffix('.sql')
        src = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
        snap = sqlite3.connect(':memory:')
        src.backup(snap)                        # a consistent copy even while a tool is writing
        src.close()
        tmp = out.with_name(f'.{out.name}.tmp')
        with open(tmp, 'w') as f:
            for line in snap.iterdump():
                f.write(line + '\n')
        snap.close()
        tmp.replace(out)
        n += 1
        print(f'dumped {db.parent.parent.name}/data/{db.name} -> {out.name}')
    return n


def git(repo, *args, check=True):
    return subprocess.run(['git', *args], cwd=repo, capture_output=True, text=True, check=check)


def commit_repo(repo, label):
    if not (repo / '.git').exists():
        print(f'kith-state: {repo} is not a git repo; skipped')
        return
    git(repo, 'add', '-A')
    if git(repo, 'diff', '--cached', '--quiet', check=False).returncode == 0:
        print(f'kith-state: {label}: nothing changed')
        push_repo(repo, label)
        return
    r = git(repo, 'commit', '-q', '-m', f'{label}: {dt.datetime.now():%Y-%m-%d %H:%M}', check=False)
    if r.returncode:
        print(f'kith-state: {label}: commit failed: {(r.stderr or r.stdout).strip().splitlines()[-1]}', file=sys.stderr)
        return
    print(f'kith-state: {label}: committed')
    push_repo(repo, label)


def push_repo(repo, label):
    """Push whatever origin lacks, also commits made by hand (folder moves, fixes), not only the ones made above."""
    if 'origin' in git(repo, 'remote', check=False).stdout.split() and unpushed(repo):
        r = git(repo, 'push', '-q', '-u', 'origin', 'HEAD', check=False)
        print(f'kith-state: {label}: pushed' if r.returncode == 0 else f'kith-state: {label}: push failed: {r.stderr.strip()}')


def commit():
    # which agents this install has, and their links, so another Mac can install them (kith-pkg install --saved)
    subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'save'], env=os.environ)
    dump()
    commit_repo(STATE, 'state')
    if AGENTS.resolve() != STATE.resolve() and (AGENTS / '.git').exists():
        commit_repo(AGENTS, 'agents')


def push_agents():
    """Each agent's role is its own repo (ignored by both): commit and push each one along with the rest."""
    subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'push', '--all'], env=os.environ)


# ---- backup: the pieces, and a GitHub copy of each -------------------------------------------------------------------

def unpushed(repo):
    n = git(repo, 'rev-list', '--count', 'HEAD', '--not', '--remotes', check=False).stdout.strip()
    return int(n) if n.isdigit() else 0


def gh_me(ask_github=False):
    """The GitHub login: gh's own record (no network), or with ask_github the live answer (is it still valid)."""
    if not shutil.which('gh'):
        return ''
    args = ['api', 'user', '-q', '.login'] if ask_github else ['config', 'get', 'user', '-h', 'github.com']
    return subprocess.run(['gh', *args], capture_output=True, text=True).stdout.strip()


def pieces():
    """What kith keeps, each with its state: ok (GitHub has it), behind (changes not pushed yet) or local (only here)."""
    me, out = gh_me(), []

    def piece(name, repo, kind):
        if not (repo / '.git').exists():
            return
        url = git(repo, 'remote', 'get-url', 'origin', check=False).stdout.strip()
        owner = re.search(r'github\.com[/:]([\w.-]+)/', url)
        theirs = kind == 'agent' and owner and me and owner.group(1).lower() != me.lower() \
            and 'upstream' not in git(repo, 'remote', check=False).stdout.split()
        changed = bool(unpushed(repo) or git(repo, 'status', '--porcelain', '--', '.', check=False).stdout.strip())
        if theirs:   # installed from someone else: their repo holds it, unless you changed it here
            state = 'local' if changed else 'ok'
        else:
            state = 'local' if not url else 'behind' if changed else 'ok'
        out.append({'name': name, 'kind': kind, 'dir': str(repo), 'remote': url, 'state': state})

    piece('state', STATE, 'state')
    if AGENTS.resolve() != STATE.resolve():
        piece('memories', AGENTS, 'memories')
    listed = subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'list', '--json'], capture_output=True, text=True).stdout
    for name, o in sorted(json.loads(listed or '{}').items()):
        if not o.get('legacy'):
            piece(name, Path(o['dir']), 'agent')
    return out


def names(ps):
    """state, memories, 3 agents: or the agents by name when there are few."""
    words = [p['name'] for p in ps if p['kind'] != 'agent']
    agents = [p['name'] for p in ps if p['kind'] == 'agent']
    words += agents if len(agents) <= 4 else [f'{len(agents)} agents']
    return ', '.join(words)


def summary(ps):
    """(mark, text): one line for kith doctor and kith backup --check."""
    local = [p for p in ps if p['state'] == 'local']
    behind = [p for p in ps if p['state'] == 'behind']
    if not ps:
        return '·', 'nothing to back up yet'
    if len(local) == len(ps):
        return '·', 'on this Mac only (Time Machine covers it); for a GitHub copy too: kith backup'
    if local:
        return '!', f'only on this Mac: {names(local)} · kith backup'
    if behind:
        return '·', f'backed up to GitHub; changes since: {names(behind)} · kith backup'
    return '✓', f'backed up to GitHub: {names(ps)}'


def ask(question):
    if not sys.stdin.isatty():
        return False
    return not input(f'{question} [Y/n] ').strip().lower().startswith('n')


def backup(yes):
    local = [p for p in pieces() if p['state'] == 'local']
    if local:
        if not shutil.which('gh'):
            sys.exit('kith backup: it needs gh, GitHub\'s command line tool: brew install gh, then kith backup run')
        me = gh_me(ask_github=True)
        if not me and sys.stdin.isatty():
            print('kith backup: log in to GitHub first (gh opens your browser)')
            subprocess.run(['gh', 'auth', 'login', '-w', '-p', 'https'])
            me = gh_me(ask_github=True)
        if not me:
            sys.exit('kith backup: gh is not logged in: gh auth login, then kith backup run')
        repo = {'state': 'hq-state', 'memories': 'hq-agents'}
        new = [f'{me}/{repo.get(p["name"]) or "hq-agent-" + p["name"]}' for p in local]
        print('New private repos on GitHub, seen only by you:\n  ' + '\n  '.join(new))
        if not yes and not ask('Make them?'):
            sys.exit('kith backup: nothing made' if sys.stdin.isatty() else 'kith backup --yes to go ahead')
        for p, name in zip(local, new):
            if p['kind'] == 'agent':
                r = subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'share', p['name']], capture_output=True, text=True)
                print(f'{p["name"]}: ' + ('backed up to ' + name if r.returncode == 0
                                          else (r.stderr or r.stdout).strip().splitlines()[-1]))
                continue
            commit_repo(Path(p['dir']), p['name'])
            r = subprocess.run(['gh', 'repo', 'create', name, '--private', '--source', p['dir'], '--remote', 'origin',
                                '--push', '--description', f'kith {p["name"]}: private'],
                               capture_output=True, text=True)
            if r.returncode == 0:
                print(f'{p["name"]}: backed up to {name}')
            elif 'already exists' in r.stderr:
                print(f'{p["name"]}: {name} already exists on GitHub, from another Mac? This one keeps its own, not '
                      f'linked. To use that one, restore it with kith init on a new Mac.', file=sys.stderr)
            else:
                print(f'{p["name"]}: gh repo create {name} failed: {r.stderr.strip()}', file=sys.stderr)
    commit()
    push_agents()
    mark, text = summary(pieces())
    print(f'{mark} {text}')
    return 0 if mark != '!' else 1


def nightly(on):
    retire_old_job('backup')
    if not on:
        kith_launchd.unload(LABEL)
        PLIST.unlink(missing_ok=True)
        print(f'removed {LABEL}: backups run only when you ask (kith backup run)')
        return
    p = paths()
    logs = p['KITH_LOGS']
    logs.mkdir(parents=True, exist_ok=True)
    me = p['KITH_HOME'] / 'kernel/bin/kith-state'   # the address, not the disk path: the kith folder can move
    launcher = kith_launcher()      # uv with Full Disk Access, for a repo on an external disk
    argv = [str(launcher), 'run', '--quiet', '--script', str(me)] if launcher.exists() else [str(me)]
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    PLIST.write_bytes(plistlib.dumps({
        'Label': LABEL, 'ProgramArguments': [*argv, 'backup', '--yes'],
        'StartCalendarInterval': {'Hour': 3, 'Minute': 0}, 'ProcessType': 'Background',
        'WorkingDirectory': str(Path.home()),
        'EnvironmentVariables': {'HOME': str(Path.home()), 'KITH_HOME': str(p['KITH_HOME']),
                                 'PATH': os.environ.get('PATH', '/usr/bin:/bin')},
        'StandardOutPath': str(logs / 'backup.log'), 'StandardErrorPath': str(logs / 'backup.log')}))
    kith_launchd.reload_or_exit(LABEL, PLIST)
    print(f'every night at 03:00 ({LABEL}); log {logs / "backup.log"}')


def main(argv):
    cmd = argv[0] if argv else '-h'
    if cmd == 'path':
        print(STATE)
    elif cmd == 'dump':
        dump()
    elif cmd == 'commit':
        commit()
        push_agents()
    elif cmd == 'backup' and '--nightly' in argv:
        nightly('off' not in argv)
    elif cmd == 'backup' and '--json' in argv:
        print(json.dumps(pieces()))
    elif cmd == 'backup' and '--check' in argv:
        mark, text = summary(pieces())
        print(f'{mark} {text}')
        return 1 if mark == '!' else 0
    elif cmd == 'backup':
        return backup('--yes' in argv or '-y' in argv)
    else:
        print(__doc__.strip())
        return 0 if cmd in ('-h', '--help') else 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
