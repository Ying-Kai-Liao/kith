#!/usr/bin/env bash
# kith-send — deliver an agent's result to the user.
#
#   kith-send "text"                         a message
#   kith-send --caption "text" FILE...       images show inline, anything else (html, pdf) as files
#   kith-send --as image "🎨 generating…"    post as another agent (helpers reporting into the owner's thread)
#   kith-send --to TARGET "text"|--caption…  ask:<id> (the caller's `kith ask --wait <id>` reads it), dm (Telegram, as below)
#   kith-send --to ask:<id> --progress "text"  a progress note for that ask: kept for its --wait, never wakes the caller
#
# Inside a Discord task (kith serve sets KITH_DISCORD_WEBHOOK_URL + KITH_DISCORD_THREAD_ID) it posts into that thread,
# named after the agent. A tool that names a Telegram chat (KITH_TELEGRAM_BOT_TOKEN + KITH_TELEGRAM_CHAT_ID in its
# environment) posts there. Inside any other chat task (Telegram, Slack, a Discord DM) it leaves the message in the
# run's outbox (KITH_BRIDGE_OUTBOX) and kith serve posts it into the thread. Otherwise it goes to Telegram:
# KITH_TELEGRAM_BOT_TOKEN / KITH_TELEGRAM_CHAT_ID from ~/.kith/secrets/env (or the file KITH_TELEGRAM_ENV_FILE names
# there). Never prints a token.
#
# A run that has an outbox of its own (KITH_RUN_OUTBOX: an app chat's run, a kith-sched run, an owner's terminal run)
# leaves the message there and stops: kith serve posts it into the person's chat with the agent, and that person is the
# one the run's origin names (a run for a guest never reaches the owner's Telegram). Telegram is for a run with no
# origin at all, or `--to dm`, which is Telegram only. Started from a Kith app chat (KITH_VIA=serve) with no outbox it still goes to Telegram
# but says so: the chat's own way to give the user a file or image is the send_file tool (mcp__kith-files__send_file).
set -euo pipefail
. "$(dirname "$0")/../lib/kith-env.sh"   # old HQ_X callers and secrets/env: KITH_X and HQ_X agree

as=${KITH_AGENT:-kith}
[[ ${1:-} == --as ]] && { as=$2; shift 2; }
to=""
[[ ${1:-} == --to ]] && { to=$2; shift 2; }
[[ ${1:-} == --as ]] && { as=$2; shift 2; }
[[ ${1:-} == --progress ]] && { progress=1; shift; } || progress=""
agent=$as
# Discord shows the agent's display_name (agent.md frontmatter) when it has one
eval "$(python3 "$(dirname "$0")/../lib/kith_paths.py" --sh)"   # KITH_AGENTS
card="$KITH_AGENTS/$as/role/agent.md"; [[ -f $card ]] || card="$KITH_AGENTS/$as/agent.md"
[[ -f $card ]] || card="$(dirname "$0")/../agents/$as/agent.md"
[[ -f $card ]] && name=$(sed -n 's/^display_name:[[:space:]]*//p' "$card" | head -1) && [[ -n $name ]] && as=$name
caption=""
[[ ${1:-} == --caption ]] && { caption=$2; shift 2; }
[[ $# -gt 0 ]] || { echo 'usage: kith-send [--as AGENT] [--to TARGET] "text" | kith-send [--as AGENT] [--to TARGET] --caption "text" FILE...' >&2; exit 2; }

# An answer to an id goes to that id's file, whatever this process's environment holds.
if [[ -n $to ]]; then
  case $to in
    ask:*)
      id=${to#ask:}
      [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || { echo "kith-send: bad target $to" >&2; exit 2; }
      [[ -f $1 ]] && kind=files || kind=text
      python3 -I - "$KITH_MACHINE/live/ask/$id.jsonl" "$agent" "$kind" "$caption" "$progress" "$@" <<'PY'
import json, os, sys, time
dest, who, kind, caption, progress, rest = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6:]
item = {'as': who, 'files': [os.path.abspath(f) for f in rest], 'caption': caption} if kind == 'files' \
    else {'as': who, 'text': ' '.join(rest)}
item['kind'] = 'progress' if progress else 'answer'   # only an answer wakes the asker (kith ask)
item['at'] = time.time()
os.makedirs(os.path.dirname(dest), exist_ok=True)
with open(dest, 'a') as f:   # kith ask --wait reads it line by line
    f.write(json.dumps(item, ensure_ascii=False) + '\n')
PY
      echo "sent to $to as $as"; exit 0 ;;
    dm) unset KITH_DISCORD_WEBHOOK_URL KITH_DISCORD_THREAD_ID KITH_BRIDGE_OUTBOX KITH_RUN_OUTBOX HQ_DISCORD_WEBHOOK_URL HQ_DISCORD_THREAD_ID HQ_BRIDGE_OUTBOX HQ_RUN_OUTBOX ;;
    *) echo "kith-send: unknown target $to (ask:<id>, dm)" >&2; exit 2 ;;
  esac
fi

if [[ -n ${KITH_DISCORD_WEBHOOK_URL:-} && -n ${KITH_DISCORD_THREAD_ID:-} ]]; then
  url="$KITH_DISCORD_WEBHOOK_URL?wait=true&thread_id=$KITH_DISCORD_THREAD_ID"
  json() { python3 -I -c 'import json,sys; print(json.dumps({"username": sys.argv[1], "content": sys.argv[2][:2000]}))' "$as" "$1"; }
  if [[ ! -f $1 ]]; then
    curl -s --fail-with-body --max-time 30 -H 'Content-Type: application/json' -d "$(json "$*")" "$url" >/dev/null
    echo "sent message to thread as $as"; exit 0
  fi
  form=(-F "payload_json=$(json "$caption")"); i=0
  for f in "$@"; do form+=(-F "files[$i]=@$f"); i=$((i + 1)); done
  curl -s --fail-with-body --max-time 120 "${form[@]}" "$url" >/dev/null
  echo "sent $i file(s) to thread as $as"; exit 0
fi

if [[ -n ${KITH_BRIDGE_OUTBOX:-} && -d $KITH_BRIDGE_OUTBOX && ! ( -n ${KITH_TELEGRAM_BOT_TOKEN:-} && -n ${KITH_TELEGRAM_CHAT_ID:-} ) ]]; then
  [[ -f $1 ]] && kind=files || kind=text
  python3 -I - "$KITH_BRIDGE_OUTBOX" "$agent" "$kind" "$caption" "$@" <<'PY'
import json, os, sys, time
box, who, kind, caption, rest = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
item = {'as': who, 'files': [os.path.abspath(f) for f in rest], 'caption': caption} if kind == 'files' \
    else {'as': who, 'text': ' '.join(rest)}
name = os.path.join(box, f'{time.time_ns()}.json')
with open(name + '.tmp', 'w') as f:
    json.dump(item, f)
os.rename(name + '.tmp', name)   # whole or not at all: the bridge reads *.json only
PY
  [[ $kind == files ]] && echo "sent $# file(s) to the thread as $as" || echo "sent message to the thread as $as"
  exit 0
fi

# The run's own outbox: the files are copied in, since the host takes only what is inside it.
if [[ -n ${KITH_RUN_OUTBOX:-} && -d $KITH_RUN_OUTBOX ]]; then
  [[ -f $1 ]] && kind=files || kind=text
  python3 -I - "$KITH_RUN_OUTBOX" "$agent" "$kind" "$caption" "$@" <<'PY'
import json, os, shutil, sys, time
box, who, kind, caption, rest = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
n = time.time_ns()
item = {'as': who, 'at': time.time()}
if kind == 'files':
    item['caption'], item['files'] = caption, []
    for i, f in enumerate(rest):
        stored = '%d-%d' % (n, i)   # the name the app shows is 'name'
        shutil.copyfile(f, os.path.join(box, stored))
        item['files'].append({'file': stored, 'name': os.path.basename(f)})
else:
    item['text'] = ' '.join(rest)
name = os.path.join(box, '%d.json' % n)
with open(name + '.tmp', 'w') as f:
    json.dump(item, f, ensure_ascii=False)
os.rename(name + '.tmp', name)   # whole or not at all: the host reads *.json only
PY
  echo "left for the Kith app as $as"
  exit 0
fi

# KITH_VIA=serve covers the whole process (routines and bot-to-bot requests started from a chat too), so this only
# hints and still goes on to Telegram as it always did.
if [[ ${KITH_VIA:-} == serve && $to != dm && -z ${KITH_TELEGRAM_CHAT_ID:-} ]]; then
  echo "kith-send: hint: in a Kith app chat, share a file or image with your send_file tool (mcp__kith-files__send_file: path, name?), not kith-send; this goes to Telegram." >&2
fi

[[ -f $KITH_SECRETS/env ]] && { set -a; . "$KITH_SECRETS/env"; set +a; kith_env_sync; }   # the file may still say HQ_TELEGRAM_*
# Or borrow a bot from another tool's env file (e.g. a Hermes profile): KITH_TELEGRAM_ENV_FILE names a file with
# TELEGRAM_BOT_TOKEN and TELEGRAM_HOME_CHANNEL.
tg_file=${KITH_TELEGRAM_ENV_FILE:-}
if [[ -z ${KITH_TELEGRAM_BOT_TOKEN:-} && -n $tg_file && -f $tg_file ]]; then
  KITH_TELEGRAM_BOT_TOKEN=$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' "$tg_file" | tr -d '"'"'"'')
  KITH_TELEGRAM_CHAT_ID=${KITH_TELEGRAM_CHAT_ID:-$(sed -n 's/^TELEGRAM_HOME_CHANNEL=//p' "$tg_file" | tr -d '"'"'"'')}
fi
if [[ -z ${KITH_TELEGRAM_BOT_TOKEN:-} || -z ${KITH_TELEGRAM_CHAT_ID:-} ]]; then
  echo "kith-send: no Telegram bot configured" >&2; exit 1
fi
api="https://api.telegram.org/bot$KITH_TELEGRAM_BOT_TOKEN"

check() { python3 -I -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("ok") else print("kith-send:", d.get("description"), file=sys.stderr) or 1)'; }

if [[ ! -f $1 ]]; then
  curl -s --max-time 30 --data-urlencode "chat_id=$KITH_TELEGRAM_CHAT_ID" --data-urlencode "text=$*" "$api/sendMessage" | check
  echo "sent message"; exit 0
fi
for f in "$@"; do
  case $(printf %s "$f" | tr "[:upper:]" "[:lower:]") in
    *.png|*.jpg|*.jpeg|*.webp) method=sendPhoto field=photo ;;
    *) method=sendDocument field=document ;;
  esac
  curl -s --max-time 120 -F "chat_id=$KITH_TELEGRAM_CHAT_ID" -F "$field=@$f" ${caption:+-F "caption=$caption"} "$api/$method" | check
  echo "sent $(basename "$f")"
  caption=""   # caption on the first item only
done
