#!/usr/bin/env bash
# kith-call — ring the person you work for: a phone call in their open Kith app.
#
#   kith-call "short reason"          rings and returns at once
#   kith-call --wait "short reason"   holds up to 50 s for the person to answer
#
# Prints one status word and exits with its code:
#   ringing 0   accepted 0 (only with --wait)   declined 3   missed 4   busy 5   rate-limited 6 (+ when to retry)
#   not-allowed 7 (this agent has no Kith chat with the person it runs for)   host unreachable 1   usage 2
# One call per agent per 10 minutes and 6 a day. There is no push: an app that isn't open misses the call, and a
# declined or missed call leaves "<agent> tried to call: <reason>" in the chat. The host puts KITH_CALL_CHAT and
# KITH_CALL_KEY in the environment of runs it starts (app chats, its routines, Telegram/Discord/Slack): the key proves
# which person the run serves, so a call reaches only them, in the agent's main app chat with that person. Runs
# without them (a terminal, a launchd schedule outside the host) get not-allowed. In a Kith app chat the same thing is
# the `call_person` tool of the kith-files server.
set -euo pipefail
. "$(dirname "$0")/../lib/kith-env.sh"   # old HQ_X callers and secrets/env: KITH_X and HQ_X agree

wait=false
[[ ${1:-} == --wait ]] && { wait=true; shift; }
[[ $# -gt 0 && -n "$*" ]] || { echo 'usage: kith-call [--wait] "short reason"' >&2; exit 2; }
[[ -n ${KITH_CALL_CHAT:-} && -n ${KITH_CALL_KEY:-} ]] || { echo "not-allowed"; echo "kith-call: only runs the Kith host started can call (no KITH_CALL_KEY here)" >&2; exit 7; }

exec python3 -I - "$(dirname "$0")" "$wait" "$*" <<'PY'
import json, os, subprocess, sys, urllib.error, urllib.request
from pathlib import Path

here, wait, reason = Path(sys.argv[1]), sys.argv[2] == 'true', sys.argv[3]
CODES = {'ringing': 0, 'accepted': 0, 'declined': 3, 'missed': 4, 'busy': 5, 'rate-limited': 6, 'not-allowed': 7}

# The host's own rule for where it lives (kith-serve endpoint); the env overrides win.
data, port = os.environ.get('KITH_SERVE_DIR'), os.environ.get('KITH_SERVE_PORT')
if not (data and port):
    try:
        d, p = subprocess.run([str(here / 'kith-serve'), 'endpoint'], capture_output=True, text=True, timeout=4,
                              check=True).stdout.split()
    except Exception:  # noqa: BLE001 — fall back to the dev defaults
        d, p = str(Path.home() / '.kith' / 'serve'), '19224'
    data, port = data or d, port or p

body = {'chat': os.environ['KITH_CALL_CHAT'], 'key': os.environ['KITH_CALL_KEY'], 'reason': reason, 'wait': wait}
try:
    token = (Path(data) / 'token').read_text().strip()
    req = urllib.request.Request(f'http://127.0.0.1:{port}/api/callPerson', json.dumps(body).encode(),
                                 {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=60 if wait else 10) as r:
        out = json.load(r)
except urllib.error.HTTPError as e:
    try:
        msg = json.load(e).get('error', '')
    except ValueError:
        msg = ''
    print(f'kith-call: the host refused: {msg or e.code}', file=sys.stderr)
    sys.exit(1)
except Exception as e:  # noqa: BLE001
    print(f'kith-call: can\'t reach the Kith host ({e})', file=sys.stderr)
    sys.exit(1)

status = out.get('status', '')
print(status + (f" (try again in {out['retryAfterSeconds']} s)" if status == 'rate-limited' and 'retryAfterSeconds' in out else ''))
sys.exit(CODES.get(status, 1))
PY
