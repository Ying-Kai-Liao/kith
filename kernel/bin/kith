#!/usr/bin/env bash
# kith — run a specialist directly, in a fresh session.
#
#   kith init [--from <github-user>]   set kith up on this Mac, or bring yours back on a new one (kith-init)
#   kith doctor                     check the install: links, repos, agents, services, plugin, background jobs
#   kith backup [--yes|--check|--nightly [off]]   everything to private GitHub repos, making the missing ones; --check says what isn't; --nightly at 03:00 (kith-state)
#   kith backup list|add|remove ...                      the backup chain kith serve moves to when the agent's own harness runs out of usage (kith-account)
#   kith account add|list|remove ...                     extra Claude / Codex logins for that chain, one folder each (kith-account)
#   kith account use <id> [--agent A] | --reset           the main account an agent's runs use; the chain sits on top of it
#   kith ls [--json]                list agents (--json: name, description, home, model, effort, harness, for programs)
#   kith who <words>                which agent owns this work: skills, tools, "Not yours" lines searched (kith-who)
#   kith <agent> [-p ID] [-m MODEL] [-e EFFORT] [-H HARNESS] [--permission-mode MODE|--bypass] [task...]  interactive without a task, one-shot with one
#   kith <agent> --resume|-r THREAD   pick up in this terminal a thread started in the app, or a Claude session id; -r alone: pick from the recent ones; -c: the latest begun here (kith-sessions)
#   kith <agent> --print [...]      show the assembled system prompt, don't run
#   kith <agent> --inspect          start one run and report what it loads (tools, MCP servers, skills, plugins)
#   kith <agent> --info-json        for a program (the bot detail page): one JSON object, the agent's role, package, skills, tools,
#                                 MCP servers, projects, schedules, cost and memory; read-only, local, each part fails soft (kith-info)
#   kith <agent> set permission MODE   this Mac's permission mode for the agent (MODE '' forgets it); its next run uses it
#   kith <agent> --launch-json [--hold PID] [...]   for a program that starts the run itself (kith serve): one JSON object on stdout
#                                 with everything the run needs (env, cwd, system_prompt, settings, MCP servers, directories,
#                                 claude_args to give claude as-is). Claude and Codex (Codex: settings and claude_args null); ignores
#                                 KITH_CLAUDE_ARGS/KITH_OUTPUT/KITH_RESUME. --backup ID launches that backup chain entry instead (exit 4 when it
#                                 can't run); "backup", "provider", "account" and "account_id" say which login the run is on.
#                                 Without --backup a run is on the agent's main account (kith account use), the default login
#                                 unless one is chosen; a session is resumed only under the account it was made under.
#   kith <agent> --backup ID [task]  a normal run (interactive or one-shot) on that backup chain entry: claude:<name> and claude-api:<profile>
#                                 on Claude Code, codex[:<name>] on Codex; exit 4 when it can't run. KITH_PROVIDER/KITH_ACCOUNT say which.
#   kith <agent> --backups-json     for a program: the agent's backup chain as one JSON object, each entry with whether it is ready
#                                 Nothing in it points at a temp file. The pinned snapshot (KITH_AGENT_DIR) is kept while --hold's
#                                 pid (default: the caller) lives; pass the long-lived process's pid. KITH_VIA=<name> tags the cost ledger.
#   kith versions|pin|unpin|rollback <agent> [VERSION]   agent package versions (kith-pkg)
#   kith new <name> "<description>"                      start a new agent (kith-new)
#   kith install <github-link> [--as NAME]               add an agent; each agent is its own git repo
#   kith update|push|commit <agent>|--all                pull from, push to or commit the agent's repo
#   kith history <agent> | kith restore <agent> <commit>   every good version is committed; restore any of them
#   kith share <agent> [--public [--fresh]]              put it on GitHub; --fresh: a public copy without its history
#   kith market [words]                                  agents people shared: pick any by number to install
#   kith search [words] [--mine]                         find agents on GitHub (repos tagged hq-agent)
#   kith deps <agent>|--all [--install]                  programs an agent runs that this Mac lacks; --install adds them
#   kith auth [ls|grant|revoke|set ...]                  which agent may use which service, as which account (kith-auth)
#   kith cost [agents|agent <name>|...]                  what the agents cost, from the usage ledger (kith-cost)
#   kith ask <agent> [-c] [--as NAME] "task"            ask an agent, get its answer back; -c continues (kith-ask)
#   kith live start|where|send <agent> ...               agents that run as one live session (session: live) (kith-live)
#   kith remote add|ls|rm ...  ·  kith ask <agent>@<machine>   agents on your other machines, over ssh (kith-remote)
#   kith memory search <words> [--agent NAME|--all]      search what the agents wrote down (kith-memory)
#   kith recall <query> [--project p] [--room r] [--thread t] [--tier 2|3|all] [--json]   search notes within what you may see (kith-recall)
#   kith summarise --thread <id>                         (owner) write a thread's summary now; kith forget --thread <id> drops its summary and recall rows (kith-recall)
#   kith memory index rebuild|update                     the local memory index behind recall (kith-recall)
#   kith memory check|log|diff|undo|forget|tidy ...           the write checks and versions of memory files (kith-memory)
#   kith project [ls [--json]|open ID|root|add ID [dir] [--in P] [--home [DIR]]]  projects: what each holds, its folder, its memory
#   kith schedule [ls|add|rm|run|log|--install ...]      run agent tasks on a cron schedule (kith-sched)
#   kith acp <agent> [--keep team,…]                     the agent as an ACP agent, one session per chat (kith-acp)
#   kith bug "<title>" [--details TEXT|-]|list|show ID|send ID|publish ID   report a bug: the owner's stays on this Mac with the transcript; anyone else's is a redacted GitHub issue after a yes (kith-bug)
#   kith migrate [--dry-run|--undo|--force]            move this Mac from ~/.hq and the dev.hq.* jobs to ~/.kith and dev.kith.*, reversibly (kith-migrate)
#   kith serve start|stop|restart|status|relay [URL]     Kith's host on this Mac (launchd dev.kith.serve, port 19224); `kith` is the same command (kith-serve)
#
# Every run is pinned to a snapshot of the agent's package (bin/kith-pkg): edits, by anyone, become the next run's
# version once they pass checks; running sessions keep theirs. Shared services and their secrets come from
# bin/kith-auth: only the ones the agent needs and is granted, secrets injected into the server process only.
#
# Same prompt the Claude Code plugin gives kith:<agent>: agent.md + PROTOCOL.md, plus the
# agent's MEMORY.md and the project:
# -p ID, else the project whose remote/path matches the current directory, else none.
# agents/<name>/settings.json is merged over your global Claude Code settings.
# Model and effort: `model:` and `effort:` in agent.md's frontmatter (the same fields the kith:<name> subagent uses),
# overridden by -m/-e or KITH_MODEL/KITH_EFFORT; unset means your global setting. Every session is tagged in the cost
# ledger (kith-cost tag) with the agent, version, model and effort.
# Harness: `harness:` in agent.md (claude, codex, pi, agy, hermes, qwen, dsh, opencode), overridden by -H or KITH_HARNESS;
# unset means claude. Every harness gets the same prompt, directories, granted MCP servers, model and effort
# (adapters/harness.py turns them into its flags). Callers ask for JSON output, a session to resume and a permission
# mode with KITH_OUTPUT=json, KITH_RESUME and KITH_PERMISSION_MODE, the same for every harness.
# Permission mode: --permission-mode MODE or --bypass (bypassPermissions), else KITH_PERMISSION_MODE (entry points set it
# from their own KITH_BRIDGE_/KITH_SCHED_/KITH_ASK_PERMISSION_MODE), else this Mac's choice for the agent (~/.kith/settings.json
# agents), else the agent's settings.json defaultMode (its author's suggestion), else kith's default (lib/kith_settings.py:
# auto, or ~/.kith/settings.json).
set -euo pipefail

# Follow the script's own symlinks but keep the repo's logical path (it may be a symlink to a path with spaces).
src=$0; while [ -L "$src" ]; do t=$(readlink "$src"); case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac; done
KITH="$(cd "$(dirname "$src")/.." && pwd)"

[[ $# -eq 0 || $1 == -h || $1 == --help ]] && { sed -n '4,47p' "$0" | sed 's/^#   //'; exit 0; }
# migrate runs before the paths below are exported: it moves what they point at, and its children must see the new ones
[[ $1 == migrate ]] && exec "$KITH/bin/kith-migrate" "${@:2}"
. "$KITH/lib/kith-env.sh"   # KITH_X and the old HQ_X agree (role repos read HQ_X)
export KITH_ROOT=$KITH
# Where things are, from the one place that knows (lib/kith_paths.py): KITH_HOME (~/kith) holding kernel/ and agents/ (each
# agent: role/ its repo, memory/ data/ files/ its life), and ~/.kith (user.md, projects, this Mac's things). Exported
# for agents' tools.
eval "$(python3 "$KITH/lib/kith_paths.py" --sh)"

case $1 in
  versions|pin|unpin|install|update|push|commit|history|restore|share|search|market|deps) exec "$KITH/bin/kith-pkg" "$@" ;;
  rollback)           shift; exec "$KITH/bin/kith-pkg" pin "$@" ;;
  auth)               shift; exec "$KITH/bin/kith-auth" "${@:-ls}" ;;
  cost)               shift; exec "$KITH/bin/kith-cost" "${@:-agents}" ;;
  ask)                shift; exec "$KITH/bin/kith-ask" "${@:---help}" ;;
  live)               shift; exec "$KITH/bin/kith-live" "${@:---help}" ;;
  init)               shift; exec "$KITH/bin/kith-init" "$@" ;;
  doctor)             shift; exec "$KITH/bin/kith-doctor" "$@" ;;
  backup)             case ${2:-} in list|add|remove) shift; exec "$KITH/bin/kith-account" backup "$@" ;; esac
                      shift; exec "$KITH/bin/hq-state" backup "$@" ;;
  account)            shift; exec "$KITH/bin/kith-account" "${@:---help}" ;;
  new)                shift; exec "$KITH/bin/kith-new" "$@" ;;
  remote)             shift; exec "$KITH/bin/kith-remote" "${@:---help}" ;;
  recall)             shift; exec "$KITH/bin/kith-recall" "${@:---help}" ;;
  summarise|forget)   exec "$KITH/bin/kith-recall" "$@" ;;
  memory)             shift; exec "$KITH/bin/kith-memory" "${@:---help}" ;;
  who)                shift; exec "$KITH/bin/kith-who" "${@:---help}" ;;
  bug)                shift; exec "$KITH/bin/kith-bug" "${@:---help}" ;;
  project)            shift; exec "$KITH/bin/kith-project" "$@" ;;
  schedule)           shift; exec "$KITH/bin/kith-sched" "${@:-ls}" ;;
  acp)                shift; exec "$KITH/bin/kith-acp" "$@" ;;
  serve)              shift; exec "$KITH/bin/kith-serve" "${@:-help}" ;;
esac

# An agent is a folder in the agents folder: its role (role/, its own repo: agent.md, skills, tools) next to its life
# (memory/, data/, files/). Older layouts: the role is the folder itself and the life is <state>/agents/<name>.
agent_dir() { for d in "$KITH_AGENTS/$1/role" "$KITH_AGENTS/$1" "$KITH/agents/$1"; do [[ -f $d/agent.md ]] && { echo "$d"; return; }; done; return 0; }   # a miss is empty output, not a failure (set -e)

# Installed agent names from all three layouts, one per line, deduped.
agent_names() {
  local d
  for d in "$KITH_AGENTS"/*/ "$KITH"/agents/*/; do
    if [[ -f ${d}role/agent.md || -f ${d}agent.md ]]; then basename "$d"; fi
  done | sort -u
}
# Names that start with, contain, or sit within edit distance 2 of the typed one, comma-separated.
agent_suggest() {
  agent_names | awk -v t="$1" '
    function lev(a, b,  i, j, la, lb, c, m, d) {
      la = length(a); lb = length(b)
      for (i = 0; i <= la; i++) d[i, 0] = i
      for (j = 0; j <= lb; j++) d[0, j] = j
      for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
        c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
        m = d[i-1, j] + 1; if (d[i, j-1] + 1 < m) m = d[i, j-1] + 1; if (d[i-1, j-1] + c < m) m = d[i-1, j-1] + c
        d[i, j] = m
      }
      return d[la, lb]
    }
    { if (index($0, t) || index(t, $0) || lev($0, t) <= 2) out = out (out ? ", " : "") $0 }
    END { print out }'
}

if [[ $1 == ls && ${2:-} == --json ]]; then
  pkgs=$("$KITH/bin/kith-pkg" list --json) && [[ -n $pkgs ]] || exit 1   # kith-pkg already printed why on stderr
  python3 -c '
import json, os, re, sys
def field(text, k):
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    f = re.search(r"^%s:[ \t]*(.*?)[ \t]*$" % k, m.group(1), re.M) if m else None
    return f.group(1) if f and f.group(1) else None
out = []
for name, o in json.load(sys.stdin).items():
    text = open(o["dir"] + "/agent.md").read()
    d = re.search(r"^description:\s*(.*)$", text, re.M)
    home = o["dir"][:-5] if o["dir"].endswith("/role") else "%s/agents/%s" % (os.environ["KITH_STATE"], name)
    h = field(text, "harness") or "claude"
    out.append({"name": name, "description": d.group(1) if d else "", "home": home, "model": field(text, "model"),
                "effort": field(text, "effort"), "harness": "claude" if h == "claude-code" else h})
print(json.dumps(out))' <<<"$pkgs"
  exit 0
fi
if [[ $1 == ls ]]; then
  "$KITH/bin/kith-pkg" list --json | python3 -c '
import json, re, sys
for name, o in json.load(sys.stdin).items():
    m = re.search(r"^description:\s*(.*)$", open(o["dir"] + "/agent.md").read(), re.M)
    print("%-10s %s" % (name, (m.group(1) if m else "")[:110]))'
  exit 0
fi

agent=$1; shift
[[ ${1:-} == --info-json ]] && exec "$KITH/bin/kith-info" "$agent"
# kith AGENT set permission MODE: this Mac's permission mode for the agent (what kith install asks, what apps change).
# MODE '' forgets it. Applies to the agent's next run from any entry point.
# kith AGENT set call-model MODEL: the model its voice-call turns run on ('default' forgets the choice, 'own' keeps the
# agent's own model).
# kith AGENT set limit N|none: the agent's monthly limit in dollars at API prices; kith AGENT set at-limit ask|tell|hold:
# what an owner's run does once the agent is at it (see kith_settings.py; kith-cost limit AGENT shows where it stands).
if [[ ${1:-} == set ]]; then
  [[ -n $(agent_dir "$agent") ]] || { echo "kith: no agent '$agent' (try: kith ls)" >&2; exit 1; }
  if [[ ${2:-} == call-model && $# -eq 3 ]]; then exec python3 "$KITH/lib/kith_settings.py" set call_model "$agent" "$3"; fi
  if [[ ${2:-} == limit && $# -eq 3 ]]; then exec python3 "$KITH/lib/kith_settings.py" set limit "$agent" "$3"; fi
  if [[ ${2:-} == at-limit && $# -eq 3 ]]; then exec python3 "$KITH/lib/kith_settings.py" set at_limit "$agent" "$3"; fi
  [[ ${2:-} == permission && $# -eq 3 ]] || { echo "usage: kith $agent set permission MODE   (MODE '' forgets this Mac's choice)
       kith $agent set call-model MODEL   (MODEL: sonnet, haiku, opus, own for the agent's own model, default to forget)
       kith $agent set limit N|none       (a monthly limit in dollars at API prices; none forgets it)
       kith $agent set at-limit MODE      (ask, tell or hold: what your own runs do at the limit; ask by default)" >&2; exit 2; }
  exec python3 "$KITH/lib/kith_settings.py" set permission_mode "$agent" "$3"
fi
src_pkg=$(agent_dir "$agent")
if [[ -z $src_pkg ]]; then
  echo "kith: no agent named \"$agent\"." >&2
  guess=$(agent_suggest "$agent")
  if [[ -n $guess ]]; then echo "Did you mean: $guess?" >&2; else echo "Run kith ls to see your agents." >&2; fi
  exit 2
fi
[[ ${1:-} == --backups-json ]] && exec python3 "$KITH/lib/kith_accounts.py" backups-json "$agent" "$src_pkg/agent.md"
if [[ $src_pkg == */role ]]; then home=${src_pkg%/role}; else home="$KITH_STATE/agents/$agent"; fi

# Who the run is for: KITH_PERSON, set by the entry point (the bridge, a schedule) and inherited by every helper, so
# access follows the person who asked however deep the calls go. Unset is the owner and changes nothing. A helper is
# checked as one (--via the agent that called it). Fails closed: no answer from kith-auth, no run.
nested=0; [[ -n ${KITH_AGENT:-} ]] && nested=1   # started by another run (KITH_AGENT is exported further down)
caller=${KITH_AGENT:-}; [[ $caller == "$agent" ]] && caller=""; p_owner=1 p_trusted=0 p_mode="" p_model="" p_deny="" p_line="" p_env_names="" p_rooms=""
if [[ -n ${KITH_PERSON:-} ]]; then
  res=$("$KITH/bin/kith-auth" resolve "$agent" ${caller:+--via "$caller"}) \
    || { echo "kith: can't check whether ${KITH_PERSON} may use $agent (kith-auth resolve failed)" >&2; exit 1; }
  eval "$(RES=$res python3 -c '
import json, os, re, shlex, sys
r = json.loads(os.environ["RES"])
q = lambda v: shlex.quote(str(v))
print("p_allowed=%d p_why=%s p_owner=%d p_id=%s" % (r["allowed"], q(r["why"]), r["owner"], q(r.get("person", ""))))
print("p_trusted=%d" % bool(r.get("trusted")))
print("p_mode=%s p_model=%s p_deny=%s" % (q(r.get("mode", "")), q(r.get("model", "")), q("\n".join(r.get("deny", [])))))
# Anyone but the owner: a name goes into the <session/> tag, so it loses what could close or forge a tag.
clean = (lambda v: re.sub("[<>\"\\x00-\\x1f\\x7f]", "", v)) if not r["owner"] else (lambda v: v.replace("\"", ""))
attrs = " ".join("%s=\"%s\"" % (k, clean(str(r[k]))) for k in ("person", "name", "lang", "tz") if r.get(k))
print("p_line=%s" % q(" " + attrs))
print("p_budget=%s p_budget_agent=%s p_was=%s" % (q(r.get("budget", "")), q(r.get("budget_agent") or ""), q(",".join(r.get("was", [])))))
print("p_rooms=%s" % q(" ".join(x for x in r.get("rooms", []) if isinstance(x, str))))
# Anyone but the owner: a membership env key must be a plain variable name that cannot change how the run starts or
# which kith it talks to; others are skipped with a warning.
env = {}
for k, v in r.get("env", {}).items():
    if not r["owner"] and (not re.fullmatch("[A-Z_][A-Z0-9_]*", k) or k in ("PATH", "HOME", "SHELL") or re.match("(DYLD_|LD_|KITH_|HQ_)", k)):
        print("kith: skipping membership env %r (not allowed)" % k, file=sys.stderr)
        continue
    env[k] = v
    print("export %s=%s" % (k, q(v)))
print("p_env_names=%s" % q(" ".join(env)))')"
  [[ $p_allowed == 1 ]] || { echo "kith: $p_why (kith-auth member $agent ${KITH_PERSON})" >&2; exit 3; }
  if [[ -n $p_budget ]]; then   # the membership's monthly cap, for the agent they reached (the caller, for a helper)
    # Fails closed for anyone but the owner: a spend that can't be read is not $0.
    if ! spent=$(KITH_PERSON_WAS=$p_was "$KITH/bin/kith-cost" spent "$KITH_PERSON" "$p_budget_agent" 2>/dev/null); then
      [[ $p_owner == 1 ]] && spent=0 || { echo "kith: can't read what ${KITH_PERSON} has spent this month (kith-cost failed); not running without the budget check" >&2; exit 3; }
    elif [[ $p_owner == 0 && ! $spent =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      echo "kith: can't read what ${KITH_PERSON} has spent this month (kith-cost gave '$spent'); not running without the budget check" >&2; exit 3
    fi
    if python3 -c 'import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)' "$spent" "$p_budget"; then
      printf 'kith: %s has used $%.2f of their $%s this month on %s; the owner can raise it (kith auth member %s %s budget=..)\n' \
        "$KITH_PERSON" "$spent" "$p_budget" "$p_budget_agent" "$p_budget_agent" "$KITH_PERSON" >&2
      # The owner's own run is never refused at a limit (it says so and goes on); anyone else's stops here.
      [[ $p_owner == 1 ]] || exit 3
    fi
  fi
  export KITH_PERSON
fi
mkdir -p "$home/memory/projects" "$home/memory/sessions" "$home/memory/shared"
# Whose memory this run uses. The owner's is the agent's memory/ itself; anyone else's is memory/people/<id>/, with
# their outputs in files/people/<id>/ and who they are in <state>/people/<id>.md (the owner's: user.md). memory/shared/
# is for every member: the craft, never a person.
mem=$home/memory files=$home/files person_file=$KITH_STATE/user.md
if [[ $p_owner == 0 ]]; then
  [[ $p_id =~ ^[a-z][a-z0-9-]*$ ]] || { echo "kith: bad person id '$p_id' from kith-auth" >&2; exit 3; }
  mem=$home/memory/people/$p_id files=$home/files/people/$p_id person_file=$KITH_STATE/people/$p_id.md
  mkdir -p "$mem/projects" "$mem/sessions" "$files" "$KITH_STATE/people"
  # Their own uv cache: the shared one is the owner's too, and a package planted in it would run in the owner's next `uv run`.
  export UV_CACHE_DIR=$files/.uv-cache; mkdir -p "$UV_CACHE_DIR"
fi
shared=$home/memory/shared

# The pinned package (prompt.md = agent.md body + PROTOCOL.md). If versioning itself breaks, run the live folder
# rather than not at all.
pkg=$("$KITH/bin/kith-pkg" resolve "$agent") && [[ -f $pkg/prompt.md ]] \
  || { echo "kith: $agent: package snapshot failed; running the live folder" >&2; pkg=$src_pkg; }
export KITH_AGENT=$agent KITH_AGENT_DIR=$pkg KITH_AGENT_HOME=$home KITH_AGENT_VERSION=${pkg##*@}
[[ $pkg == "$src_pkg" ]] && KITH_AGENT_VERSION=live

# Placeholders are filled here, at run time, so a snapshot doesn't depend on the path it was made through.
# {{HOME_REAL}}: the same folder with symlinks resolved. Permission rules match the resolved path, so a memory
# Edit rule needs it when the repo sits behind a symlink (~/Workspace/kith -> the external SSD).
home_real=$(cd "$home" && pwd -P)
real() { printf '%s' "${1/#"$home"/$home_real}"; }   # a path in the agent's folder, symlinks resolved
fill() { sed "s|{{MEMORY_DIR}}|$mem|g; s|{{SHARED_MEMORY}}|$shared|g; s|{{FILES_DIR}}|$files|g; s|{{PERSON_FILE}}|$person_file|g; s|{{AGENT_DIR}}|$pkg|g; s|{{HOME_DIR}}|$home|g; s|{{HOME_REAL}}|$home_real|g; s|{{STATE}}|$KITH_STATE|g; s|{{MACHINE}}|$KITH_MACHINE|g; s|{{AGENTS}}|$KITH_AGENTS|g; s|{{PACKAGE}}|$src_pkg|g; s|{{USER_HOME}}|$HOME|g; s|{{KITH}}|$KITH|g; s|{{HQ}}|$KITH|g; s|{{AGENT}}|$agent|g"; }
template() {
  if [[ -f $pkg/prompt.md ]]; then cat "$pkg/prompt.md"
  else awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} !fm' "$src_pkg/agent.md"; echo; cat "$KITH/PROTOCOL.md"; fi
}

[[ ${1:-} == --render ]] && { template | fill; exit 0; }
if [[ ${1:-} == --inspect ]]; then
  KITH_CLAUDE_ARGS="--output-format stream-json --verbose --max-turns 1 --permission-mode bypassPermissions" \
    "$0" "$agent" "Reply: ok" 2>/dev/null | python3 -c '
import collections, json, sys
for line in sys.stdin:
    try: d = json.loads(line)
    except ValueError: continue
    if d.get("type") == "system" and d.get("subtype") == "init": break
else: sys.exit("kith: no init event (did the run start?)")
t = d.get("tools", [])
groups = collections.Counter(x.split("__")[1] if x.startswith("mcp__") else "built-in" for x in t)
name = lambda x: x if isinstance(x, str) else x.get("name")
servers = ["%s (%s)" % (x["name"], x["status"]) for x in d.get("mcp_servers", [])]
print("tools    %d  %s" % (len(t), ", ".join("%s %d" % gn for gn in groups.most_common())))
print("mcp      " + (", ".join(servers) or "none"))
print("skills   %d" % len(d.get("skills") or []))
print("plugins  " + ", ".join(name(p) for p in d.get("plugins") or []))
bad = [x["name"] for x in d.get("mcp_servers", []) if x["status"] != "connected"]
sys.exit("kith: MCP servers not connected: %s" % bad if bad else 0)'
  exit $?
fi

print=0 project="" launch=0 hold="" resume_thread="" resume_pick="" backup="" acct="" backup_cfg_var="" backup_cfg_dir="" backup_api_helper=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --print)      print=1; shift ;;
    --launch-json) launch=1; shift ;;
    --hold)       hold=$2; shift 2 ;;
    --resume)     resume_thread=${2:?kith: --resume needs a thread id or a Claude session id}; shift 2 ;;
    -r)           if [[ -n ${2:-} && $2 != -* ]]; then resume_thread=$2; shift 2; else resume_pick=pick; shift; fi ;;
    -c|--continue) resume_pick=latest; shift ;;
    --backup)     backup=${2:?kith: --backup needs a chain entry id}; shift 2 ;;
    -p|--project) project=$2; shift 2 ;;
    -m|--model)   KITH_MODEL=$2; shift 2 ;;
    -e|--effort)  KITH_EFFORT=$2; shift 2 ;;
    -H|--harness) KITH_HARNESS=$2; shift 2 ;;
    --permission-mode) KITH_PERMISSION_MODE=$2; shift 2 ;;
    --bypass)     KITH_PERMISSION_MODE=bypassPermissions; shift ;;
    --)           shift; break ;;
    -*[[:space:]]*) break ;;   # a task that starts with a dash ("- one thing ...")
    -*)           echo "kith: unknown flag '$1' (kith --help lists them)" >&2; exit 1 ;;
    *)            break ;;
  esac
done
# --resume THREAD: pick up in this terminal a session started in the app (or another terminal); the host names it
# (bin/kith-sessions), and the run starts in the folder it ran in. Only the owner's own claude sessions are listed.
# resolve takes the session's writer claim for this shell ($$): it execs into `kith-sessions run` below, so the pid is the
# same until claude has exited, and run gives the claim back.
# -r alone picks the session from the agent's recent ones, -c takes the latest begun in this folder; then the same.
r_sid="" r_cwd="" r_from=""
if [[ -n $resume_thread || -n $resume_pick ]]; then
  [[ $launch -eq 0 && $print -eq 0 ]] || { echo "kith: --resume is for a run in this terminal, not --launch-json or --print" >&2; exit 1; }
  [[ $p_owner == 1 ]] || { echo "kith: --resume is for the owner's own sessions" >&2; exit 1; }
  if [[ -z $resume_thread && $resume_pick == pick ]]; then resume_thread=$(python3 "$KITH/bin/kith-sessions" pick "$agent") || exit 1
  elif [[ -z $resume_thread ]]; then resume_thread=$(python3 "$KITH/bin/kith-sessions" latest "$agent" "$PWD") || exit 1; fi
  [[ -n $resume_thread ]] || exit 1   # a pick that named nothing must not fall through to a fresh claude
  # Whatever named the session (--resume, -r ID, the picker, -c), it is claimed and checked here and nowhere else.
  # Not `eval "$(…)" || exit 1`: a refusal prints nothing, eval of nothing succeeds, and claude would start anyway.
  # A one-shot (a task is given) waits a few seconds for a held session; a terminal run refuses at once.
  resolved=$(python3 "$KITH/bin/kith-sessions" resolve "$agent" "$resume_thread" "$$" ${1:+oneshot}) || exit 1
  eval "$resolved"
  [[ -z $r_cwd ]] || cd "$r_cwd" || exit 1
fi
# A program reads stdout as the JSON alone: whatever a helper prints on the way goes to stderr; fd 3 is the real stdout.
[[ $print -eq 1 ]] && launch=0
[[ $launch -eq 1 ]] && exec 3>&1 1>&2
# The agent's monthly limit (kith AGENT set limit N, at API prices): an owner's run is never refused at it. At the limit
# it asks (a terminal run asks here; a one-shot or the host's launch says so and goes on: the host asks before the
# turn with a card), tells and goes on, or holds only when this Mac chose hold (kith AGENT set at-limit hold). A spend
# that can't be read is no reason to stop the owner. Anyone else's runs keep their membership budget above.
if [[ $p_owner == 1 ]] && lim=$("$KITH/bin/kith-cost" limit "$agent" --sh 2>/dev/null) && [[ -n $lim ]]; then
  l_over=0 l_at=ask l_text=""
  eval "$lim"
  if [[ $l_over == 1 ]]; then
    case $l_at in
      hold)
        echo "kith: $l_text. Its runs are held until you raise the limit (kith $agent set limit N) or the month turns; kith $agent set at-limit ask lets them ask instead." >&2
        exit 3 ;;
      ask)
        if [[ $launch -eq 0 && $print -eq 0 && $# -eq 0 && -t 0 && -t 2 ]]; then
          printf 'kith: %s. Run anyway? [Y/n] ' "$l_text" >&2
          read -r l_yes || l_yes=y
          [[ $l_yes =~ ^[Nn] ]] && { echo "kith: not run. Raise it with kith $agent set limit N." >&2; exit 0; }
        else
          echo "kith: $l_text; running anyway (your runs never stop at a limit; kith $agent set limit N raises it)." >&2
        fi ;;
      *) echo "kith: $l_text; running anyway." >&2 ;;
    esac
  fi
fi
# Launch-time lookups are the kernel's own, whoever the run is for: a guest token in the environment would narrow them.
if [[ -n $project ]]; then
  env -u KITH_RUN_TOKEN "$KITH/bin/project-id" --list | cut -f1 | cut -d' ' -f1 | grep -qx -- "$project" \
    || { echo "kith: unknown project '$project'. Known: $(env -u KITH_RUN_TOKEN "$KITH/bin/project-id" --list | cut -f1 | cut -d' ' -f1 | tr '\n' ' ')" >&2
         echo "    register one with: $KITH/bin/project-id --register $project [dir]" >&2; exit 1; }
else
  project=$(env -u KITH_RUN_TOKEN "$KITH/bin/project-id" || true)
fi

# The project's parents (closest first) and the home folders along the chain (bin/project-id --info).
info=$([[ -n $project ]] && env -u KITH_RUN_TOKEN "$KITH/bin/project-id" --info "$project" || true)
parents=$(printf '%s\n' "$info" | tail -n +2 | cut -f1 | paste -sd' ' -)
held=$([[ -n $project ]] && env -u KITH_RUN_TOKEN "$KITH/bin/project-id" --children "$project" --all || true)

# Body without frontmatter, then long-term memory: the load filter of docs/memory-context.md (lib/kith_facets.py, the
# same one the host's runs get through KITH_ROOM). The owner's run: about them, the agent's memory, then the shared part
# when there is one. Anyone else's: about them, the shared part and their own. In a group room only what everyone there
# may see; a bot guest (bot-<hex>) is shared craft and its own room's notes.
load_kind=person; [[ $p_owner == 1 ]] && load_kind=owner; [[ ${p_id:-} == bot-* ]] && load_kind=guest
load_out=$(python3 "$KITH/lib/kith_facets.py" load --agent "$agent" --home "$home" --person-file "$person_file" \
  --kind "$load_kind" --person "${p_id:-}" --rooms "$p_rooms" --room "${KITH_ROOM:-}" --project "$project" \
  --agent-md "$src_pkg/agent.md") || { echo "kith: couldn't load memory" >&2; exit 1; }
eval "$load_out"
prompt="$(template | fill)
$mems
<session project=\"${project:-none}\"$load_attrs${parents:+ parents=\"$parents\"}${held:+ holds=\"$(printf '%s\n' "$held" | cut -f1 | paste -sd' ' -)\"} cwd=\"$PWD\" date=\"$(date +%F)\"$p_line/>"

if [[ $print -eq 1 ]]; then printf '%s\n' "$prompt"; [[ $# -gt 0 ]] && printf '\n[task] %s\n' "$*"; exit 0; fi

# Run files: in the snapshot (so cleanup sees the run), or a temp dir when running the live folder.
# A launch-json run has no process of ours to wait for, so nothing it depends on lives here: the files below are read
# back into the JSON and removed, and the snapshot is held by --hold's pid (a marker named for that pid, one per pid).
if [[ $launch -eq 1 ]]; then
  runs=$(mktemp -d); trap 'rm -rf "$runs"' EXIT
  if [[ $pkg != "$src_pkg" ]]; then
    [[ ${hold:=$PPID} =~ ^[0-9]+$ ]] || { echo "kith: --hold needs a process id" >&2; exit 1; }
    mkdir -p "$pkg/.runs"; : > "$pkg/.runs/$hold.launch"
  fi
elif [[ $pkg == "$src_pkg" ]]; then runs=$(mktemp -d); else runs=$pkg/.runs; mkdir -p "$runs"; : > "$runs/$$"; fi
# Model and effort from the pinned agent.md unless the caller chose (-m/-e, KITH_MODEL/KITH_EFFORT).
field() { awk -v k="$1" 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {exit} fm && $1 == k":" {sub(/^[^:]*:[ \t]*/, ""); print; exit}' "$pkg/agent.md" 2>/dev/null || true; }
own=$(field harness); own=${own:-claude}; [[ $own == claude-code ]] && own=claude
harness=${KITH_HARNESS:-$own}; [[ $harness == claude-code ]] && harness=claude
# Which login answers: a backup chain entry (--backup ID, with --launch-json or for a normal run) replaces the harness
# and login; else the agent's main account (kith account use; lib/kith_accounts.py) on its own harness, the default
# login when none is chosen. Both go through the same launch-env. The config dir a run of kith's set (KITH_ACCOUNT_VAR)
# is not inherited: a helper agent runs on its own main account.
case ${KITH_ACCOUNT_VAR:-} in CLAUDE_CONFIG_DIR|CODEX_HOME) unset "$KITH_ACCOUNT_VAR" ;; esac
unset KITH_ACCOUNT_VAR HQ_ACCOUNT_VAR
account_id=$harness
use_account() {   # use_account ID: the entry's env, or exit 4 with one line
  local be
  be=$(python3 "$KITH/lib/kith_accounts.py" launch-env "$agent" "$1") || exit 4
  eval "$be"
  harness=$backup_harness acct=$backup_account account_id=$1
}
if [[ -n $backup ]]; then
  use_account "$backup"
elif [[ $harness == "$own" ]]; then
  be=$(python3 "$KITH/lib/kith_accounts.py" main-env "$agent" "$pkg/agent.md") || exit 4
  eval "$be"
  acct=$backup_account account_id=$main_id
fi
# A session is resumed only under the account it was made under (the cost ledger's account_id; one it doesn't know is
# taken as it is). --resume runs under that account; a session handed on (KITH_RESUME: a channel, kith ask -c) starts anew.
if [[ -n ${r_sid:-} || -n ${KITH_RESUME:-} ]]; then
  r_check=${r_sid:-$KITH_RESUME}
  made=$(python3 "$KITH/lib/kith_accounts.py" session-account "$r_check" 2>/dev/null || true)
  if [[ -n $made && $made != "$account_id" ]]; then
    if [[ -n ${r_sid:-} && -z $backup ]]; then
      echo "kith: that session was made under $made, so it runs under $made (main account for $agent: $account_id)" >&2
      use_account "$made"   # not runnable: exit 4 with what makes it ready
    elif [[ -n ${r_sid:-} ]]; then
      echo "kith: that session was made under $made, not $backup: kith $agent --resume $resume_thread --backup $made" >&2; exit 4
    else
      echo "kith: session $KITH_RESUME was made under $made, not $account_id; starting a new one" >&2
      unset KITH_RESUME HQ_RESUME
    fi
  fi
fi
[[ -n $backup && $harness != "$own" ]] && KITH_MODEL=""   # agent.md's model names a model of its own harness
if [[ -n $backup_cfg_var ]]; then export "$backup_cfg_var=$backup_cfg_dir" KITH_ACCOUNT_VAR=$backup_cfg_var; fi
# Which harness and login answer this run, for the cost ledger (kith-cost reads them from the hook and from `record`)
export KITH_PROVIDER=$harness KITH_ACCOUNT=$acct KITH_ACCOUNT_ID=$account_id
# agent.md's model names a model of its own harness: on another one (-H), that harness's default unless -m says.
[[ $harness == "$own" ]] && KITH_MODEL=${KITH_MODEL:-$(field model)}
[[ -n $p_model ]] && KITH_MODEL=$p_model   # the person's membership picks the model over the agent's and the caller's
export KITH_MODEL=${KITH_MODEL:-} KITH_EFFORT=${KITH_EFFORT:-$(field effort)} KITH_PROJECT=$project
# For this run only, like KITH_CLAUDE_ARGS below: a helper this agent starts runs on its own harness, in its own session.
out_format=${KITH_OUTPUT:-} resume=${KITH_RESUME:-} perm_mode=${KITH_PERMISSION_MODE:-}
unset KITH_HARNESS KITH_OUTPUT KITH_RESUME KITH_PERMISSION_MODE HQ_HARNESS HQ_OUTPUT HQ_RESUME HQ_PERMISSION_MODE
# --resume THREAD wins over a caller's KITH_RESUME, and only claude sessions can be taken up.
if [[ -n $r_sid ]]; then
  [[ $harness == claude ]] || { echo "kith: --resume continues Claude sessions; $agent runs on $harness" >&2; exit 1; }
  resume=$r_sid
fi
# Anyone but the owner continues only a session the cost ledger has as theirs (this person or their old ids, this agent):
# a session id is not a secret, and another person's conversation holds their memory.
if [[ $p_owner == 0 && -n $resume && $resume != *:* ]]; then
  PERSONS="$p_id,$p_was" SID=$resume AGENT=$agent DB="$KITH_MACHINE/cost.db" python3 -c '
import os, sqlite3, sys
try:
    c = sqlite3.connect(os.environ["DB"]) if os.path.exists(os.environ["DB"]) else None   # not creating the ledger here
    ids = [x for x in os.environ["PERSONS"].split(",") if x]
    ok = c.execute("select 1 from runs where session = ? and agent = ? and person in (%s)" % ",".join("?" * len(ids)),
                   [os.environ["SID"], os.environ["AGENT"], *ids]).fetchone()
except Exception:
    ok = None
sys.exit(0 if ok else 1)' || { echo "kith: session $resume is not one of ${KITH_PERSON}'s with $agent; starting a new one" >&2; resume=""; }
fi
# These two belong to one run (listing a terminal session, and where it was resumed from): a helper this agent starts must not inherit them.
unset KITH_TERMINAL_SESSION KITH_RESUMED_FROM
# What kind of one-shot this is, for the apps' rooms (bin/kith-sessions record lists it): kith-ask and kith-sched pass
# KITH_LAUNCH_KIND to the run they start; a run another run of the owner's started (from a terminal, an ask or a job) is
# a helper. The host's own runs (KITH_VIA=serve, channels) are not listed here. Neither name is inherited further.
run_kind=${KITH_LAUNCH_KIND:-} run_label=${KITH_LAUNCH_LABEL:-}
unset KITH_LAUNCH_KIND KITH_LAUNCH_LABEL KITH_RUN_KIND KITH_RUN_LABEL HQ_LAUNCH_KIND HQ_LAUNCH_LABEL HQ_RUN_KIND HQ_RUN_LABEL   # (HQ_ twins: kith_env_sync fills the KITH_ names back from them)
if [[ -z $run_kind && $nested -eq 1 ]]; then
  case ${KITH_VIA:-terminal} in terminal|ask|schedule) run_kind=helper run_label=$caller ;; esac
fi
if [[ $p_owner == 1 && -z ${KITH_PERSON:-} && -n $run_kind ]]; then
  export KITH_RUN_KIND=$run_kind KITH_RUN_LABEL=$run_label
  # `kith ask -c` continues a session: the card joins the thread of the one it resumes (the registry's resumedFrom).
  [[ -n $resume && $resume != *:* && -z $r_sid ]] && export KITH_RESUMED_FROM=$resume
fi
# An ask token (the owner's approval cards, KITH_ASK_*) belongs to one run: a helper this run starts, or any run for a person
# who isn't the owner, never inherits it. A helper of the owner's asks the host for its own below.
[[ $nested -eq 1 || $p_owner == 0 ]] && unset KITH_ASK_TOKEN KITH_ASK_SOCKET HQ_ASK_TOKEN HQ_ASK_SOCKET   # (kith_env_sync would fill the KITH_ names back from the HQ_ ones)
if [[ $launch -eq 1 ]]; then
  case $harness in claude|codex) ;; *) echo "kith: $agent runs on $harness; --launch-json covers claude and codex only for now" >&2; exit $([[ -n $backup ]] && echo 4 || echo 1) ;; esac
  out_format="" resume=""; unset KITH_CLAUDE_ARGS HQ_CLAUDE_ARGS
  export KITH_VIA=${KITH_VIA:-terminal}
fi
# The agent's defaultMode is its author's suggestion: this Mac's choice for the agent (kith install asks; agents in
# ~/.kith/settings.json) wins over it, and the caller's over both.
[[ -z $perm_mode ]] && perm_mode=$(python3 "$KITH/lib/kith_settings.py" permission_mode "$agent")
# For anyone but the owner the membership sets the permission mode, whatever the caller asked for, and deny rules
# only Claude Code can enforce keep the run on Claude Code.
if [[ $p_owner == 0 ]]; then
  perm_mode=$p_mode
  [[ $harness == claude ]] \
    || { echo "kith: $agent for ${KITH_PERSON}: runs for anyone but the owner need Claude Code (path rules), not $harness" >&2; exit $([[ -n $backup ]] && echo 4 || echo 3); }
  # Their reads are an allowlist (permissions.blockReadsOutsideWorkingDirectories for the file tools, sandbox denyRead of
  # the home folder for Bash), which Claude Code enforces from 2.1.257: an older or unreadable version is no run at all.
  cv=$(claude --version 2>/dev/null | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1)
  [[ -n $cv && $(printf '%s\n2.1.257\n' "$cv" | sort -V | head -1) == 2.1.257 ]] \
    || { echo "kith: runs for anyone but the owner need Claude Code 2.1.257 or newer (read limits); Claude Code is ${cv:+version $cv}${cv:-missing or gives no version}" >&2; exit $([[ -n $backup ]] && echo 4 || echo 3); }
  # They see this agent's own life only: every other agent's folder and the owner's user.md are denied by path
  # (logical and resolved), on top of the narrower directories below.
  for d in "$KITH_AGENTS"/*/; do
    d=${d%/}; [[ ${d##*/} == "$agent" ]] && continue
    for p in "$d" "$(cd "$d" && pwd -P)"; do p_deny+=$'\n'"Read(/$p/**)"$'\n'"Edit(/$p/**)"; done
  done
  p_deny+=$'\n'"Read(/$KITH_STATE/user.md)"$'\n'"Read(/$KITH_STATE_REAL/user.md)"
  # Inside this agent: the owner's memory and outputs, and everyone else's, by name (deny beats allow, so the run
  # gets a list of what it may not touch rather than a broad deny with exceptions).
  hide=()
  for e in "$home/memory"/* "$home/files"/*; do
    [[ -e $e ]] || continue
    case ${e##*/} in shared) [[ $e == "$home/memory/shared" ]] && continue ;; people) continue ;; esac
    [[ -d $e ]] && hide+=("$e/**") || hide+=("$e")
  done
  for e in "$home/memory/people"/* "$home/files/people"/*; do
    [[ -d $e && ${e##*/} != "$p_id" ]] && hide+=("$e/**")
  done
  for e in "$KITH_STATE/people"/*.md; do
    [[ -f $e && $e != "$person_file" ]] && hide+=("$e")
  done
  for h in "${hide[@]}"; do
    for p in "$h" "$(real "$h")" "${h/#"$KITH_STATE"/$KITH_STATE_REAL}"; do
      p_deny+=$'\n'"Read(/$p)"$'\n'"Edit(/$p)"
    done
  done
  # Nothing an owner run executes or follows may be written from here: the kernel, this agent's package (the pinned
  # snapshot and the live role), and the people files. A folder that holds their own memory or outputs is not listed.
  for d in "$KITH" "$pkg" "$src_pkg" "$KITH_STATE/people"; do
    [[ -d $d ]] || continue
    for p in "$d" "$(cd "$d" && pwd -P)"; do
      [[ $mem/ == "$p"/* || $files/ == "$p"/* || $shared/ == "$p"/* ]] && continue
      p_deny+=$'\n'"Edit(/$p/**)"
    done
  done
fi
# A mode kith no longer offers, from whichever source, starts as the one that replaced it (kith_settings.RETIRED).
case $perm_mode in manual) perm_mode=default ;; dontAsk) perm_mode=auto ;; esac
# The agent's settings plus a SessionStart hook that tags each session (new, resumed, /clear) in the cost ledger, and
# kith's secrets kept out of its file tools (they sit inside ~/.kith, which every run can read; tools get them from kith-auth),
# and the writes PROTOCOL asks for allowed without a prompt (a one-shot run has no one to approve them): its memory,
# its learned skills and the shared project files, each under its logical and its resolved path. Every installed plugin
# but kith is off unless the agent's settings turn it on, so a plugin installed after the agent was made stays out; the
# ones this Mac lists for every agent ("plugins" in ~/.kith/settings.json) are on unless the agent's settings say no.
# Shared project files are writable for the owner; for anyone else only the current project's. A run no one chose a
# mode for (no KITH_PERMISSION_MODE, no defaultMode in the agent's settings) starts in kith's default mode.
state_projects="$KITH_STATE/projects"$'\n'"$KITH_STATE_REAL/projects"
# Anyone but the owner reads the current project's files and writes none: owner runs follow what is in them (verify.md).
[[ $p_owner == 0 ]] && state_projects=""
learned="$src_pkg/skills/learned"$'\n'"$(cd "$src_pkg" && pwd -P)/skills/learned"
[[ $p_owner == 0 ]] && learned=""
if [[ $harness == claude ]]; then
plugins=$(claude plugin list --json 2>/dev/null || echo '[]')
# Memory checks: before a Write/Edit/MultiEdit of a memory file the host's `kith memory hook pre` runs kith-mem's
# checks and blocks a refused write with the reason; after it, `post` records the version. Files that aren't memory
# return at once. Without the kith binary (a kernel checkout never built) writes still go through, unchecked.
# Room notes also get a write-time record of who was in the room (bin/kith-room-ledger); it never blocks a write.
ledger_pre=$(printf '%q pre --agent %q --home %q || true' "$KITH/bin/kith-room-ledger" "$agent" "$home")
ledger_post=${ledger_pre/ pre --agent / post --agent }
mem_pre="" mem_post=""
if mbin=$(python3 "$KITH/lib/kith_paths.py" --bin) && [[ -n $mbin ]]; then
  mem_pre=$(printf '%q memory hook pre --agent %q --state %q --agents %q' "$mbin" "$agent" "$KITH_STATE" "$KITH_AGENTS")
  mem_post=${mem_pre/ hook pre / hook post }
  # Claude Code blocks a tool call on exit 2, which an older kith binary's usage error also exits with; the hook says
  # "deny" in JSON instead, and any failure of its own lets the write through.
  mem_pre+=" || true" mem_post+=" || true"
  # Anyone but the owner: a hook that fails (the binary gone, a usage error, a crash) denies the write instead of letting it through.
  [[ $p_owner == 0 ]] && mem_pre="out=\$(${mem_pre% || true}) || out='{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"the memory check could not run, so this write is refused\"}}'; printf '%s\\n' \"\$out\""
else
  echo "kith: no kith binary found, so memory writes by $agent are not checked or versioned (kith serve start builds it)" >&2
  [[ $p_owner == 0 ]] && { echo "kith: runs for anyone but the owner need the memory check; not running $agent for ${KITH_PERSON}" >&2; exit 3; }
fi
[[ $p_owner == 1 ]] && writable="$home/memory"$'\n'"$home_real/memory" \
  || writable=$(printf '%s\n' "$mem" "$(real "$mem")" "$shared" "$(real "$shared")" "$files" "$(real "$files")")
fill < "$pkg/settings.json" | P_OWNER=$p_owner P_TRUSTED=$p_trusted API_HELPER=$backup_api_helper DENY=$p_deny PLUGINS=$plugins PERM_MODE=$perm_mode MEM_PRE=$mem_pre MEM_POST=$mem_post LEDGER_PRE=$ledger_pre LEDGER_POST=$ledger_post HOOK="\"$KITH/bin/kith-cost\" tag" SESSIONS_HOOK="\"$KITH/bin/kith-sessions\" record" WRITABLE="$writable
$learned
$state_projects" python3 -c '
import json, os, re, sys
s = json.load(sys.stdin)
s.setdefault("hooks", {}).setdefault("SessionStart", []).append(
    {"hooks": [{"type": "command", "command": os.environ["HOOK"], "timeout": 10}]})
# Lists the session in the apps when it is a listable terminal run (kith-sessions says which); never fails the session.
s["hooks"]["SessionStart"].append(
    {"hooks": [{"type": "command", "command": os.environ["SESSIONS_HOOK"], "timeout": 5}]})
for event, key in (("PreToolUse", "MEM_PRE"), ("PostToolUse", "MEM_POST"), ("PreToolUse", "LEDGER_PRE"), ("PostToolUse", "LEDGER_POST")):
    if os.environ[key]:
        s["hooks"].setdefault(event, []).append(
            {"matcher": "Write|Edit|MultiEdit", "hooks": [{"type": "command", "command": os.environ[key], "timeout": 10}]})
sec = os.environ["KITH_SECRETS"]   # a folder of its own, or (the older layout) two files among the machine things
files = ["%s/**" % sec] if sec != os.environ["KITH_MACHINE"] else ["%s/env" % sec, "%s/auth.json" % sec]
s.setdefault("permissions", {}).setdefault("deny", []).extend(
    "%s(/%s)" % (tool, f) for f in files for tool in ("Read", "Edit"))   # Edit covers every file-writing tool
# ~/.kith stays readable (projects/, state, logs), but not the credentials in it, for every run, owner or not: the
# secrets folder, the kith serve token, device identity and databases, browser profiles (their logins) and the old
# bridge folder. Both spellings of each root (it may be a link). These rules stop the Read/Edit tools of Claude Code
# only: a Bash `cat` of the same file is not stopped by them. For anyone but the owner Bash is OS-sandboxed (below), so
# the same files are unreadable there too; for the owner, in auto mode the classifier, in default mode the prompt,
# is the only guard. The kernel CLIs run in Bash and are unaffected.
roots = list(dict.fromkeys(r for k in ("KITH_STATE", "KITH_MACHINE") for r in (os.environ[k], os.path.realpath(os.environ[k]))))
sys.path.insert(0, os.environ["KITH_ROOT"] + "/lib")
import kith_guard
# (index/: the memory index holds every audience, reached only through `kith recall`; memory.db*: the history and the
# promotion approvals kith_facets trusts, written by `kith memory` only.)
sensitive = list(kith_guard.SECRET_RULES)
for r in roots:
    for f in sensitive:
        for tool in ("Read", "Edit"):
            rule = "%s(/%s/%s)" % (tool, r, f)
            if rule not in s["permissions"]["deny"]:
                s["permissions"]["deny"].append(rule)
s["permissions"]["deny"].extend(d for d in os.environ["DENY"].split("\n") if d)   # from the membership of the person the run is for
# Anyone but the owner (an invited person, a bot): the OS sandbox of Claude Code (macOS seatbelt) around Bash and every
# process it starts, so the files above are closed to a shell too and KITH_PERSON cannot be dodged by reading the
# index or the serve token directly. Fails closed (failIfUnavailable), no escape hatch for the model, no excluded
# commands, no network but the host socket the run asks for its recalls. The sandbox is inherited by children: a
# nested `kith` started from that shell stays inside it. Read/Edit/Write keep following the permission rules.
if os.environ["P_OWNER"] == "0":
    def both(p):
        return list(dict.fromkeys((p, os.path.realpath(p))))
    deny_read = kith_guard.secret_paths([os.environ["KITH_STATE"], os.environ["KITH_MACHINE"]], os.environ["KITH_SECRETS"], os.environ["KITH_MACHINE"])
    machine = both(os.environ["KITH_MACHINE"])
    if os.environ.get("KITH_SERVE_HOME"):
        deny_read += both(os.path.expanduser(os.environ["KITH_SERVE_HOME"]))
    # The Read rules of the membership (other agents, the owner user.md, the memory of other people): Read(//abs/**) or Read(//abs).
    for d in os.environ["DENY"].split("\n"):
        if d.startswith("Read(/") and d.endswith(")"):
            path = d[5:-1]
            path = path[1:] if path.startswith("//") else path
            keep = []   # a rule with a glob (dir/**, dir/*.md) denies its parent folder: over-approximating is fine for a deny
            for part in path.split("/"):
                if "*" in part:
                    break
                keep.append(part)
            path = "/".join(keep)
            if path.startswith("/") and len(path) > 1:
                deny_read += both(path)
    uv_cache = os.environ.get("UV_CACHE_DIR") or os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "uv")
    allow_write = [d.strip() for d in os.environ["WRITABLE"].split("\n") if d.strip()] + [uv_cache]
    # The host socket has a fixed place, so it is allowed whether or not the caller put KITH_RUN_SOCKET in this process
    # (the host adds it to the run environment after the launch JSON is built); one that differs is allowed as well.
    socks = [x for m in machine for x in both(m + "/run/host.sock")]
    if os.environ.get("KITH_RUN_SOCKET"):
        socks += both(os.environ["KITH_RUN_SOCKET"])
    s["sandbox"] = {
        "enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False, "autoAllowBashIfSandboxed": True,
        "filesystem": {"denyRead": list(dict.fromkeys(deny_read)), "allowWrite": list(dict.fromkeys(allow_write))},
        "network": {"allowUnixSockets": list(dict.fromkeys(socks))}}
allow = s["permissions"].setdefault("allow", [])
if os.environ["P_OWNER"] == "0":   # no broad Bash rule for the run of an invited person unless the membership is trusted (F11)
    sys.path.insert(0, os.environ["KITH_ROOT"] + "/lib")
    from kith_settings import strip_broad_bash
    allow[:] = strip_broad_bash(allow, os.environ["P_TRUSTED"] == "1")
# A role rule for a kernel tool, Bash({{KITH}}/bin/tool...), names the path bare; the path may have a space, and then a
# working call quotes it and only Bash("{{KITH}}/bin/tool"...) matches. Add that spelling next to each such rule.
kbin = "Bash(%s/bin/" % os.environ["KITH_ROOT"]
for rules in (allow, s["permissions"]["deny"]):
    for r in [r for r in rules if r.startswith(kbin)]:
        name = re.match(r"[^ :)]*", r[len(kbin):]).group()
        q = "Bash(\"%s%s\"%s" % (kbin[5:], name, r[len(kbin) + len(name):])
        if q not in rules:
            rules.insert(rules.index(r) + 1, q)
allow.extend(r for r in dict.fromkeys("Edit(/%s/**)" % d for d in os.environ["WRITABLE"].split("\n") if d.strip()) if r not in allow)
sys.path.insert(0, os.environ["KITH_ROOT"] + "/lib")
from kith_settings import current, get
if not os.environ["PERM_MODE"]:
    s["permissions"].setdefault("defaultMode", get("permission_mode"))
if "defaultMode" in s["permissions"]:   # the agent author may still suggest a retired one
    s["permissions"]["defaultMode"] = current(s["permissions"]["defaultMode"])
try:
    installed = [p["id"] for p in json.loads(os.environ["PLUGINS"])]
except (ValueError, KeyError, TypeError):
    installed = []
every = get("plugins")
on = s.setdefault("enabledPlugins", {})
for p in installed:
    on.setdefault(p, p in ("kith@kith", "hq@hq") or p in every)
if os.environ["API_HELPER"]:   # claude-api backup: Claude Code asks kith-auth for the key itself; it is never in our output
    s["apiKeyHelper"] = os.environ["API_HELPER"]
json.dump(s, sys.stdout, indent=1)' > "$runs/$$.settings.json"
fi

# Directories the agent may use: the kernel (tools) under both its logical and its resolved path (Claude Code checks
# resolved paths), the state folder (user.md, projects), the agents (memory, data) and the snapshots (its skills).
dirs=(--add-dir "$KITH")
kith_real=$(cd "$KITH" && pwd -P); [[ $kith_real != "$KITH" ]] && dirs+=(--add-dir "$kith_real")
[[ $KITH_STATE != "$KITH" ]] && dirs+=(--add-dir "$KITH_STATE")
[[ -d $KITH_AGENTS && $KITH_AGENTS != "$KITH_STATE"/* ]] && dirs+=(--add-dir "$KITH_AGENTS")
[[ -d $KITH_STORE && $KITH_STORE != "$KITH_STATE"/* && $KITH_STORE != "$KITH_AGENTS"/* ]] && dirs+=(--add-dir "$KITH_STORE")
# Each project's home along the chain (the user's own folder for its files), and where the projects it holds are on
# this Mac, so an agent working on a whole client sees all of it.
while IFS=$'\t' read -r _ h; do
  [[ -n $h && $h != - ]] && h=${h/#\~/$HOME} && [[ -d $h ]] && dirs+=(--add-dir "$h")
done <<< "$info
$held"
# Anyone but the owner: the kernel, their part of this agent's folder (their memory and outputs, the shared memory,
# the agent's data) and its pinned package, and the current project's shared files; not the other agents, the
# state folder or the owner's project folders.
if [[ $p_owner == 0 ]]; then
  dirs=(--add-dir "$KITH" --add-dir "$mem" --add-dir "$shared" --add-dir "$files" --add-dir "$KITH_STATE/people" --add-dir "$pkg")
  [[ -d $home/data ]] && dirs+=(--add-dir "$home/data")
  [[ $kith_real != "$KITH" ]] && dirs+=(--add-dir "$kith_real")
  [[ -n $project && -d $KITH_STATE/projects/$project ]] && dirs+=(--add-dir "$KITH_STATE/projects/$project")
fi
# The agent's own folder under every path it is reachable by. Claude Code compares the path as typed with the working
# directory, so ~/kith/agents/<name> (a symlink) counts as outside a run whose cwd is the resolved folder and asks
# every time. Spellings: the logical one, the resolved one, and the same folder through the usual home links.
# A missing or dangling link is skipped; one that points elsewhere is not the same folder.
if [[ $p_owner == 1 ]]; then
  for d in "$home" "$home_real" "$HOME/kith/agents/$agent" "$HOME/hq/agents/$agent"; do
    [[ -d $d && $d != "$PWD" && $(cd "$d" && pwd -P) == "$home_real" ]] || continue
    seen=0; for ((i = 1; i < ${#dirs[@]}; i += 2)); do [[ ${dirs[i]} == "$d" ]] && seen=1; done
    [[ $seen == 1 ]] || dirs+=(--add-dir "$d")
  done
fi
# Anyone but the owner reads an allowlist, not a blocklist: nothing in the home folder (ssh keys, tokens of other tools,
# other repos) except what the run was given. Claude Code applies the narrower path, so the denies above stay on top of
# these. Bash gets it from the sandbox (denyRead of the home folder, allowRead of the add-dirs, the working directory and
# what uv and python need to start); the file tools from blockReadsOutsideWorkingDirectories, which already limits them to
# the working directory and the --add-dir folders.
if [[ $p_owner == 0 && $harness == claude ]]; then
  # A working directory that is the home folder, or holds one of the folders above, would be readable whole (the bridge
  # runs people's turns from the home folder): they work in their own files folder instead.
  wide=0; [[ $PWD == "$HOME" || $PWD == "$(cd "$HOME" && pwd -P)" ]] && wide=1
  for ((i = 1; i < ${#dirs[@]}; i += 2)); do [[ ${dirs[i]} == "$PWD" || ${dirs[i]} == "$PWD"/* ]] && wide=1; done
  [[ $wide == 1 && $PWD != "$files" ]] && { echo "kith: working directory $PWD is wider than a guest may read; working in $files" >&2; cd "$files"; }
  read_dirs=$PWD
  for ((i = 1; i < ${#dirs[@]}; i += 2)); do read_dirs+=$'\n'"${dirs[i]}"; done
  READ_DIRS=$read_dirs GUARD_TREES=$(printf '%s\n' "$KITH" "$src_pkg/role" "$src_pkg/skills" "$pkg" "$src_pkg" "$KITH_STATE/people" "$KITH_STORE") python3 -c '
import json, os, re, sys
f = sys.argv[1]
s = json.load(open(f))
def both(p):
    return list(dict.fromkeys((p, os.path.realpath(p))))
home = os.path.expanduser("~")
allow = []
for d in os.environ["READ_DIRS"].split("\n"):
    if d:
        allow += both(os.path.abspath(d))
# what a kernel helper needs to start: uv, the pythons it manages, the kith program itself
for d in (os.environ.get("UV_CACHE_DIR"), os.path.join(os.environ.get("XDG_CACHE_HOME") or home + "/.cache", "uv"),
          home + "/Library/Caches/uv", home + "/.local/share/uv", home + "/.local/bin"):
    if d:
        allow += both(d)
try:   # the developer shims of macOS look the toolchain up here, which can sit on another volume
    import subprocess
    dev = subprocess.run(["xcode-select", "-p"], capture_output=True, text=True, timeout=5).stdout.strip()
    if ".app/" in dev:   # xcrun loads frameworks from the whole bundle
        dev = dev[:dev.index(".app/") + 4]
    if dev:
        allow += both(dev)
except (OSError, subprocess.SubprocessError):
    pass
# A link on the way to an allowed folder (~/kith, the state folder on another disk) is read as a link before it is followed:
# allow the link itself. Seatbelt matches resolved paths, so this opens the link and nothing behind it.
for a in list(allow):
    d = os.path.dirname(a)
    while d not in ("/", ""):
        if os.path.islink(d):
            allow.append(d)
        d = os.path.dirname(d)
fs = s["sandbox"]["filesystem"]
# Deny by default: nothing is readable but what is allowed below, and the named denies from the settings (secrets, the
# serve folder, the index, other people) stay listed. Not ~/Library: the Keychain is there (lab T1).
fs["denyRead"] = ["/"] + [d for d in fs["denyRead"] if d != "/"]
allow += [x for d in ("/usr", "/bin", "/sbin", "/System", "/Library", "/private/etc", "/private/var/db/timezone",
                      "/private/var/select", "/dev", "/opt/homebrew") for x in both(d)]
allow += ["/var", "/etc"]   # the links themselves, read as links before they are followed; what they point at stays closed (/tmp is not opened)
# The Kith folder and the agents folder, dotfiles included (agents/.git holds the memory of every agent in its history):
# denied whole, then the allowlist opens back only what the run was given.
for r in ("KITH_HOME", "KITH_AGENTS"):
    if os.environ.get(r):
        for p in both(os.path.abspath(os.environ[r])):
            if p not in fs["denyRead"]:
                fs["denyRead"].append(p)
# the host socket sits among the machine things: allowing it to be read costs nothing
allow += s["sandbox"]["network"].get("allowUnixSockets", [])
fs["allowRead"] = [a for a in dict.fromkeys(allow)]
# Writes: the allowWrite list stays (the person slice, the shared memory, their uv cache); rule W and the secrets are
# denied on top, also below the folders that are allowed (deny beats allow), and the file tools get the same list.
folders = fs["allowWrite"] + [d for d in os.environ["READ_DIRS"].split("\n") if d]
extra = [x for x in os.environ.get("GUARD_TREES", "").split("\n") if x]
writable = [os.path.realpath(w) for w in fs["allowWrite"]]
# A folder that holds something writable (the agent folder holds the person memory) is not denied whole.
extra = [x for x in extra if not any(w == os.path.realpath(x) or w.startswith(os.path.realpath(x) + "/") for w in writable)]
sys.path.insert(0, os.environ["KITH_ROOT"] + "/lib")
import kith_guard
w_trees, w_files = kith_guard.rule_w(home, folders, trees=extra)
secrets = kith_guard.secret_paths([os.environ["KITH_STATE"], os.environ["KITH_MACHINE"]], os.environ["KITH_SECRETS"], os.environ["KITH_MACHINE"])
fs["denyWrite"] = list(dict.fromkeys(secrets + w_trees + [t + "/**" for t in w_trees if "**" in t] + w_files))   # a glob names the folder, not what is in it
deny = s["permissions"].setdefault("deny", [])
deny += [r for r in kith_guard.edit_rules(w_trees, w_files) if r not in deny]
# The file tools write only where Bash may: a folder the run can read but not write (the project, the kernel, the shared
# project files) is closed to Edit/Write, whatever the permission mode would allow there.
for d in os.environ["READ_DIRS"].split("\n"):
    for x in both(os.path.abspath(d)) if d else []:
        if not any(w == x or w.startswith(x + "/") or x.startswith(w + "/") for w in writable):
            r = "Edit(/%s/**)" % x
            if r not in deny:
                deny.append(r)
s["permissions"]["blockReadsOutsideWorkingDirectories"] = True
# The tool reads the owner global config (name, email, credential helpers), which sits in the closed home folder and
# makes it fail outright when it cannot be read: point it at nothing instead.
s.setdefault("env", {})["GIT_CONFIG_GLOBAL"] = "/dev/null"
if os.environ.get("UV_CACHE_DIR"):   # their own cache, also for a launch-json run whose environment comes from the host
    s["env"]["UV_CACHE_DIR"] = os.environ["UV_CACHE_DIR"]
json.dump(s, open(f, "w"), indent=1)' "$runs/$$.settings.json"
fi
# The read-only kernel commands PROTOCOL tells agents to run, allowed without a prompt. Under every path the kernel
# has (logical, resolved, ~/kith/kernel) and, since a path with a space gets quoted, with the program in quotes too.
readonly_cmds=("project-id" "project-id --list" "project-id --info:*" "project-id --children:*" "kith-memory search:*" "kith-who:*" "hq-memory search:*" "hq-who:*")
allowed=()
while IFS= read -r base; do
  [[ -n $base && -d $base/bin ]] || continue
  for c in "${readonly_cmds[@]}"; do
    name=${c%%[ :]*}; rest=${c#"$name"}
    allowed+=("Bash($base/bin/$c)" "Bash(\"$base/bin/$name\"$rest)")
  done
done < <(printf '%s\n' "$KITH" "$kith_real" "$KITH_HOME/kernel" | awk '!seen[$0]++')
# The way out of the guest sandbox is a request, not a prompt: asking is always allowed (the host makes the card, F11 2b).
[[ $p_owner == 0 ]] && allowed+=("mcp__kithpermit__request_access" "mcp__kithpermit__report_bug")
# Each agent carries only its own tools: the shared services it needs and is granted (kith-auth), its own mcp.json
# for servers no one else uses, and no global skills unless capabilities.yaml says global_skills: true. Its own
# skills are files it reads on demand. A broken auth.json costs the agent its services, not the run.
"$KITH/bin/kith-auth" mcp-config "$agent" > "$runs/$$.mcp.json" \
  || { echo "kith: $agent: no shared services this run (kith-auth failed)" >&2; echo '{"mcpServers": {}}' > "$runs/$$.mcp.json"; }

kith_env_sync   # the exports above reach role repos under their old HQ_ names too
# The agent's MCP servers for a launch-json run: the granted shared services plus its own mcp.json, as one {"mcpServers": {...}}.
# Anyone but the owner gets kith-permit and nothing else: no shared services (their logins), no server of the agent's own.
permit_mcp() { printf '{"mcpServers":{"kithpermit":{"command":"%s/bin/kith-permit","args":[]}}}' "$KITH"; }
merged_mcp() {
  [[ $p_owner == 0 ]] && { permit_mcp; return; }
  local f=("$runs/$$.mcp.json"); [[ -f $pkg/mcp.json ]] && f+=("$pkg/mcp.json")
  python3 -c '
import json, sys
servers = {}
for f in sys.argv[1:]:
    d = json.load(open(f))
    servers.update(d.get("mcpServers", d))
print(json.dumps({"mcpServers": servers}))' "${f[@]}"
}
# The launch JSON for kith serve, from the lists built above: dirs[] holds --add-dir pairs; the arguments are the argv to give
# claude (none for Codex, which the host builds itself: settings and claude_args are then null).
# Claude Code turns the Artifact tools off under the SDK and -p; every Claude run gets them, guests' included (a guest's
# artifacts publish to the owner's claude.ai account, which is accepted).
[[ $harness == claude ]] && export CLAUDE_CODE_ARTIFACT=1
export KITH_OWNER=$p_owner   # the plugin's answer to "is this run the owner's": KITH_PERSON can name the owner too
emit_launch() {
  # Only a Claude run on the agent's own model: a person's membership picks their model, and another harness names its own.
  local call_model=""
  [[ $harness == claude && -z $p_model ]] && call_model=$(python3 "$KITH/lib/kith_settings.py" call_model "$agent")
  local add_dirs allowed_tools no_slash settings=null
  add_dirs=$(for ((i = 1; i < ${#dirs[@]}; i += 2)); do printf '%s\n' "${dirs[i]}"; done)
  allowed_tools=$(printf '%s\n' "${allowed[@]}")
  [[ $harness == claude ]] && settings=$(cat "$runs/$$.settings.json")
  grep -q '^global_skills: *true' "$pkg/capabilities.yaml" 2>/dev/null && no_slash=false || no_slash=true
  [[ $harness == claude ]] || allowed_tools=""
  ENV_NAMES="$(python3 "$KITH/lib/kith_paths.py" --sh | sed -n 's/^export \([A-Z_]*\)=.*/\1/p' | paste -sd' ' -) KITH_ROOT KITH_AGENT KITH_AGENT_DIR KITH_AGENT_HOME KITH_AGENT_VERSION KITH_MODEL KITH_EFFORT KITH_PROJECT KITH_PERSON KITH_RUN_TOKEN KITH_RUN_SOCKET KITH_ROOM KITH_ROOM_MEMBERS KITH_ROOM_OWNER_ONLY KITH_VIA KITH_PROVIDER KITH_ACCOUNT KITH_ACCOUNT_ID KITH_ACCOUNT_VAR KITH_OWNER CLAUDE_CODE_ARTIFACT $backup_cfg_var $p_env_names HQ_ROOT HQ_AGENT HQ_AGENT_DIR HQ_AGENT_HOME HQ_AGENT_VERSION HQ_MODEL HQ_EFFORT HQ_PROJECT HQ_PERSON HQ_VIA" \
    ADD_DIRS=$add_dirs ALLOWED=$allowed_tools SETTINGS=$settings MCP=$(merged_mcp) PROMPT=$prompt PERM_MODE=$perm_mode NO_SLASH=$no_slash CALL_MODEL=$call_model \
    BACKUP=$backup HARNESS=$harness KITH_LIB=$KITH/lib \
    python3 -c '
import json, os
e = os.environ.get
import sys
sys.path.insert(0, e("KITH_LIB"))
from kith_settings import get
env = {k: os.environ[k] for k in e("ENV_NAMES").split() if k in os.environ}
settings = json.loads(e("SETTINGS"))
nz = lambda k: e(k) or None
claude = e("HARNESS") == "claude"
print(json.dumps({
    "version": 1, "agent": e("KITH_AGENT"), "agent_version": e("KITH_AGENT_VERSION"), "harness": e("HARNESS"), "cwd": os.getcwd(),
    "env": env, "system_prompt": e("PROMPT"), "settings": settings, "mcp_servers": json.loads(e("MCP"))["mcpServers"],
    "add_dirs": [d for d in e("ADD_DIRS").split("\n") if d], "allowed_tools": [a for a in e("ALLOWED").split("\n") if a],
    "disable_slash_commands": e("NO_SLASH") == "true", "model": nz("KITH_MODEL"), "effort": nz("KITH_EFFORT"),
    "project": nz("KITH_PROJECT"), "call_model": nz("CALL_MODEL"),
    "permission_mode": e("PERM_MODE") or (settings or {}).get("permissions", {}).get("defaultMode") or (None if claude else get("permission_mode")),
    "cost_tag": {"agent": e("KITH_AGENT"), "version": e("KITH_AGENT_VERSION"), "model": nz("KITH_MODEL"), "effort": nz("KITH_EFFORT"),
                 "via": e("KITH_VIA"), "project": nz("KITH_PROJECT"), "person": nz("KITH_PERSON")},
    "claude_args": sys.argv[1:] if claude else None,
    "backup": nz("BACKUP"), "provider": nz("KITH_PROVIDER"), "account": nz("KITH_ACCOUNT"), "account_id": nz("KITH_ACCOUNT_ID")}))' "$@" >&3
}
# Codex (or another harness the launch JSON covers): the same facts, without Claude's settings.
if [[ $launch -eq 1 && $harness != claude ]]; then emit_launch; exit 0; fi
# Every run with someone else's profile is findable by the revoke sweep (kith-sessions proc): its pid is the one that execs
# claude below, so the claim lives as long as claude (or, for an interactive run, the launcher claude runs under).
[[ $p_owner == 1 || $launch -eq 1 ]] || python3 "$KITH/bin/kith-sessions" proc "$$" "$p_id" "$agent" 2>/dev/null || true
# Another harness: the same run, handed to its adapter (prompt in a file, directories and MCP configs as lists).
if [[ $harness != claude ]]; then
  printf '%s\n' "$prompt" > "$runs/$$.prompt.md"
  run_dirs=$(for ((i = 1; i < ${#dirs[@]}; i += 2)); do printf '%s\n' "${dirs[i]}"; done)
  grep -q '^global_skills: *true' "$pkg/capabilities.yaml" 2>/dev/null && gs=1 || gs=0
  run_mcp="$runs/$$.mcp.json"; [[ -f $pkg/mcp.json ]] && run_mcp+=$'\n'"$pkg/mcp.json"
  export KITH_RUN_PROMPT="$runs/$$.prompt.md" KITH_RUN_DIRS="$PWD"$'\n'"$run_dirs" KITH_RUN_MCP=$run_mcp KITH_RUN_GLOBAL_SKILLS=$gs
  hargs=(--)
  [[ -n $out_format ]] && hargs=(--output "$out_format" "${hargs[@]}")
  [[ -n $resume ]] && hargs=(--resume "$resume" "${hargs[@]}")
  [[ -n $perm_mode ]] && hargs=(--permission-mode "$perm_mode" "${hargs[@]}")
  if [[ $# -eq 0 ]]; then
    [[ -t 0 && -t 1 ]] || { echo "kith: no terminal for an interactive session; give a task (kith $agent \"...\") or run it in a terminal" >&2; exit 1; }
    exec python3 "$KITH/adapters/harness.py" "$harness" "${hargs[@]}"
  fi
  exec python3 "$KITH/adapters/harness.py" "$harness" "${hargs[@]}" "$*"
fi

# launch-json hands the settings and the MCP servers over inline (--settings and --mcp-config take JSON as well as a file).
settings_arg="$runs/$$.settings.json" mcp_arg="$runs/$$.mcp.json"
if [[ $launch -eq 1 ]]; then
  # F11 step 2b for the host's launch (an app chat's run): the grants go into the settings it is handed, as in the exec
  # path's apply below. A once grant is pending only after a yes, and after a yes the host starts its process again with
  # this launch.
  if [[ $p_owner == 0 && -n ${KITH_RUN_TOKEN:-} && -n ${KITH_RUN_SOCKET:-} ]]; then
    python3 "$KITH/bin/kith-permit" apply "$runs/$$.settings.json" || true
  fi
  settings_arg=$(cat "$runs/$$.settings.json")
  mcp_arg=$(merged_mcp)
fi
[[ $p_owner == 0 ]] && mcp_arg=$(permit_mcp)
args=(--append-system-prompt "$prompt" "${dirs[@]}" --settings "$settings_arg" --allowedTools "${allowed[@]}")
args+=(--strict-mcp-config --mcp-config "$mcp_arg")
[[ $launch -eq 0 && $p_owner == 1 && -f $pkg/mcp.json ]] && args+=(--mcp-config "$pkg/mcp.json")
grep -q '^global_skills: *true' "$pkg/capabilities.yaml" 2>/dev/null || args+=(--disable-slash-commands)
[[ -n $KITH_MODEL ]] && args+=(--model "$KITH_MODEL")
[[ -n $KITH_EFFORT ]] && args+=(--effort "$KITH_EFFORT")
[[ $out_format == json ]] && args+=(--output-format json)
[[ -n $perm_mode ]] && args+=(--permission-mode "$perm_mode")
# A session another harness made ("codex:…") can't be resumed here: start a new one.
if [[ -n $resume ]]; then
  if [[ $resume == *:* ]]; then echo "kith: session $resume is not a Claude Code session; starting a new one" >&2
  else args+=(--resume "$resume"); fi
fi
if [[ $launch -eq 1 ]]; then emit_launch "${args[@]}"; exit 0; fi
# Extra claude flags from a caller such as kith-bridge (e.g. --output-format json --resume <session>).
# For anyone but the owner, permission flags in them are dropped: the membership's mode stands.
if [[ -n ${KITH_CLAUDE_ARGS:-} ]]; then
  read -r -a extra <<< "$KITH_CLAUDE_ARGS"
  if [[ $p_owner == 0 ]]; then
    kept=(); skip=0
    for a in "${extra[@]}"; do
      if [[ $skip == 1 ]]; then skip=0; continue; fi
      case $a in
        --permission-mode) skip=1 ;;
        --permission-mode=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions) ;;
        *) kept+=("$a") ;;
      esac
    done
    extra=(${kept[@]+"${kept[@]}"})
  fi
  args+=(${extra[@]+"${extra[@]}"})
fi
# They are for this run only: a helper this agent starts with `kith <other>` must not resume this session.
unset KITH_CLAUDE_ARGS HQ_CLAUDE_ARGS
# Every Claude start holds its session's writer claim from before claude starts until it exits, interactive or one-shot,
# fresh or resumed: the host never writes to a session a run here has open, also not between claude's start and its first
# hook. The session is the one the run continues (--resume: KITH_RESUME, -r/-c, or the bridge's KITH_CLAUDE_ARGS) or the
# one it was told to be (--session-id); a fresh run (or a fork) is given its id now, so there is one to claim. Only a bare
# --continue from a caller names none up front (no caller passes one; kith's own -c is a --resume by now).
csid=""
if [[ $harness == claude ]]; then
  given="" resumed="" fork=0 cont=0 prev=""
  for a in "${args[@]}"; do
    case $prev in --resume) resumed=$a ;; --session-id) given=$a ;; esac
    case $a in
      --resume=*) resumed=${a#--resume=} ;;
      --session-id=*) given=${a#--session-id=} ;;
      --fork-session) fork=1 ;;
      --continue|-c) cont=1 ;;
    esac
    prev=$a
  done
  if [[ -n $given ]]; then csid=$given
  elif [[ -n $resumed && $fork == 0 ]]; then csid=$resumed
  elif [[ $cont == 0 || $fork == 1 ]]; then csid=$(python3 -c 'import uuid; print(uuid.uuid4())'); args+=(--session-id "$csid")
  fi
fi
# The claim names the person kith-auth resolved (never anything the run can change), so revoking them ends this run.
claim_person=""; [[ $p_owner == 1 ]] || claim_person=$p_id
if [[ $# -gt 0 ]]; then
  # A one-shot takes the claim (kind oneshot) for this shell's pid: exec keeps the pid, so the claim is claude's own and
  # ends with it. A held session is waited for a little (KITH_CLAIM_WAIT), then refused.
  [[ -z $csid ]] || python3 "$KITH/bin/kith-sessions" claim "$csid" "$$" ${claim_person:+"$claim_person" "$agent"} || exit 1
  # A permission prompt in this run asks for approval through a card (--permission-prompt-tool) instead of being refused.
  # A guest run was given KITH_RUN_TOKEN/KITH_RUN_SOCKET by the host, an owner run KITH_ASK_*, or gets them here: the
  # host binds the token to this pid (exec keeps it) and to the session the run continues, or a --session-id chosen now.
  # No token, no host, no answer: no prompt tool, asks are refused as before, and the run goes on.
  if [[ $harness == claude ]]; then
    if [[ -z ${KITH_RUN_TOKEN:-} && -z ${KITH_ASK_TOKEN:-} && $p_owner == 1 ]]; then
      psid=${csid:-continue:$PWD}
      if ask_env=$("$KITH/bin/kith-permit" issue "$agent" "$psid" "$$"); then eval "$ask_env"; fi
    fi
    if [[ -n ${KITH_RUN_TOKEN:-} && -n ${KITH_RUN_SOCKET:-} ]] || [[ -n ${KITH_ASK_TOKEN:-} && -n ${KITH_ASK_SOCKET:-} ]]; then
      args+=(--mcp-config "{\"mcpServers\":{\"kithpermit\":{\"command\":\"$KITH/bin/kith-permit\",\"args\":[]}}}"
             --permission-prompt-tool mcp__kithpermit__approve)
    fi
    # F11 step 2b: what this session was given beyond the box (a yes on an escape card, an "always") goes into the settings
    # file now, after the claim above and before exec: a once grant is consumed by the one run that is about to start, never
    # by a profile built earlier (a read made before the claim could be spent twice). Nothing from the host, no access.
    if [[ $p_owner == 0 && -n ${KITH_RUN_TOKEN:-} && -n ${KITH_RUN_SOCKET:-} ]]; then
      python3 "$KITH/bin/kith-permit" apply "$runs/$$.settings.json" || true
    fi
  fi
  exec claude "${args[@]}" -p "$*"
fi
[[ -t 0 && -t 1 ]] || { echo "kith: no terminal for an interactive session; give a task (kith $agent \"...\") or run it in a terminal" >&2; exit 1; }
# The terminal's claim (kind terminal), for this shell's pid, which `kith-sessions run` keeps: it gives the claim back when
# claude has exited. -r/-c/--resume took it in resolve already. A held session is refused at once.
if [[ -n $csid && $csid != "${r_sid:-}" ]]; then
  python3 "$KITH/bin/kith-sessions" terminal "$csid" "$$" ${claim_person:+"$claim_person" "$agent"} || exit 1
fi
# An interactive owner run is listed in the apps (the SessionStart hook above) and may be taken over from there, which ends
# claude: it runs as a child of kith-sessions so the note about getting it back can follow it (signals and the exit code
# pass through). One-shots above stay exec.
[[ $p_owner == 1 && $harness == claude ]] && export KITH_TERMINAL_SESSION=1
[[ -n $r_sid ]] && export KITH_RESUMED_FROM=$r_from
exec python3 "$KITH/bin/kith-sessions" run "$agent" -- claude "${args[@]}"
