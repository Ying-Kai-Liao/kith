#!/usr/bin/env python3
"""kith-sched — run agent tasks on a schedule.

  kith-sched ls [AGENT]                                  every job, when it runs next and how it last went
  kith-sched add AGENT "CRON" "task" [--id ID] [-m MODEL] [-e EFFORT] [-H HARNESS]   add a job (or replace the one with that id)
  kith-sched rm AGENT ID                                 remove a job
  kith-sched pause|resume AGENT ID                       keep a job but stop or restart it
  kith-sched run AGENT ID                                run a job now, in the background
  kith-sched log [AGENT [ID]]                            the last runs, with the path of each run's output
  kith-sched prune                                       trim old run logs, rotate auth.log, drop dead terminal records (tick does it hourly)
  kith-sched tick                                        (launchd, every minute) start the jobs that are due
  kith-sched run-turn AGENT JOB --turn N --claim C       (the Kith host, once the core fires the schedules) run the core's turn N of a job
  kith-sched --install | --uninstall                     the LaunchAgent dev.kith.sched that ticks

--json (ls, add, rm, pause, resume, run, log; anywhere after the verb): one JSON object on stdout, nothing else. A
listing is {"jobs": [...]} / {"runs": [...]}; an acting verb is {"ok": true, ...}; a failure is {"ok": false, "error"}
with the exit code the text mode has. `log` also takes AGENT/ID.

A job is a one-shot `kith AGENT "task"`, the same run as from your terminal: pinned package, memory, the agent's own
tools, tagged in the cost ledger with via=schedule. The task is told it was scheduled and to deliver with kith-send,
which goes to your Telegram and, through the run's outbox, to the person's chat with the agent in the Kith app. Jobs
live with the agent's life, <kith>/agents/AGENT/jobs.json, so they are versioned with your memory and never shared
with the package.

A job runs as the person whose run added it (KITH_PERSON then; none = the owner), with their limits, checked against
kith-auth each time it is due: once they are revoked or no longer a member, or while this Mac is out of sync with the
Kith cloud, the job is skipped with a line in tick.log. Only they or the owner can `run` it by hand; anyone else's
`run` of an owner's job runs as them.

CRON is five fields, minute hour day-of-month month day-of-week (0 or 7 = Sunday), each *, a number, a range a-b,
a list a,b and a step */n or a-b/n; or @hourly, @daily, @weekly, @monthly. Times are this Mac's local time. When the
Mac slept through a due time, the job runs once on the next tick (if the miss was under a day), not once per miss.

Runs start with `--permission-mode` from KITH_SCHED_PERMISSION_MODE when set, else in the agent's settings.json
defaultMode, else in kith's default (auto; ~/.kith/settings.json changes it): no one is there to approve a tool call, so
one that would need it is refused. The agent's settings.json allow/deny rules still apply.
Machine state (last tick, last runs): ~/.kith/sched/. Logs (tick.log, each run's output): ~/.kith/logs/sched/.

run-turn is the host's way to run a turn the core fired for a job of this file (`kith kernel cutover step schedules`): the host
claims the turn, starts `kith-sched run-turn` detached and pipes the turn's fields to its stdin as one JSON object
{"prompt", "settings": {"model", "effort", "harness", "person"} | null}. It builds the run exactly as `run` and the tick do
(`run_env`), records its own pid and start time on the turn's claim (`claim.attach`, a check-and-set) and only then replaces
itself with `kith AGENT task`, so the pid IS the run. It never reads or writes state.json (a tombstone by then) and never takes
tick.lock. Exit codes: 2 no such job or bad input, 3 the person may not run it now, or is not the person the host
claimed the turn for, 4 the claim is gone (cancelled, ended, already running: nothing ran), 5 the core did not answer or
refused the call (nothing ran). The host also sends the turn's "person"; a run whose job's person (the turn's settings', else
the job's current) is another exits 3 before it attaches, so a revoke of the claim's person always reaches the run. A turn with `settings: null` (fired before they were kept)
uses the job's current model, effort and harness. KITH_SCHED_PERMISSION_MODE is read from the environment run-turn gets, which
is the host's (the launchd plist of the tick does not set it either).

KITH_SCHED_NOW (tests): the time kith-sched takes as now, instead of the clock: ISO local time ("2026-11-03T08:00") or
epoch seconds. Unset, nothing changes. It sets the tick, the catch-up window, the 6 h still-running rule, `ls`'s next
times and the stamps kith-sched writes; it does not move the clock of the runs it starts.
"""
import contextlib, datetime as dt, fcntl, io, json, os, plistlib, re, shutil, subprocess, sys, time
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import kith_launchd  # noqa: E402
import kith_registry  # noqa: E402
import kith_procstart  # noqa: E402
import kith_runenv  # noqa: E402
import kith_tombstone  # noqa: E402
import kith_sched_core  # noqa: E402  the verbs once the schedules are the Kith core's
from kith_paths import paths, launcher, job_installed, retire_old_job, stable_kernel  # noqa: E402  the one place that knows where kith's folders are
KITH_SCHED_TICK_LOCK = 1  # honours sched/tick.lock (cutover gate reads this line)
STATE = paths()['KITH_STATE']
MACHINE = paths()['KITH_MACHINE'] / 'sched'  # last tick, last run per job
LOGS = paths()['KITH_LOGS'] / 'sched'  # tick.log, one log per run
LABEL = 'dev.kith.sched'
PLIST = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
LAUNCHER = launcher()  # uv with Full Disk Access, for a repo on an external disk
EFFORTS = ('low', 'medium', 'high', 'xhigh', 'max')
MACROS = {'@hourly': '0 * * * *', '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
          '@weekly': '0 0 * * 0', '@monthly': '0 0 1 * *'}
CATCH_UP = dt.timedelta(days=1)
# Pruning (reversible choices). Run logs: keep a job's newest KEEP_RUNS, or anything newer than KEEP_RUN_DAYS, whichever
# keeps more. auth.log is an audit log: rotated past AUTH_LOG_MAX bytes (one .1 copy), never truncated. A terminal
# session record is dropped after TERMINAL_DAYS once its process is gone.
KEEP_RUNS, KEEP_RUN_DAYS = 50, 30
AUTH_LOG_MAX = 5 * 1024 * 1024
TERMINAL_DAYS = 7
PRUNE_EVERY = 3600   # seconds between prunes: the tick runs every minute, the files grow slowly


def clock():
    """Now, as local time without a zone. KITH_SCHED_NOW (ISO local time, or epoch seconds) hands tests a fixed one."""
    v = os.environ.get('KITH_SCHED_NOW', '').strip()
    if not v:
        return dt.datetime.now()
    try:
        return dt.datetime.fromtimestamp(float(v))
    except ValueError:
        t = dt.datetime.fromisoformat(v)
        return t.astimezone().replace(tzinfo=None) if t.tzinfo else t


def epoch():
    """clock() as epoch seconds; the real time.time() when KITH_SCHED_NOW is unset."""
    return clock().timestamp() if os.environ.get('KITH_SCHED_NOW', '').strip() else time.time()


# --- cron -------------------------------------------------------------------------------------------------------------

def field(spec, lo, hi):
    """One cron field → the set of values it allows."""
    out = set()
    for part in spec.split(','):
        m = re.fullmatch(r'(\*|\d+(?:-\d+)?)(?:/(\d+))?', part)
        if not m:
            raise ValueError('bad cron field %r' % spec)
        rng, step = m.group(1), int(m.group(2) or 1)
        a, b = (lo, hi) if rng == '*' else (map(int, rng.split('-')) if '-' in rng else (int(rng), int(rng)))
        if m.group(2) and '-' not in rng and rng != '*':
            b = hi  # "5/15" = from 5 to the end, every 15
        if not (lo <= a <= hi and lo <= b <= hi) or step < 1:
            raise ValueError('cron field %r out of range %d-%d' % (spec, lo, hi))
        out.update(range(a, b + 1, step))
    return out


def parse(cron):
    """'m h dom mon dow' → (minutes, hours, days, months, weekdays, dom restricted, dow restricted)."""
    f = MACROS.get(cron.strip(), cron).split()
    if len(f) != 5:
        raise ValueError('cron needs 5 fields (minute hour day month weekday), got %r' % cron)
    dow = {d % 7 for d in field(f[4], 0, 7)}
    return (field(f[0], 0, 59), field(f[1], 0, 23), field(f[2], 1, 31), field(f[3], 1, 12), dow,
            f[2] != '*', f[4] != '*')


def matches(c, t):
    mins, hours, days, months, dow, dom_set, dow_set = c
    if t.minute not in mins or t.hour not in hours or t.month not in months:
        return False
    d, w = t.day in days, (t.weekday() + 1) % 7 in dow
    return (d or w) if dom_set and dow_set else (d and w)  # cron: both restricted = either may match


def next_time(c, after, limit=dt.timedelta(days=366)):
    t = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
    end = after + limit
    while t <= end:
        if t.month not in c[3]:
            t = (t.replace(day=1, hour=0, minute=0) + dt.timedelta(days=32)).replace(day=1); continue
        if t.hour not in c[1]:
            t = t.replace(minute=0) + dt.timedelta(hours=1); continue
        if matches(c, t):
            return t
        t += dt.timedelta(minutes=1)
    return None


# --- jobs -------------------------------------------------------------------------------------------------------------

def agents():
    pkgs = paths()['KITH_AGENTS']
    return sorted(p.name for p in pkgs.iterdir() if (p / 'agent.md').is_file() or (p / 'role' / 'agent.md').is_file()) \
        if pkgs.is_dir() else []


def jobs_file(agent):
    pkgs = paths()['KITH_AGENTS']
    return (pkgs / agent if (pkgs / agent / 'role').is_dir() else STATE / 'agents' / agent) / 'jobs.json'


def read_jobs(f):
    """The jobs in f ([] when there is no file); raises ValueError when the file can't be read as a list of jobs."""
    if not f.exists():
        return []
    jobs = json.loads(f.read_text())
    if not isinstance(jobs, list) or not all(isinstance(j, dict) and 'id' in j for j in jobs):
        raise ValueError('not a list of jobs')
    return jobs


def load(agent):
    """For readers (tick, ls): a file that can't be read counts as no jobs, with a line on stderr."""
    f = jobs_file(agent)
    try:
        return read_jobs(f)
    except (OSError, ValueError) as e:
        print('kith-sched: %s: %s (skipped)' % (f, e), file=sys.stderr); return []


@contextlib.contextmanager
def editing(agent):
    """The one way to change an agent's jobs: yields its jobs under an exclusive lock, then replaces jobs.json whole
    with the list as the block left it. A file that can't be read is refused, never overwritten as if it were empty."""
    f = jobs_file(agent)
    f.parent.mkdir(parents=True, exist_ok=True)
    MACHINE.mkdir(parents=True, exist_ok=True)
    with open(MACHINE / ('%s.jobs.lock' % agent), 'a') as lock:   # flock goes with the process: a crash frees it
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            jobs = read_jobs(f)
        except (OSError, ValueError) as e:
            sys.exit("kith-sched: can't read %s (%s); fix or remove it first, nothing was changed" % (f, e))
        yield jobs
        tmp = f.with_name('.%s.%d.tmp' % (f.name, os.getpid()))
        with open(tmp, 'w') as out:
            out.write(json.dumps(jobs, indent=2, ensure_ascii=False) + '\n')
            out.flush(); os.fsync(out.fileno())
        os.replace(tmp, f)


def all_jobs():
    for a in agents():
        for j in load(a):
            if 'trigger' in j and 'cron' not in j:   # a routine the Kith core fires (kith migrate), not a cron job of ours
                continue
            yield a, j


def machine():
    # Moved to the Kith core (`kith migrate step schedules`): state.json is a note, and carrying on as if it were empty
    # would start every job again. Tombstoned is not caught below (it is an OSError): kith-sched stops with its message.
    kith_tombstone.check(MACHINE / 'state.json')
    try:
        return json.loads((MACHINE / 'state.json').read_text())
    except (OSError, ValueError):
        return {}


class LockBusy(Exception):
    pass


_lock_held = False   # this process holds tick.lock: the lock is taken once, at the outer level (flock is per open file)
LOCK_WAIT = float(os.environ.get('KITH_SCHED_LOCK_WAIT') or 50)   # seconds: a step holds it for tens of seconds, the next launchd tick is a minute away (tests shorten it)
RUN_LOCK_WAIT = min(LOCK_WAIT, 20)   # `run` by hand: under the 30 s the host gives `kith schedule run`, so it is rarely killed between Popen and the pid's save
PRUNE_LOCK_WAIT = min(LOCK_WAIT, 2)   # housekeeping only: a held lock skips it until a later tick rather than delay this one


@contextlib.contextmanager
def tick_lock(wait=LOCK_WAIT):
    """<machine>/sched/tick.lock, exclusive, around everything that reads state.json and then writes it or starts a job
    (the tick, `run`). `kith kernel cutover step schedules` takes the same flock from its import to its tombstone, so
    the two exclude each other (Rust's fs2 lock_exclusive is flock on macOS): a slot is run by one of us, never both.
    flock goes with the process, so a crash frees it. Not taken within `wait` seconds: LockBusy. Reentrant."""
    global _lock_held
    if _lock_held:
        yield; return
    MACHINE.mkdir(parents=True, exist_ok=True)
    with open(MACHINE / 'tick.lock', 'a') as lock:
        end = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB); break
            except OSError:
                if time.monotonic() >= end:
                    raise LockBusy('sched/tick.lock is held (a cutover step?)')
                time.sleep(0.2)
        _lock_held = True
        try:
            yield
        finally:
            _lock_held = False


def save_machine(s):
    with tick_lock():   # the tombstone re-check and the rename happen under the lock the step tombstones under
        MACHINE.mkdir(parents=True, exist_ok=True)
        kith_tombstone.check(MACHINE / 'state.json')   # the last stop before the rename would replace the note
        tmp = MACHINE / 'state.json.tmp'
        tmp.write_text(json.dumps(s, indent=1))
        tmp.replace(MACHINE / 'state.json')


def slug(text):
    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')[:24] or 'job'


# --- running ----------------------------------------------------------------------------------------------------------

def resolve(agent, person):
    """kith-auth's answer for a run of agent for person ({allowed, why, owner, person, held, ...}); raises when it
    can't answer."""
    return json.loads(subprocess.run([str(KITH / 'bin/kith-auth'), 'resolve', agent, '--person', person],
                                     capture_output=True, text=True, timeout=30, check=True).stdout)


def refused(agent, job):
    """Why the job must not run now, or None. A job runs as the person whose run added it, checked at fire time: a
    revoke, a removed membership or a Mac out of sync with the Kith cloud (R8, as the bridge) stops it. Fails closed."""
    if not job.get('person'):
        return None
    try:
        r = resolve(agent, job['person'])
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        return "can't check %s with kith-auth (%s)" % (job['person'], e)
    if not r.get('allowed'):
        return r.get('why') or 'not allowed'
    if r.get('held'):
        return 'this Mac is out of sync with the Kith cloud'
    return None


def run_outbox(agent, job, person):
    """The run's outbox, <machine>/outbox/<run>/: kith-send leaves its messages there and kith serve posts them into
    the person's chat with the agent, whenever it next runs. Who the run is for is in <run>.json beside it, out of the
    run's reach (a guest's sandbox may write the folder only). None when it can't be made (a run inside a sandbox)."""
    root = paths()['KITH_MACHINE'] / 'outbox'
    run = re.sub(r'[^A-Za-z0-9._-]', '_', 'sched-%s-%s-%d' % (agent, job['id'], time.time_ns()))
    try:
        (root / run).mkdir(parents=True)
        meta = root / (run + '.json')
        with open(str(meta) + '.tmp', 'w') as f:
            json.dump({'agent': agent, 'person': person, 'via': 'schedule', 'job': job['id'], 'cron': job['cron'],
                       'at': epoch()}, f)
        os.replace(str(meta) + '.tmp', meta)
    except OSError:
        return None
    return root / run


def tell_app(agent, jid, op):
    """Leaves the change in the run's own outbox (an app chat's run, a scheduled run), when it has one: kith serve
    checks it against the jobs and shows it as a Schedule card in the person's chat with the agent."""
    box = os.environ.get('KITH_RUN_OUTBOX') or os.environ.get('HQ_RUN_OUTBOX')
    if not box or not os.path.isdir(box):
        return
    name = os.path.join(box, '%d.json' % time.time_ns())
    try:
        with open(name + '.tmp', 'w') as f:
            json.dump({'as': agent, 'at': epoch(), 'schedule': {'id': jid, 'op': op}}, f)
        os.rename(name + '.tmp', name)   # whole or not at all: the host reads *.json only
    except OSError as e:
        print('kith-sched: the app was not told (%s)' % e, file=sys.stderr)


def start(agent, job, now, why):
    """Start `kith AGENT task` detached; its output goes to a log file. Returns the log path, or None when the job's
    person may not run it now (said on stdout, the tick log). Runs under tick.lock (taken here when the caller has not).

    The run is recorded in state.json (at, why, log) and saved BEFORE the process starts, then pid and procStart are
    added: a crash in between leaves a recorded run with no pid, a skipped slot and never a second start."""
    with tick_lock(wait=LOCK_WAIT if why.startswith('due') else RUN_LOCK_WAIT):
        return _start(agent, job, now, why)


def run_env(agent, job, now, why):
    """Everything a run of `job` starts with: (argv, env, log path), or None when the job's person may not run it now (said on
    stdout, the tick log). The one builder for the tick, `run` and `run-turn`, so a run is the same whoever starts it: the task
    text, model, effort, harness, permission mode, KITH_PERSON, the outbox (its meta out of the run's reach), via=schedule and the
    backup chain. Makes the log folder and the outbox, writes nothing else."""
    no = refused(agent, job)
    if no:
        print('%s skipped %s/%s: it runs for %s, and %s' % (now.isoformat(timespec='minutes'), agent, job['id'],
                                                           job['person'], no))
        return None
    out = LOGS / 'runs' / agent
    out.mkdir(parents=True, exist_ok=True)
    log = out / ('%s-%s.log' % (job['id'], now.strftime('%Y%m%d-%H%M')))
    task = ('%s\n\n(Scheduled job "%s" of %s, cron `%s`, %s. No one is watching this session: finish the task and '
            'deliver the result with %s/bin/kith-send. If there is nothing worth sending, send nothing.)'
            % (job['task'], job['id'], agent, job['cron'], why, KITH))
    env = dict(os.environ, KITH_VIA='schedule', KITH_SCHED_JOB=job['id'],
               KITH_LAUNCH_KIND='schedule', KITH_LAUNCH_LABEL=job['id'])   # a card in the agent's room (bin/kith-sessions)
    if os.environ.get('KITH_SCHED_PERMISSION_MODE'):   # unset: the agent's mode, else kith's default (bin/kith)
        env['KITH_PERMISSION_MODE'] = os.environ['KITH_SCHED_PERMISSION_MODE']
    for k in ('KITH_AGENT', 'KITH_MODEL', 'KITH_EFFORT', 'KITH_HARNESS', 'KITH_DISCORD_WEBHOOK_URL', 'KITH_DISCORD_THREAD_ID',
              'KITH_BRIDGE_OUTBOX', 'KITH_RUN_OUTBOX', 'KITH_CALL_CHAT', 'KITH_CALL_KEY'):   # and the HQ_ twins that sync_env made
        env.pop('HQ_' + k[5:], None)
        env.pop(k, None)
    env.pop('KITH_SCHED_NOW', None)   # the test clock is the tick's, not the run's
    env['KITH_BACKUP_CHAIN'] = 'on'   # no host picks the account: bin/kith walks the account candidates (kith account pick)
    if job.get('person'):   # none: whoever started this (launchd's tick: the owner; a run by hand: that run's person)
        env['KITH_PERSON'] = env['HQ_PERSON'] = job['person']
    person = env.get('KITH_PERSON') or None
    # The run's origin: the host makes the call key for this agent and this job's person only. Host down: no key
    # (kith-call says unreachable) and the outbox as before; the host drains it when it is back.
    origin = kith_runenv.fetch(agent, person)
    has_chat = bool(origin and origin.get('chat'))
    if has_chat:
        env.update(origin['env'])
    if origin and not has_chat and person is None:
        pass   # the owner has no app chat with this agent: no outbox, kith-send goes to Telegram as it always did
    else:
        if origin and not has_chat:   # a guest: never the owner's Telegram, whatever the run does
            print('%s %s/%s: %s has no app chat with %s, so what this run sends is dropped'
                  % (now.isoformat(timespec='minutes'), agent, job['id'], person, agent))
        box = run_outbox(agent, job, person)
        if box:
            env['KITH_RUN_OUTBOX'] = env['HQ_RUN_OUTBOX'] = str(box)
    if job.get('model'): env['KITH_MODEL'] = job['model']
    if job.get('effort'): env['KITH_EFFORT'] = job['effort']
    if job.get('harness'): env['KITH_HARNESS'] = job['harness']
    return [str(KITH / 'bin/kith'), agent, task], env, log


def log_header(now, agent, job, why):
    return '# %s %s %s (%s)\n' % (now.isoformat(timespec='minutes'), agent, job['id'], why)


def _start(agent, job, now, why):
    built = run_env(agent, job, now, why)
    if not built:
        return None
    argv, env, log = built
    key = '%s/%s' % (agent, job['id'])
    s = machine()
    s.setdefault('last', {})[key] = {'at': now.isoformat(timespec='minutes'), 'why': why, 'log': str(log)}
    save_machine(s)   # recorded before the run exists
    try:
        with open(log, 'w') as fh:
            fh.write(log_header(now, agent, job, why)); fh.flush()
            p = subprocess.Popen(argv, cwd=str(Path.home()), env=env, stdin=subprocess.DEVNULL,
                                 stdout=fh, stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as e:
        # The record is saved and no process exists: say so in it, or ls and log would show a run that never was as done.
        s = machine()
        s.setdefault('last', {}).setdefault(key, {})['error'] = 'not started: %s' % e
        save_machine(s)
        print('%s %s/%s not started: %s' % (now.isoformat(timespec='minutes'), agent, job['id'], e))
        return None
    s = machine()
    s.setdefault('last', {})[key].update({'pid': p.pid, 'procStart': kith_procstart.start_stamp(p.pid)})
    save_machine(s)
    return log


# --- run-turn: the core's turn, run as kith-sched runs a job --------------------------------------------------------------

EXIT_BAD, EXIT_REFUSED, EXIT_GONE, EXIT_NOANSWER = 2, 3, 4, 5


def turn_job(job, spec):
    """The job as this turn runs it: the turn's prompt and the job's settings fixed when the core fired it (model, effort,
    harness and the job's own `person`, none when the job had none: the run is then the owner's, as `start` runs it), the rest
    (id, cron for the task text) from the job. A turn with no `settings` (fired before they were kept) takes the job's current
    ones. The turn's own person (who the claim is swept by) is the host's business, not the run's environment."""
    out = dict(job, task=spec['prompt'])
    out.setdefault('cron', '')
    settings = spec.get('settings')
    if isinstance(settings, dict):
        for k in ('model', 'effort', 'harness', 'person'):
            out.pop(k, None)
            if settings.get(k):
                out[k] = settings[k]
    return out


def attach(claim, pid):
    """Records this process on the turn's claim (check-and-set: claimed, no process yet). Exits without running when the core
    refuses or does not answer."""
    import kith_claims
    try:
        ans = kith_claims.call('claim.attach', {'claimId': claim, 'pid': pid, 'started': kith_procstart.start_stamp(pid)})
    except kith_claims.Refused as e:
        _quit(EXIT_NOANSWER, 'the core refused claim %s: %s' % (claim, e))
    except kith_claims.NoAnswer as e:
        _quit(EXIT_NOANSWER, 'the core did not answer for claim %s: %s' % (claim, e.why))
    if not ans.get('attached'):
        _quit(EXIT_GONE, 'claim %s is gone (%s); nothing ran' % (claim, ans.get('state') or ans.get('refused')))


def _quit(code, msg):
    print('kith-sched: run-turn: %s' % msg, file=sys.stderr)
    sys.exit(code)


def run_turn(agent, jid, claim, spec):
    """Runs the core's turn of job `jid`: builds the run as `start` does, attaches this process to the claim, then execs kith.
    Never returns. No state.json, no tick.lock: the schedules are the core's by now."""
    job = next((j for j in load(agent) if j.get('id') == jid), None)
    if job is None:
        _quit(EXIT_BAD, '%s has no job %r' % (agent, jid))
    if not isinstance(spec.get('prompt'), str) or not spec['prompt']:
        _quit(EXIT_BAD, 'the turn has no prompt')
    now = clock().replace(second=0, microsecond=0)
    why = 'core turn %s' % spec.get('turn', '?')
    run = turn_job(job, spec)
    # The claim is swept by the turn's person: a run as another one (the job's person changed since the turn was fired, and the
    # turn has no settings) would be missed by that person's revoke. Owner is no person, whatever the core calls it.
    def who(p):
        return '' if p in (None, '', 'owner') else p
    if 'person' in spec and who(run.get('person')) != who(spec['person']):
        _quit(EXIT_REFUSED, 'the job runs as %r, not as the turn'"'"'s person %r' % (run.get('person'), spec['person']))
    built = run_env(agent, run, now, why)
    if not built:
        _quit(EXIT_REFUSED, 'the job may not run now (see the line above)')
    argv, env, log = built
    try:
        # Not truncated yet: a second run-turn for this turn (a host restart in the same minute) opens the same file, and the
        # one that loses the attach must leave the winner's log as it is.
        fd = os.open(log, os.O_WRONLY | os.O_CREAT, 0o644)
    except OSError as e:
        _quit(EXIT_BAD, "can't open the log %s: %s" % (log, e))
    try:
        attach(claim, os.getpid())
    except SystemExit:
        box = env.get('KITH_RUN_OUTBOX')   # made for a run that will not happen
        if box:
            shutil.rmtree(box, ignore_errors=True)
            Path(box + '.json').unlink(missing_ok=True)
        raise
    try:
        os.ftruncate(fd, 0)
        os.write(fd, log_header(now, agent, job, why).encode())
    except OSError as e:
        _quit(EXIT_BAD, "can't write the log %s: %s" % (log, e))
    devnull = os.open(os.devnull, os.O_RDONLY)
    os.dup2(devnull, 0); os.dup2(fd, 1); os.dup2(fd, 2)
    os.chdir(str(Path.home()))
    os.execve(argv[0], argv, env)


def running(pid):
    try:
        os.kill(pid, 0); return True
    except (OSError, TypeError):
        return False


def still_running(prev, now):
    """A recorded run still counts as running: its pid is alive, under 6 h old and, when the record has a procStart (older
    ones have none), that process started when it says (a reused pid is not our run)."""
    if not running(prev.get('pid')) or prev.get('at', '') < (now - dt.timedelta(hours=6)).isoformat():
        return False
    return kith_procstart.same_process(prev.get('procStart'), kith_procstart.start_stamp(prev['pid']))


# --- pruning ----------------------------------------------------------------------------------------------------------

def prune_runs(runs_dir, busy=(), now=None, keep=KEEP_RUNS, days=KEEP_RUN_DAYS):
    """Delete run logs beyond a job's newest `keep` that are also older than `days`. `busy` paths are never touched."""
    now = now or time.time()
    by_job = {}
    for f in Path(runs_dir).glob('*/*.log'):
        m = re.fullmatch(r'(.+)-\d{8}-\d{4}\.log', f.name)
        if m: by_job.setdefault((f.parent.name, m.group(1)), []).append(f)
    gone = 0
    for files in by_job.values():
        files.sort(key=lambda f: f.name)   # the name carries the start time; mtime can be bumped by a late write
        for f in files[:-keep]:
            try:
                if str(f) in busy or now - f.stat().st_mtime < days * 86400:
                    continue   # a skewed clock only ever keeps more: age is measured, never assumed
                f.unlink(); gone += 1
            except OSError:
                pass   # already gone (another tick) or not ours to remove
    return gone


def rotate_log(log, limit=AUTH_LOG_MAX):
    """auth.log over `limit` → auth.log.1 (replacing the older copy). Appenders that opened the old file finish into
    .1; the next append creates a fresh file. Returns True when it rotated."""
    try:
        if Path(log).stat().st_size <= limit:
            return False
        os.replace(log, str(log) + '.1')
        return True
    except OSError:
        return False


def prune_terminal(dirpath, now=None, days=TERMINAL_DAYS):
    """Remove live/terminal/*.json records older than `days` whose pid is not running (no pid: treated as gone). Each one
    under its sid's lock (contract A10, kith_registry.lock_at, the lock the hook's write and the core take): a lock not had
    within a second skips the file for the next prune, and the age and pid are read again under the lock, so a record
    written while this looked is never the one deleted. A name that is no session id has no writer to wait for."""
    now = now or time.time()
    gone = 0

    def stale(f):
        if now - f.stat().st_mtime < days * 86400:
            return False
        try:
            pid = json.loads(f.read_text()).get('pid')
        except (OSError, ValueError, AttributeError):
            pid = None
        return not running(pid)

    for f in Path(dirpath).glob('*.json'):
        try:
            if not stale(f):
                continue
            sid = f.name[:-len('.json')]
            if not kith_registry.safe_id(sid):
                f.unlink(); gone += 1
                continue
            with kith_registry.lock_at(dirpath, sid) as held:
                if held and stale(f):
                    f.unlink(); gone += 1
        except OSError:
            pass
    return gone


def prune_registry(state, now=None):
    """The session registry's housekeeping, in $KITH_STATE/live/terminal (where kith-sessions writes it and the host reads it).
    Once it is the core's (kith_registry.switched) nothing here: the core prunes its rows and their files. In Files mode a
    spool entry left by a Writer-mode hook (before a rollback) is put in place first when newer, then old records go."""
    if kith_registry.switched(state):
        return 0
    kith_registry.drain(state)
    return prune_terminal(kith_registry.reg_dir(state), now)


def prune(force=False):
    """Hourly housekeeping from the tick: run logs, auth.log, terminal records. Deletes are idempotent.

    The schedules' tombstone stops the jobs, not this: once the core fires them, kith-sched runs no job (so no log of
    its own is busy) and keeps the hour in a stamp file of its own instead of state.json."""
    try:
        with tick_lock(wait=PRUNE_LOCK_WAIT):   # read and save of state.json under the lock, so a `run` by hand in between keeps its `last`
            _prune(force)
    except LockBusy:
        pass   # held (a step?): a later tick prunes


def _prune(force):
    t = epoch()
    try:
        s = machine()
    except kith_tombstone.Tombstoned:
        stamp = MACHINE / 'pruned.stamp'
        try:
            last = int(stamp.read_text().strip())
        except (OSError, ValueError):
            last = 0
        if not force and t - last < PRUNE_EVERY:
            return
        MACHINE.mkdir(parents=True, exist_ok=True)
        stamp.write_text(str(t))
        busy = set()
    else:
        if not force and t - s.get('pruned', 0) < PRUNE_EVERY:
            return
        s['pruned'] = t
        save_machine(s)
        busy = {v.get('log') for v in s.get('last', {}).values() if running(v.get('pid'))}
    prune_runs(LOGS / 'runs', busy, t)
    auth = Path(os.environ.get('KITH_AUTH') or paths()['KITH_SECRETS'] / 'auth.json').with_name('auth.log')
    rotate_log(auth)
    prune_registry(STATE, t)


def tick():
    try:
        prune()
    except Exception as e:   # housekeeping must never stop jobs from starting
        print('kith-sched: prune: %s' % e, file=sys.stderr)
    # The wake queue (kith-wake): owed turns of ended sessions start here once their writer lets go, and turns whose
    # deliverer died (a restart) are answered or owed again. First, a kith ask answer whose asker's session has ended
    # without reading it becomes such a turn (kith-ask --sweep).
    try:
        subprocess.run([sys.executable, str(KITH / 'bin/kith-ask'), '--sweep'], timeout=30, stdout=subprocess.DEVNULL)
    except Exception as e:  # noqa: BLE001
        print('kith-sched: ask sweep: %s' % e, file=sys.stderr)
    try:
        subprocess.run([sys.executable, str(KITH / 'bin/kith-wake'), 'drain'], timeout=30, stdout=subprocess.DEVNULL)
    except Exception as e:  # noqa: BLE001
        print('kith-sched: wake drain: %s' % e, file=sys.stderr)
    now = clock().replace(second=0, microsecond=0)
    try:
        with tick_lock():   # one exclusive lock over read, decide, record, save; prune, the sweep and the drain are outside
            _tick(now)
    except LockBusy as e:
        print('kith-sched: %s; nothing started this minute' % e, file=sys.stderr)


def _tick(now):
    s = machine()   # a tombstone stops here, before anything is read or started
    last = dt.datetime.fromisoformat(s['tick']) if s.get('tick') else now - dt.timedelta(minutes=1)
    since = max(last, now - CATCH_UP)
    try:
        if since < now:
            _fire_due(now, since)
    finally:
        s = machine()
        s['tick'] = now.isoformat(timespec='minutes')   # last: a run is recorded before it starts, the tick after
        save_machine(s)


def _fire_due(now, since):
    for agent, job in all_jobs():
        if job.get('paused'):
            continue
        try:
            c = parse(job['cron'])
        except (ValueError, KeyError) as e:
            print('kith-sched: %s/%s: %s' % (agent, job.get('id'), e), file=sys.stderr); continue
        due = next_time(c, since, now - since)
        if due is None or due > now:
            continue
        prev = machine().get('last', {}).get('%s/%s' % (agent, job['id']), {})
        if still_running(prev, now):
            print('kith-sched: %s/%s still running (pid %s), skipped' % (agent, job['id'], prev['pid']), file=sys.stderr)
            continue
        if prev.get('at', '') >= due.isoformat(timespec='minutes') and str(prev.get('why', '')).startswith('due'):
            continue   # this slot was started already, pid or not (killed before the tick was saved): never run twice
        why = 'due %s' % due.strftime('%H:%M') + ('' if due == now else ', caught up after sleep')
        log = start(agent, job, now, why)
        if log:
            print('%s started %s/%s → %s' % (now.isoformat(timespec='minutes'), agent, job['id'], log))


# --- launchd ----------------------------------------------------------------------------------------------------------

def install():
    LOGS.mkdir(parents=True, exist_ok=True)
    me = stable_kernel() / 'bin/kith-sched'   # cli/current: an update moves the link, the plist stays
    argv = [str(LAUNCHER), 'run', '--quiet', '--script', str(me), 'tick'] if LAUNCHER.exists() else [str(me), 'tick']
    PLIST.write_bytes(plistlib.dumps({
        'Label': LABEL, 'ProgramArguments': argv, 'StartInterval': 60, 'RunAtLoad': True,
        'ProcessType': 'Background', 'WorkingDirectory': str(Path.home()),
        'EnvironmentVariables': {'HOME': str(Path.home()), 'KITH_HOME': str(paths()['KITH_HOME']),
                                 'PATH': os.environ.get('PATH', '/usr/bin:/bin')},
        'StandardOutPath': str(LOGS / 'tick.log'), 'StandardErrorPath': str(LOGS / 'tick.log')}))
    retire_old_job('sched')
    kith_launchd.reload_or_exit(LABEL, PLIST)
    print('installed %s: ticks every minute; log %s' % (PLIST, LOGS / 'tick.log'))


def uninstall():
    retire_old_job('sched')
    subprocess.run(['launchctl', 'bootout', 'gui/%d/%s' % (os.getuid(), LABEL)], capture_output=True)
    PLIST.unlink(missing_ok=True)
    print('removed %s' % LABEL)


# --- commands ---------------------------------------------------------------------------------------------------------

def need_agent(a):
    if a not in agents():
        sys.exit('kith-sched: no agent %r (have: %s)' % (a, ' '.join(agents())))


def find(agent, jid, jobs=None):
    jobs = load(agent) if jobs is None else jobs
    for j in jobs:
        if j['id'] == jid:
            return j
    sys.exit('kith-sched: %s has no job %r (have: %s)' % (agent, jid, ' '.join(j['id'] for j in jobs) or 'none'))


def ls(only=None):
    now, last = clock(), machine().get('last', {})
    rows = [(a, j) for a, j in all_jobs() if only in (None, a)]
    if not rows:
        print('no jobs%s. Add one: kith schedule add <agent> "0 8 * * *" "the task"' % (' for ' + only if only else ''))
    for a, j in rows:
        try:
            n = 'paused' if j.get('paused') else (next_time(parse(j['cron']), now) or 'never').strftime('%a %d %b %H:%M')
        except (ValueError, AttributeError) as e:
            n = 'bad cron: %s' % e
        l = last.get('%s/%s' % (a, j['id']), {})
        print('%-10s %-18s %-16s next %-18s last %s' % (a, j['id'], j['cron'], n, l.get('at', '-')))
        print('%-10s %s%s' % ('', j['task'][:100].replace('\n', ' '), '  (for %s)' % j['person'] if j.get('person') else ''))
    if rows and not job_installed('sched'):
        print('\nnot ticking: run `kith schedule --install` so launchd starts due jobs')


def log(agent=None, jid=None):
    for k, v in sorted(machine().get('last', {}).items(), key=lambda kv: kv[1]['at']):
        a, j = k.split('/', 1)
        if agent in (None, a) and jid in (None, j):
            state = 'failed' if v.get('error') else 'running' if still_running(v, clock()) else 'done'
            print('%s  %-24s %-7s %s' % (v['at'], k, state, v['log'].replace(str(Path.home()), '~', 1)))
    if agent and jid:
        runs = sorted((LOGS / 'runs' / agent).glob(jid + '-*.log'))
        if runs:
            print('\n' + runs[-1].read_text()[-3000:])


# --- --json -----------------------------------------------------------------------------------------------------------

def job_row(agent, j, last, now):
    """One job for a client: the stored fields (older files may lack some), when it runs next, how it last went."""
    row = {'agent': agent, 'id': j['id'], 'cron': j.get('cron'), 'task': j.get('task'), 'paused': bool(j.get('paused'))}
    for k in ('person', 'model', 'effort', 'harness'):
        if j.get(k): row[k] = j[k]
    nxt = None
    try:
        if not row['paused']:
            n = next_time(parse(j['cron']), now)
            nxt = n.isoformat(timespec='minutes') if n else None
    except (ValueError, AttributeError, KeyError, TypeError) as e:
        row['error'] = 'bad cron: %s' % e
    row['next'] = nxt
    l = last.get('%s/%s' % (agent, j['id']))
    row['last'] = {'at': l.get('at'), 'why': l.get('why'), 'pid': l.get('pid'), 'log': l.get('log'),
                   'running': still_running(l, now)} if l else None
    if row['last'] and l.get('error'):
        row['last']['error'] = l['error']
    return row


def json_cmd(cmd, rest):
    """The --json twin of a verb: returns the object to print. Failures arrive as SystemExit(message)."""
    now = clock()
    if cmd == 'ls':
        if rest: need_agent(rest[0])
        last = machine().get('last', {})
        return {'jobs': [job_row(a, j, last, now) for a, j in all_jobs() if not rest or a == rest[0]],
                'ticking': bool(job_installed('sched'))}
    if cmd == 'log':
        agent, jid = (rest[0].split('/', 1) + [None])[:2] if rest and '/' in rest[0] else ((rest + [None, None])[:2])
        n = None
        if '/' in (rest[0] if rest else ''):
            n = rest[1] if len(rest) > 1 else None
        elif len(rest) > 2:
            n = rest[2]
        if n is not None and (not n.isdigit() or int(n) < 1):
            sys.exit('kith-sched: n must be a positive number')
        if agent: need_agent(agent)
        runs = []
        for k, v in sorted(machine().get('last', {}).items(), key=lambda kv: kv[1].get('at', '')):
            a, j = k.split('/', 1)
            if agent in (None, a) and jid in (None, j):
                runs.append({'agent': a, 'id': j, 'at': v.get('at'), 'why': v.get('why'), 'pid': v.get('pid'),
                             'log': v.get('log'), 'running': still_running(v, now)})
                if v.get('error'): runs[-1]['error'] = v['error']
        if n: runs = runs[-int(n):]
        return {'agent': agent, 'id': jid, 'runs': runs}
    if cmd == 'add':
        opts, pos, i = {}, [], 0
        while i < len(rest):
            if rest[i] in ('--id', '-m', '--model', '-e', '--effort', '-H', '--harness'):
                if i + 1 >= len(rest): sys.exit('kith-sched: %s needs a value' % rest[i])
                opts[{'--id': 'id', '-H': 'H', '--harness': 'H'}.get(rest[i], rest[i].lstrip('-')[0])] = rest[i + 1]; i += 2
            else:
                pos.append(rest[i]); i += 1
        if len(pos) != 3:
            sys.exit('usage: kith-sched add AGENT "CRON" "task" [--id ID] [-m MODEL] [-e EFFORT] [-H HARNESS]')
        agent, cron, task = pos
        need_agent(agent)
        try:
            nxt = next_time(parse(cron), now)
        except ValueError as e:
            sys.exit('kith-sched: %s' % e)
        if opts.get('e') and opts['e'] not in EFFORTS:
            sys.exit('kith-sched: effort must be one of %s' % ', '.join(EFFORTS))
        job = {'id': opts.get('id') or slug(task), 'cron': cron, 'task': task}
        if os.environ.get('KITH_PERSON'): job['person'] = os.environ['KITH_PERSON']
        if opts.get('m'): job['model'] = opts['m']
        if opts.get('e'): job['effort'] = opts['e']
        if opts.get('H'): job['harness'] = opts['H']
        with editing(agent) as jobs:
            had = any(j['id'] == job['id'] for j in jobs)
            jobs[:] = [j for j in jobs if j['id'] != job['id']] + [job]
        tell_app(agent, job['id'], 'updated' if had else 'added')
        return {'ok': True, 'replaced': had, 'job': job_row(agent, job, machine().get('last', {}), now)}
    if cmd in ('rm', 'pause', 'resume', 'run') and len(rest) == 2:
        agent, jid = rest
        need_agent(agent)
        if cmd == 'run':
            buf = io.StringIO()
            job = find(agent, jid)
            caller = os.environ.get('KITH_PERSON')
            if job.get('person') and caller:
                try:
                    me, them = resolve(agent, caller), resolve(agent, job['person'])
                except (OSError, ValueError, subprocess.SubprocessError) as e:
                    sys.exit("kith-sched: can't check %s with kith-auth (%s)" % (caller, e))
                if not me.get('owner') and me.get('person') != them.get('person'):
                    sys.exit('kith-sched: %s/%s runs for %s; only they or the owner can start it by hand'
                             % (agent, jid, job['person']))
            with contextlib.redirect_stdout(buf):
                lg = start(agent, job, now.replace(second=0, microsecond=0), 'run by hand')
            if not lg:
                sys.exit('kith-sched: ' + (buf.getvalue().strip() or 'not started'))
            l = machine().get('last', {}).get('%s/%s' % (agent, jid), {})
            return {'ok': True, 'agent': agent, 'id': jid, 'pid': l.get('pid'), 'log': str(lg)}
        with editing(agent) as jobs:
            job = find(agent, jid, jobs)
            was = bool(job.get('paused'))
            if cmd == 'rm':
                jobs.remove(job); changed = True
            else:
                job.pop('paused', None)
                if cmd == 'pause': job['paused'] = True
                changed = (not was) if cmd == 'pause' else was
        tell_app(agent, jid, {'rm': 'removed', 'pause': 'paused', 'resume': 'resumed'}[cmd])
        return {'ok': True, 'agent': agent, 'id': jid, 'changed': changed}
    sys.exit('kith-sched: --json: usage: kith-sched ls|add|rm|pause|resume|run|log ... --json')


def main_json(argv):
    out, err, code = {'ok': False}, io.StringIO(), 0
    cmd = argv[0] if argv else ''
    try:
        with contextlib.redirect_stderr(err):
            out = json_cmd(cmd, argv[1:])
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 1
        msg = e.code if isinstance(e.code, str) else 'failed'
        out = {'ok': False, 'error': re.sub(r'^kith-sched: ', '', msg)}
    except Exception as e:   # a client reads JSON whatever happens
        code, out = 1, {'ok': False, 'error': str(e)}
    print(json.dumps(out, ensure_ascii=False))
    sys.exit(code)


def main_run_turn(rest):
    """`run-turn AGENT JOB --turn N --claim C` with the turn's JSON on stdin (see the module doc)."""
    pos, opts, i = [], {}, 0
    while i < len(rest):
        if rest[i] in ('--turn', '--claim') and i + 1 < len(rest) and rest[i + 1].isdigit():
            opts[rest[i][2:]] = int(rest[i + 1]); i += 2
        else:
            pos.append(rest[i]); i += 1
    if len(pos) != 2 or 'claim' not in opts:
        _quit(EXIT_BAD, 'usage: kith-sched run-turn AGENT JOB --turn N --claim C   (the turn as JSON on stdin)')
    try:
        spec = json.loads(sys.stdin.read())
        if not isinstance(spec, dict):
            raise ValueError('not an object')
    except ValueError as e:
        _quit(EXIT_BAD, 'stdin is not the turn as JSON: %s' % e)
    spec['turn'] = opts.get('turn')
    run_turn(pos[0], pos[1], opts['claim'], spec)


def main(argv):
    if '--json' in argv and argv[:1] != ['tick']:
        return main_json([a for a in argv if a != '--json'])
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return
    cmd, rest = argv[0], argv[1:]
    if cmd == 'tick': return tick()
    if cmd == 'run-turn': return main_run_turn(rest)
    if cmd == 'prune': return prune(force=True)
    if cmd == '--install': return install()
    if cmd == '--uninstall': return uninstall()
    if cmd == 'ls': return ls(rest[0] if rest else None)
    if cmd == 'log': return log(*rest[:2])
    if cmd == 'add':
        opts, pos, i = {}, [], 0
        while i < len(rest):
            if rest[i] in ('--id', '-m', '--model', '-e', '--effort', '-H', '--harness'):
                opts[{'--id': 'id', '-H': 'H', '--harness': 'H'}.get(rest[i], rest[i].lstrip('-')[0])] = rest[i + 1]; i += 2
            else:
                pos.append(rest[i]); i += 1
        if len(pos) != 3:
            sys.exit('usage: kith-sched add AGENT "CRON" "task" [--id ID] [-m MODEL] [-e EFFORT] [-H HARNESS]')
        agent, cron, task = pos
        need_agent(agent)
        try:
            nxt = next_time(parse(cron), clock())
        except ValueError as e:
            sys.exit('kith-sched: %s' % e)
        if opts.get('e') and opts['e'] not in EFFORTS:
            sys.exit('kith-sched: effort must be one of %s' % ', '.join(EFFORTS))
        job = {'id': opts.get('id') or slug(task), 'cron': cron, 'task': task}
        if os.environ.get('KITH_PERSON'):   # the person whose run adds it; it runs as them (start)
            job['person'] = os.environ['KITH_PERSON']
        if opts.get('m'): job['model'] = opts['m']
        if opts.get('e'): job['effort'] = opts['e']
        if opts.get('H'): job['harness'] = opts['H']
        with editing(agent) as jobs:
            had = any(j['id'] == job['id'] for j in jobs)
            jobs[:] = [j for j in jobs if j['id'] != job['id']] + [job]
        tell_app(agent, job['id'], 'updated' if had else 'added')
        print('%s/%s: next run %s' % (agent, job['id'], nxt.strftime('%a %d %b %H:%M') if nxt else 'never'))
        if not job_installed('sched'):
            print('not ticking yet: run `kith schedule --install` once')
        return
    if cmd in ('rm', 'pause', 'resume', 'run') and len(rest) == 2:
        agent, jid = rest
        if cmd == 'run':
            job = find(agent, jid)
            caller = os.environ.get('KITH_PERSON')
            if job.get('person') and caller:   # by hand, never as someone else (the owner may)
                try:
                    me, them = resolve(agent, caller), resolve(agent, job['person'])
                except (OSError, ValueError, subprocess.SubprocessError) as e:
                    sys.exit("kith-sched: can't check %s with kith-auth (%s)" % (caller, e))
                if not me.get('owner') and me.get('person') != them.get('person'):
                    sys.exit('kith-sched: %s/%s runs for %s; only they or the owner can start it by hand'
                             % (agent, jid, job['person']))
            log = start(agent, job, clock().replace(second=0, microsecond=0), 'run by hand')
            if not log:
                sys.exit(1)
            print('started → %s' % log)
            return
        with editing(agent) as jobs:
            job = find(agent, jid, jobs)
            if cmd == 'rm':
                jobs.remove(job)
            else:
                job.pop('paused', None)
                if cmd == 'pause': job['paused'] = True
        done = {'rm': 'removed', 'pause': 'paused', 'resume': 'resumed'}[cmd]
        tell_app(agent, jid, done)
        print('%s/%s %s' % (agent, jid, done))
        return
    sys.exit('kith-sched: unknown command; see kith-sched --help')


if __name__ == '__main__':
    try:
        if kith_sched_core.takes(sys.argv[1:], paths()['KITH_MACHINE']):   # switched: the core answers, in the same words
            sys.exit(kith_sched_core.main(sys.argv[1:], tell_app))
        main(sys.argv[1:])
    except kith_tombstone.Tombstoned as e:   # the schedule state moved to the core (kith migrate step schedules)
        if sys.argv[1:] == ['tick']:
            # launchd runs this every minute: after the switch it fires nothing (the core does), and a non-zero exit
            # would show the job as broken forever. One quiet line, exit 0; every other verb still fails closed.
            print('kith-sched: tick skipped, the schedules moved to the Kith core (%s)' % e.module)
            sys.exit(0)
        sys.exit('kith-sched: %s' % e)
    except LockBusy as e:   # `run` by hand while a cutover step holds the lock
        sys.exit('kith-sched: %s; try again in a minute' % e)
