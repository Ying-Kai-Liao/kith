#!/usr/bin/env python3
"""kith-sched — run agent tasks on a schedule.

  kith-sched ls [AGENT]                                  every job, when it runs next and how it last went
  kith-sched add AGENT "CRON" "task" [--id ID] [-m MODEL] [-e EFFORT] [-H HARNESS]   add a job (or replace the one with that id)
  kith-sched rm AGENT ID                                 remove a job
  kith-sched pause|resume AGENT ID                       keep a job but stop or restart it
  kith-sched run AGENT ID                                run a job now, in the background
  kith-sched log [AGENT [ID]]                            the last runs, with the path of each run's output
  kith-sched prune                                       trim old run logs, rotate auth.log, drop dead terminal records (tick does it hourly)
  kith-sched tick                                        (launchd, every minute) start the jobs that are due
  kith-sched --install | --uninstall                     the LaunchAgent dev.kith.sched that ticks

A job is a one-shot `kith AGENT "task"`, the same run as from your terminal: pinned package, memory, the agent's own
tools, tagged in the cost ledger with via=schedule. The task is told it was scheduled and to deliver with kith-send,
which goes to your Telegram and, through the run's outbox, to the person's chat with the agent in the Kith app. Jobs
live with the agent's life, <kith>/agents/AGENT/jobs.json, so they are versioned with your memory and never shared
with the package.

A job runs as the person whose run added it (KITH_PERSON then; none = the owner), with their limits, checked against
kith-auth each time it is due: once they are revoked or no longer a member, or while this Mac is out of sync with the
Kith cloud, the job is skipped with a line in tick.log. Only they or the owner can `run` it by hand; anyone else's
`run` of an owner's job runs as them.

CRON is five fields, minute hour day-of-month month day-of-week (0 or 7 = Sunday), each *, a number, a range a-b,
a list a,b and a step */n or a-b/n; or @hourly, @daily, @weekly, @monthly. Times are this Mac's local time. When the
Mac slept through a due time, the job runs once on the next tick (if the miss was under a day), not once per miss.

Runs start with `--permission-mode` from KITH_SCHED_PERMISSION_MODE when set, else in the agent's settings.json
defaultMode, else in kith's default (auto; ~/.kith/settings.json changes it): no one is there to approve a tool call, so
one that would need it is refused. The agent's settings.json allow/deny rules still apply.
Machine state (last tick, last runs): ~/.kith/sched/. Logs (tick.log, each run's output): ~/.kith/logs/sched/.
"""
import contextlib, datetime as dt, fcntl, json, os, plistlib, re, subprocess, sys, time
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import kith_launchd  # noqa: E402
from kith_paths import paths, launcher, job_installed, retire_old_job  # noqa: E402  the one place that knows where kith's folders are
STATE = paths()['KITH_STATE']
MACHINE = paths()['KITH_MACHINE'] / 'sched'  # last tick, last run per job
LOGS = paths()['KITH_LOGS'] / 'sched'  # tick.log, one log per run
LABEL = 'dev.kith.sched'
PLIST = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
LAUNCHER = launcher()  # uv with Full Disk Access, for a repo on an external disk
EFFORTS = ('low', 'medium', 'high', 'xhigh', 'max')
MACROS = {'@hourly': '0 * * * *', '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
          '@weekly': '0 0 * * 0', '@monthly': '0 0 1 * *'}
CATCH_UP = dt.timedelta(days=1)
# Pruning (reversible choices). Run logs: keep a job's newest KEEP_RUNS, or anything newer than KEEP_RUN_DAYS, whichever
# keeps more. auth.log is an audit log: rotated past AUTH_LOG_MAX bytes (one .1 copy), never truncated. A terminal
# session record is dropped after TERMINAL_DAYS once its process is gone.
KEEP_RUNS, KEEP_RUN_DAYS = 50, 30
AUTH_LOG_MAX = 5 * 1024 * 1024
TERMINAL_DAYS = 7
PRUNE_EVERY = 3600   # seconds between prunes: the tick runs every minute, the files grow slowly


# --- cron -------------------------------------------------------------------------------------------------------------

def field(spec, lo, hi):
    """One cron field → the set of values it allows."""
    out = set()
    for part in spec.split(','):
        m = re.fullmatch(r'(\*|\d+(?:-\d+)?)(?:/(\d+))?', part)
        if not m:
            raise ValueError('bad cron field %r' % spec)
        rng, step = m.group(1), int(m.group(2) or 1)
        a, b = (lo, hi) if rng == '*' else (map(int, rng.split('-')) if '-' in rng else (int(rng), int(rng)))
        if m.group(2) and '-' not in rng and rng != '*':
            b = hi  # "5/15" = from 5 to the end, every 15
        if not (lo <= a <= hi and lo <= b <= hi) or step < 1:
            raise ValueError('cron field %r out of range %d-%d' % (spec, lo, hi))
        out.update(range(a, b + 1, step))
    return out


def parse(cron):
    """'m h dom mon dow' → (minutes, hours, days, months, weekdays, dom restricted, dow restricted)."""
    f = MACROS.get(cron.strip(), cron).split()
    if len(f) != 5:
        raise ValueError('cron needs 5 fields (minute hour day month weekday), got %r' % cron)
    dow = {d % 7 for d in field(f[4], 0, 7)}
    return (field(f[0], 0, 59), field(f[1], 0, 23), field(f[2], 1, 31), field(f[3], 1, 12), dow,
            f[2] != '*', f[4] != '*')


def matches(c, t):
    mins, hours, days, months, dow, dom_set, dow_set = c
    if t.minute not in mins or t.hour not in hours or t.month not in months:
        return False
    d, w = t.day in days, (t.weekday() + 1) % 7 in dow
    return (d or w) if dom_set and dow_set else (d and w)  # cron: both restricted = either may match


def next_time(c, after, limit=dt.timedelta(days=366)):
    t = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
    end = after + limit
    while t <= end:
        if t.month not in c[3]:
            t = (t.replace(day=1, hour=0, minute=0) + dt.timedelta(days=32)).replace(day=1); continue
        if t.hour not in c[1]:
            t = t.replace(minute=0) + dt.timedelta(hours=1); continue
        if matches(c, t):
            return t
        t += dt.timedelta(minutes=1)
    return None


# --- jobs -------------------------------------------------------------------------------------------------------------

def agents():
    pkgs = paths()['KITH_AGENTS']
    return sorted(p.name for p in pkgs.iterdir() if (p / 'agent.md').is_file() or (p / 'role' / 'agent.md').is_file()) \
        if pkgs.is_dir() else []


def jobs_file(agent):
    pkgs = paths()['KITH_AGENTS']
    return (pkgs / agent if (pkgs / agent / 'role').is_dir() else STATE / 'agents' / agent) / 'jobs.json'


def read_jobs(f):
    """The jobs in f ([] when there is no file); raises ValueError when the file can't be read as a list of jobs."""
    if not f.exists():
        return []
    jobs = json.loads(f.read_text())
    if not isinstance(jobs, list) or not all(isinstance(j, dict) and 'id' in j for j in jobs):
        raise ValueError('not a list of jobs')
    return jobs


def load(agent):
    """For readers (tick, ls): a file that can't be read counts as no jobs, with a line on stderr."""
    f = jobs_file(agent)
    try:
        return read_jobs(f)
    except (OSError, ValueError) as e:
        print('kith-sched: %s: %s (skipped)' % (f, e), file=sys.stderr); return []


@contextlib.contextmanager
def editing(agent):
    """The one way to change an agent's jobs: yields its jobs under an exclusive lock, then replaces jobs.json whole
    with the list as the block left it. A file that can't be read is refused, never overwritten as if it were empty."""
    f = jobs_file(agent)
    f.parent.mkdir(parents=True, exist_ok=True)
    MACHINE.mkdir(parents=True, exist_ok=True)
    with open(MACHINE / ('%s.jobs.lock' % agent), 'a') as lock:   # flock goes with the process: a crash frees it
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            jobs = read_jobs(f)
        except (OSError, ValueError) as e:
            sys.exit("kith-sched: can't read %s (%s); fix or remove it first, nothing was changed" % (f, e))
        yield jobs
        tmp = f.with_name('.%s.%d.tmp' % (f.name, os.getpid()))
        with open(tmp, 'w') as out:
            out.write(json.dumps(jobs, indent=2, ensure_ascii=False) + '\n')
            out.flush(); os.fsync(out.fileno())
        os.replace(tmp, f)


def all_jobs():
    for a in agents():
        for j in load(a):
            yield a, j


def machine():
    try:
        return json.loads((MACHINE / 'state.json').read_text())
    except (OSError, ValueError):
        return {}


def save_machine(s):
    MACHINE.mkdir(parents=True, exist_ok=True)
    tmp = MACHINE / 'state.json.tmp'
    tmp.write_text(json.dumps(s, indent=1))
    tmp.replace(MACHINE / 'state.json')


def slug(text):
    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')[:24] or 'job'


# --- running ----------------------------------------------------------------------------------------------------------

def resolve(agent, person):
    """kith-auth's answer for a run of agent for person ({allowed, why, owner, person, held, ...}); raises when it
    can't answer."""
    return json.loads(subprocess.run([str(KITH / 'bin/kith-auth'), 'resolve', agent, '--person', person],
                                     capture_output=True, text=True, timeout=30, check=True).stdout)


def refused(agent, job):
    """Why the job must not run now, or None. A job runs as the person whose run added it, checked at fire time: a
    revoke, a removed membership or a Mac out of sync with the Kith cloud (R8, as the bridge) stops it. Fails closed."""
    if not job.get('person'):
        return None
    try:
        r = resolve(agent, job['person'])
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        return "can't check %s with kith-auth (%s)" % (job['person'], e)
    if not r.get('allowed'):
        return r.get('why') or 'not allowed'
    if r.get('held'):
        return 'this Mac is out of sync with the Kith cloud'
    return None


def run_outbox(agent, job, person):
    """The run's outbox, <machine>/outbox/<run>/: kith-send leaves its messages there and kith serve posts them into
    the person's chat with the agent, whenever it next runs. Who the run is for is in <run>.json beside it, out of the
    run's reach (a guest's sandbox may write the folder only). None when it can't be made (a run inside a sandbox)."""
    root = paths()['KITH_MACHINE'] / 'outbox'
    run = re.sub(r'[^A-Za-z0-9._-]', '_', 'sched-%s-%s-%d' % (agent, job['id'], time.time_ns()))
    try:
        (root / run).mkdir(parents=True)
        meta = root / (run + '.json')
        with open(str(meta) + '.tmp', 'w') as f:
            json.dump({'agent': agent, 'person': person, 'via': 'schedule', 'job': job['id'], 'at': time.time()}, f)
        os.replace(str(meta) + '.tmp', meta)
    except OSError:
        return None
    return root / run


def start(agent, job, now, why):
    """Start `kith AGENT task` detached; its output goes to a log file. Returns the log path, or None when the job's
    person may not run it now (said on stdout, the tick log)."""
    no = refused(agent, job)
    if no:
        print('%s skipped %s/%s: it runs for %s, and %s' % (now.isoformat(timespec='minutes'), agent, job['id'],
                                                           job['person'], no))
        return None
    out = LOGS / 'runs' / agent
    out.mkdir(parents=True, exist_ok=True)
    log = out / ('%s-%s.log' % (job['id'], now.strftime('%Y%m%d-%H%M')))
    task = ('%s\n\n(Scheduled job "%s" of %s, cron `%s`, %s. No one is watching this session: finish the task and '
            'deliver the result with %s/bin/kith-send. If there is nothing worth sending, send nothing.)'
            % (job['task'], job['id'], agent, job['cron'], why, KITH))
    env = dict(os.environ, KITH_VIA='schedule', KITH_SCHED_JOB=job['id'],
               KITH_LAUNCH_KIND='schedule', KITH_LAUNCH_LABEL=job['id'])   # a card in the agent's room (bin/kith-sessions)
    if os.environ.get('KITH_SCHED_PERMISSION_MODE'):   # unset: the agent's mode, else kith's default (bin/kith)
        env['KITH_PERMISSION_MODE'] = os.environ['KITH_SCHED_PERMISSION_MODE']
    for k in ('KITH_AGENT', 'KITH_MODEL', 'KITH_EFFORT', 'KITH_HARNESS', 'KITH_DISCORD_WEBHOOK_URL', 'KITH_DISCORD_THREAD_ID',
              'KITH_BRIDGE_OUTBOX', 'KITH_RUN_OUTBOX'):   # and the HQ_ twins that sync_env made
        env.pop('HQ_' + k[5:], None)
        env.pop(k, None)
    if job.get('person'):   # none: whoever started this (launchd's tick: the owner; a run by hand: that run's person)
        env['KITH_PERSON'] = env['HQ_PERSON'] = job['person']
    box = run_outbox(agent, job, env.get('KITH_PERSON') or None)
    if box:
        env['KITH_RUN_OUTBOX'] = env['HQ_RUN_OUTBOX'] = str(box)
    if job.get('model'): env['KITH_MODEL'] = job['model']
    if job.get('effort'): env['KITH_EFFORT'] = job['effort']
    if job.get('harness'): env['KITH_HARNESS'] = job['harness']
    with open(log, 'w') as fh:
        fh.write('# %s %s %s (%s)\n' % (now.isoformat(timespec='minutes'), agent, job['id'], why)); fh.flush()
        p = subprocess.Popen([str(KITH / 'bin/kith'), agent, task], cwd=str(Path.home()), env=env, stdin=subprocess.DEVNULL,
                             stdout=fh, stderr=subprocess.STDOUT, start_new_session=True)
    s = machine()
    s.setdefault('last', {})['%s/%s' % (agent, job['id'])] = {'at': now.isoformat(timespec='minutes'),
                                                              'pid': p.pid, 'log': str(log), 'why': why}
    save_machine(s)
    return log


def running(pid):
    try:
        os.kill(pid, 0); return True
    except (OSError, TypeError):
        return False


# --- pruning ----------------------------------------------------------------------------------------------------------

def prune_runs(runs_dir, busy=(), now=None, keep=KEEP_RUNS, days=KEEP_RUN_DAYS):
    """Delete run logs beyond a job's newest `keep` that are also older than `days`. `busy` paths are never touched."""
    now = now or time.time()
    by_job = {}
    for f in Path(runs_dir).glob('*/*.log'):
        m = re.fullmatch(r'(.+)-\d{8}-\d{4}\.log', f.name)
        if m: by_job.setdefault((f.parent.name, m.group(1)), []).append(f)
    gone = 0
    for files in by_job.values():
        files.sort(key=lambda f: f.name)   # the name carries the start time; mtime can be bumped by a late write
        for f in files[:-keep]:
            try:
                if str(f) in busy or now - f.stat().st_mtime < days * 86400:
                    continue   # a skewed clock only ever keeps more: age is measured, never assumed
                f.unlink(); gone += 1
            except OSError:
                pass   # already gone (another tick) or not ours to remove
    return gone


def rotate_log(log, limit=AUTH_LOG_MAX):
    """auth.log over `limit` → auth.log.1 (replacing the older copy). Appenders that opened the old file finish into
    .1; the next append creates a fresh file. Returns True when it rotated."""
    try:
        if Path(log).stat().st_size <= limit:
            return False
        os.replace(log, str(log) + '.1')
        return True
    except OSError:
        return False


def prune_terminal(dirpath, now=None, days=TERMINAL_DAYS):
    """Remove live/terminal/*.json records older than `days` whose pid is not running (no pid: treated as gone)."""
    now = now or time.time()
    gone = 0
    for f in Path(dirpath).glob('*.json'):
        try:
            if now - f.stat().st_mtime < days * 86400:
                continue
            try:
                pid = json.loads(f.read_text()).get('pid')
            except (OSError, ValueError, AttributeError):
                pid = None
            if running(pid):
                continue
            f.unlink(); gone += 1
        except OSError:
            pass
    return gone


def prune(force=False):
    """Hourly housekeeping from the tick: run logs, auth.log, terminal records. Deletes are idempotent."""
    s = machine()
    t = time.time()
    if not force and t - s.get('pruned', 0) < PRUNE_EVERY:
        return
    s['pruned'] = t
    save_machine(s)
    busy = {v.get('log') for v in s.get('last', {}).values() if running(v.get('pid'))}
    prune_runs(LOGS / 'runs', busy, t)
    auth = Path(os.environ.get('KITH_AUTH') or paths()['KITH_SECRETS'] / 'auth.json').with_name('auth.log')
    rotate_log(auth)
    prune_terminal(paths()['KITH_MACHINE'] / 'live' / 'terminal', t)


def tick():
    try:
        prune()
    except Exception as e:   # housekeeping must never stop jobs from starting
        print('kith-sched: prune: %s' % e, file=sys.stderr)
    # The wake queue (kith-wake): owed turns of ended sessions start here once their writer lets go, and turns whose
    # deliverer died (a restart) are answered or owed again.
    try:
        subprocess.run([sys.executable, str(KITH / 'bin/kith-wake'), 'drain'], timeout=30, stdout=subprocess.DEVNULL)
    except Exception as e:  # noqa: BLE001
        print('kith-sched: wake drain: %s' % e, file=sys.stderr)
    now = dt.datetime.now().replace(second=0, microsecond=0)
    s = machine()
    last = dt.datetime.fromisoformat(s['tick']) if s.get('tick') else now - dt.timedelta(minutes=1)
    since = max(last, now - CATCH_UP)
    s['tick'] = now.isoformat(timespec='minutes')
    save_machine(s)
    if since >= now:
        return
    for agent, job in all_jobs():
        if job.get('paused'):
            continue
        try:
            c = parse(job['cron'])
        except (ValueError, KeyError) as e:
            print('kith-sched: %s/%s: %s' % (agent, job.get('id'), e), file=sys.stderr); continue
        due = next_time(c, since, now - since)
        if due is None or due > now:
            continue
        prev = machine().get('last', {}).get('%s/%s' % (agent, job['id']), {})
        if running(prev.get('pid')) and prev.get('at', '') >= (now - dt.timedelta(hours=6)).isoformat():
            print('kith-sched: %s/%s still running (pid %s), skipped' % (agent, job['id'], prev['pid']), file=sys.stderr)
            continue
        why = 'due %s' % due.strftime('%H:%M') + ('' if due == now else ', caught up after sleep')
        log = start(agent, job, now, why)
        if log:
            print('%s started %s/%s → %s' % (now.isoformat(timespec='minutes'), agent, job['id'], log))


# --- launchd ----------------------------------------------------------------------------------------------------------

def install():
    LOGS.mkdir(parents=True, exist_ok=True)
    me = paths()['KITH_HOME'] / 'kernel/bin/kith-sched'   # the address, not the disk path: the kith folder can move
    argv = [str(LAUNCHER), 'run', '--quiet', '--script', str(me), 'tick'] if LAUNCHER.exists() else [str(me), 'tick']
    PLIST.write_bytes(plistlib.dumps({
        'Label': LABEL, 'ProgramArguments': argv, 'StartInterval': 60, 'RunAtLoad': True,
        'ProcessType': 'Background', 'WorkingDirectory': str(Path.home()),
        'EnvironmentVariables': {'HOME': str(Path.home()), 'KITH_HOME': str(paths()['KITH_HOME']),
                                 'PATH': os.environ.get('PATH', '/usr/bin:/bin')},
        'StandardOutPath': str(LOGS / 'tick.log'), 'StandardErrorPath': str(LOGS / 'tick.log')}))
    retire_old_job('sched')
    kith_launchd.reload_or_exit(LABEL, PLIST)
    print('installed %s: ticks every minute; log %s' % (PLIST, LOGS / 'tick.log'))


def uninstall():
    retire_old_job('sched')
    subprocess.run(['launchctl', 'bootout', 'gui/%d/%s' % (os.getuid(), LABEL)], capture_output=True)
    PLIST.unlink(missing_ok=True)
    print('removed %s' % LABEL)


# --- commands ---------------------------------------------------------------------------------------------------------

def need_agent(a):
    if a not in agents():
        sys.exit('kith-sched: no agent %r (have: %s)' % (a, ' '.join(agents())))


def find(agent, jid, jobs=None):
    jobs = load(agent) if jobs is None else jobs
    for j in jobs:
        if j['id'] == jid:
            return j
    sys.exit('kith-sched: %s has no job %r (have: %s)' % (agent, jid, ' '.join(j['id'] for j in jobs) or 'none'))


def ls(only=None):
    now, last = dt.datetime.now(), machine().get('last', {})
    rows = [(a, j) for a, j in all_jobs() if only in (None, a)]
    if not rows:
        print('no jobs%s. Add one: kith schedule add <agent> "0 8 * * *" "the task"' % (' for ' + only if only else ''))
    for a, j in rows:
        try:
            n = 'paused' if j.get('paused') else (next_time(parse(j['cron']), now) or 'never').strftime('%a %d %b %H:%M')
        except (ValueError, AttributeError) as e:
            n = 'bad cron: %s' % e
        l = last.get('%s/%s' % (a, j['id']), {})
        print('%-10s %-18s %-16s next %-18s last %s' % (a, j['id'], j['cron'], n, l.get('at', '-')))
        print('%-10s %s%s' % ('', j['task'][:100].replace('\n', ' '), '  (for %s)' % j['person'] if j.get('person') else ''))
    if rows and not job_installed('sched'):
        print('\nnot ticking: run `kith schedule --install` so launchd starts due jobs')


def log(agent=None, jid=None):
    for k, v in sorted(machine().get('last', {}).items(), key=lambda kv: kv[1]['at']):
        a, j = k.split('/', 1)
        if agent in (None, a) and jid in (None, j):
            state = 'running' if running(v.get('pid')) else 'done'
            print('%s  %-24s %-7s %s' % (v['at'], k, state, v['log'].replace(str(Path.home()), '~', 1)))
    if agent and jid:
        runs = sorted((LOGS / 'runs' / agent).glob(jid + '-*.log'))
        if runs:
            print('\n' + runs[-1].read_text()[-3000:])


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return
    cmd, rest = argv[0], argv[1:]
    if cmd == 'tick': return tick()
    if cmd == 'prune': return prune(force=True)
    if cmd == '--install': return install()
    if cmd == '--uninstall': return uninstall()
    if cmd == 'ls': return ls(rest[0] if rest else None)
    if cmd == 'log': return log(*rest[:2])
    if cmd == 'add':
        opts, pos, i = {}, [], 0
        while i < len(rest):
            if rest[i] in ('--id', '-m', '--model', '-e', '--effort', '-H', '--harness'):
                opts[{'--id': 'id', '-H': 'H', '--harness': 'H'}.get(rest[i], rest[i].lstrip('-')[0])] = rest[i + 1]; i += 2
            else:
                pos.append(rest[i]); i += 1
        if len(pos) != 3:
            sys.exit('usage: kith-sched add AGENT "CRON" "task" [--id ID] [-m MODEL] [-e EFFORT] [-H HARNESS]')
        agent, cron, task = pos
        need_agent(agent)
        try:
            nxt = next_time(parse(cron), dt.datetime.now())
        except ValueError as e:
            sys.exit('kith-sched: %s' % e)
        if opts.get('e') and opts['e'] not in EFFORTS:
            sys.exit('kith-sched: effort must be one of %s' % ', '.join(EFFORTS))
        job = {'id': opts.get('id') or slug(task), 'cron': cron, 'task': task}
        if os.environ.get('KITH_PERSON'):   # the person whose run adds it; it runs as them (start)
            job['person'] = os.environ['KITH_PERSON']
        if opts.get('m'): job['model'] = opts['m']
        if opts.get('e'): job['effort'] = opts['e']
        if opts.get('H'): job['harness'] = opts['H']
        with editing(agent) as jobs:
            jobs[:] = [j for j in jobs if j['id'] != job['id']] + [job]
        print('%s/%s: next run %s' % (agent, job['id'], nxt.strftime('%a %d %b %H:%M') if nxt else 'never'))
        if not job_installed('sched'):
            print('not ticking yet: run `kith schedule --install` once')
        return
    if cmd in ('rm', 'pause', 'resume', 'run') and len(rest) == 2:
        agent, jid = rest
        if cmd == 'run':
            job = find(agent, jid)
            caller = os.environ.get('KITH_PERSON')
            if job.get('person') and caller:   # by hand, never as someone else (the owner may)
                try:
                    me, them = resolve(agent, caller), resolve(agent, job['person'])
                except (OSError, ValueError, subprocess.SubprocessError) as e:
                    sys.exit("kith-sched: can't check %s with kith-auth (%s)" % (caller, e))
                if not me.get('owner') and me.get('person') != them.get('person'):
                    sys.exit('kith-sched: %s/%s runs for %s; only they or the owner can start it by hand'
                             % (agent, jid, job['person']))
            log = start(agent, job, dt.datetime.now().replace(second=0, microsecond=0), 'run by hand')
            if not log:
                sys.exit(1)
            print('started → %s' % log)
            return
        with editing(agent) as jobs:
            job = find(agent, jid, jobs)
            if cmd == 'rm':
                jobs.remove(job)
            else:
                job.pop('paused', None)
                if cmd == 'pause': job['paused'] = True
        print('%s/%s %s' % (agent, jid, {'rm': 'removed', 'pause': 'paused', 'resume': 'resumed'}[cmd]))
        return
    sys.exit('kith-sched: unknown command; see kith-sched --help')


if __name__ == '__main__':
    main(sys.argv[1:])
