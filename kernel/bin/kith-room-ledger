#!/bin/sh
# kith-room-ledger pre|post --agent A --home DIR: this script moved to the kith program (`kith kernel room-ledger`,
# core/kernel/src/room_ledger/). It stays at this path for the runs that hold it: the Pre/PostToolUse hooks of a run started
# before the launch wrote the Rust call, and the launch itself while no program lists the module. Same stdin, same effect as the
# program.
#
# Unlike the other stubs, a program that is not found is NOT an error exit: this is a hook of every Write, Edit and MultiEdit, and
# its command ends in `|| true`, so it must exit 0 whatever happens. But "nothing recorded" is not the safe direction either: a
# `post` that is skipped leaves the older, wider record in place for the new text, and a `pre` that is skipped lets the `post`
# record a note from before the ledger as wide as the room. So with no program a `pre` for a path under a `rooms/` folder says
# "deny" in the PreToolUse JSON on stdout (exit 2 would be swallowed by the `|| true`): room notes are refused while the program
# is missing, nothing else is. A `post` prints nothing. The path is judged as written and with its folder's links resolved.
#
# Finds the program without Python (see bin/project-id): the first candidate whose `kernel version` lists "room-ledger":
#   $KITH_BIN, the release this file sits in (<release>/share/kith/kernel/bin -> <release>/bin/kith), a kith on PATH that is
#   not a kernel entry, the host kith serve installed, a build in the checkout (the builds come first with KITH_DEV_BIN=1).
self=$0
n=0
while [ -L "$self" ] && [ $n -lt 16 ]; do
  link=$(readlink "$self") || exit 0
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
  n=$((n + 1))
done
# The logical path, as bin/kith keeps it (it may be a link to a path with spaces).
kernel=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd) || exit 0
[ -n "$kernel" ] || exit 0

# A kith program: executable, not a kernel bash entry (the last three parts of its real path are kernel/bin/kith), and its
# `kernel version` lists the module.
usable() {
  [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] || return 1
  f=$1
  k=0
  while [ -L "$f" ] && [ $k -lt 16 ]; do
    l=$(readlink "$f") || return 1
    case $l in /*) f=$l ;; *) f=$(dirname "$f")/$l ;; esac
    k=$((k + 1))
  done
  case $(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/$(basename "$f") in */kernel/bin/kith) return 1 ;; esac
  "$1" kernel version 2>/dev/null | grep -q '"room-ledger"'
}
# Each try sets bin and succeeds on a usable program (a path may have a space: nothing here is split).
try() { usable "$1" && bin=$1; }
try_built() {
  target=${CARGO_TARGET_DIR:-$kernel/../serve/host/target}
  try "$target/dev-app/kith" || try "$target/release/kith" || try "$target/debug/kith"
}
try_path() {
  oldifs=$IFS; IFS=:
  for d in $PATH; do
    if [ -n "$d" ] && try "$d/kith"; then IFS=$oldifs; return 0; fi
  done
  IFS=$oldifs
  return 1
}
try_release() { case $kernel in */share/kith/kernel) try "$kernel/../../../bin/kith" ;; *) return 1 ;; esac; }
bin=
if [ "${KITH_DEV_BIN:-}" = 1 ]; then
  try "${KITH_BIN:-}" || try_built || try_path || try "$HOME/.kith/serve/bin/kith-serve" || try_release
else
  try "${KITH_BIN:-}" || try_release || try_path || try "$HOME/.kith/serve/bin/kith-serve" || try_built
fi
if [ -n "$bin" ]; then exec "$bin" kernel room-ledger --kernel "$kernel" "$@"; fi

# No program: refuse a room note's write (see the head of this file), do nothing else.
[ "${1:-}" = pre ] || exit 0
input=$(cat 2>/dev/null) || exit 0
file=$(printf '%s' "$input" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
room=
case $input in *rooms/*) room=1 ;; esac
case $file in
  /*) dir=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P) && case $dir/ in */rooms/*) room=1 ;; esac ;;
esac
[ -n "$room" ] || exit 0
printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"the room ledger could not run (no kith program lists the room-ledger module; kith update), so this write to a room note is refused"}}'
exit 0
