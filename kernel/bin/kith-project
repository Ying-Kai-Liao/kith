#!/usr/bin/env python3
"""kith-project — the projects kith knows: what each holds, where its files are, what the agents wrote about it.

  kith project [dir]                                   the project here (or at dir) and the ones it sits in
  kith project ls [--json]                             every project, as a tree; --json: {"projects":[{id, paths, home,
                                                     remotes, parent, memory, exists}]} sorted by id, paths absolute
  kith project add ID [dir] [--in PARENT] [--home [DIR]] [--json]
                                                     register or change one (bin/project-id --register); a bare
                                                     --home makes one: inside the parent's home, else <root>/ID;
                                                     --json prints the entry as ls --json does
  kith project root [DIR]                              where new homes go (default ~/Documents); DIR changes it
  kith project notes ID...                             the tier-1 notes of those projects as this run may see them
                                                     (KITH_AGENT, KITH_PERSON, KITH_ROOM): what a chat gets when its
                                                     subject moves to a project after its first message
  kith project open [ID] [claude options]              work on the whole project: Claude Code in its home (else its
                                                     folder) with every project it holds that is on this Mac

A project can sit in another: a client or company holding several repos, a line of research holding a paper repo
and a data folder. Agents working in one know its parents and read their memory when the task needs it. Its home is
any folder of yours, wherever you
already keep its files (Documents, Drive, Dropbox); kith points at it and never lays it out or moves anything in it.
A new project with no folder yet gets an empty one under the root.
"""
import json, os, subprocess, sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / 'lib'))
from kith_paths import paths  # noqa: E402
STATE = paths()['KITH_STATE']
HOME = str(Path.home())


def registry():
    try:
        return json.loads((STATE / 'projects.json').read_text()).get('projects', {})
    except FileNotFoundError:
        return {}


def short(p):
    return p.replace(HOME, '~', 1) if p.startswith(HOME) else p


def memory(pid):
    d = STATE / 'projects' / pid
    names = sorted(f.name for f in d.glob('*.md')) if d.is_dir() else []
    return '%s/  %s' % (short(str(d)), ', '.join(names) if names else '(nothing yet)')


def home_line(home):
    d = Path(os.path.expanduser(home))
    if not d.is_dir():
        return '%s  (missing on this Mac)' % home
    n = sum(1 for f in d.iterdir() if not f.name.startswith('.'))
    return '%s  (%d items)' % (home, n)


def show(projects, pid, children):
    p = projects[pid]
    print(pid + ('  in ' + p['parent'] if p.get('parent') else ''))
    for r in p.get('remotes', []):
        print('  repo    ' + r)
    for a in p.get('paths', []):
        if a != p.get('home'):
            print('  folder  ' + a)
    if p.get('home'):
        print('  home    ' + home_line(p['home']))
    print('  memory  ' + memory(pid))
    if children.get(pid):
        print('  holds   ' + ', '.join(children[pid]))


def entry(pid, p):
    """One project as ls --json and add --json print it: absolute paths, `exists` = a folder of it is on this Mac."""
    absp = lambda d: os.path.abspath(os.path.expanduser(d))
    paths = [absp(d) for d in p.get('paths', [])]
    home = absp(p['home']) if p.get('home') else None
    return {'id': pid, 'paths': paths, 'home': home, 'remotes': list(p.get('remotes', [])),
            'parent': p.get('parent') or None, 'memory': str(STATE / 'projects' / pid),
            'exists': any(os.path.isdir(d) for d in ([home] if home else []) + paths)}


def add(argv):
    if '--json' not in argv:
        return subprocess.call([str(BIN / 'project-id'), '--register', *argv])
    run = subprocess.run([str(BIN / 'project-id'), '--register', *[a for a in argv if a != '--json']],
                         stdout=subprocess.PIPE, text=True)
    if run.returncode == 0:
        pid = run.stdout.strip().splitlines()[-1]
        print(json.dumps(entry(pid, registry()[pid])))
    return run.returncode


def lines(*args):
    run = subprocess.run([str(BIN / 'project-id'), *args], capture_output=True, text=True)
    return [l.split('\t') for l in run.stdout.splitlines() if l] if run.returncode == 0 else None


def open_project(argv):
    """Claude Code in the project's home with the folders of everything it holds, so one session sees all of it."""
    pid = argv[0] if argv and not argv[0].startswith('-') else None
    rest = argv[1:] if pid else argv
    if pid is None:
        found = subprocess.run([str(BIN / 'project-id')], capture_output=True, text=True)
        pid = found.stdout.strip() if found.returncode == 0 else None
        if not pid:
            print('kith project open <id>: no project here (kith project ls shows them)', file=sys.stderr)
            return 1
    me = lines('--children', pid, '--all')
    if me is None:
        print('kith project open: no project %r (kith project ls shows them)' % pid, file=sys.stderr)
        return 1
    projects = registry()
    p = projects[pid]
    where = next((d for d in [p.get('home')] + p.get('paths', [])
                  if d and os.path.isdir(os.path.expanduser(d))), None)
    if not where:
        print('kith project open: %s has no folder on this Mac; give it one: kith project add %s --home [DIR]'
              % (pid, pid), file=sys.stderr)
        return 1
    where = os.path.expanduser(where)
    dirs, missing = [], []
    for c, d in me:
        d = os.path.expanduser(d)
        if d == '-':
            missing.append(c)
        elif not (d + '/').startswith(where.rstrip('/') + '/') and d not in dirs:   # inside the home: already there
            dirs.append(d)
    print('%s: %s' % (pid, short(where)) + ('  + ' + ', '.join(short(d) for d in dirs) if dirs else ''))
    if missing:
        print('not on this Mac: %s (clone it, then kith project add <id> <dir> --in %s)' % (', '.join(missing), pid))
    os.chdir(where)
    args = ['claude', *[x for d in dirs for x in ('--add-dir', d)], *rest]
    os.execvp('claude', args)


def notes(ids):
    """Who asks comes from the environment, never from arguments, as for `kith recall`."""
    import kith_facets, kith_recall
    who = kith_recall.caller()
    agent, aud = who['agent'], who['audiences']
    import re
    if not agent or aud == [] or not re.fullmatch(r'[a-z][a-z0-9-]*', agent):
        return 0   # not a known caller: nothing, like recall
    if aud is None or who['who'] == 'owner':
        reader = {'kind': 'owner', 'id': '', 'rooms': []}
    elif who['who'].startswith('bot-'):
        reader = {'kind': 'guest', 'id': who['who'], 'rooms': []}
    else:
        reader = {'kind': 'person', 'id': who['who'], 'rooms': [a[5:] for a in aud if a.startswith('room:')]}
    p = paths()
    home = next((d for d in (p['KITH_AGENTS'] / agent, p['KITH_STATE'] / 'agents' / agent) if d.is_dir()), None)
    if not home:
        return 0
    room = os.environ.get('KITH_ROOM') or kith_facets.own_room(agent, reader)
    ids = [i for i in ids if kith_facets.ID.match(i)]
    out = kith_facets.project_notes(agent, home, reader, room, ids)
    if out['block']:
        print(out['block'])
        if out['more']:
            print('(%d more project notes: kith recall <words> --project <id>)' % out['more'])
    for i in ids:
        start = kith_facets.start_files(agent, home, reader, room, i, members=None, state=p['KITH_STATE'])
        if start:
            print(start)
    return 0


def main(argv):
    if argv[:1] in (['-h'], ['--help']):
        print(__doc__.strip()); return 0
    if argv[:1] == ['add']:
        return add(argv[1:])
    if argv[:1] == ['root']:
        return subprocess.call([str(BIN / 'project-id'), '--root', *argv[1:]])
    if argv[:1] == ['notes']:
        return notes(argv[1:])
    if argv[:1] == ['open']:
        return open_project(argv[1:])
    projects = registry()
    children = {}
    for pid, p in sorted(projects.items()):
        if p.get('parent') in projects:
            children.setdefault(p['parent'], []).append(pid)

    if argv[:1] == ['ls'] and '--json' in argv:
        print(json.dumps({'projects': [entry(pid, p) for pid, p in sorted(projects.items())]}))
        return 0
    if argv[:1] == ['ls']:
        if not projects:
            print('no projects yet. Register one: kith project add <id> [dir] [--in PARENT] [--home [DIR]]')
            return 0

        def tree(pid, depth, seen):
            p = projects[pid]
            where = p.get('home') or ' '.join(p.get('remotes', []) + p.get('paths', []))
            print('%-28s %s' % ('  ' * depth + pid, where))
            for c in children.get(pid, []):
                if c not in seen:
                    tree(c, depth + 1, seen | {c})
        for pid, p in sorted(projects.items()):
            if p.get('parent') not in projects:
                tree(pid, 0, {pid})
        return 0

    found = subprocess.run([str(BIN / 'project-id'), *argv[:1]], capture_output=True, text=True)
    if found.returncode != 0:
        print('no project here. Register one: kith project add <id> [dir] [--in PARENT] [--home [DIR]]')
        return 1
    chain = subprocess.run([str(BIN / 'project-id'), '--info', found.stdout.strip()],
                           capture_output=True, text=True).stdout.split('\n')
    for i, line in enumerate(l for l in chain if l):
        if i:
            print()
        show(projects, line.split('\t')[0], children)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
