#!/usr/bin/env python3
"""kith-group — the owner's commands for bot guests in rooms, over the host's local API.

  kith group add-bot <room> <bot> [--json]      let one of your bot guests (Grok) see a group room from now on
  kith group remove-bot <room> <bot> [--json]   take it out of the room
  kith bot set <bot> [--wake-profile P] [--turn-timeout S] [--json]
                                                a bot guest's wake settings: P is a kith-auth profile of the `grok`
                                                service (what `kith send-to grok --profile P` uses; '' clears it); S is how
                                                long one of its turns may run (the host clamps it to 30..3600)

<room> and <bot> are an id or a name (case-insensitive, exact). Edits are read-modify-write of the member list, so two
edits at the same moment: the last one wins. The host decides who may join (your own active bots only) and says why not.
Exit: 0 done, 1 refused or host unreachable, 2 usage / unknown or ambiguous name."""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def host_endpoint():
    """(data dir, port) of this install's kith serve. kith-serve owns the rule (dev 19224 / packaged main 19225); the
    env overrides win. Same as kith-auth."""
    data, port = os.environ.get('KITH_SERVE_DIR'), os.environ.get('KITH_SERVE_PORT')
    if not (data and port):
        try:
            d, p = subprocess.run([str(Path(__file__).resolve().parent / 'kith-serve'), 'endpoint'], capture_output=True,
                                  text=True, timeout=4, check=True).stdout.split()
        except Exception:  # noqa: BLE001 — fall back to the dev defaults
            d, p = str(Path.home() / '.kith' / 'serve'), '19224'
        data, port = data or d, port or p
    return Path(data), port


def host_call(method, body):
    """The host's local API (owner token over loopback). (answer, None), or (None, why it couldn't be reached)."""
    import urllib.error
    import urllib.request
    try:
        data, port = host_endpoint()
        token = (data / 'token').read_text().strip()
        req = urllib.request.Request(f'http://127.0.0.1:{port}/api/{method}', json.dumps(body).encode(),
                                     {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'})
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r), None
    except urllib.error.HTTPError as e:
        try:
            why = json.load(e).get('error')
            return None, why if isinstance(why, str) and why else f'kith serve answered {e.code}'
        except (ValueError, AttributeError):
            return None, f'kith serve answered {e.code}'
    except Exception as e:  # noqa: BLE001
        return None, f'kith serve is not reachable ({e.__class__.__name__})'


IDLE_S, CAP_S = float(os.environ.get('KITH_GROUP_IDLE_S') or 1.0), 10.0


def read_bots():
    """(every bot the host keeps, None) or (None, why). No API method lists rooms: they come only with the event stream's
    catch-up (GET /events?since=0: hello, then each bot, then entries, then the stream stays open with no end marker).
    So read until it goes quiet for IDLE_S (the catch-up is sent at once), at most CAP_S. The latest event per id wins; a
    deleted bot is gone."""
    import urllib.error
    import urllib.request
    try:
        data, port = host_endpoint()
        token = (data / 'token').read_text().strip()
        req = urllib.request.Request(f'http://127.0.0.1:{port}/events?since=0', headers={'Authorization': f'Bearer {token}'})
        bots, end = {}, time.monotonic() + CAP_S
        with urllib.request.urlopen(req, timeout=IDLE_S) as r:
            while time.monotonic() < end:
                try:
                    line = r.readline()
                except OSError:  # quiet for IDLE_S (socket timeout): the catch-up is over
                    break
                if not line:
                    break
                if not line.startswith(b'data:'):
                    continue
                try:
                    ev = json.loads(line[5:])
                except ValueError:
                    continue
                if ev.get('type') == 'bot' and isinstance(ev.get('bot'), dict) and ev['bot'].get('id'):
                    b = ev['bot']
                    if b.get('deleted'):
                        bots.pop(b['id'], None)
                    else:
                        bots[b['id']] = b
        return bots, None
    except urllib.error.HTTPError as e:
        return None, f'kith serve answered {e.code}'
    except Exception as e:  # noqa: BLE001
        return None, f'kith serve is not reachable ({e.__class__.__name__})'


def die(msg, code=1):
    print(f'kith: {msg}', file=sys.stderr)
    sys.exit(code)


def pick(what, want, rows):
    """The row whose id is `want`, else the one whose name is (case-insensitive, exact). Unknown or ambiguous: exit 2
    with the candidates."""
    for r in rows:
        if r['id'] == want:
            return r
    hits = [r for r in rows if str(r.get('name', '')).casefold() == want.casefold()]
    if len(hits) == 1:
        return hits[0]
    names = ', '.join(f"{r.get('name')} ({r['id']})" for r in (hits or rows)) or 'none'
    if hits:
        die(f"more than one {what} is called '{want}'. Use the id: {names}", 2)
    die(f"no {what} called '{want}'. Known: {names}", 2)


def guest_bots():
    ans, why = host_call('bots', {})
    if why:
        die(why)
    return [b for b in (ans or {}).get('bots') or [] if isinstance(b, dict) and b.get('botId')]


def pick_guest(want, members=()):
    rows = [{'id': b['botId'], 'name': b.get('name')} for b in guest_bots()]
    # A bot already in the room can come out even when the guest list no longer shows it.
    if not any(r['id'] == want for r in rows) and want in members:
        return {'id': want, 'name': want}
    return pick('bot', want, rows)


def pick_room(want):
    bots, why = read_bots()
    if why:
        die(why)
    room = bots.get(want)
    if room is not None and room.get('kind') != 'group':
        die(f"'{room.get('name') or want}' is not a group room.", 2)
    if room is None:
        groups = [r for r in bots.values() if r.get('kind') == 'group']
        if not any(str(r.get('name', '')).casefold() == want.casefold() for r in groups) and any(
                str(r.get('name', '')).casefold() == want.casefold() for r in bots.values()):
            die(f"'{want}' is not a group room.", 2)
        room = pick('room', want, groups)
    return room


def cmd_member(args):
    room = pick_room(args.room)
    members = [m for m in room.get('members') or [] if isinstance(m, str)]
    bot = pick_guest(args.bot, members)
    name, rname = bot['name'], room.get('name') or room['id']
    if args.verb == 'add-bot':
        if bot['id'] in members:
            print(json.dumps({'unchanged': True, 'members': members}) if args.json else f'{name} is already in {rname}')
            return 0
        new = members + [bot['id']]
    else:
        if bot['id'] not in members:
            die(f'{name} is not in {rname}.')
        new = [m for m in members if m != bot['id']]
    ans, why = host_call('updateBot', {'id': room['id'], 'members': new})
    if why:
        die(why)
    if args.json:
        print(json.dumps(ans))
    elif args.verb == 'add-bot':
        print(f'{name} will see this room from now on')
    else:
        print(f'{name} removed from {rname}')
    return 0


def cmd_set(args):
    body = {}
    if args.wake_profile is not None:
        body['wakeProfile'] = args.wake_profile
    if args.turn_timeout is not None:
        body['turnTimeoutS'] = args.turn_timeout
    if not body:
        die('give --wake-profile and/or --turn-timeout.', 2)
    bot = pick_guest(args.bot)
    ans, why = host_call('setBotLimits', {'botId': bot['id'], **body})
    if why:
        die(why)
    if args.json:
        print(json.dumps(ans))
        return 0
    lim = ((ans or {}).get('bot') or {}).get('limits') or {}
    wp = lim.get('wakeProfile')
    print(f"{bot['name']}: wake profile {wp or '(none)'}, turn timeout {lim.get('turnTimeoutS')}s")
    if wp:
        # The wake runs as the host's `serve` grant (kith send-to grok --for serve), which has to list this profile.
        want = wp if '/' in wp else f'grok/{wp}'
        r = subprocess.run([sys.executable, str(Path(__file__).resolve().parent / 'kith-auth'), 'granted', '--for', 'serve', 'grok'],
                           capture_output=True, text=True)
        if want not in r.stdout.split():
            print(f"{want} has no host grant yet, so the wake can't reach it: add the key with "
                  f"`kith keys add grok --profile {want.partition('/')[2]}`, or for an existing key run "
                  f"`kith-auth grant serve grok {want}`.")
    return 0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        die(f'{message}. See: kith group --help', 2)


def main():
    if len(sys.argv) < 3 or sys.argv[1] in ('-h', '--help') or sys.argv[2] in ('-h', '--help'):
        print(__doc__)
        sys.exit(0 if len(sys.argv) > 1 and {'-h', '--help'} & set(sys.argv[1:3]) else 2)
    ap = Parser(prog='kith')
    sub = ap.add_subparsers(dest='group', required=True)
    for g, verbs in (('group', ('add-bot', 'remove-bot')), ('bot', ('set',))):
        vp = sub.add_parser(g).add_subparsers(dest='verb', required=True)
        for v in verbs:
            p = vp.add_parser(v)
            if g == 'group':
                p.add_argument('room')
            p.add_argument('bot')
            p.add_argument('--json', action='store_true')
            if v == 'set':
                p.add_argument('--wake-profile')
                p.add_argument('--turn-timeout', type=int)
    args = ap.parse_args()
    sys.exit(cmd_set(args) if args.verb == 'set' else cmd_member(args))


if __name__ == '__main__':
    main()
