#!/usr/bin/env python3
"""kith-group — the owner's commands for bot guests in rooms, over the host's local API.

  kith group add-bot <room> <bot> [--json]      let one of your bot guests (Grok) see a group room from now on
  kith group remove-bot <room> <bot> [--json]   take it out of the room
  kith group secret <room> --to <member|bot> [--label L] [--ttl MIN] [--json]
                                                hand ONE member of the room a one-time secret. The value is read from stdin
                                                only (never an argument): pipe it in, or type it at the no-echo prompt.
                                                It lapses in MIN minutes (default 10, 1..60) and can be taken once.
  kith group secrets <room> [--json]            the open ones: id, to, label, when it lapses (never a value)
  kith group secret <room> --withdraw <id>      take one back before it is used
  kith bot ls [--json]                          the bot guests: id, name, state, whose, agents
  kith bot invite <name> [--agent A ...] [--bot-id ID] [--provider P] [--json]
                                                a link for a bot to join (a new bot, or --bot-id: a fresh link for one of
                                                yours); the link is the only token-bearing output, for your terminal only
  kith bot revoke-invite <inviteId> [--json]    take back an unused bot invite
  kith bot revoke <bot> [--json]                remove a bot guest (twice: fine, changed false)
  kith bot decide <bot> allow|deny [--always] [--json]   answer a bot waiting at the door (--always: allow every bot of its owner)
  kith bot auto-allow <person> on|off [--json]  let that invited person's bots in without asking
  kith bot set <bot> [--wake-profile P] [--turn-timeout S] [--json]
                                                a bot guest's wake settings: P is a kith-auth profile of the `grok`
                                                service (what `kith send-to grok --profile P` uses; '' clears it); S is how
                                                long one of its turns may run (the host clamps it to 30..3600)

<room> and <bot> are an id or a name (case-insensitive, exact). Edits are read-modify-write of the member list, so two
edits at the same moment: the last one wins. The host decides who may join (your own active bots only) and says why not.
Exit: 0 done, 1 refused or host unreachable, 2 usage / unknown or ambiguous name."""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from kith_host import host_call, host_endpoint  # noqa: E402


IDLE_S, CAP_S = float(os.environ.get('KITH_GROUP_IDLE_S') or 1.0), 10.0


def read_bots():
    """(every bot the host keeps, None) or (None, why). No API method lists rooms: they come only with the event stream's
    catch-up (GET /events?since=0: hello, then each bot, then entries, then the stream stays open with no end marker).
    So read until it goes quiet for IDLE_S (the catch-up is sent at once), at most CAP_S. The latest event per id wins; a
    deleted bot is gone."""
    import urllib.error
    import urllib.request
    try:
        data, port = host_endpoint()
        token = (data / 'token').read_text().strip()
        req = urllib.request.Request(f'http://127.0.0.1:{port}/events?since=0', headers={'Authorization': f'Bearer {token}'})
        bots, end = {}, time.monotonic() + CAP_S
        with urllib.request.urlopen(req, timeout=IDLE_S) as r:
            while time.monotonic() < end:
                try:
                    line = r.readline()
                except OSError:  # quiet for IDLE_S (socket timeout): the catch-up is over
                    break
                if not line:
                    break
                if not line.startswith(b'data:'):
                    continue
                try:
                    ev = json.loads(line[5:])
                except ValueError:
                    continue
                if ev.get('type') == 'bot' and isinstance(ev.get('bot'), dict) and ev['bot'].get('id'):
                    b = ev['bot']
                    if b.get('deleted'):
                        bots.pop(b['id'], None)
                    else:
                        bots[b['id']] = b
        return bots, None
    except urllib.error.HTTPError as e:
        return None, f'kith serve answered {e.code}'
    except Exception as e:  # noqa: BLE001
        return None, f'kith serve is not reachable ({e.__class__.__name__})'


JSON_ERRORS = False   # set for the bot verbs that report as {"ok": ...}: a refusal is an object on stdout, same exit code


def die(msg, code=1):
    if JSON_ERRORS:
        print(json.dumps({'ok': False, 'error': msg}))
    else:
        print(f'kith: {msg}', file=sys.stderr)
    sys.exit(code)


def pick(what, want, rows):
    """The row whose id is `want`, else the one whose name is (case-insensitive, exact). Unknown or ambiguous: exit 2
    with the candidates."""
    for r in rows:
        if r['id'] == want:
            return r
    hits = [r for r in rows if str(r.get('name', '')).casefold() == want.casefold()]
    if len(hits) == 1:
        return hits[0]
    names = ', '.join(f"{r.get('name')} ({r['id']})" for r in (hits or rows)) or 'none'
    if hits:
        die(f"more than one {what} is called '{want}'. Use the id: {names}", 2)
    die(f"no {what} called '{want}'. Known: {names}", 2)


def guest_bots():
    ans, why = host_call('bots', {})
    if why:
        die(why)
    return [b for b in (ans or {}).get('bots') or [] if isinstance(b, dict) and b.get('botId')]


NEW_BOT_VERBS = ('ls', 'invite', 'revoke-invite', 'revoke', 'decide', 'auto-allow')


def bot_args(args):
    """(positionals, options) of the bot verbs that report as {"ok": ...}."""
    obj, pos, i = {}, [], 0
    valued = {'--bot-id': 'botId', '--provider': 'provider'}
    while i < len(args):
        a = args[i]
        if a in ('--json', '--always'):
            obj[a] = True
        elif a == '--agent' or a in valued:
            if i + 1 >= len(args) or args[i + 1].startswith('--'):
                die(f'{a} needs a value', 2)
            i += 1
            if a == '--agent':
                obj.setdefault('agents', []).append(args[i])
            else:
                obj[valued[a]] = args[i]
        elif a.startswith('--'):
            die(f'unknown option {a}. See: kith bot --help', 2)
        else:
            pos.append(a)
        i += 1
    return pos, obj


def say(js, obj, text):
    print(json.dumps(obj) if js else text)


def ask_host(method, body):
    ans, why = host_call(method, body)
    if why:
        die(why)
    return ans or {}


def bot_target(want):
    """A bot guest's id as given (bg_..), else resolved by name; a removed bot stays addressable by its id."""
    return want if want.startswith('bg_') else pick_guest(want)['id']


def cmd_bot_verb(verb, args):
    pos, o = bot_args(args)
    js = bool(o.get('--json'))
    usage = {'ls': 'kith bot ls [--json]', 'invite': 'kith bot invite <name> [--agent A ...] [--bot-id ID] [--json]',
             'revoke-invite': 'kith bot revoke-invite <inviteId> [--json]', 'revoke': 'kith bot revoke <bot> [--json]',
             'decide': 'kith bot decide <bot> allow|deny [--always] [--json]',
             'auto-allow': 'kith bot auto-allow <person> on|off [--json]'}[verb]
    want = {'ls': 0, 'invite': 1, 'revoke-invite': 1, 'revoke': 1, 'decide': 2, 'auto-allow': 2}[verb]
    if len(pos) != want or (verb == 'decide' and pos[1] not in ('allow', 'deny')) or (
            verb == 'auto-allow' and pos[1] not in ('on', 'off')):
        die(f'usage: {usage}', 2)
    if verb == 'ls':
        bots = [b for b in ask_host('bots', {}).get('bots') or [] if isinstance(b, dict)]
        say(js, {'ok': True, 'bots': bots}, '\n'.join(
            f"{b.get('botId')}  {b.get('name')}  {b.get('state')}  "
            + (f"of {b['ownerPerson']}" if b.get('ownerPerson') else 'yours')
            + '  ' + (', '.join(b.get('agents') or []) or 'no agents') for b in bots) or 'no bot guests')
    elif verb == 'invite':
        body = {'name': pos[0], 'agents': o.get('agents', [])}
        for k in ('botId', 'provider'):
            if o.get(k):
                body[k] = o[k]
        a = ask_host('createBotInvite', body)
        res = {'ok': True, **{k: a.get(k) for k in ('botId', 'inviteId', 'expiresAt', 'link', 'kithLink', 'share')}}
        say(js, res, res['share'] or res['link'])
    elif verb == 'revoke-invite':
        changed = bool(ask_host('revokeBotInvite', {'inviteId': pos[0]}).get('revoked'))
        say(js, {'ok': True, 'inviteId': pos[0], 'changed': changed},
            f'{pos[0]} revoked' if changed else f'{pos[0]} was already used, revoked or gone')
    elif verb == 'revoke':
        bot = bot_target(pos[0])
        changed = bool(ask_host('revokeBot', {'botId': bot}).get('revoked'))
        say(js, {'ok': True, 'botId': bot, 'changed': changed}, f'{bot} removed' if changed else f'{bot} was already removed')
    elif verb == 'decide':
        bot = bot_target(pos[0])
        body = {'botId': bot, 'decision': pos[1]}
        if o.get('--always'):
            if pos[1] != 'allow':
                die('--always goes with allow', 2)
            body['alwaysForOwner'] = True
        b = ask_host('decideBot', body).get('bot') or {}
        say(js, {'ok': True, 'botId': bot, 'decision': pos[1], 'state': b.get('state')},
            f"{b.get('name') or bot}: {b.get('state') or pos[1]}")
    else:
        on = pos[1] == 'on'
        ask_host('setAutoAllowBots', {'personId': pos[0], 'on': on})
        say(js, {'ok': True, 'person': pos[0], 'autoAllow': on},
            f"{pos[0]}'s bots {'come in without asking' if on else 'wait for your answer'}")
    return 0


def pick_guest(want, members=()):
    rows = [{'id': b['botId'], 'name': b.get('name')} for b in guest_bots()]
    # A bot already in the room can come out even when the guest list no longer shows it.
    if not any(r['id'] == want for r in rows) and want in members:
        return {'id': want, 'name': want}
    return pick('bot', want, rows)


def pick_room(want, bots=None):
    if bots is None:
        bots, why = read_bots()
        if why:
            die(why)
    room = bots.get(want)
    if room is not None and room.get('kind') != 'group':
        die(f"'{room.get('name') or want}' is not a group room.", 2)
    if room is None:
        groups = [r for r in bots.values() if r.get('kind') == 'group']
        if not any(str(r.get('name', '')).casefold() == want.casefold() for r in groups) and any(
                str(r.get('name', '')).casefold() == want.casefold() for r in bots.values()):
            die(f"'{want}' is not a group room.", 2)
        room = pick('room', want, groups)
    return room


def cmd_member(args):
    room = pick_room(args.room)
    members = [m for m in room.get('members') or [] if isinstance(m, str)]
    bot = pick_guest(args.bot, members)
    name, rname = bot['name'], room.get('name') or room['id']
    if args.verb == 'add-bot':
        if bot['id'] in members:
            print(json.dumps({'unchanged': True, 'members': members}) if args.json else f'{name} is already in {rname}')
            return 0
        new = members + [bot['id']]
    else:
        if bot['id'] not in members:
            die(f'{name} is not in {rname}.')
        new = [m for m in members if m != bot['id']]
    ans, why = host_call('updateBot', {'id': room['id'], 'members': new})
    if why:
        die(why)
    if args.json:
        print(json.dumps(ans))
    elif args.verb == 'add-bot':
        print(f'{name} will see this room from now on')
    else:
        print(f'{name} removed from {rname}')
    return 0


def read_value():
    """The secret from stdin. A terminal gets a no-echo prompt; a pipe is read whole. One trailing newline is the
    shell's, not the secret's."""
    if sys.stdin.isatty():
        import getpass
        value = getpass.getpass('Secret (hidden): ')
    else:
        value = sys.stdin.read()
        if value.endswith('\n'):
            value = value[:-1]
    if not value:
        die('the secret is empty. Pipe it in on stdin.', 2)
    return value


def when(ms):
    return time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(ms / 1000))


def cmd_secret(args):
    bots, why = read_bots()
    if why:
        die(why)
    room = pick_room(args.room, bots)
    if args.withdraw:
        if args.to or args.label or args.ttl is not None:
            die('--withdraw takes only the id.', 2)
        ans, why = host_call('withdrawSecret', {'id': args.withdraw})
        if why:
            die(why)
        done = bool((ans or {}).get('withdrawn'))
        print(json.dumps(ans) if args.json else (f'{args.withdraw} withdrawn' if done else
              f'{args.withdraw} was already used, over or gone'))
        return 0 if done else 1
    if not args.to:
        die('say who gets it with --to <member|bot>.', 2)
    if args.ttl is not None and not 1 <= args.ttl <= 60:
        die('--ttl is 1 to 60 minutes.', 2)
    members = [m for m in room.get('members') or [] if isinstance(m, str)]
    names = {b['botId']: b.get('name') for b in guest_bots()}
    rows = [{'id': m, 'name': (bots.get(m) or {}).get('name') or names.get(m) or m} for m in members]
    to = pick('member', args.to, rows)
    value = read_value()
    body = {'room': room['id'], 'to': to['id'], 'value': value}
    if args.label:
        body['label'] = args.label
    if args.ttl is not None:
        body['ttlS'] = args.ttl * 60
    ans, why = host_call('sendSecret', body)
    del body, value
    if why:
        die(why)
    if args.json:
        print(json.dumps(ans))
    else:
        print(f"secret {ans.get('id')} sent to {to['name']}; it lapses at {when(ans.get('expiresAt', 0))}")
    return 0


def cmd_secrets(args):
    room = pick_room(args.room)
    ans, why = host_call('roomSecrets', {'room': room['id']})
    if why:
        die(why)
    now = time.time() * 1000
    open_ = [s for s in (ans or {}).get('secrets') or [] if s.get('state') == 'pending' and s.get('expiresAt', 0) > now]
    if args.json:
        print(json.dumps({'secrets': open_}))
        return 0
    if not open_:
        print('no open secrets')
    for s in open_:
        print(f"{s['id']}  to {s.get('recipient')}  {s.get('label') or '(no label)'}  lapses {when(s['expiresAt'])}")
    return 0


def cmd_set(args):
    body = {}
    if args.wake_profile is not None:
        body['wakeProfile'] = args.wake_profile
    if args.turn_timeout is not None:
        body['turnTimeoutS'] = args.turn_timeout
    if not body:
        die('give --wake-profile and/or --turn-timeout.', 2)
    bot = pick_guest(args.bot)
    ans, why = host_call('setBotLimits', {'botId': bot['id'], **body})
    if why:
        die(why)
    if args.json:
        print(json.dumps(ans))
        return 0
    lim = ((ans or {}).get('bot') or {}).get('limits') or {}
    wp = lim.get('wakeProfile')
    print(f"{bot['name']}: wake profile {wp or '(none)'}, turn timeout {lim.get('turnTimeoutS')}s")
    if wp:
        # The wake runs as the host's `serve` grant (kith send-to grok --for serve), which has to list this profile.
        want = wp if '/' in wp else f'grok/{wp}'
        r = subprocess.run([sys.executable, str(Path(__file__).resolve().parent / 'kith-auth'), 'granted', '--for', 'serve', 'grok'],
                           capture_output=True, text=True)
        if want not in r.stdout.split():
            print(f"{want} has no host grant yet, so the wake can't reach it: add the key with "
                  f"`kith keys add grok --profile {want.partition('/')[2]}`, or for an existing key run "
                  f"`kith-auth grant serve grok {want}`.")
    return 0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        if message.startswith('unrecognized arguments'):  # argparse would print them, and one may be a secret
            message = 'unrecognized arguments (not shown). A secret never goes in an argument: pipe it on stdin'
        die(f'{message}. See: kith group --help', 2)


def main():
    if len(sys.argv) < 3 or sys.argv[1] in ('-h', '--help') or sys.argv[2] in ('-h', '--help'):
        print(__doc__)
        sys.exit(0 if len(sys.argv) > 1 and {'-h', '--help'} & set(sys.argv[1:3]) else 2)
    global JSON_ERRORS
    if sys.argv[1] == 'bot' and sys.argv[2] in NEW_BOT_VERBS:
        JSON_ERRORS = '--json' in sys.argv
        sys.exit(cmd_bot_verb(sys.argv[2], sys.argv[3:]))
    ap = Parser(prog='kith')
    sub = ap.add_subparsers(dest='group', required=True)
    for g, verbs in (('group', ('add-bot', 'remove-bot', 'secret', 'secrets')), ('bot', ('set',))):
        vp = sub.add_parser(g).add_subparsers(dest='verb', required=True)
        for v in verbs:
            p = vp.add_parser(v)
            if g == 'group':
                p.add_argument('room')
            if v in ('secret', 'secrets'):
                p.add_argument('--json', action='store_true')
                if v == 'secret':
                    p.add_argument('--to')
                    p.add_argument('--label')
                    p.add_argument('--ttl', type=int, metavar='MIN')
                    p.add_argument('--withdraw', metavar='ID')
                continue
            p.add_argument('bot')
            p.add_argument('--json', action='store_true')
            if v == 'set':
                p.add_argument('--wake-profile')
                p.add_argument('--turn-timeout', type=int)
    args = ap.parse_args()
    sys.exit({'set': cmd_set, 'secret': cmd_secret, 'secrets': cmd_secrets}.get(args.verb, cmd_member)(args))


if __name__ == '__main__':
    main()
