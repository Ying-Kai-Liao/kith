#!/usr/bin/env python3
"""kith-remote — call the agents on your other machines: house@mini.

  kith remote add NAME SSH-TARGET     a machine you can ssh into (e.g. mini you@mac-mini); checks it and lists its agents
  kith remote ls                      the machines, whether they answer, and their agents
  kith remote rm NAME                 forget one
  kith ask AGENT@NAME [options] "task"   ask an agent there (the options of kith ask, plus --no-code); -c continues

For your own machines only: it is plain ssh (over Tailscale, a LAN, anything your ssh config reaches), so it adds no
server, port or token. Whoever can ssh in as you could run kith there anyway. The agent runs on its machine, with that
machine's memory, accounts and tools; only the task, your code and its answer and files travel. Never state.
The other machine runs it as its owner, so a run for anyone else (KITH_PERSON, not the owner) is refused until there
is a person id that holds across machines.

Code handoff, when you ask from inside a git repo (--no-code skips it):
  1. Your working tree, uncommitted and untracked files included (not ignored ones), is snapshotted as a commit
     without touching your index or branch, and pushed over ssh into a scratch clone on the other machine
     (~/.kith/cache/handoff/), never into its own checkout of the project.
  2. The agent works in a worktree of it, on branch kith/<agent>/<id>, told which subfolder you were in; the clone
     has your origin, so it finds the same project. Whatever it leaves uncommitted is committed for it at the end.
  3. If it changed anything, the branch is fetched back into your repo as kith/<agent>/<id>. Its first commit is your
     snapshot, so `git diff <snapshot> kith/<agent>/<id>` (printed with the answer) is exactly the agent's change, and
     `… | git apply` puts it in your working tree.
  Files that aren't code (images, reports) go in the worktree's .kith-out/, copied back to ./kith-out/<id>/.
  -c continues in the same worktree with the same agent session; changes you made since are not sent again.

The run on the other machine is `kith ask` there (tagged via=ask), with --permission-mode from that machine's
KITH_REMOTE_PERMISSION_MODE when set, else the agent's settings.json defaultMode, else that machine's kith default (auto).
Once per agent machine: macOS keeps the login keychain, where Claude Code keeps its login, away from ssh sessions, so
run `claude setup-token` there and put the token in its ~/.kith/secrets/env as CLAUDE_CODE_OAUTH_TOKEN=... (chmod 600);
remote runs use it, nothing else does.
Machines: ~/.kith/remotes.json. Conversations are listed with the rest in `kith ask ls`.
"""
import base64, datetime as dt, hashlib, importlib.util, json, os, re, shlex, shutil, subprocess, sys, tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from kith_paths import paths  # noqa: E402  the one place that knows where kith's folders are
CONF = paths()['KITH_MACHINE'] / 'remotes.json'
ENV = paths()['KITH_SECRETS'] / 'env'
HANDOFF = paths()['KITH_CACHE'] / 'handoff'  # scratch clones and worktrees: rebuildable
_loader = SourceFileLoader('kith_ask', str(KITH / 'bin/kith-ask'))
ask = importlib.util.module_from_spec(importlib.util.spec_from_loader('kith_ask', _loader))
_loader.exec_module(ask)  # conversations are kept with kith ask's
SSH = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'ControlMaster=auto',
       '-o', 'ControlPath=~/.ssh/hq-%C', '-o', 'ControlPersist=120']


def remotes():
    try:
        r = json.loads(CONF.read_text())
    except (OSError, ValueError):
        return {}
    for m in r.values():   # entries saved before the rename keep the remote command under 'hq'
        if isinstance(m, dict) and 'kith' not in m and 'hq' in m:
            m['kith'] = m['hq']
    return r


def save_remotes(r):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(r, indent=1) + '\n')


def rsh(target, inner, check=True, capture=True):
    """Run a command on the other machine in a login shell (so its PATH has claude, git, uv)."""
    p = subprocess.run(SSH + [target, 'exec "$SHELL" -lc ' + shlex.quote(inner)],
                       capture_output=capture, text=True, stdin=subprocess.DEVNULL)
    if check and p.returncode != 0:
        sys.exit('kith remote: %s: %s' % (target, ((p.stderr or '') + (p.stdout or '')).strip()[-1500:] or 'ssh failed'))
    return p


def last_json(out):
    for line in reversed(out.strip().splitlines()):
        try:
            return json.loads(line)
        except ValueError:
            continue
    return None


def git(*args, cwd=None, env=None, check=True):
    p = subprocess.run(['git', *args], cwd=cwd, env=env, capture_output=True, text=True)
    if check and p.returncode != 0:
        sys.exit('kith remote: git %s: %s' % (args[0], p.stderr.strip()[-800:]))
    return p.stdout.strip()


def git_env(target):
    return dict(os.environ, GIT_SSH_COMMAND=' '.join(shlex.quote(a) for a in SSH))


# --- machines ---------------------------------------------------------------------------------------------------------

def add(name, target):
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', name):
        sys.exit('kith remote: a machine name is lowercase letters, digits and -')
    p = rsh(target, 'command -v kith || { [ -x ~/.local/bin/kith ] && echo ~/.local/bin/kith; }', check=False)
    if p.returncode == 255:
        sys.exit('kith remote: cannot ssh %s: %s\n  It must work without a password: ssh-copy-id %s, and Remote Login '
                 'on (System Settings → General → Sharing).' % (target, p.stderr.strip(), target))
    kith = (p.stdout.strip().splitlines() or [''])[-1]
    if not kith:
        sys.exit('kith remote: %s has no kith on its PATH or in ~/.local/bin (run install.sh there)' % target)
    agents = rsh(target, shlex.quote(kith) + ' ls').stdout.strip()
    r = remotes()
    r[name] = {'ssh': target, 'kith': kith}
    save_remotes(r)
    print('%s → %s (%s)\n%s' % (name, target, kith, agents))


def ls():
    r = remotes()
    if not r:
        print('no machines yet: kith remote add <name> <ssh target>')
    for name, m in r.items():
        p = rsh(m['ssh'], shlex.quote(m['kith']) + ' ls', check=False)
        names = [l.split()[0] for l in p.stdout.strip().splitlines() if l.strip()] if p.returncode == 0 else []
        print('%-10s %-28s %s' % (name, m['ssh'], ' '.join('%s@%s' % (a, name) for a in names)
                                 if p.returncode == 0 else 'unreachable: ' + p.stderr.strip()[-120:]))


def machine(name):
    m = remotes().get(name)
    if not m:
        sys.exit('kith remote: no machine %r (have: %s). Add it: kith remote add %s <ssh target>'
                 % (name, ' '.join(remotes()) or 'none', name))
    return m


# --- the calling side -------------------------------------------------------------------------------------------------

def snapshot(top):
    """The working tree as a commit (tracked + untracked, minus ignored), leaving the index and branch alone."""
    head = git('rev-parse', '--verify', '-q', 'HEAD', cwd=top, check=False)
    with tempfile.TemporaryDirectory() as d:
        idx = Path(d) / 'index'
        real = Path(top) / git('rev-parse', '--git-path', 'index', cwd=top)
        if real.exists():
            shutil.copy(real, idx)
        env = dict(os.environ, GIT_INDEX_FILE=str(idx))
        git('add', '-A', '--', '.', ':(exclude,glob)**/kith-out/**', cwd=top, env=env)  # not what came back before
        tree = git('write-tree', cwd=top, env=env)
    if head and tree == git('rev-parse', 'HEAD^{tree}', cwd=top):
        return head, False
    parents = ['-p', head] if head else []
    sha = git('-c', 'user.name=kith', '-c', 'user.email=hq@localhost', 'commit-tree', tree, *parents,
              '-m', 'kith handoff: working tree of %s' % os.uname().nodename, cwd=top)
    return sha, True


def call(agent, host, opts, task, cont, name, as_json, no_code):
    m = machine(host)
    cwd = Path.cwd()
    key = '%s@%s|%s' % (agent, host, ('as:' + name) if name else cwd)
    prev = ask.load().get(key) if cont else None
    if cont and not prev:
        sys.exit('kith ask: no conversation with %s@%s %s to continue; start one without -c'
                 % (agent, host, 'named ' + name if name else 'from this directory'))
    cid = prev['id'] if prev else dt.datetime.now().strftime('%m%d%H%M%S')
    top = None if no_code else git('rev-parse', '--show-toplevel', check=False) or None
    req = {'agent': agent, 'id': cid, 'opts': opts, 'task': task, 'cont': bool(prev), 'caller': os.uname().nodename,
           'from': str(cwd)}
    kith = shlex.quote(m['kith'])

    if top and not prev:
        origin = git('remote', 'get-url', 'origin', cwd=top, check=False)
        slug = re.sub(r'[^a-z0-9]+', '-', Path(top).name.lower()).strip('-') + '-' + \
            hashlib.sha1((origin or top).encode()).hexdigest()[:6]
        repo = (last_json(rsh(m['ssh'], '%s remote _repo %s' % (kith, shlex.quote(json.dumps(
            {'slug': slug, 'origin': origin})))).stdout) or {}).get('repo')
        if not repo:
            sys.exit('kith remote: %s did not prepare a handoff clone' % host)
        sha, dirty = snapshot(top)
        print('[sending %s%s to %s]' % (sha[:8], ' (with uncommitted changes)' if dirty else '', host), file=sys.stderr)
        git('push', '-q', '--force', '%s:%s' % (m['ssh'], repo), '%s:refs/hq/in/%s' % (sha, cid), cwd=top,
            env=git_env(m['ssh']))
        rel = os.path.relpath(cwd, top)
        req.update(repo=repo, base=sha, sub='' if rel == '.' else rel)
    elif prev:
        req.update({k: prev[k] for k in ('repo', 'base', 'sub') if prev.get(k)})

    # The delegation record kith-ask made for this ask (hop caps and cost cap passed): the chain goes with the request, so
    # the run on the other Mac counts its hops and cost on from here.
    rid = os.environ.get('KITH_ASK_RECORD')
    mine = ask.delegation_of(rid) if rid else None
    if mine:
        req['delegation'] = mine
    blob = base64.b64encode(json.dumps(req).encode()).decode()
    p = rsh(m['ssh'], '%s remote _run %s' % (kith, blob), check=False)
    res = last_json(p.stdout)
    if not res:
        if rid:
            ask.settle(rid, 0, 'stopped')
        sys.stderr.write((p.stderr or p.stdout or 'kith ask: no answer from %s\n' % host)[-3000:])
        return 1
    if rid:   # the other Mac's cost is the chain's cost here too
        ask.settle(rid, res.get('cost_usd') or 0, 'stopped' if res.get('error') else 'answered')

    branch, notes = res.get('branch'), []
    if branch and res.get('commits') and top:
        git('fetch', '-q', '%s:%s' % (m['ssh'], res['repo']), '+%s:%s' % (branch, branch), cwd=top, env=git_env(m['ssh']))
        base = req['base'][:10]
        notes.append('%d commit(s) on %s · review: git diff %s %s · apply to your tree: git diff %s %s | git apply'
                     % (res['commits'], branch, base, branch, base, branch))
    if res.get('files'):
        dest = cwd / 'kith-out' / cid
        dest.mkdir(parents=True, exist_ok=True)
        subprocess.run(['scp', '-q', '-r', '-o', 'ControlPath=~/.ssh/hq-%C', '-o', 'BatchMode=yes',
                        '%s:%s/.' % (m['ssh'], shlex.quote(res['out'])), str(dest)], check=False)
        notes.append('%d file(s) in %s' % (len(res['files']), os.path.relpath(dest)))

    turns = (prev or {}).get('turns', 0) + 1
    cost = (prev or {}).get('cost', 0) + (res.get('cost_usd') or 0)
    entry = {'agent': '%s@%s' % (agent, host), 'id': cid, 'session_id': res.get('session_id'),
             'at': dt.datetime.now().isoformat(timespec='minutes'), 'turns': turns, 'cost': round(cost, 4),
             'last': ' '.join(task.split()), 'opts': opts}
    entry.update({k: req[k] for k in ('repo', 'base', 'sub') if req.get(k)})
    ask.keep(key, entry)
    if as_json:
        print(json.dumps(dict(res, agent='%s@%s' % (agent, host), turn=turns, local_branch=branch if notes else None),
                         ensure_ascii=False))
    else:
        print(res.get('answer', ''))
        again = 'kith ask %s@%s -c%s "…"' % (agent, host, ' --as ' + name if name else '')
        print('\n[%s@%s · turn %d · $%.2f this turn%s · continue: %s]' % (
            agent, host, turns, res.get('cost_usd') or 0, ''.join(' · ' + n for n in notes), again), file=sys.stderr)
    return 1 if res.get('error') else 0


# --- the agent's side (run over ssh) ----------------------------------------------------------------------------------

def env_file():
    out = {}
    try:
        for line in ENV.read_text().splitlines():
            m = re.match(r'\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*)', line)
            if m:
                out[m.group(1)] = m.group(2).strip().strip('"\'')
    except OSError:
        pass
    return out


def serve_repo(req):
    repo = HANDOFF / req['slug'] / 'repo'
    if not (repo / '.git').exists():
        repo.mkdir(parents=True, exist_ok=True)
        git('init', '-q', cwd=repo)
        if req.get('origin'):
            git('remote', 'add', 'origin', req['origin'], cwd=repo)
        (repo / '.git/info').mkdir(exist_ok=True)
        with open(repo / '.git/info/exclude', 'a') as f:
            f.write('.kith-out/\n')
    print(json.dumps({'repo': str(repo)}))


def serve_run(req):
    agent, cid = req['agent'], req['id']
    if req.get('repo'):
        repo, branch = Path(req['repo']), 'kith/%s/%s' % (agent, cid)
        wt = repo.parent / 'wt' / cid
        if not wt.exists():
            git('worktree', 'add', '-q', '-B', branch, str(wt), 'refs/hq/in/' + cid, cwd=repo)
        else:   # a conversation begun before the rename keeps its hq/<agent>/<id> branch
            branch = git('branch', '--show-current', cwd=wt, check=False) or branch
        work = wt  # the root, so the whole tree is in reach; the caller's subfolder is named in the task
        where = ('You are working in a handoff worktree of the caller\'s repo, %s, on branch %s, which starts from '
                 'their working tree (uncommitted changes included)%s. Make code changes here and commit them; the '
                 'caller gets this branch back to review. ' % (
                     wt, branch, '; they were in its subfolder %s' % req['sub'] if req.get('sub') else ''))
    else:
        repo, branch, wt = None, None, HANDOFF / '_plain' / cid
        wt.mkdir(parents=True, exist_ok=True)
        work, where = wt, ''
    out = wt / '.kith-out'
    out.mkdir(exist_ok=True)
    task = req['task'] if req.get('cont') else (
        '%s\n\n(Asked from %s:%s through kith ask. %sFiles for the caller that aren\'t code (images, reports, exports) '
        'go in %s; they are copied back. Your final answer is returned to the caller.)'
        % (req['task'], req['caller'], req['from'], where, out))
    argv = [str(KITH / 'bin/kith-ask'), agent, '--json', '--as', 'remote-' + cid]
    if req.get('cont'):
        argv.append('-c')
    for k, v in (req.get('opts') or {}).items():
        argv += [k, v]
    env = dict(os.environ)
    for k, v in (req.get('delegation') or {}).items():   # kith-ask's lineage() reads these
        env['KITH_ASK_' + k.upper()] = str(v)
    if os.environ.get('KITH_REMOTE_PERMISSION_MODE'):   # unset: the agent's mode, else kith's default (bin/kith)
        env['KITH_ASK_PERMISSION_MODE'] = os.environ['KITH_REMOTE_PERMISSION_MODE']
    # Over ssh, macOS keeps the login keychain (where Claude Code keeps its login) out of reach: use the long-lived
    # token from `claude setup-token`, kept in kith's env file (ENV) as CLAUDE_CODE_OAUTH_TOKEN, for this run only.
    if 'CLAUDE_CODE_OAUTH_TOKEN' not in env:
        token = env_file().get('CLAUDE_CODE_OAUTH_TOKEN')
        if token:
            env['CLAUDE_CODE_OAUTH_TOKEN'] = token
    p = subprocess.run(argv + ['--', task], cwd=str(work), env=env, capture_output=True, text=True,
                       stdin=subprocess.DEVNULL)
    res = last_json(p.stdout)
    if res and res.get('error') and 'login' in (res.get('answer') or '').lower() and 'CLAUDE_CODE_OAUTH_TOKEN' not in env:
        res['answer'] = ('⚠️ %s: Claude Code is not logged in for ssh sessions (the login keychain is locked to them). '
                         'Once, on %s: run `claude setup-token` and put the token in %s as '
                         'CLAUDE_CODE_OAUTH_TOKEN=... (chmod 600).' % (os.uname().nodename, os.uname().nodename, ENV))
    res = res or {'answer': '⚠️ %s failed on %s:\n%s' % (agent, os.uname().nodename,
                                                                         (p.stderr or p.stdout)[-1500:]), 'error': True}
    if branch:
        if git('status', '--porcelain', cwd=wt):
            git('add', '-A', cwd=wt)
            git('-c', 'user.name=kith %s' % agent, '-c', 'user.email=hq@localhost', 'commit', '-q', '-m',
                'kith %s: changes left uncommitted' % agent, cwd=wt)
        res.update(repo=str(repo), branch=branch,
                   commits=int(git('rev-list', '--count', '%s..%s' % (req['base'], branch), cwd=wt) or 0))
    res.update(out=str(out), files=sorted(str(f.relative_to(out)) for f in out.rglob('*') if f.is_file()))
    print(json.dumps(res, ensure_ascii=False))


# --- commands ---------------------------------------------------------------------------------------------------------

def for_someone_else(agent):
    """The person this run is for when that isn't the owner (KITH_PERSON, checked with kith-auth), else None. Fails
    closed: when kith-auth can't answer, the person."""
    person = os.environ.get('KITH_PERSON')
    if not person:
        return None
    try:
        r = json.loads(subprocess.run([str(KITH / 'bin/kith-auth'), 'resolve', agent, '--person', person],
                                      capture_output=True, text=True, timeout=30, check=True).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return person
    return None if r.get('owner') else person


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == 'add' and len(rest) == 2: return add(*rest)
    if cmd == 'ls': return ls()
    if cmd == 'rm' and len(rest) == 1:
        r = remotes(); r.pop(rest[0], None); save_remotes(r); print('forgot %s' % rest[0]); return 0
    if cmd == '_repo': return serve_repo(json.loads(rest[0]))
    if cmd == '_run': return serve_run(json.loads(base64.b64decode(rest[0])))
    if cmd == 'ask':  # from kith-ask, for AGENT@MACHINE
        agent, host = rest[0].split('@', 1)
        who = for_someone_else(agent)
        if who:
            sys.exit("kith ask: %s is only for the owner for now: this run is for %s, and %s has no id for them yet, so "
                     "the run there would have the owner's rights. Ask %s on this Mac instead." % (rest[0], who, host, agent))
        cont, name, as_json, no_code, opts, words, i = False, None, False, False, {}, [], 0
        args = rest[1:]
        while i < len(args):
            a = args[i]
            if a in ('-c', '--continue'): cont = True; i += 1
            elif a == '--as': name = args[i + 1]; i += 2
            elif a == '--json': as_json = True; i += 1
            elif a == '--no-code': no_code = True; i += 1
            elif a in ('-p', '--project', '-m', '--model', '-e', '--effort'):
                opts['-' + a.lstrip('-')[0]] = args[i + 1]; i += 2
            elif a == '--': words += args[i + 1:]; break
            else: words.append(a); i += 1
        if not words:
            sys.exit('usage: kith ask AGENT@MACHINE [-c] [--as NAME] [--no-code] [-p P] [-m M] [-e E] [--json] "task"')
        return call(agent, host, opts, ' '.join(words), cont, name, as_json, no_code)
    sys.exit('kith remote: unknown command; see kith remote --help')


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]) or 0)
