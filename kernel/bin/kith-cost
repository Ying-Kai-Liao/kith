#!/bin/sh
''':'
# Two languages in one file, on purpose. The launchd job dev.kith.cost (written by hand, no installer owns it) runs
# `kith-uv run --quiet --script <kernel>/bin/kith-cost sync`, and uv runs a script as Python. The chain is
# launchd -> kith-uv -> python -> /bin/sh -> kith. Line 2 is a no-op `:` to sh and opens a triple-quoted string to Python; the
# string holds the whole sh part, and the Python after it re-runs this same file under /bin/sh. So the installed plist keeps
# working with nobody editing it. Rules for this file: the sh part never has three single quotes in a row, the Python part has no single quote but the one in its last comment, and every
# path through it ends in exec or exit before the line that closes the string. R9 (deleting this stub) must first rewrite the
# plist (retire-python plan, rule 3).
# kith-cost: this script moved to the kith program (`kith kernel cost`, core/kernel/src/cost/). It stays at this path for the
# callers that run the file: the SessionStart hook of a run that started with the old hook path, adapters/harness.py (`record`),
# the host, older hosts, other kernel tools. The usage text is `kith kernel cost -h`. Same stdout, stderr and exit codes as the
# program.
#
# Finds the program without Python: the first candidate whose `kernel version` lists "cost-ledger" (an older program that has the
# read verbs only is not enough: `tag` and `record` write the ledger):
#   $KITH_BIN, the release this file sits in (<release>/share/kith/kernel/bin -> <release>/bin/kith), a kith on PATH that is
#   not a kernel entry, the host kith serve installed, a build in the checkout (the builds come first with KITH_DEV_BIN=1).
# None found: `tag` exits 0 without a word (a hook never blocks a session start); any other verb prints one line on stderr and
# exits 3 (the code of "this moved"). Callers treat any non-zero as "cost unknown", and the line shows.
self=$0
n=0
while [ -L "$self" ] && [ $n -lt 16 ]; do
  link=$(readlink "$self") || break
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
  n=$((n + 1))
done
# The logical path, as bin/kith keeps it (it may be a link to a path with spaces).
kernel=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)
if [ -z "$kernel" ]; then
  echo "kith-cost: cannot find the kernel folder this script sits in" >&2
  exit 3
fi
# The module that has the ledger's writers (`tag`, `record`), not only the read verbs an older program lists under "cost".
need='"cost-ledger"'

# A kith program: executable, not a kernel bash entry (the last three parts of its real path are kernel/bin/kith), and its
# `kernel version` lists the module $need names.
usable() {
  [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] || return 1
  f=$1
  k=0
  while [ -L "$f" ] && [ $k -lt 16 ]; do
    l=$(readlink "$f") || return 1
    case $l in /*) f=$l ;; *) f=$(dirname "$f")/$l ;; esac
    k=$((k + 1))
  done
  case $(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/$(basename "$f") in */kernel/bin/kith) return 1 ;; esac
  "$1" kernel version 2>/dev/null | grep -q "$need"
}
# Each try sets bin and succeeds on a usable program (a path may have a space: nothing here is split).
try() { usable "$1" && bin=$1; }
try_built() {
  target=${CARGO_TARGET_DIR:-$kernel/../serve/host/target}
  try "$target/dev-app/kith" || try "$target/release/kith" || try "$target/debug/kith"
}
try_path() {
  oldifs=$IFS; IFS=:
  for d in $PATH; do
    if [ -n "$d" ] && try "$d/kith"; then IFS=$oldifs; return 0; fi
  done
  IFS=$oldifs
  return 1
}
try_release() { case $kernel in */share/kith/kernel) try "$kernel/../../../bin/kith" ;; *) return 1 ;; esac; }
bin=
if [ "${KITH_DEV_BIN:-}" = 1 ]; then
  try "${KITH_BIN:-}" || try_built || try_path || try "$HOME/.kith/serve/bin/kith-serve" || try_release
else
  try "${KITH_BIN:-}" || try_release || try_path || try "$HOME/.kith/serve/bin/kith-serve" || try_built
fi
if [ -z "$bin" ]; then
  # `tag` is the SessionStart hook of every kith run: it must never block a session from starting, so with no program it
  # says nothing and exits 0 (the session just goes unattributed). Everything else says why and exits 3.
  [ "${1:-}" = tag ] && exit 0
  echo "kith-cost: this script moved to the kith program (module cost-ledger), which was not found; kith update" >&2
  exit 3
fi
exec "$bin" kernel cost --kernel "$kernel" "$@"

exit 3
'''
import os
import sys

if __name__ == "__main__":
    try:
        os.execv("/bin/sh", ["/bin/sh", os.path.abspath(__file__)] + sys.argv[1:])
    except OSError as e:
        print("kith-cost: cannot run /bin/sh: %s" % e, file=sys.stderr)
        sys.exit(3)
# ' sh never gets here; this quote ends the one the line of three quotes above opens for it, so `sh -n` parses the whole file
