#!/usr/bin/env bash
# kith-serve — run Kith's host (serve/host, binary kith-serve) on this Mac as a launchd job.
#
#   kith serve start [--no-build]   build the host (cargo skips what is fresh), install it to ~/.kith/serve/bin, load launchd job dev.kith.serve.
#                                   The live host builds only from its own checkout, ~/.kith/hq-serve: from any other repo checkout
#                                   this hands over to ~/.kith/hq-serve/kernel/bin/kith-serve, or refuses when that is missing.
#   kith serve start --dev          build from THIS checkout anyway (dev only; same as KITH_SERVE_DEV=1). restart takes --dev too.
#   kith serve stop                 stop the job (keeps data and the job file)
#   kith serve restart              stop, then start --no-build
#   kith serve status               the host's own status, and the relay in use
#   kith serve relay [URL]          show or set the relay URL (~/.kith/serve/config.json); restart for it to take effect
#   kith serve cloud [...]          the host's cloud status and settings; --confirm-owner accepts an owner change by
#                                   typing the account at a terminal (refused when stdin is not a terminal)
#
# Data dir ~/.kith/serve, port 19224, launchd label dev.kith.serve, logs inside the data dir. The host's own
# subcommands (install, stop, status) do the launchd work. `kith serve ...` is the same command.
set -euo pipefail

src=$0; while [ -L "$src" ]; do t=$(readlink "$src"); case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac; done
SELF="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
REPO="$(cd "$(dirname "$src")/../.." && pwd)"
HOST=$REPO/serve/host
DATA=$HOME/.kith/serve
BIN=$DATA/bin/kith-serve
CONFIG=$DATA/config.json
PORT=19224
# The build runs inside serve/host, so a relative target dir is fixed against the caller's folder first.
case ${CARGO_TARGET_DIR:-/} in /*) ;; *) export CARGO_TARGET_DIR=$PWD/$CARGO_TARGET_DIR ;; esac

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

find_cargo() {
  command -v cargo 2>/dev/null && return 0
  local c
  # Newest toolchain by modification time.
  c=$(ls -td "$HOME"/.rustup/toolchains/*/bin/cargo 2>/dev/null | head -1 || true)
  [ -n "$c" ] && { echo "$c"; return 0; }
  return 1
}

# A packaged install (kith from a release tarball) has no serve/ source: its host is the kith binary itself, which
# runs as the host when installed under the name kith-serve. kith sets KITH_BIN; else the binary beside share/.
PACKAGED=0; [ -f "$HOST/Cargo.toml" ] || PACKAGED=1
# The Mac app's main build ships a kith for the main environment (own data dir and port, see serve/host environment.rs);
# its bundle says so in share/kith/env, so these commands never touch the dev service's paths.
if [ $PACKAGED = 1 ] && [ "$(cat "$REPO/env" 2>/dev/null)" = main ]; then DATA=$HOME/.kith/serve-main; BIN=$DATA/bin/kith-serve; CONFIG=$DATA/config.json; PORT=19225; fi

built_bin() {
  if [ $PACKAGED = 1 ]; then echo "${KITH_BIN:-$(cd "$REPO" && pwd -P)/../../bin/kith}"; else echo "${CARGO_TARGET_DIR:-$HOST/target}/dev-app/kith-serve"; fi
}

# macOS: a rebuilt binary is ad-hoc signed by the linker, so the Keychain sees a new program and asks for access
# again (an unseen prompt freezes the host's credential store). Signing every install with the same identity and
# identifier keeps one designated requirement, so "Always Allow" survives. The identity is KITH_SIGN_IDENTITY, else
# the first valid "Apple Development" one; with neither it stays ad-hoc and says so.
sign_identity() {
  [ "$(uname)" = Darwin ] || return 0
  local identity=${KITH_SIGN_IDENTITY:-}
  if [ -z "$identity" ]; then
    identity=$(security find-identity -v -p codesigning 2>/dev/null | sed -n 's/^ *[0-9]*) \([0-9A-F]\{40\}\) "Apple Development.*/\1/p' | head -1)
  fi
  if [ -z "$identity" ]; then
    echo "kith serve: no codesigning identity (set KITH_SIGN_IDENTITY): signing ad hoc, so the Keychain may ask for access again after each rebuild" >&2
    identity=-
  fi
  echo "$identity"
}

sign_host() {
  codesign --force --sign "$2" --identifier "${KITH_SIGN_ID:-dev.kith.serve}" "$1" >/dev/null 2>&1 \
    || { echo "kith serve: codesign failed; the binary keeps its build signature" >&2; return 1; }
}

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else cksum "$1" | cut -d' ' -f1,2 | tr ' ' -; fi
}

# The local voice helper goes beside the host (the host looks for it there), replaced by rename like the host.
# Without a built one the install goes on; an older copy is kept until a newer build exists.
install_tts() {
  local src=$1 dest; dest=$(dirname "$BIN")/kith-tts
  [ -x "$src" ] || return 0
  if [ -x "$dest" ] && cmp -s "$src" "$dest"; then return 0; fi
  mkdir -p "$(dirname "$BIN")"
  if cp "$src" "$dest.tmp.$$" && chmod 755 "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"; then echo "installed $dest"
  else rm -f "$dest.tmp.$$"; echo "kith serve: couldn't install kith-tts; local voice stays unavailable" >&2; fi
}

cmd_start() {
  local build=1 dev=0 a
  [ "${KITH_SERVE_DEV:-}" = 1 ] && dev=1
  for a in "$@"; do case $a in --no-build) build=0 ;; --dev) dev=1 ;; *) echo "kith serve start: unknown option $a" >&2; exit 2 ;; esac; done
  # The live host must never be built from whichever checkout the caller happens to be in (~/kith resolves to the
  # dev repo). Only ~/.kith/hq-serve builds it; another checkout hands over to that one, or refuses. Compared by
  # resolved path, so hq-serve's own script never hands over to itself.
  if [ $PACKAGED = 0 ] && [ $dev = 0 ]; then
    local live=$HOME/.kith/hq-serve here live_real
    here=$(cd "$REPO" && pwd -P); live_real=$(cd "$live" 2>/dev/null && pwd -P || true)
    if [ "$here" != "$live_real" ]; then
      if [ -x "$live/kernel/bin/kith-serve" ]; then
        echo "kith serve: $here is not the live checkout; using $live"
        exec "$live/kernel/bin/kith-serve" start "$@"
      fi
      echo "kith serve: the live host builds only from $live (a checkout of main), and it is missing; this checkout ($here) is not it." >&2
      echo "  To build from this checkout anyway (dev only): kith serve start --dev  (or KITH_SERVE_DEV=1)" >&2
      exit 1
    fi
  fi
  local built; built=$(built_bin)
  [ $PACKAGED = 1 ] && build=0
  # Always ask cargo: its target dir may be shared across checkouts, so file times can't say what this tree built.
  if [ $build = 1 ]; then
    local cargo; cargo=$(find_cargo) || { echo "kith serve: cargo not found (install Rust: https://rustup.rs)" >&2; exit 1; }
    echo "building kith-serve (dev-app profile)..."
    local log; log=$(mktemp "${TMPDIR:-/tmp}/kith-serve-build.XXXXXX")
    local lowprio=(); [ -x /usr/sbin/taskpolicy ] && lowprio=(/usr/sbin/taskpolicy -b)
    # Build from inside serve/ so serve/rust-toolchain.toml picks the pinned Rust under rustup. KITH_SERVE_ENV is
    # read at compile time: an exported `main` would build a main host (other port, folder, label) for the dev slot.
    if ! (cd "$HOST" && PATH="$(dirname "$cargo"):$PATH" exec env -u KITH_SERVE_ENV ${lowprio[@]+"${lowprio[@]}"} "$cargo" build --profile dev-app --manifest-path "$HOST/Cargo.toml" --bin kith-serve) >"$log" 2>&1; then
      tail -n 30 "$log" >&2
      rm -f "$log"
      echo "kith serve: build failed; the installed host (if any) is unchanged" >&2
      exit 1
    fi
    # The local voice helper (its own crate, Apple silicon only). A failed build only leaves local voice unavailable.
    if [ "$(uname -s)-$(uname -m)" = Darwin-arm64 ] && ! (cd "$HOST" && PATH="$(dirname "$cargo"):$PATH" exec env -u KITH_SERVE_ENV ${lowprio[@]+"${lowprio[@]}"} "$cargo" build --profile dev-app --manifest-path "$HOST/Cargo.toml" -p kith-tts) >"$log" 2>&1; then
      tail -n 30 "$log" >&2
      echo "kith serve: kith-tts didn't build; local voice stays unavailable" >&2
    fi
    rm -f "$log"
  fi
  if [ -x "$built" ]; then
    # A signature changes the file, so what was installed is told by the hash of what was built and how it was signed.
    local want identity; identity=$(sign_identity)
    want="$(sha256_of "$built"):$identity"
    if [ ! -x "$BIN" ] || [ "$(cat "$BIN.built" 2>/dev/null)" != "$want" ]; then
      mkdir -p "$DATA/bin"
      if ! { cp "$built" "$BIN.tmp.$$" && chmod +x "$BIN.tmp.$$"; }; then
        rm -f "$BIN.tmp.$$"; echo "kith serve: couldn't copy the host to $BIN" >&2; exit 1
      fi
      if [ -n "$identity" ] && ! sign_host "$BIN.tmp.$$" "$identity"; then want="$want:unsigned"; fi
      mv -f "$BIN.tmp.$$" "$BIN" || { echo "kith serve: couldn't install $BIN" >&2; exit 1; }
      echo "$want" >"$BIN.built"
      echo "installed $BIN"
    fi
  fi
  install_tts "$(dirname "$built")/kith-tts"
  [ -x "$BIN" ] || { echo "kith serve: no host binary at $built or $BIN: run kith serve start without --no-build" >&2; exit 1; }
  # The job runs this checkout's kith, not whichever one the login shell finds first. A launcher (config.json
  # `launcher` or KITH_SERVE_LAUNCHER) is opt-in per machine, e.g. when the agents live on an external volume.
  local entry="${KITH_KERNEL_BIN:-${HQ_BIN:-$REPO/kernel/bin/kith}}"
  KITH_KERNEL_BIN="$entry" HQ_BIN="$entry" "$BIN" install --port $PORT
}

relay_url() {
  [ -f "$CONFIG" ] || return 0
  python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("relay_url") or "")
except Exception: pass' "$CONFIG"
}

# The relay in use: ask the running host (it knows the environment's override too), else the file, else the
# build's default (a kith serve build is Dev, which has a built-in relay).
relay_line() {
  local u=""
  if [ -x "$BIN" ]; then u=$("$BIN" cloud --port $PORT 2>/dev/null | sed -n 's/^url: *//p' | head -1 || true); fi
  # "-" is the host saying it has no relay (the cloud is off): not a host that can't answer.
  case $u in "") u=$(relay_url) ;; -) echo "relay: none (the cloud is off)"; return 0 ;; *) echo "relay: $u (host)"; return 0 ;; esac
  if [ -n "$u" ]; then echo "relay: $u (config.json)"; else echo "relay: built-in default (kith serve relay <url> to change)"; fi
}

cmd_relay() {
  if [ $# -eq 0 ]; then relay_line; return 0; fi
  case $1 in
    https://?*|http://127.0.0.1|http://127.0.0.1[:/]*|http://localhost|http://localhost[:/]*) ;;
    *) echo "kith serve relay: the URL must start with https:// (or http://127.0.0.1 / http://localhost)" >&2; exit 2 ;;
  esac
  mkdir -p "$DATA"
  python3 - "$CONFIG" "$1" <<'PY'
import json, os, sys, tempfile
path, url = sys.argv[1:3]
try: cfg = json.load(open(path))
except Exception: cfg = {}
cfg['relay_url'] = url
# A temp file of its own in the same folder, so two writers never share one and the rename stays atomic.
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or '.', prefix='.config.json.')
with os.fdopen(fd, 'w') as f:
    f.write(json.dumps(cfg, indent=2) + '\n')
os.replace(tmp, path)
PY
  echo "relay set. Run: kith serve restart"
}

cmd_status() {
  if [ -x "$BIN" ]; then "$BIN" status --port $PORT || true; else echo "kith-serve: not installed (kith serve start)"; fi
  relay_line
}

case ${1:-help} in
  start)   shift; cmd_start "$@" ;;
  stop)    [ -x "$BIN" ] || { echo "kith serve: not installed" >&2; exit 1; }; "$BIN" stop ;;
  restart) shift; "$SELF" stop; cmd_start --no-build "$@" ;;
  status)  cmd_status ;;
  relay)   shift; cmd_relay "$@" ;;
  cloud)   shift; [ -x "$BIN" ] || { echo "kith serve: not installed" >&2; exit 1; }
           # Who owns this Mac is confirmed by a person at a terminal, never by a script or an agent piping an answer.
           for a in "$@"; do
             if [ "$a" = --confirm-owner ] && [ ! -t 0 ]; then
               echo "kith serve: an owner change is confirmed by a person: run this in a terminal, or use the Kith app" >&2; exit 1
             fi
           done
           "$BIN" cloud --port $PORT "$@" ;;
  # Where this install's host lives, for kith-sessions: one rule, the one above.
  endpoint) echo "$DATA $PORT" ;;
  help|-h|--help) usage ;;
  *) echo "kith serve: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
