#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["discord.py>=2.4,<3", "slack_sdk>=3.27,<4", "aiohttp>=3.9"]
# ///
"""kith-bridge — talk to kith agents from chat: Discord, Telegram and Slack, any number of bots, in one process.

  kith-bridge            run the bridge (foreground; launchd keeps it alive with --install)
  kith-bridge --install  install the macOS LaunchAgent so it starts at login and restarts if it dies
  kith-bridge --status   show the connections, rooms and open threads
  kith-bridge --launcher copy uv to ~/.kith/bin/kith-uv (or the existing hq-uv); give that file Full Disk Access once, then --install

Each bot is a connection: a discord/, telegram/ or slack/ profile granted to `bridge` (kith-auth set telegram/hq
TELEGRAM_BOT_TOKEN, then kith-auth grant bridge telegram telegram/hq; several bots: telegram/hq,telegram/home). The
Discord token in KITH_DISCORD_BOT_TOKEN is discord/hq. Each connection runs and restarts on its own, so one platform
failing doesn't take the others down.

What happens with a message is the same everywhere (lib/kith_bridge/core.py): the sender is a person (kith-auth people;
an account is linked with /link CODE from kith-auth invite), `@agent` picks who answers, a thread is one task, its
replies resume the same session, messages sent while the agent works are queued, and stop or a correction ends the
run. Runs for anyone but the owner get KITH_PERSON, so bin/kith applies their membership. The platforms: discord_chat.py,
telegram_chat.py, slack_chat.py next to it.

Config (env or ~/.kith/secrets/env): KITH_DISCORD_BOT_TOKEN, KITH_DISCORD_GUILD (server name or ID when the bot is in
several; its owner counts as kith's owner until the owner's Discord account is linked, and with it unset no server
owner does), KITH_BRIDGE_PERMISSION_MODE (the owner's runs, on any harness; unset: the agent's settings.json defaultMode,
else kith's default, auto),
KITH_BRIDGE_DM_DEFAULT (the agent the owner's new DMs go to; default personal), KITH_BRIDGE_DEBOUNCE (seconds to wait
for more messages before a run starts; default 2), KITH_BRIDGE_ROUTER (jev or off; default jev when a Jev key is
found), KITH_BRIDGE_INTERRUPT (off: corrections wait for the next turn instead of restarting the run),
KITH_BRIDGE_CONTEXT_SHOW (a reply ends with a small "context N%" line once the thread's session is at least this full,
in percent; default 30, off to never show it), KITH_BRIDGE_STALL (seconds the bridge may be stuck before it exits for
launchd to start it again; default 180).
State: ~/.kith/bridge/ (rooms, threads → sessions, the inbox, webhooks, downloaded attachments, run outboxes).
Log: ~/.kith/logs/bridge.log.

Self-healing: a watchdog thread exits the process when the event loop or its thread pool stops answering (launchd's
KeepAlive starts it again); a connection that goes quiet (Discord: no gateway traffic, Telegram: no poll comes back)
is restarted. What was sent while the bridge was away is answered once when it is back, marked late: Telegram keeps
it until the saved offset confirms it, Discord's is read from history after the last message the bridge saw.
"""
import asyncio
import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import kith_launchd  # noqa: E402
from kith_paths import paths, launcher as uv_launcher, retire_old_job, sync_env  # noqa: E402  the one place that knows where kith's folders are
from kith_bridge.core import STATE_DIR, Core, agents, log, read_state  # noqa: E402
LABEL = 'dev.kith.bridge'
# launchd can't read the external SSD without Full Disk Access; grant it to this fixed copy of uv, not the
# versioned Homebrew path that `brew upgrade uv` replaces
LAUNCHER = uv_launcher()

LOG = paths()['KITH_LOGS'] / 'bridge.log'


def load_env():
    f = paths()['KITH_SECRETS'] / 'env'
    if f.exists():
        for line in f.read_text().splitlines():
            k, sep, v = line.strip().partition('=')
            # only kith's own settings: everything here is inherited by the agent runs the bridge starts, and the
            # file also holds things for other tools (CLAUDE_CODE_OAUTH_TOKEN is for kith-remote's runs only)
            if sep and k.strip().startswith(('KITH_', 'HQ_')):
                os.environ.setdefault(k.strip(), v.strip().strip('"\''))
    sync_env()   # HQ_X lines written before the rename fill in KITH_X


def launcher():
    import shutil
    uv = shutil.which('uv')
    if not uv:
        sys.exit('uv not found on PATH')
    LAUNCHER.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(os.path.realpath(uv), LAUNCHER)
    print(f'copied {os.path.realpath(uv)} → {LAUNCHER}\n'
          f'Grant it Full Disk Access (System Settings → Privacy & Security → Full Disk Access → +, Cmd+Shift+G, '
          f'paste the path), then run kith-bridge --install. A new copy needs granting again.')


def install():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    me = paths()['KITH_HOME'] / 'kernel' / 'bin' / 'kith-bridge'   # the address, not the disk path: the kith folder can move
    argv = [LAUNCHER, 'run', '--quiet', '--script', me] if LAUNCHER.exists() else [me]
    args = ''.join(f'<string>{a}</string>' for a in argv)
    plist = Path.home() / 'Library' / 'LaunchAgents' / f'{LABEL}.plist'
    path = f"{Path.home()}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array>{args}</array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string><key>HOME</key><string>{Path.home()}</string></dict>
  <key>WorkingDirectory</key><string>{Path.home()}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{LOG}</string>
  <key>StandardErrorPath</key><string>{LOG}</string>
</dict></plist>
""")
    retire_old_job('bridge')
    kith_launchd.reload_or_exit(LABEL, plist)
    print(f'installed {plist}; logs in {LOG}')


SECRETS = {'discord': ['DISCORD_BOT_TOKEN'], 'telegram': ['TELEGRAM_BOT_TOKEN'],
           'slack': ['SLACK_BOT_TOKEN', 'SLACK_APP_TOKEN']}


def connections():
    """[(profile, platform, {VAR: secret})]: every bot granted to the bridge, plus the Discord token from env."""
    auth = str(KITH / 'bin' / 'kith-auth')
    out = []
    for platform, names in SECRETS.items():
        r = subprocess.run([auth, 'granted', '--for', 'bridge', platform], capture_output=True, text=True)
        for profile in r.stdout.split():
            got = {}
            for var in names:
                g = subprocess.run([auth, 'get', '--for', 'bridge', '--profile', profile, platform, var],
                                   capture_output=True, text=True)
                if g.returncode or not g.stdout.strip():
                    log(f'{profile}: {g.stderr.strip() or var + " is empty"}; not connecting it')
                    break
                got[var] = g.stdout.strip()
            else:
                out.append((profile, platform, got))
    if os.environ.get('KITH_DISCORD_BOT_TOKEN') and not any(p == 'discord/hq' for p, _, _ in out):
        out.append(('discord/hq', 'discord', {'DISCORD_BOT_TOKEN': os.environ['KITH_DISCORD_BOT_TOKEN']}))
    return out


async def supervise(adapter):
    """One connection: run it, and when it drops, fails or goes quiet for adapter.quiet seconds, start it again after
    a pause that grows to 5 min."""
    pause = 5
    while True:
        began = time.time()
        adapter.alive = time.monotonic()
        run = asyncio.create_task(adapter.start())
        try:
            while not run.done():
                await asyncio.wait({run}, timeout=min(15, (adapter.quiet or 45) / 3))
                silent = time.monotonic() - adapter.alive
                if adapter.quiet and not run.done() and silent > adapter.quiet:
                    log(f'{adapter.conn}: nothing from it for {silent:.0f}s; restarting the connection')
                    run.cancel()
                    await asyncio.wait({run}, timeout=30)   # a call stuck in a thread is left behind
                    break
            else:
                run.result()
                log(f'{adapter.conn}: connection ended')
        except asyncio.CancelledError:
            run.cancel()
            raise
        except Exception as e:  # noqa: BLE001  never let one platform take the bridge down
            log(f'{adapter.conn}: {type(e).__name__}: {e}')
        pause = 5 if time.time() - began > 600 else min(pause * 2, 300)
        log(f'{adapter.conn}: reconnecting in {pause}s')
        await asyncio.sleep(pause)


async def heartbeat(beat, every):
    """Proves that the loop runs and its thread pool (Telegram's polls, DNS lookups, kith-auth) has room."""
    while True:
        await asyncio.to_thread(time.monotonic)
        beat[0] = time.monotonic()
        await asyncio.sleep(every)


def watchdog(beat, limit):
    """A thread of its own: when the heartbeat stops for `limit` seconds the bridge is stuck, so it exits and
    launchd (KeepAlive) starts it again."""
    while True:
        time.sleep(min(10, limit / 3))
        silent = time.monotonic() - beat[0]
        if silent > limit:
            log(f'stuck: no heartbeat for {silent:.0f}s; exiting so launchd starts the bridge again')
            os._exit(70)


def guard():
    """Starts the watchdog; -> the heartbeat task."""
    limit = float(os.environ.get('KITH_BRIDGE_STALL') or 180)
    beat = [time.monotonic()]
    threading.Thread(target=watchdog, args=(beat, limit), daemon=True, name='kith-bridge-watchdog').start()
    return asyncio.create_task(heartbeat(beat, min(5, limit / 4)))


async def serve():
    tasks = [guard()]
    core = Core()
    conns = await asyncio.to_thread(connections)
    if not conns:
        sys.exit(f"kith-bridge: no bots: set KITH_DISCORD_BOT_TOKEN in {paths()['KITH_SECRETS'] / 'env'}, or grant one "
                 f"(kith-auth set telegram/hq TELEGRAM_BOT_TOKEN; kith-auth grant bridge telegram telegram/hq)")
    for profile, platform, secrets in conns:
        try:
            if platform == 'discord':
                from kith_bridge.discord_chat import Discord as A
            elif platform == 'telegram':
                from kith_bridge.telegram_chat import Telegram as A
            else:
                from kith_bridge.slack_chat import Slack as A
        except ImportError as e:
            log(f'{profile}: {e}; not connecting it')
            continue
        tasks.append(asyncio.create_task(supervise(A(profile, secrets, core))))
    log(f'connecting {", ".join(p for p, _, _ in conns)}; agents: {", ".join(agents())}')
    await asyncio.gather(*tasks)


def main():
    load_env()
    if '--launcher' in sys.argv:
        return launcher()
    if '--install' in sys.argv:
        return install()
    if '--status' in sys.argv:
        st = read_state()
        print(json.dumps({'connections': sorted(st['conns']), 'rooms': st['rooms'],
                          'threads': {k: {x: t.get(x) for x in ('person', 'owner', 'last', 'sessions')}
                                      for k, t in st['threads'].items()},
                          'inbox': {k: v for k, v in st['inbox'].items() if v}}, indent=2))
        return
    asyncio.run(serve())


if __name__ == '__main__':
    main()
