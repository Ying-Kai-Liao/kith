#!/usr/bin/env python3
"""kith-init — set kith up on this Mac, or bring yours back on a new one. Safe to run again: it only does what is missing.

  kith init                  check what kith needs, make ~/.kith and the agents folder (each a git repo), a user.md to
                           fill in, offer one backup to private GitHub repos (default no; kith backup), and a starter
                           agent. On a new Mac whose GitHub login has a backup (<you>/hq-state), it offers to bring
                           it back first
  kith init --from <github-user>
                           the same restore without asking: clone <user>/hq-state into ~/.kith and <user>/hq-agents
                           into the agents folder, then install every agent agents.json lists
                           Either way it asks whether your agents run on another Mac, and if so sets up the ssh login
                           and kith remote add for you
  kith init --yes            take each offer's default without asking (the starter yes, GitHub copies no); without a
                           terminal, offers are skipped

install.sh runs it at the end. `kith doctor` checks a working install.
"""
import json, os, re, shutil, socket, subprocess, sys
from pathlib import Path

KITH = Path(os.environ.get('KITH_ROOT') or os.path.dirname(os.path.dirname(
    os.path.normpath(os.path.join(os.environ.get('PWD') or os.getcwd(), sys.argv[0])))))
LIB = Path(__file__).resolve().parent.parent / 'lib'
sys.path.insert(0, str(LIB))
from kith_paths import paths  # noqa: E402  the one place that knows where kith's folders are

sys.stdout.reconfigure(line_buffering=True)   # in order with the tools it runs, also when piped
P = paths()
STATE, AGENTS, SECRETS = P['KITH_STATE'], P['KITH_AGENTS'], P['KITH_SECRETS']
GITHUB = os.environ.get('KITH_GITHUB', 'https://github.com')   # another git host, or a local folder in tests
YES = '--yes' in sys.argv or '-y' in sys.argv
ASK = sys.stdin.isatty() and not YES
MACHINE_FOLDERS = (Path.home() / '.kith', Path.home() / '.hq')   # this Mac's folder: new name, or old until kith migrate


def run(*args, cwd=None, check=False):
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, check=check)


# ---- how it looks ------------------------------------------------------------------------------------------------------
# Colour only on a terminal, and never with NO_COLOR set; piped output stays plain text.

COLOR = sys.stdout.isatty() and not os.environ.get('NO_COLOR')


def paint(code, text):
    return f'\033[{code}m{text}\033[0m' if COLOR else text


def dim(text):
    return paint('2', text)


def accent(text):
    return paint('38;5;79', text)


MARKS = {'✓': lambda: paint('32', '✓'), '!': lambda: paint('33', '!'), '✗': lambda: paint('31', '✗'),
         '-': lambda: dim('·')}
LOGO = ['█', '█▄▄ ▄▄▄', '█ █ █▄█', '      █']
STEPS = 0
RESTORED = set()   # folders restore() just brought back, so ensure_repo doesn't list them twice


def logo(title, subtitle):
    print()
    for i, row in enumerate(LOGO):
        side = {1: paint('1', title), 2: dim(subtitle)}.get(i, '')
        print(f'  {accent(row.ljust(9))}  {side}'.rstrip())


def section(title):
    global STEPS
    STEPS += 1
    print(f'\n  {accent(str(STEPS))}  {paint("1", title)}')


def say(mark, text, note=''):
    print(f'     {MARKS[mark]()} {text}' + (f'  {dim(note)}' if note else ''))


def tilde(path):
    home = str(Path.home())
    return '~' + str(path)[len(home):] if str(path).startswith(home) else str(path)


def offer(question, default=True, note=''):
    """Yes/no: asked on a terminal; --yes takes the default; without a terminal, nothing is done."""
    if YES:
        return default
    if not ASK:
        return False
    if note:
        print(f'       {dim(note)}')
    a = input(f'     {accent("?")} {question} {dim("Y/n" if default else "y/N")} ').strip().lower()
    return default if not a else a.startswith('y')


def prompt(question, default=''):
    if not ASK:
        return ''
    return input(f'     {accent("?")} {question}' + (f' {dim(f"({default})")}' if default else '') + ' ').strip()


def has_commits(repo):
    return run('git', 'rev-parse', '--verify', '-q', 'HEAD', cwd=repo).returncode == 0


def gh_user():
    if not shutil.which('gh'):
        return ''
    return run('gh', 'api', 'user', '-q', '.login').stdout.strip()


# ---- what kith needs ----------------------------------------------------------------------------------------------------

def check_tools():
    """True when kith can work; prints what is missing and how to fix it."""
    ok = True
    for tool, why, fix in (('git', 'agents are git repos', 'xcode-select --install'),
                           ('claude', 'agents run in Claude Code', 'https://claude.com/claude-code')):
        if shutil.which(tool):
            say('✓', tool)
        else:
            ok = False
            say('✗', f'{tool} is missing', f'{why} · {fix}')
    for key in ('user.name', 'user.email'):
        if run('git', 'config', '--global', key).stdout.strip():
            continue
        say('!', f'git has no {key}', 'every agent version is a commit, which needs it')
        value = prompt(f'Your {key.split(".")[1]} for git')
        if value:
            run('git', 'config', '--global', key, value)
            say('✓', f'git {key} set')
        else:
            ok = False
            say('✗', f'git {key} not set', f'git config --global {key} "..."')
    if not shutil.which('gh'):
        say('-', 'gh', 'optional, for backups and sharing · brew install gh')
    elif not gh_user():
        say('-', 'gh', 'not logged in · optional, for backups and sharing · gh auth login')
    else:
        say('✓', f'gh ({gh_user()})')
    if not shutil.which('uv'):
        say('-', 'uv', 'optional, for Discord and some agents\' tools · brew install uv')
    return ok


# ---- the two private repos ------------------------------------------------------------------------------------------

def ensure_repo(folder, gitignore, label):
    """folder as a git repo with the given .gitignore and a first commit."""
    folder.mkdir(parents=True, exist_ok=True)
    if not (folder / '.git').exists():
        run('git', 'init', '-q', '-b', 'main', cwd=folder)
    if not (folder / '.gitignore').exists():
        shutil.copy(LIB / gitignore, folder / '.gitignore')
    if not has_commits(folder):
        run('git', 'add', '-A', cwd=folder)
        r = run('git', 'commit', '-q', '-m', f'{label}: start', cwd=folder)
        if r.returncode:
            say('!', f'{label}: no first commit yet', (r.stderr or r.stdout).strip().splitlines()[-1])
            return
    if folder in RESTORED:
        return
    say('✓', tilde(folder).ljust(14), {'state': 'who you are, your projects',
                                         'agents': "each agent's memory and data"}.get(label, ''))


def restore(user):
    """A new Mac: this user's state into ~/.kith and agents into the agents folder, both from GitHub."""
    if GITHUB == 'https://github.com' and gh_user():
        run('gh', 'auth', 'setup-git')   # git fetches the private repos with gh's login
    for folder, repo, label in ((STATE, 'hq-state', 'state'), (AGENTS, 'hq-agents', 'agents')):
        url = f'{GITHUB}/{user}/{repo}.git'
        if (folder / '.git').exists() and has_commits(folder):
            say('✓', tilde(folder), 'already has history; kept')
            continue
        folder.mkdir(parents=True, exist_ok=True)
        if not (folder / '.git').exists():
            run('git', 'init', '-q', '-b', 'main', cwd=folder)
        run('git', 'remote', 'remove', 'origin', cwd=folder)
        run('git', 'remote', 'add', 'origin', url, cwd=folder)
        r = run('git', 'fetch', '-q', 'origin', cwd=folder)
        if r.returncode and label == 'agents':   # memories were never backed up: agents start fresh, nothing lost
            run('git', 'remote', 'remove', 'origin', cwd=folder)
            say('-', tilde(folder), f'no {user}/{repo} on GitHub; agents start with empty memories')
            continue
        if r.returncode:
            sys.exit(f'✗ {label}: could not fetch {url} ({r.stderr.strip()}). Private? gh auth login, then again.')
        branch = run('git', 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD', cwd=folder).stdout.strip() \
            or ('origin/main' if run('git', 'rev-parse', '-q', '--verify', 'origin/main', cwd=folder).returncode == 0
                else 'origin/master')
        r = run('git', 'checkout', '-q', '-f', '-B', branch.split('/', 1)[1], '--track', branch, cwd=folder)
        if r.returncode:
            sys.exit(f'✗ {label}: checkout failed: {r.stderr.strip()}')
        say('✓', tilde(folder), f'from {user}/{repo}')
        RESTORED.add(folder)
    if STATE in MACHINE_FOLDERS:
        (STATE / 'secrets').mkdir(exist_ok=True)
        os.chmod(STATE / 'secrets', 0o700)


def backed_up():
    return json.loads(run(str(KITH / 'bin' / 'kith-state'), 'backup', '--json').stdout or '[]')


def gh_login():
    """gh auth login in the browser, on a terminal: the GitHub login, or ''."""
    if not ASK or not shutil.which('gh'):
        return ''
    say('-', 'logging in to GitHub', 'gh opens your browser')
    subprocess.run(['gh', 'auth', 'login', '-w', '-p', 'https'])
    return gh_user()


def find_backup():
    """A new Mac (no state yet): offer the backup at <you>/hq-state, found through the GitHub login."""
    if has_commits(STATE) or not shutil.which('gh'):
        return
    me, asked = gh_user(), False
    if not me:
        asked = True
        if not offer('Bring back kith from a GitHub backup?', default=False,
                     note='Only if you use kith on another Mac and backed it up there.'):
            return
        me = gh_login()
        if not me:
            say('!', 'not logged in to GitHub', 'later: kith init --from <your GitHub name>')
            return
    if run('gh', 'repo', 'view', f'{me}/hq-state', '--json', 'name').returncode:
        if asked:
            say('-', f'no backup at {me}/hq-state', 'starting fresh')
        return
    if asked:   # they said bring it back already
        say('✓', f'found your backup, {me}/hq-state')
        restore(me)
    elif offer(f'You have kith backed up on GitHub ({me}/hq-state). Bring it back to this Mac?', default=True,
               note='Your profile, projects, agents and their memories.'):
        restore(me)


def backups():
    """One backup: a private GitHub repo for every piece that has none (kith backup does the work)."""
    ps = backed_up()
    local = [p['name'] for p in ps if p['state'] == 'local']
    if not local:
        say('✓', 'backed up to GitHub', dim(', '.join(p['name'] for p in ps)) if len(ps) < 6 else f'{len(ps)} pieces')
        every_night(ask=True)
        return
    if not shutil.which('gh'):
        say('-', 'on this Mac only', 'for a GitHub copy too: brew install gh, then kith backup')
        return
    if len(local) < len(ps):   # some are on GitHub already: the rest belongs there too
        yes = offer(f'Back up the rest too: {", ".join(local)}?', default=True,
                    note='The other pieces are already in private repos on GitHub.')
    else:
        yes = offer('Also keep a copy in private GitHub repos?', default=False,
                    note='It stays on this Mac either way. With a copy, a new Mac gets everything back: your '
                         'profile, agents and their memories.')
    if not yes:
        say('-', 'on this Mac only' if len(local) == len(ps) else f'only here: {", ".join(local)}',
            'later: kith backup')
        return
    if not gh_user() and not gh_login():
        say('!', 'not logged in to GitHub', 'later: kith backup')
        return
    r = run(str(KITH / 'bin' / 'kith-state'), 'backup', '--yes')
    for line in r.stdout.splitlines():
        m = re.match(r'([\w-]+): (backed up to .*)', line)
        if m:
            say('✓', m.group(1), m.group(2))
    for line in r.stderr.splitlines():
        say('✗', line)
    left = [p['name'] for p in backed_up() if p['state'] == 'local']
    if left:
        say('!', f'still only here: {", ".join(left)}', 'kith backup says why')
    every_night(ask=False)


def every_night(ask):
    """The nightly backup: on with the backup itself; asked about only for a backup made before it existed."""
    if (Path.home() / 'Library/LaunchAgents/dev.kith.backup.plist').exists():
        say('✓', 'every night at 03:00', 'kith backup --nightly off stops it')
        return
    if ask and not offer('Back up every night?', default=True, note='Today it runs only when you ask.'):
        say('-', 'only when you ask', 'later: kith backup --nightly')
        return
    r = run(str(KITH / 'bin' / 'kith-state'), 'backup', '--nightly')
    say('✓' if r.returncode == 0 else '✗', 'every night at 03:00' if r.returncode == 0 else 'nightly backup',
        'kith backup --nightly off stops it' if r.returncode == 0 else (r.stderr or r.stdout).strip()[-200:])


# ---- agents on another Mac ------------------------------------------------------------------------------------------

def tailscale_macs():
    """Online Macs on your tailnet other than this one, as (short name, address)."""
    exe = shutil.which('tailscale') or '/Applications/Tailscale.app/Contents/MacOS/Tailscale'
    try:
        peers = json.loads(run(exe, 'status', '--json').stdout or '{}').get('Peer') or {}
    except (OSError, ValueError):
        return []
    out = []
    for p in peers.values():
        if p.get('OS') == 'macOS' and p.get('Online') and p.get('TailscaleIPs'):
            name = (p.get('DNSName') or p.get('HostName') or '').split('.')[0]
            try:
                socket.gethostbyname(name)   # MagicDNS on: the name is nicer and survives a new address
                out.append((name, name))
            except OSError:
                out.append((name or p['TailscaleIPs'][0], p['TailscaleIPs'][0]))
    return sorted(out)


def other_macs():
    """A Mac that uses agents running on another of yours: a key, login without a password, kith remote add.
    Returns the names of the machines set up."""
    conf = P['KITH_MACHINE'] / 'remotes.json'
    try:
        have = json.loads(conf.read_text())
    except (OSError, ValueError):
        have = {}
    if have:
        say('✓', ', '.join(have), 'kith remote ls')
        return list(have)
    if not offer('Do your agents run on another Mac you want to use from here?', default=False):
        say('-', 'agents run on this Mac', 'later: kith remote add <name> <user>@<mac>')
        return []
    macs = tailscale_macs()
    for i, (name, _) in enumerate(macs, 1):
        print(f'       {accent(str(i))}  {name}')
    pick = prompt('Which Mac?', 'number, name or address' if macs else 'name or address')
    host = macs[int(pick) - 1][1] if pick.isdigit() and 0 < int(pick) <= len(macs) else pick
    if not host:
        say('-', 'skipped', 'later: kith remote add <name> <user>@<mac>')
        return []
    me = os.environ.get('USER', '')
    target = f'{prompt("Your user name on it?", me) or me}@{host}'
    ssh = Path.home() / '.ssh'
    if not any(ssh.glob('id_*.pub')):
        ssh.mkdir(mode=0o700, exist_ok=True)
        run('ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(ssh / 'id_ed25519'))
        say('✓', 'made an ssh key', tilde(ssh / 'id_ed25519'))
    test = ('ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'StrictHostKeyChecking=accept-new',
            target, 'true')
    if run(*test).returncode:
        print(f'       {dim(f"The password for {target}, asked once: from then on this Mac logs in without it.")}')
        print(f'       ', end='', flush=True)
        subprocess.run(['ssh-copy-id', '-o', 'StrictHostKeyChecking=accept-new', target], capture_output=True)
        print('\r', end='')   # back to the line's start when ssh asked for nothing
        if run(*test).returncode:
            say('✗', f'cannot log in to {target}', 'on that Mac: System Settings → General → Sharing → Remote '
                                                     'Login, on for this user; then kith init again')
            return []
    say('✓', f'logs in to {target}')
    short = re.sub(r'[^a-z0-9-]', '', host.split('.')[0].lower()) or 'mac'
    short = 'mini' if 'mini' in short else short
    name = re.sub(r'[^a-z0-9-]', '', prompt('A short name for it?', short).lower()) or short
    r = run(str(KITH / 'bin' / 'kith-remote'), 'add', name, target)
    if r.returncode:
        say('✗', f'kith remote add {name}', (r.stderr or r.stdout).strip().splitlines()[-1])
        return []
    agents = [l.split()[0] for l in r.stdout.strip().splitlines()[1:] if l.strip()]
    say('✓', f'{name} added', ', '.join(f'{a}@{name}' for a in agents) or 'no agents there yet')
    return [name]


# ---- starting points ------------------------------------------------------------------------------------------------

def user_md():
    f = STATE / 'user.md'
    if f.exists():
        return
    shutil.copy(LIB / 'user.md', f)


def you():
    """You as kith's owner (kith-auth people), named once from git: other people you add later are checked against
    you. Logins and browser profiles are yours by default; API keys and bots are shared."""
    auth = str(KITH / 'bin' / 'kith-auth')
    listing = run(auth, 'people').stdout
    if '(owner)' in listing:
        say('✓', f'you are {listing.split()[0]} in kith')
        return
    full = run('git', 'config', '--global', 'user.name').stdout.strip()
    guess = re.sub(r'[^a-z0-9-]', '', (full.split() or [os.environ.get('USER', 'me')])[0].lower()) or 'me'
    answer = prompt('What should kith call you? (a short id, like your first name)', guess) or guess
    pid = re.sub(r'[^a-z0-9-]', '', answer.lower()) or guess
    r = run(auth, 'person', pid, f'name={full or answer}', 'owner')
    if r.returncode == 0:
        say('✓', f'you are {pid} in kith', 'your logins stay yours; add people with kith auth person, see kith auth people')
    else:
        say('!', 'could not name you in kith', r.stderr.strip())


def project_root():
    """Where a new project's files go (kith project add ID --home): asked once, kept in projects.json as "homes"."""
    f = STATE / 'projects.json'
    reg = json.loads(f.read_text())
    if 'homes' in reg or not ASK:
        return   # without a terminal ~/Documents is the default anyway; asked on the next run that has one
    print(f'       {dim("A project (a client, a product, a line of research) can have a folder for its files. kith links")}')
    print(f'       {dim("folders you already have; a new project with none gets one here.")}')
    where = prompt('Where do you keep project files?', '~/Documents') or '~/Documents'
    d = Path(os.path.expanduser(where))
    if not d.is_dir():
        say('!', f'no folder {where}', 'kept ~/Documents; change it with: kith project root <folder>')
        return
    reg['homes'] = tilde(d.resolve())
    f.write_text(json.dumps(reg, indent=2) + '\n')
    say('✓', f'new project folders go in {reg["homes"]}', 'kith project root <folder> changes it')


def starter():
    have = json.loads(run(str(KITH / 'bin' / 'kith-pkg'), 'list', '--json').stdout or '{}')
    if have:
        say('✓', ', '.join(sorted(have)))
        return
    starters = {n: s for n, s in json.loads((LIB / 'starters.json').read_text()).items()
                if not n.startswith('$') and s.get('link')}
    got = 0
    for name, s in starters.items():
        if offer(f'Install the {name}?', note=f'The agent that {s["about"]}.'):
            r = run(str(KITH / 'bin' / 'kith-pkg'), 'install', s['link'], '--as', name, '--yes')
            got += r.returncode == 0
            say('✓' if r.returncode == 0 else '✗', name if r.returncode == 0 else f'{name} not installed',
                s['link'] if r.returncode == 0 else (r.stderr or r.stdout).strip()[-200:])
        else:
            say('-', f'no {name}', f'later: kith install {s["link"]}')
    if not got:
        say('-', 'no agents yet', 'kith new <name> "<what it does>"' if not starters else 'kith market finds more')


def find_agents():
    """The market's new agents, to install by number (kith market). Each install shows what the agent may do first."""
    if ASK:
        subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'market', '--new'])


TOUR = [
    ('Agents', 'Each one is a specialist with its own skills, tools and a memory that grows as you use it.'),
    ('Reach one', 'kith <agent> in a terminal, or ask for it by name in any Claude Code session.'),
    ('Yours', '~/.kith and ~/kith/agents stay on this Mac.'),
    ('Undo', 'Every change is a version: kith history <agent>, then kith restore <agent> <commit>.'),
    ('Share', 'kith install <owner>/<repo> adds one someone shared; kith share <agent> shares yours.'),
]


def tour():
    print(f'\n  {paint("1", "How kith works")}')
    for head, text in TOUR:
        print(f'     {accent(head.ljust(10))} {text}')


def done(commands, note=''):
    print(f'\n  {paint("32", "✓")} {paint("1", "Ready.")} ' + ('Start here:' if len(commands) == 1 else 'Next:'))
    for c in commands:
        print(f'       {accent("$")} {paint("1", c)}')
    if note:
        print(f'       {dim(note)}')
    print()


def main(argv):
    if '-h' in argv or '--help' in argv:
        print(__doc__.strip())
        return
    logo('kith', 'your agents, on your Mac')
    section('What kith needs')
    if not check_tools():
        sys.exit(f'\n  Fix the {paint("31", "✗")} above, then run kith init again.\n')
    if STATE not in MACHINE_FOLDERS:
        say('-', f'state is {tilde(STATE)}', '~/.kith is not this Mac\'s folder yet; see install.sh')
    elif STATE == Path.home() / '.kith' and not (Path.home() / '.hq').exists():
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / '.migrated').touch()   # a fresh Mac starts on ~/.kith: lib/kith_paths.py reads the marker
    if '--from' in argv:
        i = argv.index('--from')
        if i + 1 >= len(argv):
            sys.exit('kith init --from <github-user>')
        restore(argv[i + 1])
    section('Your folders')
    if '--from' not in argv:
        find_backup()
    (STATE / 'projects').mkdir(parents=True, exist_ok=True)
    if not (STATE / 'projects.json').exists():
        (STATE / 'projects.json').write_text('{"projects": {}}\n')
    user_md()
    you()
    project_root()
    ensure_repo(STATE, 'dot-kith.gitignore', 'state')
    ensure_repo(AGENTS, 'agents.gitignore', 'agents')
    if (STATE / 'agents.json').exists():   # the agents this state lists (another Mac's): install the missing ones
        r = run(str(KITH / 'bin' / 'kith-pkg'), 'install', '--saved')
        for line in (r.stdout + r.stderr).splitlines():
            m = re.match(r'installed ([\w.-]+) from (\S+)', line)
            if m:
                say('✓', m.group(1), re.sub(r'^.*?([\w.-]+/[\w.-]+?)(\.git)?$', r'from \1', m.group(2)))
            elif re.match(r'[\w.-]+: ', line):
                say('!', *line.split(': ', 1))
        subprocess.run([str(KITH / 'bin' / 'kith-pkg'), 'fetch', '--all'], capture_output=True)
    section('Backups')
    backups()
    section('Other Macs')
    remote = other_macs()
    section('Agents')
    if remote and not json.loads(run(str(KITH / 'bin' / 'kith-pkg'), 'list', '--json').stdout or '{}'):
        say('-', 'none on this Mac', f'you use the ones on {remote[0]}')
        done([f'kith ask <agent>@{remote[0]} "…"', 'kith remote ls'],
             f'From inside a git repo, the agent works on your code and sends its change back as a branch.')
        return
    starter()
    section('Agents people shared')
    find_agents()
    if 'updated: never' not in (STATE / 'user.md').read_text():
        done(['kith ls', 'kith <agent>', 'kith doctor'], 'your agents · talk to one · check everything')
        return
    tour()
    if (AGENTS / 'builder' / 'role').is_dir():
        done(['kith builder'], 'It asks a few questions about you, then builds your first specialist with you.')
    else:
        done(['kith new <name> "<what it does>"'])


if __name__ == '__main__':
    main(sys.argv[1:])
