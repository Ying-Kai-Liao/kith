#!/usr/bin/env python3
"""kith-lifecycle — what Kith does with a session no process runs (F12, designs/2026-10-24-lifecycle.md).

  kith-lifecycle sweep [--session SID] [--at-sleep]
                          the tick (kith-wake drain starts it): for each listed session with no live writer, the 54-minute
                          decision of its idle period, once (rule 5): compact, sleep or end. Compact runs
                          `claude -p --resume SID "/compact"` only while holding the session's writer claim and after
                          checking again under it (rule 11), and under kith-stub, which holds the conversation's lock until claude exits (a run
                          that holds it already: `busy`, no decision, the next sweep tries again; no stub: a warning, or a refusal
                          with KITH_REQUIRE_STUB=1); the claim names the stub's pid, or claude's when there is none (claim-then-exec;
                          claude descends from the stub), so it lasts while claude writes even if the sweep dies. End is written only under the claim too (rule 12). Prints one
                          line per session it acted on. --at-sleep: ask now (a 5-minute cache has no timer; the wrapper
                          calls it as a session goes to sleep).
  kith-lifecycle status SID [--json]   what is known: how it ended (idle, quit, ... or crash), the decision, outstanding work
  kith-lifecycle intent SID WHY PID   write an intent (before a signal; the host's stop paths do the same in Rust)

Rules this keeps: one compactor per session: only a session with no live process and no claim is touched, and a live
interactive one compacts itself at 54 minutes (Claude's own idle compaction); the compaction's own write is no turn, so it
never restarts the idle clock; nothing here signals any process. Host bot sessions (ACP) have no registry file, so this
never sees them; a session the host keeps a conversation for (resolveThread knows it) is skipped too: the host's own
compactor (memory/compaction.rs while_idle) keeps those. A failed /compact is tried once per idle period. One sweep at a time
(flock sessions/lifecycle.lock).
"""
import argparse, fcntl, importlib.machinery, importlib.util, json, os, re, shutil, signal, sys, time
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / 'lib'))
import kith_lifecycle as lc  # noqa: E402
import kith_paths  # noqa: E402

KINDS = ('terminal', 'ask', 'schedule', 'helper')
COMPACT_TIMEOUT = 900


def sessions_mod():
    loader = importlib.machinery.SourceFileLoader('kith_sessions', str(BIN / 'kith-sessions'))
    spec = importlib.util.spec_from_loader('kith_sessions', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def entries(ks):
    d = ks.reg_dir()
    for f in sorted(d.glob('*.json')) if d and d.is_dir() else ():
        try:
            e = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(e, dict) and e.get('sessionId') and e.get('kind', 'terminal') in KINDS and e.get('transcriptPath'):
            yield e


def waiting(sid):
    """A parked wake request or a waiter is still open for the session (a sign it will be back)."""
    s = lc.state_dir()
    if not s:
        return False
    for f in (s / 'sessions' / 'waits').glob('*.json'):
        try:
            if json.loads(f.read_text()).get('session') == sid:
                return True
        except (OSError, ValueError):
            pass
    for f in (s / 'sessions' / 'queue').glob('*.json'):
        try:
            if f.name != 'answered.json' and sid in f.read_text(errors='replace'):
                return True
        except OSError:
            pass   # delivered and removed since the listing
    return False


def host_owns(ks, sid):
    """The host keeps a conversation for this session (an app thread, or a terminal session it imported): its own compactor
    (memory::compaction::while_idle) handles that one, so this never does (rule 6, one compactor per session). False when the
    host is down or doesn't know it. The host does not report open/pinned/closed threads, so those signals are not used."""
    r = ks.host_call('resolveThread', {'thread': sid})
    return bool(r and not r.get('error') and r.get('sessionId'))


def writer_free(ks, e, me=None):
    """Nobody else writes the session: no live claim but our own (`me`: the pid we claimed it for), no live claude process."""
    sid, me = e['sessionId'], me or os.getpid()
    mine = lambda c: c and c.get('pid') == me
    if ks.writer_mode():   # the claims are the core's: the claim we hold (take_claim) is the only writer, there are no files to look at
        return not ks.live_pid(e)
    claims = [c for c in (ks.read_claim(ks.claim_path(sid)), ks.read_claim(ks.claim_path(sid, True))) if not mine(c)]
    return not (any(ks.claim_live(c) for c in claims) or ks.live_pid(e))


def decide_for(ks, e, at=None):
    t, sid, kind = e['transcriptPath'], e['sessionId'], e.get('kind') or 'terminal'
    if lc.decide(t, kind, False, None, at=at) is None:
        return None   # too early: the host is not asked
    return lc.decide(t, kind, waiting(sid), None, at=at)


def settled(sid, since, decision=None):
    """This idle period already has its decision acted on (a compaction done, or ended)."""
    d = lc.read_decision(sid)
    return bool(d and d.get('idleSince') == since and (d.get('compacted') or d.get('failed') or d.get('decision') == 'end' and d.get('ended')))


def still(ks, e, want, since, at=None, me=None):
    """The checks under the claim (rules 11, 12): nothing changed since the decision was made."""
    sid, t = e['sessionId'], e['transcriptPath']
    d = lc.read_decision(sid)
    if not d or d.get('decision') != want or d.get('idleSince') != since or d.get('compacted'):
        return False   # cleared by a resume, or already done this period
    if lc.last_turn_at(t) != since or not writer_free(ks, e, me):
        return False
    if lc.compacted_since(t, since) and want == 'compact':
        return False   # Claude compacted it itself since (rule 6, belt and braces)
    if want == 'compact' and lc.context_tokens(t) < lc.FLOOR_TOKENS:
        return False
    return decide_for(ks, e, at) == want


def failed(sid, why):
    """One try per idle period: a failed /compact is recorded and not retried until the session has a new turn."""
    lc.write_decision(sid, {**(lc.read_decision(sid) or {}), 'failed': why, 'failedAt': time.time()})
    return f'failed: {why}'


def parked(argv, cwd, env, group=False, keep=None):
    """Fork the process that will be claude, parked before its exec: it execs argv (in cwd, with env, stdio on /dev/null)
    when b'1' is written to `go`, and exits without running anything when `go` closes unwritten (also when this process
    dies). Its pid is claude's pid (or the kith-stub's that runs claude), so the writer claim can name it before it starts
    (claim-then-exec, as a one-shot does in kernel/bin/kith). `group`: it leads a process group of its own, which reap() kills as
    a whole. `keep`: an fd that survives the exec (kith-stub's status pipe). Returns (pid, go, err): an exec that fails writes why to `err`; one that succeeds closes it."""
    go_r, go_w = os.pipe()
    err_r, err_w = os.pipe()   # not inheritable (PEP 446): the exec closes them
    pid = os.fork()
    if pid == 0:
        try:
            os.close(go_w)
            os.close(err_r)
            if group:
                os.setpgid(0, 0)
            if keep is not None:
                os.set_inheritable(keep, True)
            if os.read(go_r, 1) == b'1':
                os.chdir(cwd)
                null = os.open(os.devnull, os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(null, fd)
                os.execvpe(argv[0], argv, env)
        except BaseException as x:  # noqa: BLE001 — reported to the parent, never raised in a forked copy of the sweep
            try:
                os.write(err_w, str(x).encode())
            except BaseException:  # noqa: BLE001
                pass
        finally:
            os._exit(127)
    os.close(go_r)
    os.close(err_w)
    return pid, go_w, err_r


def reap(pid, timeout=None, group=False):
    """Wait for pid; its exit code (negative: the signal), or None when it ran past timeout (it is then killed and reaped).
    `group`: pid leads its own process group (parked(group=True)); the kill takes the group, so a kith-stub in front does not
    leave claude running without the lock."""
    end = time.monotonic() + timeout if timeout else None
    while True:
        got, status = os.waitpid(pid, os.WNOHANG if end else 0)
        if got:
            return os.waitstatus_to_exitcode(status)
        if time.monotonic() >= end:
            os.killpg(pid, signal.SIGKILL) if group else os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
            if group:   # the claim may be given back only once claude has left the process table (a write stuck in the kernel)
                for _ in range(100):
                    try:
                        os.killpg(pid, 0)
                    except OSError:
                        break
                    time.sleep(0.1)
            return None
        time.sleep(0.2)


def lock_stub(sid):
    """-> (argv prefix, problem): the conversation's writer lock, as kernel/bin/kith takes it for a run with a session id: the
    run starts under `kith-stub --lock-dir <machine>/core/locks --key SID --`, which holds the lock until claude exits. The
    program is KITH_STUB_BIN, else beside the kith program (where it really lives first, then as given). No program, or an id
    kith-stub's keys cannot hold: no prefix, and `problem` says so (a warning; KITH_REQUIRE_STUB=1 makes it a refusal)."""
    if not re.fullmatch(r'[a-z0-9._-]+', sid):
        return [], f'session id "{sid}" cannot be locked (only a-z 0-9 . _ - are allowed)'
    stub = os.environ.get('KITH_STUB_BIN')
    if not stub:
        kbin = kith_paths.kith_bin()
        for d in (os.path.dirname(os.path.realpath(kbin)), os.path.dirname(kbin)) if kbin else ():
            if os.access(os.path.join(d, 'kith-stub'), os.X_OK):
                stub = os.path.join(d, 'kith-stub')
                break
    if not (stub and os.access(stub, os.X_OK)):
        return [], 'no kith-stub program beside kith, so this conversation cannot be locked'
    machine = os.environ.get('KITH_MACHINE') or str(kith_paths.paths()['KITH_MACHINE'])
    return [stub, '--lock-dir', os.path.join(machine, 'core', 'locks'), '--key', sid, '--'], None


def stub_word(fd):
    """What kith-stub wrote on its status pipe before it ran claude: "locked", "busy", or '' (it hit a lock error)."""
    try:
        return os.read(fd, 64).decode(errors='replace').strip()
    except OSError:
        return ''


def compact(ks, e, since, at):
    """The claim names claude's own pid, not this sweep's (I11): a sweep that dies while claude writes leaves the claim held
    by the live writer, so nobody else gets in until claude has exited."""
    sid, t = e['sessionId'], e['transcriptPath']
    claude = os.environ.get('KITH_CLAUDE') or shutil.which('claude') or 'claude'
    env = {k: v for k, v in os.environ.items() if k not in ('KITH_PERSON', 'KITH_VIA', 'CLAUDECODE', 'CLAUDE_CODE_ENTRYPOINT')}
    env['CLAUDE_CONFIG_DIR'] = str(Path(t).parents[2])   # the login the session was made under
    # The conversation's writer lock (a --direct run or a host turn on it is busy, not a second writer). The stub, not claude, is
    # the process the claim names: claude descends from it, and the claim ends with the stub, which waits for claude.
    stub, problem = lock_stub(sid)
    # The stub says on a status pipe whether it holds the lock ("locked" / "busy"; nothing and EOF is a lock error): claude can
    # itself exit 75, 126 or 127, so the exit code alone cannot tell.
    status_r = status_w = None
    if stub:
        status_r, status_w = os.pipe()
        stub = [*stub[:-1], '--status-fd', str(status_w), '--']
    pid, go, err = parked([*stub, claude, '-p', '--resume', sid, '/compact'], e.get('cwd') or '/', env, group=bool(stub), keep=status_w)
    if stub:
        os.close(status_w)
    reaped = False
    try:
        if ks.take_claim(sid, pid, 'oneshot', agent=e.get('agent'), lifecycle_owner=True):
            return 'held'
        if not still(ks, e, 'compact', since, at, pid):
            return 'skipped'
        if not (e.get('cwd') and os.path.isdir(e['cwd'])):
            return failed(sid, 'the session\'s folder is gone')   # --resume would look in the wrong project
        if problem:
            if os.environ.get('KITH_REQUIRE_STUB') == '1':
                return failed(sid, problem)
            print(f'kith-lifecycle: {problem}; this compaction of {sid} is not locked against another run of the conversation', file=sys.stderr)
        os.write(go, b'1')
        why = b''
        while True:
            chunk = os.read(err, 4096)
            if not chunk:
                break
            why += chunk
        if why:   # claude not on PATH, say
            return failed(sid, why.decode(errors='replace'))
        rc = reap(pid, COMPACT_TIMEOUT, group=bool(stub))
        reaped = True
        if rc is None:
            return failed(sid, 'timed out')
        if stub:
            word = stub_word(status_r)
            if word == 'busy':
                return 'busy'   # no decision: the pending 'compact' stands, and the next sweep tries again
            if not word and rc != 0:
                return failed(sid, f'the conversation lock could not be taken (kith-stub exit {rc})')
            if word == 'locked' and rc in (126, 127):
                return failed(sid, f'claude did not start (exit {rc})')
        if rc == 0:
            lc.write_decision(sid, {**(lc.read_decision(sid) or {}), 'compacted': True, 'compactedAt': time.time()})
            return 'compacted'
        return failed(sid, f'exit {rc}')
    finally:
        if status_r is not None:
            os.close(status_r)
        os.close(go)   # a child still parked exits without running claude
        os.close(err)
        if not reaped:
            reap(pid)
        ks.release_claims(pid)


def end(ks, e, since, at):
    sid = e['sessionId']
    if ks.take_claim(sid, os.getpid(), 'oneshot', agent=e.get('agent'), lifecycle_owner=True):
        return 'held'
    try:
        if not still(ks, e, 'end', since, at):
            return 'skipped'
        lc.write_decision(sid, {**(lc.read_decision(sid) or {}), 'ended': True, 'endedAt': time.time()})
        return 'ended'
    finally:
        ks.release_claims(os.getpid())


def decided_at(d):
    return max(float(d.get(k) or 0) for k in ('at', 'compactedAt', 'endedAt', 'failedAt'))


def quiet(e):
    """Nothing to look at: a decision (or a finished compaction, end or failure) is on record for this idle period and the
    transcript has not been written since, so the file is not parsed again. A pending 'compact' is always looked at."""
    d = lc.read_decision(e['sessionId'])
    try:
        fresh = os.path.getmtime(e['transcriptPath']) <= decided_at(d or {})
    except OSError:
        return True
    return bool(d and fresh and (d.get('decision') != 'compact' or d.get('compacted') or d.get('failed')))


def one(ks, e, at_sleep):
    sid = e['sessionId']
    since = lc.last_turn_at(e['transcriptPath'])
    if since is None or settled(sid, since):
        return None
    at = since + lc.cache_life() if at_sleep else None
    want = decide_for(ks, e, at)
    if not want or host_owns(ks, sid):
        return None
    old = lc.read_decision(sid)
    if not old or old.get('idleSince') != since or old.get('decision') != want:
        lc.write_decision(sid, {'decision': want, 'at': time.time(), 'idleSince': since, 'compacted': False})
        if want == 'sleep':
            return (sid, want, 'asleep')
    elif want == 'sleep':
        return None
    if want == 'compact':
        return (sid, want, compact(ks, e, since, at))
    return (sid, want, end(ks, e, since, at))


def sweep(only=None, at_sleep=False):
    """One sweep at a time (a non-blocking lock: the tick starts one every minute and a compaction can take minutes);
    one session failing never ends the sweep."""
    s = lc.state_dir()
    if not s:
        return []
    (s / 'sessions').mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = os.open(s / 'sessions' / 'lifecycle.lock', os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(lock)
        return []
    ks, out = sessions_mod(), []
    try:
        for e in entries(ks):
            if only and e['sessionId'] != only or (not only and quiet(e)) or not writer_free(ks, e):
                continue
            try:
                got = one(ks, e, at_sleep)
            except Exception as x:  # noqa: BLE001
                got = (e['sessionId'], '?', f'error: {x}')
            if got:
                out.append(got)
    finally:
        os.close(lock)
    return out


def status(sid):
    ks = sessions_mod()
    e = next((x for x in entries(ks) if x['sessionId'] == sid), None)
    why = lc.how_it_ended(sid, bool(e) and not ks.live_pid(e), e and e.get('pid'), e and e.get('procStart'),
                         e and e.get('launcher'), e and e.get('launcherStart'))
    print(json.dumps({'session': sid, 'ended': why, 'decision': lc.read_decision(sid),
                      'outstanding': lc.outstanding(e['transcriptPath']) if e else []}))


def main(argv):
    p = argparse.ArgumentParser(prog='kith-lifecycle', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('sweep')
    s.add_argument('--session')
    s.add_argument('--at-sleep', action='store_true')
    st = sub.add_parser('status')
    st.add_argument('session')
    st.add_argument('--json', action='store_true')   # accepted for symmetry: status always prints the one JSON object
    i = sub.add_parser('intent')
    i.add_argument('session')
    i.add_argument('why')
    i.add_argument('pid', type=int)
    a = p.parse_args(argv)
    if a.cmd == 'sweep':
        for sid, want, did in sweep(a.session, a.at_sleep):
            print(f'{sid} {want} {did}')
    elif a.cmd == 'status':
        status(a.session)
    elif a.cmd == 'intent':
        lc.write_intent(a.session, a.why, a.pid)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
