#!/usr/bin/env python3
"""kith-door — the doors of this Mac (kernel/lib/kith_door.py): fixed commands the kernel runs for a guest in a box.

  kith door prepare AGENT DOOR           (owner) download the door's packages and Chrome into this Mac's door cache
  kith door sweep [--person ID]... [--no-recheck]   stop the doors of these people, of a gone supervisor, and every door
                                         its person may no longer run; prints {"ended": [claims]}
  kith door ls                           the doors running now
"""
import os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import kith_door

if __name__ == '__main__':
    try:
        sys.exit(kith_door.main(sys.argv[1:]))
    except kith_door.DoorError as e:
        print(f'kith door: {e}', file=sys.stderr)
        sys.exit(1)
