#!/usr/bin/env python3
"""kith-ask — ask a kith agent and get its answer back, as a conversation you can continue.

  kith ask <agent> [options] "task"     run the agent on the task in this directory; print its answer
  kith ask <agent> -p ID "task"         ... in project ID's folder on this Mac (project-id --where), from anywhere
  kith ask <agent> -C DIR "task"        ... in DIR
  kith ask <agent> -c "follow-up"       continue the last conversation with that agent from this directory
  kith ask ls                           the conversations kept, newest first
  kith ask <agent>@<machine> "task"     an agent on another machine of yours, over ssh; the owner's runs only (kith remote --help)
  kith ask --bg <agent> [options] "task"  the same run in the background: prints an id at once and returns
  kith ask --wait ID [--timeout S]      the answers to ID since you last looked (waits up to S seconds, default 600,
                                      for the first; exit 3 when none came). For a --bg run: waits for the run to
                                      end, prints its answer and exits with its exit code (every call prints it again)

Options: -c/--continue, --as NAME (a named conversation: -c --as NAME picks it up from anywhere, in its folder),
-C/--dir DIR (work in DIR), -p PROJECT (its memory, and its folder unless -C says; the current one if it has none),
-m MODEL, -e EFFORT, -H HARNESS (claude, codex, pi, agy, hermes, qwen, dsh, opencode; default the agent's own),
--json (the whole result: answer, session, cost, turns).

The same run as `kith <agent> "task"`: its pinned package, own settings and services, memory and project, tagged
via=ask in the cost ledger. The difference is what comes back: the answer alone on stdout (status and errors on
stderr, exit 1 when the agent failed), and its session kept so `-c` resumes it with everything it saw and did.
That makes it the way for a script, another harness or a Claude Code session to work with a specialist over
several turns, in the agent's own tools instead of the caller's.

Permission mode: KITH_ASK_PERMISSION_MODE when set, else the agent's settings.json defaultMode, else kith's default (auto;
~/.kith/settings.json changes it). A tool that needs approval asks through a card in the apps, the same as any
one-shot run: the owner answers it (or a member, for their own run's files). A yes within the window (90 s by default)
lets the run go on; later, the run is told to end its turn and a yes resumes its session. With no host running there is
no card and the tool is refused.
Without --bg the call blocks until the agent has finished (minutes for a real job). With --bg it returns an id at
once: the run goes on detached, its answer and errors are kept in ~/.kith/ask-bg/, and `kith ask --wait ID` collects
them. Everything else (-c, -p, --json, ...) means the same.
Live agents (`session: live` in agent.md, e.g. coder) run as one session of their own. When it is running (kith-live
where), the task is typed into it with reply=ask:<id> and kith ask returns at once with the id; the agent answers with
`kith-send --to ask:<id>` (a job can take an hour), and `kith ask --wait <id>` prints the answers. -p sends the project
along; -c, --as, -m, -e and -H don't apply. Not running: the task runs once as usual.

Conversations: ~/.kith/ask.json (agent + directory, or --as NAME → session id). A conversation belongs to the
directory it ran in, so after -C or -p, `-c` from inside that folder (or with the same -C/-p) continues it.
"""
import datetime as dt, fcntl, json, os, subprocess, sys, time
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from kith_paths import paths  # noqa: E402  the one place that knows where kith's folders are
KEPT = paths()['KITH_MACHINE'] / 'ask.json'
BG = paths()['KITH_MACHINE'] / 'ask-bg'
EFFORTS = ('low', 'medium', 'high', 'xhigh', 'max')


def load():
    try:
        return json.loads(KEPT.read_text())
    except (OSError, ValueError):
        return {}


def keep(key, value):
    KEPT.parent.mkdir(parents=True, exist_ok=True)
    with open(KEPT.with_suffix('.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        kept = load()
        kept[key] = value
        tmp = KEPT.with_suffix('.tmp')
        tmp.write_text(json.dumps(kept, indent=1))
        tmp.replace(KEPT)


def ls():
    kept = sorted(load().items(), key=lambda kv: kv[1].get('at', ''), reverse=True)
    if not kept:
        print('no conversations yet: kith ask <agent> "task"')
    home = str(Path.home())
    for key, v in kept:
        print('%s  %-10s %3d turn(s)  $%-6.2f %s' % (v.get('at', '?'), v.get('agent', '?'), v.get('turns', 0),
                                                   v.get('cost', 0), key.split('|', 1)[1].replace(home, '~', 1)))
        print('    %s' % v.get('last', '')[:110])


def wait_bg(mid, timeout):
    """The answer of a `kith ask --bg` run: waits for it to end, then prints what it printed."""
    out, err, code = BG / (mid + '.out'), BG / (mid + '.err'), BG / (mid + '.exit')
    end = time.time() + timeout
    while not code.exists() and time.time() < end:
        time.sleep(1)
    if not code.exists():
        print('kith ask: %s is still running; ask again with: kith ask --wait %s' % (mid, mid), file=sys.stderr)
        return 3
    sys.stdout.write(out.read_text() if out.exists() else '')
    sys.stderr.write(err.read_text() if err.exists() else '')
    try:
        return int(code.read_text().strip() or 1)
    except ValueError:
        return 1


def background(argv):
    """Run this same call detached; print its id at once. The wrapper writes the exit code last, atomically."""
    mid = 'bg-%s-%s' % (dt.datetime.now().strftime('%Y%m%d%H%M%S'), os.urandom(3).hex())
    BG.mkdir(parents=True, exist_ok=True)
    (BG / (mid + '.cmd')).write_text(' '.join(argv) + '\n')
    base = str(BG / mid)
    script = '"$@" >"$0.out" 2>"$0.err" </dev/null; echo $? >"$0.exit.tmp"; mv "$0.exit.tmp" "$0.exit"'
    subprocess.Popen(['/bin/sh', '-c', script, base, sys.executable, os.path.abspath(__file__), *argv],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    print('started %s in the background as %s; its answer: kith ask --wait %s' % (argv[0], mid, mid))
    return 0


def wait(argv):
    """kith ask --wait ID [--timeout S]: the answers since last time; the first may take a while."""
    mid = argv[0] if argv else ''
    if not mid or not all(c.isalnum() or c in '._-' for c in mid):
        sys.exit('usage: kith ask --wait ID [--timeout SECONDS]')
    timeout = float(argv[argv.index('--timeout') + 1]) if '--timeout' in argv else 600
    if (BG / (mid + '.cmd')).exists():
        return wait_bg(mid, timeout)
    box = paths()['KITH_MACHINE'] / 'live' / 'ask'
    log, seen = box / ('%s.jsonl' % mid), box / ('%s.read' % mid)
    done = int(seen.read_text() or 0) if seen.exists() else 0
    end = time.time() + timeout
    while True:
        lines = log.read_text().splitlines() if log.exists() else []
        if len(lines) > done or time.time() >= end:
            break
        time.sleep(2)
    if len(lines) <= done:
        print('kith ask: no answer to %s yet; ask again with: kith ask --wait %s' % (mid, mid), file=sys.stderr)
        return 3
    for row in lines[done:]:
        try:
            item = json.loads(row)
        except ValueError:
            continue
        print(item.get('text') or 'files: ' + ', '.join(item.get('files', [])) +
              (' (%s)' % item['caption'] if item.get('caption') else ''))
    seen.write_text(str(len(lines)))
    return 0


def live(agent, task, project):
    """Type the task into the agent's running session; None when it isn't a live agent or isn't running."""
    live_bin = str(KITH / 'bin/kith-live')
    if subprocess.run([live_bin, 'is', agent]).returncode != 0:
        return None
    at = subprocess.run([live_bin, 'where', agent], capture_output=True, text=True)
    if at.returncode != 0:
        print('kith ask: %s runs as a live session and none is running; this task runs once instead '
              '(start it to keep its queue: kith live start %s)' % (agent, agent), file=sys.stderr)
        return None
    mid = '%s-%s' % (dt.datetime.now().strftime('%Y%m%d%H%M%S'), os.urandom(3).hex())
    sender = 'agent:' + os.environ['KITH_AGENT'] if os.environ.get('KITH_AGENT') else 'owner'
    r = subprocess.run([live_bin, 'send', agent, '--reply', 'ask:' + mid, '--from', sender, '--id', mid,
                        *(['--project', project] if project else []), '--', task], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        return r.returncode
    print('sent to %s\'s live session (%s) as %s; its answers: kith ask --wait %s'
          % (agent, at.stdout.strip(), mid, mid))
    return 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return 0
    bg = '--bg' in argv   # anywhere before the task's `--`
    if bg:
        argv = [a for a in argv if a != '--bg']
    if argv[0] == 'ls':
        ls(); return 0
    if argv[0] == '--wait':
        return wait(argv[1:])
    if '@' in argv[0]:  # an agent on another machine
        os.execv(str(KITH / 'bin/kith-remote'), [str(KITH / 'bin/kith-remote'), 'ask', *argv])
    agent, rest = argv[0], argv[1:]
    cont, name, as_json, where, kith_opts, words, i = False, None, False, None, [], [], 0
    while i < len(rest):
        a = rest[i]
        if a in ('-c', '--continue'): cont = True; i += 1
        elif a == '--as': name = rest[i + 1]; i += 2
        elif a == '--json': as_json = True; i += 1
        elif a in ('-C', '--dir'): where = rest[i + 1]; i += 2
        elif a in ('-p', '--project', '-m', '--model', '-e', '--effort', '-H', '--harness'):
            if a in ('-e', '--effort') and rest[i + 1] not in EFFORTS:
                sys.exit('kith ask: effort must be one of %s' % ', '.join(EFFORTS))
            kith_opts += [a, rest[i + 1]]; i += 2
        elif a == '--': words += rest[i + 1:]; break
        else: words.append(a); i += 1
    task = ' '.join(words).strip()
    if not task:
        sys.exit('usage: kith ask <agent> [-c] [--as NAME] [-C DIR] [-p PROJECT] [-m MODEL] [-e EFFORT] [-H HARNESS] [--json] "task"')
    if not cont and not os.environ.get('KITH_PERSON'):   # anyone but the owner: a one-shot, which bin/kith checks
        sent = live(agent, task, next((v for f, v in zip(kith_opts[::2], kith_opts[1::2]) if f in ('-p', '--project')), ''))
        if sent is not None:
            return sent
    if bg:   # a live agent already answered above; anything else runs detached, as the call without --bg
        return background([agent, *rest])

    # Where the agent works: -C, else the folder of the project -p names, else a named conversation's own folder.
    project = next((v for f, v in zip(kith_opts[::2], kith_opts[1::2]) if f in ('-p', '--project')), None)
    if not where and project:
        found = subprocess.run([str(KITH / 'bin/project-id'), '--where', project], capture_output=True, text=True)
        where = found.stdout.strip() or None
        if not where and not found.stderr:   # an unknown project: bin/kith says so
            print('kith ask: %s has no folder on this Mac, so %s works here; to give it one: \'%s\' --register %s DIR'
                  % (project, agent, KITH / 'bin/project-id', project), file=sys.stderr)
    if not where and cont and name:
        where = (load().get('%s|as:%s' % (agent, name)) or {}).get('dir')
    started = os.getcwd()
    if where:
        try:
            os.chdir(os.path.expanduser(where))
        except OSError as e:
            sys.exit('kith ask: cannot work in %s: %s' % (where, e.strerror))

    key = '%s|%s' % (agent, ('as:' + name) if name else os.getcwd())
    prev = load().get(key) if cont else None
    if cont and not prev:
        sys.exit('kith ask: no conversation with %s %s to continue; start one without -c'
                 % (agent, 'named ' + name if name else 'from this directory'))

    # A continued conversation keeps its project, model, effort and harness unless this call names new ones.
    given = kith_opts[::2]
    for flag, alias in (('-p', '--project'), ('-m', '--model'), ('-e', '--effort'), ('-H', '--harness')):
        if prev and flag not in given and alias not in given and (prev.get('opts') or {}).get(flag):
            kith_opts += [flag, prev['opts'][flag]]
    opts = {(f if len(f) == 2 else '-' + {'harness': 'H'}.get(f[2:], f[2])): v
            for f, v in zip(kith_opts[::2], kith_opts[1::2])}

    env = dict(os.environ, KITH_VIA='ask', KITH_OUTPUT='json')   # bin/kith: the same for every harness
    # The asked agent's room shows the run as a card, "asked by <caller>" (a terminal when no agent is asking): bin/kith-sessions.
    env.update(KITH_LAUNCH_KIND='ask', KITH_LAUNCH_LABEL=os.environ.get('KITH_AGENT', ''))
    if os.environ.get('KITH_ASK_PERMISSION_MODE'):
        env['KITH_PERMISSION_MODE'] = os.environ['KITH_ASK_PERMISSION_MODE']
    if prev:
        env['KITH_RESUME'] = prev['session_id']
    proc = subprocess.run([str(KITH / 'bin/kith'), agent, *kith_opts, '--', task], env=env, stdin=subprocess.DEVNULL,
                          capture_output=True, text=True)
    try:
        res = json.loads(proc.stdout)
    except ValueError:
        sys.stderr.write((proc.stderr or proc.stdout or 'kith ask: %s gave no answer\n' % agent)[-3000:])
        return proc.returncode or 1

    sid, text = res.get('session_id'), res.get('result') or ''
    turns = (prev or {}).get('turns', 0) + 1
    cost = (prev or {}).get('cost', 0) + (res.get('total_cost_usd') or 0)
    if sid:
        keep(key, {'agent': agent, 'session_id': sid, 'at': dt.datetime.now().isoformat(timespec='minutes'),
                   'turns': turns, 'cost': round(cost, 4), 'opts': opts, 'dir': os.getcwd(),
                   'last': ' '.join(task.split())})
    if as_json:
        print(json.dumps({'agent': agent, 'answer': text, 'session_id': sid, 'error': bool(res.get('is_error')),
                          'turn': turns, 'cost_usd': res.get('total_cost_usd'), 'num_turns': res.get('num_turns')},
                         ensure_ascii=False))
    else:
        print(text)
        moved = '' if name or os.getcwd() == started else (' -p ' + project if project else " -C '%s'" % os.getcwd())
        again = 'kith ask %s -c%s "…"' % (agent, (' --as ' + name) if name else moved)
        print('\n[%s · turn %d · $%.2f this turn · continue: %s]'
              % (agent, turns, res.get('total_cost_usd') or 0, again), file=sys.stderr)
    return 1 if res.get('is_error') else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
