#!/usr/bin/env python3
"""kith-sessions — terminal `kith <agent>` sessions the host can list and continue on the phone (continue anywhere).

  kith-sessions record                     SessionStart hook (stdin: the hook's JSON): writes $KITH_STATE/live/terminal/<sid>.json
                                           for a listable session, nothing otherwise. Never fails the session.
  kith-sessions resolve AGENT THREAD PID   for `kith AGENT --resume THREAD`: prints shell assignments (r_sid, r_cwd, r_from); the host
                                           names the session (POST /api/resolveThread), else a raw Claude session id found on disk.
                                           Takes the session's writer claim for PID (the launcher's shell, which then execs `run`)
  kith-sessions claim SID PID [PERSON [AGENT]]  for a one-shot `claude -p --resume SID`: takes the writer claim for PID (the launcher's shell, which
                                           then execs claude), waiting up to KITH_CLAIM_WAIT s (default 5) while another writer holds it;
                                           then exits 1 with "held by <kind> (pid N)". resolve ... oneshot does the same for -c/-r.
                                           A fresh one-shot claims the --session-id bin/kith chose for it the same way.
  kith-sessions terminal SID PID [PERSON [AGENT]]  for an interactive run that resolve did not claim (a fresh one, on the
                                           --session-id bin/kith chose; KITH_RESUME): the claim, kind terminal, for PID (the
                                           launcher's shell, which then execs `run`, which gives it back); refused at once when held
  kith-sessions proc PID PERSON AGENT     every non-owner run: a session-less `proc-PID.claim` naming the person, so the revoke sweep
                                           finds the run (and the claude below it) after a host restart
  kith-sessions pick AGENT                 for `kith AGENT -r`: the agent's recent sessions (cost ledger runs with a transcript),
                                           numbered on stderr; reads a number on stdin and prints that session id
  kith-sessions latest AGENT DIR           for `kith AGENT -c`: the id of the agent's newest session begun in DIR
                                           (both only name a session: `resolve` still claims and checks it)
  kith-sessions run AGENT -- CMD...        run CMD (claude) as a child: signals and exit code pass through; afterwards gives back the
                                           claims of this process and, if the host took the session over while it ran, says how to get it back

Registry file (contract with the host, serve/): dir 0700, file 0600, written by tmp + rename:
  {"v":1,"sessionId","agent","cwd","transcriptPath","pid" (the claude process),"project","source","resumedFrom","startedAt",
   "account" (the login it was made under: KITH_ACCOUNT_ID, e.g. claude or claude:work; bin/kith resumes it only there)}
Writer claim (contract with the host, serve/host/src/terminal/claim.rs): $KITH_STATE/live/terminal/<sid>.claim, made whole in a
temp file and linked into place (exclusive), 0600: {"pid","procStart","at","kind"}. Whoever holds it is the one writer of the
session, before the registry file exists and with the host down. Stale (pid gone, or started at another time) = free, taken over by rename.
`--resume` claims BEFORE it asks whether the host is busy. A fresh run is claimed too, from before claude starts: bin/kith picks its
session id (--session-id) and claims that, so there is no moment between claude's start and its SessionStart hook in which the host
could take the session for a writer it does not see.
Live = the pid runs and ~/.claude/sessions/<pid>.json names the same sessionId (the host decides; resolve reuses it).
Listable = the owner's own run of one of these kinds (the file's "kind", with "label" saying who started a one-shot and
"procStart" the claude process' start, for the host's liveness when claude keeps no session file):
  terminal  interactive, started in a terminal by `kith <agent>`: the launcher sets KITH_TERMINAL_SESSION=1 for exactly that run
  ask | schedule | helper   a one-shot: bin/kith sets KITH_RUN_KIND for exactly that run from what its launcher passed
            (kith-ask, kith-sched: KITH_LAUNCH_KIND) or, started by another run of the owner's, `helper`.
Never listed: KITH_PERSON runs, the host's own runs (KITH_VIA=serve, channels, tidying), KITH_HIDE_SESSION, agent worktrees.
"""
import datetime as dt, fcntl, json, os, signal, subprocess, sys, time, urllib.error, urllib.request
from pathlib import Path


def now():
    return dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def reg_dir():
    state = os.environ.get('KITH_STATE')
    return Path(state) / 'live' / 'terminal' if state else None


def claude_dir():
    return Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude')


def transcripts(pattern):
    """Transcripts matching pattern under every Claude login's projects: this run's, the default one, and each extra
    account's (kith account add claude <name>), so a session made under another main account is still found."""
    roots = [claude_dir(), Path.home() / '.claude']
    try:
        machine = os.environ.get('KITH_MACHINE')
        if not machine:
            sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
            from kith_paths import paths
            machine = paths()['KITH_MACHINE']
        roots += sorted((Path(machine) / 'accounts' / 'claude').glob('*'))
    except Exception:  # noqa: BLE001 — the default places still count
        pass
    seen = set()
    for r in roots:
        if r in seen:
            continue
        seen.add(r)
        yield from (r / 'projects').glob(pattern)


def run_kind(env=os.environ):
    """What kind of listable run this is, else None: `terminal` (interactive `kith <agent>`), or a one-shot of the owner's that
    bin/kith labelled for this run (KITH_RUN_KIND: ask | schedule | helper). The host's own runs (serve, channels, tidying) and
    anyone else's (KITH_PERSON) are never listed: the apps show those themselves or the person's room does."""
    if env.get('KITH_PERSON') or env.get('KITH_HIDE_SESSION') == '1' or not env.get('KITH_AGENT'):
        return None
    if env.get('KITH_TERMINAL_SESSION') == '1':
        return 'terminal' if env.get('KITH_VIA', 'terminal') == 'terminal' else None
    return env.get('KITH_RUN_KIND') if env.get('KITH_RUN_KIND') in ONE_SHOTS else None


ONE_SHOTS = ('ask', 'schedule', 'helper')


def run_label(kind, env=os.environ):
    """How the room says who started a one-shot; None for a terminal."""
    who = (env.get('KITH_RUN_LABEL') or '').strip()[:60]
    if kind == 'ask':
        return 'asked by %s' % who if who else 'asked from a terminal'
    if kind == 'schedule':
        return 'scheduled: %s' % who if who else 'scheduled'
    if kind == 'helper':
        return 'helper of %s' % who if who else 'helper'
    return None


def listable(cwd, env=os.environ):
    return run_kind(env) is not None and '/.claude/worktrees/' not in cwd + '/'


def ps_row(pid):
    out = subprocess.run(['ps', '-o', 'ppid=,comm=', '-p', str(pid)], capture_output=True, text=True, timeout=3).stdout.split(None, 1)
    return (int(out[0]), out[1].strip()) if len(out) == 2 else (0, '')


def claude_pid(sid):
    """The claude process above this hook: the ancestor whose ~/.claude/sessions file names our session, else the first called claude."""
    pid, named = os.getppid(), 0
    for _ in range(12):
        if pid <= 1:
            break
        try:
            if json.loads((claude_dir() / 'sessions' / f'{pid}.json').read_text()).get('sessionId') == sid:
                return pid
        except (OSError, ValueError):
            pass
        ppid, comm = ps_row(pid)
        if not named and os.path.basename(comm) == 'claude':
            named = pid
        pid = ppid
    return named or None


def write_atomic(path, data):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    tmp = path.with_name(f'.{path.name}.{os.getpid()}.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(data, f)
    os.replace(tmp, path)


def record():
    try:
        hook, env = json.load(sys.stdin), os.environ
        sid, cwd, d = hook.get('session_id'), hook.get('cwd') or os.getcwd(), reg_dir()
        if not (sid and d and listable(cwd)):
            return
        path, started = d / f'{sid}.json', now()
        if hook.get('source') == 'compact':   # same session, same file: keep when it began
            try:
                started = json.loads(path.read_text()).get('startedAt', started)
            except (OSError, ValueError):
                pass
        kind = run_kind()
        pid = claude_pid(sid)
        resumed = env.get('KITH_RESUMED_FROM') or None
        write_atomic(path, {
            'v': 1, 'sessionId': sid, 'agent': env['KITH_AGENT'], 'cwd': cwd, 'transcriptPath': hook.get('transcript_path'),
            'pid': pid, 'project': env.get('KITH_PROJECT') or None, 'source': hook.get('source') or 'startup',
            'resumedFrom': resumed, 'startedAt': started, 'account': env.get('KITH_ACCOUNT_ID') or None,
            'kind': kind, 'label': run_label(kind), 'procStart': proc_start(pid) if pid and kind != 'terminal' else None})
    except Exception as e:  # noqa: BLE001 — listing must never block a session
        print(f'kith-sessions record: {e}', file=sys.stderr)


def host_endpoint():
    """(data dir, port) of this install's host. kith-serve owns the rule (dev 19224 / packaged main 19225); the env overrides win."""
    data, port = os.environ.get('KITH_SERVE_DIR'), os.environ.get('KITH_SERVE_PORT')
    if not (data and port):
        try:
            d, p = subprocess.run([str(Path(__file__).resolve().parent / 'kith-serve'), 'endpoint'], capture_output=True, text=True,
                                  timeout=4, check=True).stdout.split()
        except Exception:  # noqa: BLE001 — fall back to the dev defaults
            d, p = str(Path.home() / '.kith' / 'serve'), '19224'
        data, port = data or d, port or p
    return Path(data), port


def host_call(method, body):
    """The host's local API (owner token over loopback), as the host's own CLI reaches it. None when it can't be reached."""
    try:
        data, port = host_endpoint()
        token = (data / 'token').read_text().strip()
        req = urllib.request.Request(f'http://127.0.0.1:{port}/api/{method}',
                                     json.dumps(body).encode(), {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'})
        with urllib.request.urlopen(req, timeout=4) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:   # a refusal with a body is an answer ("unknown thread"); a 404 is an older host
        if e.code == 404:
            return {'error': 'unknown method', 'unknownMethod': True}
        try:
            return json.load(e)
        except ValueError:
            return None
    except Exception:  # noqa: BLE001
        return None


def proc_start(pid):
    """The start time of pid as `ps` prints it in the C locale (the host writes and reads the same text; the caller's locale
    would print another one), whitespace squeezed; None when it can't be read."""
    try:
        out = subprocess.run(['ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True, text=True, timeout=3,
                             env={**os.environ, 'LC_ALL': 'C'}).stdout
    except Exception:  # noqa: BLE001
        return None
    return ' '.join(out.split()) or None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except (OSError, TypeError, ValueError):
        return False


def claim_path(sid, takeover=False):
    d = reg_dir()
    return d / f'{sid}.{"takeover." if takeover else ""}claim' if d else None


def read_claim(path):
    try:
        c = json.loads(path.read_text())
        return c if isinstance(c, dict) else None
    except (OSError, ValueError):
        return None


def claim_live(c):
    if not c or not pid_alive(c.get('pid')):
        return False
    claimed, actual = c.get('procStart'), proc_start(c['pid'])
    return not (claimed and actual) or ' '.join(claimed.split()) == actual


def take_claim(sid, pid, kind='terminal', person=None, agent=None):
    """Take the writer claim on sid for pid. Returns None when taken, else the live claim that holds it. The claim is made
    whole in a temp file and linked into place (exclusive); a stale one is removed and replaced under a lock file next
    to it, so two takers never both judge it stale and one deletes the other's fresh claim."""
    dest = claim_path(sid)
    dest.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    mine = {'pid': pid, 'procStart': proc_start(pid), 'at': now(), 'kind': kind}
    if person:
        mine['person'] = person   # whose profile the run has, so revoking them can end it (absent: the owner)
        if agent:
            mine['agent'] = agent   # which agent, so narrowing their access ends only the runs on agents they lost
    tmp = dest.with_name(f'.{sid}.claim.{os.getpid()}.tmp')
    tmp.unlink(missing_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(mine, f)
    lock = os.open(dest.with_name(f'{sid}.claim.lock'), os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for _ in range(3):
            try:
                os.link(tmp, dest)   # exclusive: fails when a claim is there
                os.close(lock)
                lock = None
                prune_stale(dest)
                return None
            except FileExistsError:
                pass
            seen = read_claim(dest)
            if claim_live(seen):
                return seen
            dest.unlink(missing_ok=True)   # stale or garbage; nobody else judges it while we hold the lock
        return read_claim(dest) or mine
    finally:
        if lock is not None:
            os.close(lock)
        tmp.unlink(missing_ok=True)


def prune_stale(keep):
    """Remove the session claims whose holder is gone (a one-shot exec'd claude, so nothing of its gives its claim back): a
    stale claim is free anyway, this only keeps a fresh run's claim from staying behind for good. Each under its lock,
    re-read, as a taker would judge it. The host's take-over claims and the proc claims are left to their owners."""
    for f in keep.parent.glob('*.claim'):
        if f == keep or f.name.startswith('proc-') or f.name.endswith('.takeover.claim'):
            continue
        try:
            lock = os.open(f.with_name(f.name[:-len('.claim')] + '.claim.lock'), os.O_WRONLY | os.O_CREAT, 0o600)
        except OSError:
            continue
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if f.exists() and not claim_live(read_claim(f)):
                f.unlink(missing_ok=True)
        finally:
            os.close(lock)


def claim_wait():
    """How long a one-shot waits for a held session (seconds; KITH_CLAIM_WAIT, default 5)."""
    try:
        return max(0.0, float(os.environ.get('KITH_CLAIM_WAIT', '5')))
    except ValueError:
        return 5.0


def claim_waiting(sid, pid, kind, wait, person=None, agent=None):
    """take_claim, retried for up to `wait` seconds while a live writer holds the session. None when taken (also when pid
    already holds it), else the live claim that still holds it."""
    end = time.monotonic() + wait
    while True:
        held = take_claim(sid, pid, kind, person, agent)
        if not held or held.get('pid') == pid:
            return None
        if time.monotonic() >= end:
            return held
        time.sleep(0.25)


def claim_oneshot(sid, pid, person=None, agent=None):
    """`kith-sessions claim SID PID`: for a `claude -p` one-shot (--resume SID, or a fresh --session-id SID). PID is the
    launcher's shell, which then execs claude, so the claim names claude itself and dies with it (a stale claim is free); a
    killed wrapper cannot free it."""
    claim_start(sid, pid, 'oneshot', claim_wait(), person, agent)


def claim_terminal(sid, pid, person=None, agent=None):
    """`kith-sessions terminal SID PID`: for an interactive run resolve did not claim. PID is the launcher's shell, which
    then execs `run`: the claim lasts until claude has exited and `run` gives it back. A held session is refused at once,
    as a second terminal on a resumed one is."""
    claim_start(sid, pid, 'terminal', 0, person, agent)


def claim_start(sid, pid, kind, wait, person=None, agent=None):
    if not reg_dir():
        sys.exit('kith: KITH_STATE is not set, so the session cannot be claimed')
    held = claim_waiting(sid, pid, kind, wait, person, agent)
    if held:
        sys.exit(f'kith: that session is busy: held by {held.get("kind", "terminal")} (pid {held.get("pid")}); try again in a moment')
    taking = read_claim(claim_path(sid, True))
    if claim_live(taking):
        release_claims(pid)
        sys.exit('kith: that session is being taken over in the app right now; try again in a moment')


def proc_claim(pid, person, agent):
    """`kith-sessions proc PID PERSON AGENT`: a run that has a person's profile (any non-owner run, fresh or resumed) is
    findable by the revoke sweep for its whole life: `proc-<pid>.claim` names no session, so it keeps no writer out. PID is
    the launcher's shell, which then execs claude (or kith-sessions run, whose child claude the sweep finds as a descendant).
    Claims of processes that are gone are cleaned up here."""
    d = reg_dir()
    if not d:
        return
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    for f in d.glob('proc-*.claim'):
        if not claim_live(read_claim(f)):
            f.unlink(missing_ok=True)
    mine = {'pid': pid, 'procStart': proc_start(pid), 'at': now(), 'kind': 'app', 'person': person, 'agent': agent}
    tmp = d / f'.proc-{pid}.claim.{os.getpid()}.tmp'
    tmp.write_text(json.dumps(mine))
    os.chmod(tmp, 0o600)
    os.replace(tmp, d / f'proc-{pid}.claim')


def release_claims(pid):
    """Give back every claim pid holds (the terminal's own run ended)."""
    d = reg_dir()
    for f in (d.glob('*.claim') if d and d.is_dir() else ()):
        # Under the claim lock, re-reading: a taker may have replaced the claim since the glob.
        lock = os.open(f.with_name(f.name[:-len('.claim')] + '.claim.lock'), os.O_WRONLY | os.O_CREAT, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            c = read_claim(f)
            if c and c.get('pid') == pid:
                f.unlink(missing_ok=True)
        finally:
            os.close(lock)


def live_pid(entry):
    pid = entry.get('pid')
    try:
        os.kill(pid, 0)
        # the login the session was made under keeps its sessions folder (<config dir>/projects/<p>/<sid>.jsonl)
        root = Path(entry['transcriptPath']).parents[2] if entry.get('transcriptPath') else claude_dir()
        return pid if json.loads((root / 'sessions' / f'{pid}.json').read_text()).get('sessionId') == entry.get('sessionId') else None
    except (OSError, ValueError, TypeError, IndexError):
        return None


def cwd_in(transcript):
    """The folder a transcript's session ran in; '' when it names none."""
    try:
        with open(transcript) as f:
            for _, line in zip(range(60), f):
                try:
                    c = json.loads(line).get('cwd')
                except ValueError:
                    continue
                if c:
                    return c
    except OSError:
        pass
    return ''


def transcript_cwd(sid):
    """The folder a Claude session ran in, from its transcript; None when there is no such session, '' when it names no folder."""
    for t in transcripts(f'*/{sid}.jsonl'):
        return cwd_in(t)
    return None


def first_text(transcript, width=70):
    """The first thing the person typed in a transcript, on one line and cut to width; '' when there is none."""
    try:
        with open(transcript) as f:
            for _, line in zip(range(400), f):
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get('type') != 'user' or d.get('isMeta') or d.get('isSidechain'):
                    continue
                c = (d.get('message') or {}).get('content')
                for t in [c] if isinstance(c, str) else [b.get('text') or '' for b in c or [] if isinstance(b, dict) and b.get('type') == 'text']:
                    t = ' '.join(t.split())
                    if t and not t.startswith('<'):   # command echoes, hook output and reminders come as tags
                        return t if len(t) <= width else t[:width - 1] + '…'
    except OSError:
        pass
    return ''


def recent(agent, limit=15, where=None):
    """The owner's past Claude sessions of AGENT that still have a transcript, newest first (only those begun in WHERE when
    given): [(session, started, via, project, first text)]. From the cost ledger's runs, which every kith run is tagged in."""
    import sqlite3
    machine = os.environ.get('KITH_MACHINE')
    if not machine:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
        from kith_paths import paths
        machine = paths()['KITH_MACHINE']
    db = Path(machine) / 'cost.db'
    if not db.is_file():
        return []
    c = sqlite3.connect(db.as_uri() + '?mode=ro', uri=True)
    try:
        rows = c.execute("select session, started, via, project from runs where agent = ? and coalesce(person, '') = '' "
                         "and session not like '%:%' order by started desc", (agent,)).fetchall()   # 'codex:…': not Claude's
    finally:
        c.close()
    on_disk = {}
    for t in transcripts('*/*.jsonl'):
        on_disk.setdefault(t.stem, t)
    here, out = where and os.path.realpath(where), []
    for sid, started, via, project in rows:
        t = on_disk.get(sid)
        if not t or (here and os.path.realpath(cwd_in(t) or '/nowhere') != here):
            continue
        out.append((sid, started, via, project, first_text(t)))
        if len(out) == limit:
            break
    return out


def pick(agent):
    """For `kith AGENT -r`: list the agent's recent sessions on stderr, read a number, print that session's id."""
    rows = recent(agent)
    if not rows:
        sys.exit(f'kith: no {agent} sessions to resume (none in the cost ledger with a transcript on this Mac)')
    for i, (_, started, via, project, text) in enumerate(rows, 1):
        try:
            when = dt.datetime.fromisoformat(started).replace(tzinfo=dt.timezone.utc).astimezone().strftime('%m-%d %H:%M')
        except (TypeError, ValueError):
            when = '?'.ljust(11)
        print(f'{i:>3}  {when}  {via or "?":<9} {project or "-":<12} {text}', file=sys.stderr)
    print('resume which? (number, Enter to cancel) ', end='', file=sys.stderr, flush=True)
    a = sys.stdin.readline().strip()
    if not a:
        sys.exit(1)
    if not a.isdigit() or not 1 <= int(a) <= len(rows):
        sys.exit(f'kith: no session {a} in the list')
    print(rows[int(a) - 1][0])


def latest(agent, where):
    """For `kith AGENT -c`: print the id of the agent's newest session begun in WHERE."""
    rows = recent(agent, 1, where)
    if not rows:
        sys.exit(f'kith: no {agent} session started in {where} to continue (kith {agent} -r lists them all)')
    print(rows[0][0])


def resolve(agent, thread, claimer=None, wait=0):
    """Name the session to resume and take its writer claim for `claimer` (default: our parent, the launcher's shell, which
    execs `run` and so keeps the pid until claude has exited). The claim comes BEFORE the host is asked whether it is busy: a
    send that is accepted after the claim cannot start, one accepted before it is counted by the host."""
    claimer = claimer or os.getppid()
    d = reg_dir()
    claimed = []

    def die(m):
        if claimed:
            release_claims(claimer)
        sys.exit(f'kith: {m}')

    def claim(sid):
        if not d:
            die('KITH_STATE is not set, so the session cannot be claimed')
        held = claim_waiting(sid, claimer, 'oneshot' if wait else 'terminal', wait)
        if held:
            die(f'that session is open in another writer (pid {held.get("pid")}, {held.get("kind", "terminal")}); close it first')
        claimed.append(sid)
        # The host ending a terminal holds its own claim until the session is imported.
        taking = read_claim(claim_path(sid, True))
        if claim_live(taking):
            die('that session is being taken over in the app right now; try again in a moment')

    def registry_entry(sid):
        try:
            return json.loads((d / f'{sid}.json').read_text()) if d else {}
        except (OSError, ValueError):
            return {}

    r = host_call('resolveThread', {'thread': thread})
    if r and not r.get('error') and r.get('sessionId') and r.get('claims') != 1:
        r = {'error': 'no claims', 'unknownMethod': True}   # a host from before the claims cannot vouch for its threads either
    if r and not r.get('error') and r.get('sessionId'):
        if r.get('agent') != agent:
            die(f'that thread belongs to {r.get("agent")}, not {agent}: kith {r.get("agent")} --resume {thread}')
        sid, cwd = r['sessionId'], r.get('cwd') or ''
        claim(sid)
        # Asked again with the claim held: this answer is the one that counts (the first only named the session).
        again = host_call('resolveThread', {'thread': sid})
        if not (again and not again.get('error') and again.get('sessionId') == sid):
            die('the Kith host stopped answering; try again')
        r = again
        if r.get('hostBusy'):
            die('the app is answering in that thread right now; try again when it has finished')
    elif r and r.get('unknownMethod'):
        # A host older than continue-anywhere cannot say whether it is writing: only a session a terminal started (it is in
        # the registry) is safe; app threads are never there.
        sid = thread
        if not registry_entry(sid):
            die('this Kith host is too old to continue app threads in the terminal (update kith serve to do that); '
                'only sessions started in a terminal can be resumed until then')
        cwd = ''
        claim(sid)
    else:   # host not running, or not one of its threads: a raw Claude session id will do
        sid, cwd = thread, transcript_cwd(thread)
        if cwd is None:
            die(f'unknown thread "{thread}"' + ('' if r is not None else ' (the Kith host is not running, so only a Claude session id can be resumed)'))
        claim(sid)
    e = registry_entry(sid)
    if e and live_pid(e):
        die(f'that session is open in another terminal (pid {live_pid(e)}); close it first')
    if e and e.get('agent') not in (None, agent):
        die(f'that session belongs to {e["agent"]}, not {agent}')
    cwd = cwd or e.get('cwd') or ''
    if cwd and not os.path.isdir(cwd):
        die(f'the session\'s folder {cwd} is gone')
    q = lambda s: "'" + s.replace("'", "'\\''") + "'"
    print(f'r_sid={q(sid)} r_cwd={q(cwd)} r_from={q(sid)}')


def run(agent, cmd):
    """Run cmd as a child of ours so the take-over note can follow it. The child gets the default signals back; we ignore ^C
    (the child decides what it means), pass TERM/HUP on and return its exit code (128+n for a signal)."""
    child = os.fork()
    if not child:
        for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(s, signal.SIG_DFL)
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print(f'kith: cannot run {cmd[0]}: {e}', file=sys.stderr)
            os._exit(127)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda n, _f: os.kill(child, n))
    st = 0
    while True:
        try:
            _, st = os.waitpid(child, 0)
            break
        except InterruptedError:
            continue
        except ChildProcessError:
            break
    try:
        release_claims(os.getpid())
        taken_note(agent, child)
        wake_owed()
    except Exception as e:  # noqa: BLE001
        print(f'kith-sessions: {e}', file=sys.stderr)
    return os.waitstatus_to_exitcode(st)   # a signal death comes back as -n


def wake_owed():
    """A terminal held its session while wakes for it queued (a reply, a card, a waiter): now that it let go, the kernel's
    wake queue may deliver them without waiting for the next tick. A kith ask this session made and didn't read the
    answer of becomes one of them first (kith-ask --sweep, M8)."""
    d = reg_dir()
    if not d:
        return
    here = Path(__file__).resolve().parent
    script = '"$0" "$1" --sweep; ls "$3"/*.json >/dev/null 2>&1 && exec "$0" "$2" drain'
    subprocess.Popen(['/bin/sh', '-c', script, sys.executable, str(here / 'kith-ask'), str(here / 'kith-wake'),
                      str(d.parent.parent / 'sessions' / 'queue')],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def taken_note(agent, pid):
    d = reg_dir()
    if not d or not d.is_dir():
        return
    for f in d.glob('*.json'):
        try:
            e = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        taken = f.with_suffix('.taken')
        if e.get('pid') != pid or not taken.exists():
            continue
        # a .taken left by an earlier crash is older than this run
        began = dt.datetime.strptime(e['startedAt'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=dt.timezone.utc).timestamp()
        fresh = taken.stat().st_mtime >= began
        taken.unlink(missing_ok=True)
        if fresh:
            r = host_call('resolveThread', {'thread': e['sessionId']}) or {}
            print(f'continued in Kith — get it back with: kith {agent} --resume {r.get("threadId") or e["sessionId"]}', file=sys.stderr)


if __name__ == '__main__':
    a = sys.argv[1:]
    if a[:1] == ['record']:
        record()
    elif a[:1] == ['resolve'] and len(a) in (3, 4, 5):
        # A fifth word "oneshot": a `-p` run, which waits a little for a held session instead of refusing at once.
        resolve(a[1], a[2], int(a[3]) if len(a) > 3 else None, claim_wait() if a[4:] == ['oneshot'] else 0)
    elif a[:1] == ['claim'] and len(a) in (3, 4, 5):
        # A fourth word: the person the run is for (kith-auth's answer, set by the launcher); none is the owner. A fifth: its agent.
        claim_oneshot(a[1], int(a[2]), a[3] if len(a) > 3 else None, a[4] if len(a) > 4 else None)
    elif a[:1] == ['terminal'] and len(a) in (3, 4, 5):
        claim_terminal(a[1], int(a[2]), a[3] if len(a) > 3 else None, a[4] if len(a) > 4 else None)
    elif a[:1] == ['proc'] and len(a) == 4:
        proc_claim(int(a[1]), a[2], a[3])
    elif a[:1] == ['pick'] and len(a) == 2:
        pick(a[1])
    elif a[:1] == ['latest'] and len(a) == 3:
        latest(a[1], a[2])
    elif a[:1] == ['run'] and len(a) > 3 and a[2] == '--':
        rc = run(a[1], a[3:])
        sys.exit(128 - rc if rc < 0 else rc)
    else:
        sys.exit(__doc__)
